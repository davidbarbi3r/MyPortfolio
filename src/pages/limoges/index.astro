---
import Layout from '../../layouts/PageLayout.astro';
import { Icon } from 'astro-icon/components';
import HeroImage from '../../assets/images/DSCF7551-3.jpg';
import Image from '~/components/common/Image.astro';

const metadata = {
  title: 'David Barbier | Concepteur de sites web et consultant SEO à Limoges',
  description:
    'Concepteur de sites web freelance à Limoges. Création de site internet sur-mesure, référencement SEO et maintenance. 23 Rue de la Fonderie, Limoges.',
};

// JSON-LD LocalBusiness schema
// Note: branchOf pointe vers le LocalBusiness principal d'Ajaccio
// pour signaler à Google que c'est la même entité (solo operator)
const localBusinessSchema = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "@id": "https://www.davidbarbier.com/limoges/#localbusiness",
  "name": "David Barbier | Concepteur de sites web à Limoges",
  "image": "https://www.davidbarbier.com/david-barbier-consultant-seo-ajaccio.jpg",
  "url": "https://www.davidbarbier.com/limoges/",
  "branchOf": {
    "@id": "https://www.davidbarbier.com/#localbusiness"
  },
  "telephone": "+33623565299",
  "email": "hello@davidbarbier.com",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "23 Rue de la Fonderie",
    "addressLocality": "Limoges",
    "postalCode": "87000",
    "addressCountry": "FR"
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": 45.8352862,
    "longitude": 1.2524095
  },
  "openingHoursSpecification": {
    "@type": "OpeningHoursSpecification",
    "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
    "opens": "09:00",
    "closes": "18:00"
  },
  "areaServed": {
    "@type": "GeoCircle",
    "geoMidpoint": {
      "@type": "GeoCoordinates",
      "latitude": 45.8352862,
      "longitude": 1.2524095
    },
    "geoRadius": "50000"
  },
  "sameAs": [
    "https://twitter.com/daviddeveloppe",
    "https://www.linkedin.com/in/dbarbier/",
    "https://www.instagram.com/daviddeveloppe/",
    "https://www.facebook.com/daviddeveloppe",
    "https://www.malt.fr/profile/davidbarbier",
    "https://github.com/davidbarbi3r"
  ],
  "priceRange": "€€"
};

// JSON-LD Breadcrumb schema
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Accueil",
      "item": "https://www.davidbarbier.com/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Limoges",
      "item": "https://www.davidbarbier.com/limoges/"
    }
  ]
};

const services = [
  {
    title: "Création de site internet",
    description: "Un site qui vous ressemble et qui travaille pour vous 24h/24. Vos clients vous trouvent, vous contactent, vous font confiance.",
    href: "/limoges/wordpress/",
    icon: "tabler:device-desktop"
  },
  {
    title: "Référencement Google",
    description: "Soyez visible quand vos clients vous cherchent. Apparaissez en première page et attirez des prospects qualifiés chaque semaine.",
    href: "/limoges/consultant-seo/",
    icon: "tabler:chart-line"
  },
  {
    title: "Maintenance de site internet",
    description: "Gardez votre site performant et sécurisé. Mises à jour, sauvegardes, monitoring et interventions rapides pour que vous puissiez vous concentrer sur votre activité.",
    href: "/limoges/maintenance-site-internet/",
    icon: "tabler:tool"
  }
];

const testimonials = [
  {
    quote: "David est d'une incroyable patience, d'une oreille attentive, il est pleinement acteur de la mise en lumière de mon travail. D'un grand professionnalisme, je recommande vivement son accompagnement.",
    name: "Marion",
    role: "Fondatrice Gaomata Limoges",
    initial: "M",
    featured: true
  },
  {
    quote: "Parfait, je recommande a 100%. Ayant une pizzeria sur Limoges avec un site internet vieillissant, nous avons choisi David Barbier, pour effectuer une refonte complète de notre site. Nous en sommes pleinement satisfaits, il a su se montrer à l'écoute, réactif et entreprenant.",
    name: "Sebastien",
    role: "Associé Pizza Carmes Limoges",
    initial: "S",
    featured: false
  },
  {
    quote: "Je remercie David pour son travail de qualité dans la conception et la réalisation du site internet REST'Ô DOM. Son écoute, et son professionnalisme ont permis la bonne exécution du site.",
    name: "Cedric",
    role: "Fondateur Rest'ô Dom",
    initial: "C",
    featured: false
  }
];
---

<script>
  const heroImg = document.getElementById('heroImg');

  function scrollPosition(){
    return window.scrollY;
  }

  function percentageScrolled(){
    return scrollPosition() / (document.body.scrollHeight - window.innerHeight);
  }

  function screenWidth(){
    return window.innerWidth;
  }

  function parallax(){
    if (heroImg && screenWidth() > 1024 && percentageScrolled() < 0.20) {
      heroImg.style.transform = `translateY(${scrollPosition() * 0.4}px)`;
    }
  }

  window.addEventListener('scroll', function(){
    parallax();
  });
</script>

<Layout metadata={metadata}>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(localBusinessSchema)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  </Fragment>

  <!-- 1. Hero Section -->
  <section class="relative isolate overflow-hidden dark:bg-[#030620]">
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6">
      <div class="py-12 md:py-20 lg:py-0 lg:flex lg:items-center lg:h-screen lg:gap-8">
      <div class="basis-1/2 text-center lg:text-left pb-10 md:pb-16 mx-auto">
        <!-- Badge localisation -->
        <div class="mt-8 sm:mt-16 lg:mt-8">
          <span class="inline-flex items-center">
            <span class="rounded-full bg-green-800/10 dark:bg-gray-700 px-3 py-1 text-sm font-semibold text-brown ring-1 ring-inset ring-green-950/10 mb-8">
              <Icon name="tabler:map-pin" class="inline mr-1 w-4 h-4" />
              Limoges, Haute-Vienne
            </span>
          </span>
        </div>

        <!-- Titre principal H1 -->
        <h1 class="mt-4 text-pretty font-heading text-3xl font-semibold tracking-tight text-green-950 sm:text-5xl dark:text-white">
          David Barbier | Concepteur de sites web à Limoges
        </h1>

        <!-- Description -->
        <p class="mt-8 text-pretty text-lg text-gray-600 dark:text-gray-300">
          Vous cherchez à attirer plus de clients à Limoges ? Création de site internet sur-mesure et référencement SEO : je vous aide à transformer votre présence en ligne en véritable levier de croissance.
        </p>

        <!-- NAP visible -->
        <address class="mt-8 not-italic bg-green-50 dark:bg-green-950/30 rounded-lg p-6">
          <p class="text-lg font-semibold text-green-900 dark:text-green-100 mb-2">
            <Icon name="tabler:map-pin" class="inline mr-2 w-5 h-5" />
            23 Rue de la Fonderie, 87000 Limoges
          </p>
          <p class="text-lg text-green-800 dark:text-green-200">
            <Icon name="tabler:phone" class="inline mr-2 w-5 h-5" />
            <a href="tel:+33623565299" class="hover:underline">06 23 56 52 99</a>
          </p>
        </address>

        <!-- Bouton CTA -->
        <div class="mt-8">
          <a
            href="tel:+33623565299"
            class="inline-flex items-center gap-2 rounded-full bg-green-600 px-6 py-3 text-sm font-semibold text-white shadow-sm hover:bg-green-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-green-600"
          >
            Me contacter
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
          </a>
        </div>
      </div>

      <!-- Image avec parallax -->
      <div class="basis-1/2">
        <div class="relative m-auto max-w-5xl overflow-hidden rounded-md">
          <div id="heroImg" class="relative m-auto max-w-5xl">
            <Image
              src={HeroImage}
              alt="David Barbier - Création site internet et SEO à Limoges"
              class="mx-auto rounded-md w-full object-bottom object-fill"
              widths={[400, 768, 1024, 2040]}
              sizes="(max-width: 767px) 400px, (max-width: 1023px) 768px, (max-width: 2039px) 1024px, 2040px"
              width={600}
              height={800}
              loading="eager"
            />
          </div>
        </div>
      </div>
    </div>
    </div>
  </section>

  <!-- 2. Services Section -->
  <section class="py-20 sm:py-28 bg-gray-50 dark:bg-gray-900">
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
      <!-- Titre avec mise en avant -->
      <div class="mx-auto max-w-2xl text-center mb-16">
        <h2 class="text-4xl font-bold tracking-tight text-gray-900 dark:text-white sm:text-5xl">
          Comment je peux vous <span class="text-emerald-700 dark:text-emerald-400">aider</span>
        </h2>
        <p class="mt-6 text-lg text-gray-600 dark:text-gray-300">
          Vous méritez une présence en ligne qui vous apporte de vrais résultats. Pas juste un site, mais un outil qui génère des clients.
        </p>
      </div>

      <!-- Cards services -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-10 max-w-4xl mx-auto pt-8">
        {services.map((service) => (
          <a
            href={service.href}
            class="group relative bg-white dark:bg-gray-800 rounded-3xl p-8 pt-12 shadow-sm hover:shadow-xl transition-all duration-300"
          >
            <!-- Icon détouré en haut à gauche avec effet de découpe -->
            <div class="absolute -top-5 left-8 w-14 h-14 rounded-full bg-gray-50 dark:bg-gray-900 flex items-center justify-center">
              <div class="w-11 h-11 rounded-full bg-gradient-to-br from-emerald-500 to-green-600 flex items-center justify-center shadow-md">
                <Icon name={service.icon} class="w-5 h-5 text-white" />
              </div>
            </div>

            <!-- Titre -->
            <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-3">
              {service.title}
            </h3>

            <!-- Description -->
            <p class="text-gray-600 dark:text-gray-400 mb-6">
              {service.description}
            </p>

            <!-- Lien -->
            <span class="inline-flex items-center gap-2 text-green-600 dark:text-green-400 font-semibold group-hover:gap-3 transition-all">
              En savoir plus
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
              </svg>
            </span>
          </a>
        ))}
      </div>

      <!-- CTA button -->
      <div class="text-center mt-12">
        <a
          href="tel:+33623565299"
          class="inline-flex items-center gap-2 px-8 py-4 bg-emerald-700 hover:bg-emerald-600 text-white font-semibold rounded-full shadow-lg hover:shadow-xl transition-all duration-300"
        >
          Discutons de votre projet
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- 2.5 Trust / E-E-A-T Section - Basé à Ajaccio -->
  <section class="py-20 sm:py-28 bg-white dark:bg-gray-950">
    <div class="mx-auto max-w-4xl px-6 lg:px-8">
      <!-- Label -->
      <p class="text-xs font-semibold uppercase tracking-[0.2em] text-gray-400 dark:text-gray-500 mb-6 flex items-center gap-2">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
        En toute transparence
      </p>

      <!-- H2 -->
      <h2 class="text-3xl sm:text-4xl font-bold tracking-tight text-gray-900 dark:text-white mb-8">
        Pourquoi un consultant à Ajaccio pour votre site à <span class="text-emerald-700 dark:text-emerald-400">Limoges</span> ?
      </h2>

      <!-- Story -->
      <div class="space-y-6 text-lg text-gray-600 dark:text-gray-300">
        <p>
          J'ai vécu <strong class="text-gray-900 dark:text-white">plus de 20 ans à Limoges</strong>. C'est la ville où j'ai grandi, où j'ai démarré mon activité, et où vit toujours une bonne partie de ma famille. Quand je dis "ville de cœur", ce n'est pas une formule : j'y retourne régulièrement — pour mes clients actifs en Haute-Vienne et pour les miens.
        </p>
        <p>
          En 2020, j'ai déménagé en Corse pour des raisons personnelles. Mais <strong class="text-gray-900 dark:text-white">Limoges n'est pas un ancien marché, c'est un marché actuel</strong>.
        </p>
      </div>

      <!-- Concrete points -->
      <p class="mt-12 font-semibold text-gray-900 dark:text-white">
        Concrètement, pour votre projet :
      </p>
      <ul class="mt-6 space-y-5 text-gray-600 dark:text-gray-300">
        <li class="flex gap-x-3">
          <svg class="mt-1 size-5 flex-none text-emerald-600 dark:text-emerald-400" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
            <path fill-rule="evenodd" d="M10 18a8 8 0 1 0 0-16 8 8 0 0 0 0 16Zm3.857-9.809a.75.75 0 0 0-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 1 0-1.06 1.061l2.5 2.5a.75.75 0 0 0 1.137-.089l4-5.5Z" clip-rule="evenodd" />
          </svg>
          <span>
            <strong class="font-semibold text-gray-900 dark:text-white">Je connais le terrain.</strong> Les zones, les concurrents locaux, les annuaires du Limousin, les spécificités des SERPs en Haute-Vienne. Pas d'apprentissage à vos frais.
          </span>
        </li>
        <li class="flex gap-x-3">
          <svg class="mt-1 size-5 flex-none text-emerald-600 dark:text-emerald-400" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
            <path fill-rule="evenodd" d="M10 18a8 8 0 1 0 0-16 8 8 0 0 0 0 16Zm3.857-9.809a.75.75 0 0 0-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 1 0-1.06 1.061l2.5 2.5a.75.75 0 0 0 1.137-.089l4-5.5Z" clip-rule="evenodd" />
          </svg>
          <span>
            <strong class="font-semibold text-gray-900 dark:text-white">RDV physique possible.</strong> Entre famille et clients en cours, je reviens à Limoges plusieurs fois par an. Un café en centre-ville ou un passage à votre bureau, c'est inclus.
          </span>
        </li>
        <li class="flex gap-x-3">
          <svg class="mt-1 size-5 flex-none text-emerald-600 dark:text-emerald-400" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
            <path fill-rule="evenodd" d="M10 18a8 8 0 1 0 0-16 8 8 0 0 0 0 16Zm3.857-9.809a.75.75 0 0 0-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 1 0-1.06 1.061l2.5 2.5a.75.75 0 0 0 1.137-.089l4-5.5Z" clip-rule="evenodd" />
          </svg>
          <span>
            <strong class="font-semibold text-gray-900 dark:text-white">Le reste du temps, on bosse en visio.</strong> Mêmes outils, même méthode, même réactivité que pour mes clients à Ajaccio. 90% du SEO et du dev web se fait à distance, même quand on habite à 500m.
          </span>
        </li>
        <li class="flex gap-x-3">
          <svg class="mt-1 size-5 flex-none text-emerald-600 dark:text-emerald-400" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
            <path fill-rule="evenodd" d="M10 18a8 8 0 1 0 0-16 8 8 0 0 0 0 16Zm3.857-9.809a.75.75 0 0 0-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 1 0-1.06 1.061l2.5 2.5a.75.75 0 0 0 1.137-.089l4-5.5Z" clip-rule="evenodd" />
          </svg>
          <span>
            <strong class="font-semibold text-gray-900 dark:text-white">Un interlocuteur, pas une agence.</strong> Pas de chef de projet, pas de sous-traitance, pas de "je reviens vers vous". Vous parlez directement à celui qui fait le boulot.
          </span>
        </li>
      </ul>

      <!-- Soft CTA -->
      <div class="mt-12 border-l-4 border-emerald-600 pl-6">
        <p class="text-lg text-gray-700 dark:text-gray-300">
          <strong class="text-gray-900 dark:text-white">Envie d'en discuter ?</strong> Premier échange de 20 min, sans engagement.
        </p>
        <a
          href="tel:+33623565299"
          class="mt-4 inline-flex items-center gap-2 text-emerald-700 dark:text-emerald-400 font-semibold hover:gap-3 transition-all"
        >
          Réserver un échange
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- 3. Avis Section -->
  <section class="relative isolate bg-white pb-32 pt-24 sm:pt-32 dark:bg-gray-900">
    <div class="absolute inset-x-0 top-1/2 -z-10 -translate-y-1/2 transform-gpu overflow-hidden opacity-30 blur-3xl" aria-hidden="true">
      <div class="ml-[max(50%,38rem)] aspect-[1313/771] w-[82.0625rem] bg-gradient-to-tr from-green-300 to-green-600" style="clip-path: polygon(74.1% 44.1%, 100% 61.6%, 97.5% 26.9%, 85.5% 0.1%, 80.7% 2%, 72.5% 32.5%, 60.2% 62.4%, 52.4% 68.1%, 47.5% 58.3%, 45.2% 34.5%, 27.5% 76.7%, 0.1% 64.9%, 17.9% 100%, 27.6% 76.8%, 76.1% 97.7%, 74.1% 44.1%)"></div>
    </div>
    <div class="absolute inset-x-0 top-0 -z-10 flex transform-gpu overflow-hidden pt-32 opacity-25 blur-3xl sm:pt-40 xl:justify-end" aria-hidden="true">
      <div class="ml-[-22rem] aspect-[1313/771] w-[82.0625rem] flex-none origin-top-right rotate-[30deg] bg-gradient-to-tr from-green-300 to-green-600 xl:mr-[calc(50%-12rem)] xl:ml-0" style="clip-path: polygon(74.1% 44.1%, 100% 61.6%, 97.5% 26.9%, 85.5% 0.1%, 80.7% 2%, 72.5% 32.5%, 60.2% 62.4%, 52.4% 68.1%, 47.5% 58.3%, 45.2% 34.5%, 27.5% 76.7%, 0.1% 64.9%, 17.9% 100%, 27.6% 76.8%, 76.1% 97.7%, 74.1% 44.1%)"></div>
    </div>
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
      <div class="mx-auto max-w-2xl text-center">
        <h2 class="text-base/7 font-semibold text-green-600 dark:text-green-400">Avis clients</h2>
        <p class="mt-2 text-balance text-4xl font-semibold tracking-tight text-gray-900 sm:text-5xl dark:text-white">Ce que mes clients de Limoges disent</p>
      </div>
      <div class="mx-auto mt-16 grid max-w-2xl grid-cols-1 grid-rows-1 gap-8 text-sm/6 text-gray-900 sm:mt-20 sm:grid-cols-2 xl:mx-0 xl:max-w-none xl:grid-flow-col xl:grid-cols-4 dark:text-gray-100">
        <!-- Colonne 1 - Premier avis -->
        <figure class="rounded-2xl bg-white p-6 shadow-lg ring-1 ring-gray-900/5 sm:col-span-2 xl:col-span-1 xl:row-span-2 dark:bg-gray-800 dark:ring-white/10">
          <blockquote class="text-gray-900 dark:text-white">
            <p>"{testimonials[1].quote}"</p>
          </blockquote>
          <figcaption class="mt-6 flex items-center gap-x-4">
            <div class="flex size-10 items-center justify-center rounded-full bg-green-100 font-semibold text-green-600 dark:bg-green-900 dark:text-green-300">
              {testimonials[1].initial}
            </div>
            <div>
              <div class="font-semibold dark:text-white">{testimonials[1].name}</div>
              <div class="text-gray-600 dark:text-gray-400">{testimonials[1].role}</div>
            </div>
          </figcaption>
        </figure>

        <!-- Avis principal (featured) - au centre -->
        <figure class="rounded-2xl bg-white p-6 shadow-lg ring-1 ring-gray-900/5 sm:col-span-2 xl:col-start-2 xl:row-end-1 dark:bg-gray-800 dark:ring-white/10">
          <blockquote class="p-6 text-lg font-semibold tracking-tight text-gray-900 sm:p-12 sm:text-xl/8 dark:text-white">
            <p>"{testimonials[0].quote}"</p>
          </blockquote>
          <figcaption class="flex flex-wrap items-center gap-x-4 gap-y-4 border-t border-gray-900/10 px-6 py-4 sm:flex-nowrap dark:border-white/10">
            <div class="flex size-10 items-center justify-center rounded-full bg-green-100 font-semibold text-green-600 dark:bg-green-900 dark:text-green-300">
              {testimonials[0].initial}
            </div>
            <div class="flex-auto">
              <div class="font-semibold dark:text-white">{testimonials[0].name}</div>
              <div class="text-gray-600 dark:text-gray-400">{testimonials[0].role}</div>
            </div>
            <div class="flex gap-0.5 text-green-600 dark:text-green-400">
              {[1, 2, 3, 4, 5].map(() => (
                <svg class="size-5 flex-none" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                  <path fill-rule="evenodd" d="M10.868 2.884c-.321-.772-1.415-.772-1.736 0l-1.83 4.401-4.753.381c-.833.067-1.171 1.107-.536 1.651l3.62 3.102-1.106 4.637c-.194.813.691 1.456 1.405 1.02L10 15.591l4.069 2.485c.713.436 1.598-.207 1.404-1.02l-1.106-4.637 3.62-3.102c.635-.544.297-1.584-.536-1.65l-4.752-.382-1.831-4.401z" clip-rule="evenodd" />
                </svg>
              ))}
            </div>
          </figcaption>
        </figure>

        <!-- Colonne 3 - Dernier avis -->
        <figure class="rounded-2xl bg-white p-6 shadow-lg ring-1 ring-gray-900/5 sm:col-span-2 xl:col-span-1 xl:row-span-2 dark:bg-gray-800 dark:ring-white/10">
          <blockquote class="text-gray-900 dark:text-white">
            <p>"{testimonials[2].quote}"</p>
          </blockquote>
          <figcaption class="mt-6 flex items-center gap-x-4">
            <div class="flex size-10 items-center justify-center rounded-full bg-green-100 font-semibold text-green-600 dark:bg-green-900 dark:text-green-300">
              {testimonials[2].initial}
            </div>
            <div>
              <div class="font-semibold dark:text-white">{testimonials[2].name}</div>
