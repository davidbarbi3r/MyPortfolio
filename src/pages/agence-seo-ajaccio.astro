---
import Layout from '../layouts/PageLayout.astro';
import Image from '../components/common/Image.astro';
import HeroImage from '../assets/images/DSCF7551-3.jpg';
import Activateur from "../assets/images/activateur.png"
import { localBusinessAjaccioNode, LOCAL_BUSINESS_AJACCIO_ID } from '~/utils/business-schema';
import { aggregateRatingSchemaAjaccio } from '~/utils/reviews';

const metadata = {
  title: 'Référencement naturel SEO à Ajaccio : accompagnement mensuel | David Barbier',
  description:
    "Accompagnement SEO mensuel pour TPE et indépendants. Stratégie, technique, contenu, suivi. À partir de 490€/mois, engagement 6 mois. Audit gratuit.",
};

const serviceStructuredData = {
  "@context": "https://schema.org",
  "@graph": [
    localBusinessAjaccioNode,
    {
      "@type": ["Product", "Service"],
      "@id": "https://www.davidbarbier.com/agence-seo-ajaccio/#service",
      "name": "Accompagnement SEO mensuel",
      "description": "Accompagnement SEO mensuel pour TPE et indépendants en Corse. Stratégie, technique, contenu, netlinking, suivi mensuel avec reporting Search Console.",
      "provider": { "@id": LOCAL_BUSINESS_AJACCIO_ID },
      "aggregateRating": aggregateRatingSchemaAjaccio,
      "areaServed": [
        { "@type": "City", "name": "Ajaccio" },
        { "@type": "AdministrativeArea", "name": "Corse" }
      ],
      "serviceType": "Accompagnement SEO",
      "hasOfferCatalog": {
        "@type": "OfferCatalog",
        "name": "Offres d'accompagnement SEO",
        "itemListElement": [
          {
            "@type": "Offer",
            "name": "Accompagnement SEO mensuel",
            "description": "Stratégie SEO complète avec suivi mensuel",
            "priceSpecification": {
              "@type": "UnitPriceSpecification",
              "minPrice": "490",
              "priceCurrency": "EUR",
              "unitCode": "MON",
              "valueAddedTaxIncluded": false
            }
          },
          {
            "@type": "Offer",
            "name": "Audit SEO complet",
            "description": "Analyse approfondie + plan d'action stratégique",
            "price": "690",
            "priceCurrency": "EUR",
            "url": "https://www.davidbarbier.com/audit-seo-ajaccio/"
          },
          {
            "@type": "Offer",
            "name": "Audit SEO gratuit",
            "description": "Analyse rapide et factuelle de votre site",
            "price": "0",
            "priceCurrency": "EUR",
            "url": "https://www.davidbarbier.com/audit-seo-gratuit-ajaccio/"
          },
          {
            "@type": "Offer",
            "name": "Optimisation de fiche d'établissement Google",
            "description": "Mise en conformité et optimisation complète de votre fiche Google",
            "price": "350",
            "priceCurrency": "EUR",
            "url": "https://www.davidbarbier.com/optimisation-fiche-google-ajaccio/"
          },
          {
            "@type": "Offer",
            "name": "Suivi & animation Google Business Profile mensuel",
            "description": "Animation mensuelle de votre fiche Google Business : posts, gestion des avis, monitoring",
            "priceSpecification": {
              "@type": "UnitPriceSpecification",
              "price": "100",
              "priceCurrency": "EUR",
              "unitCode": "MON",
              "valueAddedTaxIncluded": false
            }
          }
        ]
      }
    }
  ]
};

const faqStructuredData = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Combien de temps faut-il pour voir des résultats en SEO ?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Les premiers mouvements sur vos mots-clés sont visibles entre 3 et 4 mois. Des résultats concrets en leads ou chiffre d'affaires arrivent entre 6 et 12 mois, selon la concurrence et l'état de départ. Je recommande un engagement minimum de 6 mois pour que la stratégie ait le temps de payer."
      }
    },
    {
      "@type": "Question",
      "name": "Pourquoi parler d'agence si vous travaillez seul ?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Parce que ce qui compte ce n'est pas la structure juridique, c'est la capacité à livrer. Je travaille seul sur la stratégie et l'exécution SEO. Quand un projet demande des compétences que je n'ai pas (rédaction longue, design, dev très spécialisé), j'active un réseau de freelances seniors avec qui je collabore depuis des années. Vous parlez toujours à moi, jamais à un commercial ou un stagiaire."
      }
    },
    {
      "@type": "Question",
      "name": "Et si au bout de 6 mois je n'ai aucun résultat ?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Je ne prends que des projets viables sur le plan SEO - l'audit initial est justement là pour l'identifier avant de commencer. Si malgré ça les résultats tardent, on fait un point trimestriel où on peut arrêter sans pénalité. L'accompagnement mensuel n'est pas un abonnement piégé : pas de reconduction tacite, pas de frais de résiliation."
      }
    },
    {
      "@type": "Question",
      "name": "Est-ce que je garde la main sur mes comptes (Google, WordPress, hébergement) ?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Oui, sans exception. Tous vos comptes (Google Business Profile, Search Console, Analytics, WordPress, hébergeur) restent à votre nom, avec vos identifiants. Je travaille sur vos accès, je ne crée rien à mon nom. Si on arrête la collaboration, vous partez avec tout - et sans que ça casse quoi que ce soit."
      }
    },
    {
      "@type": "Question",
      "name": "Audit gratuit ou audit complet à 690€ ?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "L'audit gratuit (15-20 min en visio) donne un constat rapide de l'existant, sans rapport écrit ni plan. L'audit complet à 690€ ajoute les analyses concurrence, backlinks, sémantique, présence IA, et la liste des corrections classées par priorité. Livré en 5 jours ouvrés."
      }
    },
    {
      "@type": "Question",
      "name": "Combien coûte un accompagnement SEO ?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Quatre formules transparentes. Accompagnement SEO mensuel : 490€ HT/jour, avec 1 à 3 jours/mois selon votre projet (à partir de 490€/mois, engagement 6 mois). Audit complet : 690€ HT (état des lieux + corrections priorisées, sans suivi). Optimisation fiche d'établissement Google : 350€ HT (one shot). Suivi et animation Google Business mensuel : 100€ HT/mois (posts, avis, monitoring, sans engagement). Pour un besoin ponctuel, interventions à la demi-journée (245€ HT) ou à la journée (490€ HT) sans engagement. Tarifs HT, sans frais caché, sans reconduction tacite."
      }
    }
  ]
};

const breadcrumbStructuredData = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Accueil",
      "item": "https://www.davidbarbier.com/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Accompagnement SEO",
      "item": "https://www.davidbarbier.com/agence-seo-ajaccio/"
    }
  ]
};
---

<Layout metadata={metadata}>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(serviceStructuredData)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(faqStructuredData)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbStructuredData)} />
  </Fragment>

  <section class="relative isolate overflow-hidden dark:bg-[#030620]">
    <!-- Fil d'Ariane -->
    <div class="mx-auto max-w-7xl px-6 pt-8 lg:px-8">
      <nav aria-label="Fil d'Ariane" class="text-sm font-body">
        <ol class="flex items-center gap-2 text-gray-500 dark:text-gray-400 flex-wrap">
          <li><a href="/" class="hover:text-green-700 dark:hover:text-green-400 transition-colors">Accueil</a></li>
          <li><svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg></li>
          <li class="text-gray-900 dark:text-white font-medium">Accompagnement SEO</li>
        </ol>
      </nav>
    </div>

    <div class="mx-auto max-w-7xl px-6 pb-24 pt-4 sm:pb-12 lg:flex lg:px-8 lg:py-16">
      <div class="mx-auto max-w-2xl lg:mx-0 lg:shrink-0 lg:pt-8">
        <!-- Badge localisation -->
        <div class="mt-8 sm:mt-16 lg:mt-8">
          <span class="inline-flex items-center">
            <span
              class="rounded-full bg-green-800/10 dark:bg-gray-700 px-3 py-1 text-sm font-semibold text-brown ring-1 ring-inset ring-green-950/10"
            >
              Ajaccio - Corse
            </span>
          </span>
        </div>

        <!-- H1 SEO-focus -->
        <h1 class="mt-6 text-base font-semibold uppercase tracking-wider text-emerald-700 dark:text-emerald-400">
          Référencement naturel SEO à Ajaccio
        </h1>

        <!-- Titre visuel commercial -->
        <p class="mt-3 text-pretty font-heading text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tight leading-[1.1]">
          <span class="text-green-950 dark:text-white">Plus haut sur Google,</span><br />
          <span class="text-emerald-700 dark:text-emerald-400">plus de clients trouvés.</span>
        </p>

        <!-- Trust line -->
        <p class="mt-6 text-sm text-gray-500 dark:text-gray-400">
          ⭐ 5/5 sur Google · 16 avis · +50 clients accompagnés · Basé à Ajaccio
        </p>

        <!-- Problem statement -->
        <p class="mt-8 text-pretty text-lg text-gray-600 dark:text-gray-300">
          Vous avez un site, vos concurrents sont devant vous sur Google, et vous ne savez pas comment changer ça. C'est exactement le problème que résout mon <strong>accompagnement SEO mensuel</strong>.
        </p>

        <p class="mt-6 text-pretty text-lg text-gray-600 dark:text-gray-300">
          Technique, contenu, liens - les 3 piliers du SEO travaillés ensemble pour vous installer durablement sur vos mots-clés stratégiques. Reporting mensuel clair, chiffres vérifiables dans votre Search Console.
        </p>

        <!-- Call-to-action -->
        <div class="mt-10 flex items-center gap-x-6">
          <a
            href="/audit-seo-gratuit-ajaccio/"
            class="rounded-md bg-green-700 px-4 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-green-700/90 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brown"
          >
            Demander un audit gratuit
          </a>
          <a href="#services" class="inline-flex items-center gap-2 text-sm font-semibold text-gray-900 dark:text-gray-300 whitespace-nowrap">
            Découvrir mes services <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
          </a>
        </div>
        <p class="mt-3 text-xs text-gray-500 dark:text-gray-400 max-w-md">
          Audit gratuit = analyse rapide et factuelle de votre site. <a href="/audit-seo-ajaccio/" class="underline hover:text-emerald-700 dark:hover:text-emerald-400">L'audit complet (690€)</a> va plus loin : backlinks, concurrence, stratégie.
        </p>
      </div>

      <!-- Image / dashboard -->
      <div class="mx-auto mt-16 flex max-w-2xl lg:ml-10 lg:mr-0 lg:mt-0 lg:max-w-none xl:ml-32">
        <div class="max-w-3xl flex-none sm:max-w-5xl lg:max-w-none">
          <div
            class="-m-2 rounded-xl bg-gray-900/5 p-2 ring-1 ring-inset ring-gray-900/10 lg:-m-4 lg:rounded-2xl lg:p-4"
          >
            <img
              src="https://imagedelivery.net/4zDfTa1ovbR8nr2bLQ6Mxg/af43940c-7bc0-4088-bd7a-6f7002f9b200/public"
              alt="Visualisation des performances SEO dans la google search console"
              class="w-[76rem] rounded-md shadow-2xl ring-1 ring-gray-900/10 max-h-[80vh] object-contain object-left"
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Résultats concrets -->
  <section class="py-16 sm:py-20 px-6 lg:px-8 bg-gray-50 dark:bg-slate-800">
    <div class="mx-auto max-w-5xl">
      <div class="mb-12">
        <p class="text-xs font-semibold uppercase tracking-[0.2em] text-gray-400 dark:text-gray-500 mb-4 flex items-center gap-2">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
          Résultats concrets
        </p>
        <h2 class="text-3xl sm:text-4xl font-bold tracking-tight text-gray-900 dark:text-white">
          Des clients qui trouvent, <span class="text-emerald-700 dark:text-emerald-400">appellent, achètent.</span>
        </h2>
        <p class="mt-4 text-gray-600 dark:text-gray-300 max-w-2xl">
          J'ai déménagé à Ajaccio il y a 4 ans. Certains de mes cases chiffrés viennent de clients continentaux - la méthode est la même partout.
        </p>
      </div>

      <div class="grid md:grid-cols-2 gap-6">
        <article class="bg-white dark:bg-gray-900 rounded-2xl p-8 shadow-sm border border-gray-100 dark:border-gray-800 flex flex-col">
          <div class="flex items-center gap-2 mb-4">
            <span class="inline-flex items-center gap-1.5 rounded-full bg-emerald-600/10 px-2.5 py-1 text-xs font-semibold text-emerald-700 dark:text-emerald-400">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
              Ajaccio
            </span>
            <span class="text-xs text-gray-500 dark:text-gray-400">Santé · Cabinet médical</span>
          </div>
          <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-3">
            Endoajaccio - endodontiste
          </h3>
          <p class="text-sm text-gray-600 dark:text-gray-300 mb-6">
            Site conçu from scratch + fondations SEO locales + Google Business Profile optimisé.
          </p>
          <div class="bg-emerald-50 dark:bg-emerald-900/20 rounded-xl p-4 mb-4 mt-auto">
            <p class="text-2xl font-bold text-emerald-700 dark:text-emerald-400">5 nouveaux patients / jour</p>
            <p class="text-xs text-gray-600 dark:text-gray-400 mt-1">depuis la mise en ligne</p>
          </div>
          <p class="text-xs text-gray-500 dark:text-gray-500 italic leading-relaxed">
            L'endodontie est peu représentée en Corse, ce qui a accéléré le positionnement. La méthode reste la même sur des secteurs plus compétitifs.
          </p>
        </article>

        <article class="bg-white dark:bg-gray-900 rounded-2xl p-8 shadow-sm border border-gray-100 dark:border-gray-800 flex flex-col">
          <div class="flex items-center gap-2 mb-4">
            <span class="inline-flex items-center gap-1.5 rounded-full bg-amber-600/10 px-2.5 py-1 text-xs font-semibold text-amber-700 dark:text-amber-400">
              <span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span>
              Bordeaux
            </span>
            <span class="text-xs text-gray-500 dark:text-gray-400">Service à domicile · B2C</span>
          </div>
          <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-3">
            Restodom - portage de repas à Bordeaux
          </h3>
          <p class="text-sm text-gray-600 dark:text-gray-300 mb-6">
            Accompagnement SEO sur 12 mois : stratégie technique + éditoriale + netlinking.
          </p>
          <div class="bg-emerald-50 dark:bg-emerald-900/20 rounded-xl p-4 mb-4 mt-auto">
            <p class="text-2xl font-bold text-emerald-700 dark:text-emerald-400">Top 1 Google</p>
            <p class="text-xs text-gray-600 dark:text-gray-400 mt-1">sur "portage repas bordeaux" en 12 mois</p>
          </div>
          <p class="text-xs text-gray-500 dark:text-gray-500 italic leading-relaxed">
            Requête commerciale locale avec concurrence. Position tenue dans la durée - toujours en top 1 aujourd'hui.
          </p>
        </article>
      </div>

      <!-- Testimonials clients (avis Google publics) -->
      <div class="mt-10 grid md:grid-cols-2 gap-6">
        <figure class="bg-white dark:bg-gray-900 rounded-2xl p-8 shadow-sm border border-emerald-200 dark:border-emerald-800 relative flex flex-col">
          <svg class="absolute top-6 left-6 w-10 h-10 text-emerald-100 dark:text-emerald-900/40" fill="currentColor" viewBox="0 0 32 32" aria-hidden="true">
            <path d="M9.352 4C4.456 7.456 1 13.12 1 19.36c0 5.088 3.072 8.064 6.624 8.064 3.36 0 5.856-2.688 5.856-5.856 0-3.168-2.208-5.472-5.088-5.472-.576 0-1.344.096-1.536.192.48-3.264 3.552-7.104 6.624-9.024L9.352 4Zm16.512 0c-4.8 3.456-8.256 9.12-8.256 15.36 0 5.088 3.072 8.064 6.624 8.064 3.264 0 5.856-2.688 5.856-5.856 0-3.168-2.304-5.472-5.184-5.472-.576 0-1.248.096-1.44.192.48-3.264 3.456-7.104 6.528-9.024L25.864 4Z"/>
          </svg>
          <blockquote class="pl-12 text-base leading-relaxed text-gray-700 dark:text-gray-200 italic flex-grow">
            « Je remercie David pour son travail de qualité dans la conception et la réalisation du site internet REST'Ô DOM. Son écoute et son professionnalisme ont permis la bonne exécution du site. La collaboration se poursuit à l'heure actuelle, car il est SEO également - me permettant ainsi de gagner grandement en visibilité grâce à ses compétences. »
          </blockquote>
          <figcaption class="pl-12 mt-5 pt-4 border-t border-gray-100 dark:border-gray-800">
            <p class="text-sm font-semibold text-gray-900 dark:text-white">REST'Ô DOM</p>
            <p class="text-xs text-gray-500 dark:text-gray-400">Portage de repas à domicile · Bordeaux</p>
          </figcaption>
        </figure>

        <figure class="bg-white dark:bg-gray-900 rounded-2xl p-8 shadow-sm border border-emerald-200 dark:border-emerald-800 relative flex flex-col">
          <svg class="absolute top-6 left-6 w-10 h-10 text-emerald-100 dark:text-emerald-900/40" fill="currentColor" viewBox="0 0 32 32" aria-hidden="true">
            <path d="M9.352 4C4.456 7.456 1 13.12 1 19.36c0 5.088 3.072 8.064 6.624 8.064 3.36 0 5.856-2.688 5.856-5.856 0-3.168-2.208-5.472-5.088-5.472-.576 0-1.344.096-1.536.192.48-3.264 3.552-7.104 6.624-9.024L9.352 4Zm16.512 0c-4.8 3.456-8.256 9.12-8.256 15.36 0 5.088 3.072 8.064 6.624 8.064 3.264 0 5.856-2.688 5.856-5.856 0-3.168-2.304-5.472-5.184-5.472-.576 0-1.248.096-1.44.192.48-3.264 3.456-7.104 6.528-9.024L25.864 4Z"/>
          </svg>
          <blockquote class="pl-12 text-base leading-relaxed text-gray-700 dark:text-gray-200 italic flex-grow">
            « Je collabore avec David depuis près d'un an : j'apprécie son sérieux, sa réactivité et sa disponibilité. Je vois les fruits de son travail, avec une hausse du trafic intéressante et pertinente dans le cadre de son activité. Je recommande fortement. »
          </blockquote>
          <figcaption class="pl-12 mt-5 pt-4 border-t border-gray-100 dark:border-gray-800">
            <p class="text-sm font-semibold text-gray-900 dark:text-white">Mobincub</p>
            <p class="text-xs text-gray-500 dark:text-gray-400">Client SEO · 1 an de collaboration</p>
          </figcaption>
        </figure>
      </div>

      <div class="mt-12 text-center">
        <a
          href="tel:+33623565299"
          class="inline-flex items-center gap-2 text-emerald-700 dark:text-emerald-400 font-semibold hover:gap-3 transition-all"
        >
          Réservons 20 min pour parler de votre cas
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
        </a>
      </div>
    </div>
  </section>

  <!-- Agence solo, mais pas seul -->
  <section class="px-6 py-16 sm:py-20 lg:px-8 bg-gradient-to-b from-amber-50/50 to-white dark:from-slate-800 dark:to-slate-900">
    <div class="mx-auto max-w-3xl">
      <p class="text-xs font-semibold uppercase tracking-[0.2em] text-gray-400 dark:text-gray-500 mb-6 flex items-center gap-2">
        <span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span>
        Agence vs freelance - le vrai débat
      </p>

      <h2 class="text-3xl sm:text-4xl font-bold tracking-tight text-gray-900 dark:text-white mb-6 leading-tight">
        Agence solo. <span class="text-emerald-700 dark:text-emerald-400">Mais pas tout seul.</span>
      </h2>

      <p class="text-lg text-gray-600 dark:text-gray-300 leading-relaxed">
        Solo sur l'opérationnel - vous parlez à celui qui fait le boulot. Quand un projet demande des compétences pointues que je n'ai pas, j'active un réseau de freelances seniors. Pas de stagiaire, pas d'offshore.
      </p>

      <!-- Comparaison -->
      <div class="mt-10 grid md:grid-cols-2 gap-6">
        <!-- Agence classique -->
        <div class="rounded-2xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-slate-900 p-6">
          <p class="text-sm font-semibold uppercase tracking-wide text-gray-500 dark:text-gray-400 mb-3">Agence classique</p>
          <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-4">Vous payez la structure, pas le travail</h3>
          <ul class="space-y-3 text-sm text-gray-600 dark:text-gray-300">
            <li class="flex gap-2"><span class="text-red-500 flex-shrink-0">✕</span>Commercial qui prend soin de vous jusqu'à la signature</li>
            <li class="flex gap-2"><span class="text-red-500 flex-shrink-0">✕</span>Dossier traité ensuite par un junior payé 1500€/mois</li>
            <li class="flex gap-2"><span class="text-red-500 flex-shrink-0">✕</span>Tarif gonflé pour financer locaux, salaires, marges</li>
            <li class="flex gap-2"><span class="text-red-500 flex-shrink-0">✕</span>Problème ? Vous êtes un ticket traité dans 3 semaines</li>
            <li class="flex gap-2"><span class="text-red-500 flex-shrink-0">✕</span>Reporting cosmétique pour justifier la facture</li>
          </ul>
        </div>

        <!-- Agence solo -->
        <div class="rounded-2xl border-2 border-emerald-500 bg-emerald-50 dark:bg-emerald-900/20 p-6">
          <p class="text-sm font-semibold uppercase tracking-wide text-emerald-700 dark:text-emerald-400 mb-3">Agence solo + collectif</p>
          <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-4">Vous payez l'expertise, point</h3>
          <ul class="space-y-3 text-sm text-gray-700 dark:text-gray-300">
