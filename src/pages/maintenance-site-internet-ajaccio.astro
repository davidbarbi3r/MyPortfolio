---
import Layout from '../layouts/PageLayout.astro';
import Image from '../components/common/Image.astro';
import HeroImage from '../assets/images/DSCF7551-3.jpg';
import { localBusinessAjaccioNode, LOCAL_BUSINESS_AJACCIO_ID } from '~/utils/business-schema';

const metadata = {
  title: "Maintenance site internet Ajaccio : site performant et sécurisé",
  description:
    "Maintenance WordPress & site web à Ajaccio. Mises à jour, sécurité, sauvegardes. Forfaits à partir de 30€/mois ou intervention ponctuelle à 60€/h.",
};

const serviceStructuredData = {
  "@context": "https://schema.org",
  "@graph": [
    localBusinessAjaccioNode,
    {
      "@type": "Service",
      "@id": "https://www.davidbarbier.com/maintenance-site-internet-ajaccio/#service",
      "name": "Maintenance de site internet à Ajaccio",
      "description":
        "Maintenance WordPress et multi-technologies à Ajaccio. Mises à jour, sécurité, sauvegardes, monitoring et support pour garder votre site performant.",
      "provider": { "@id": LOCAL_BUSINESS_AJACCIO_ID },
      "areaServed": [
        { "@type": "City", "name": "Ajaccio" },
        { "@type": "AdministrativeArea", "name": "Corse" },
      ],
      "serviceType": "Maintenance de site internet",
      "hasOfferCatalog": {
        "@type": "OfferCatalog",
        "name": "Offres de maintenance",
        "itemListElement": [
          {
            "@type": "Offer",
            "name": "Intervention ponctuelle",
            "description": "Intervention à l'heure ou à la journée sur votre site",
            "price": "60",
            "priceCurrency": "EUR",
            "priceSpecification": {
              "@type": "UnitPriceSpecification",
              "price": "60",
              "priceCurrency": "EUR",
              "unitCode": "HUR",
              "valueAddedTaxIncluded": false,
            },
          },
          {
            "@type": "Offer",
            "name": "Pack maintenance mensuel",
            "description": "Forfait maintenance mensuel adapté à la technologie de votre site",
            "price": "30",
            "priceCurrency": "EUR",
            "priceSpecification": {
              "@type": "UnitPriceSpecification",
              "price": "30",
              "priceCurrency": "EUR",
              "unitCode": "MON",
              "valueAddedTaxIncluded": false,
            },
          },
        ],
      },
    },
  ],
};

const faqStructuredData = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Pourquoi maintenir mon site internet ?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Un site non maintenu présente trois risques concrets : failles de sécurité exploitables par des bots, ralentissements qui plombent votre SEO, et incompatibilités avec les navigateurs récents. La maintenance préventive coûte largement moins cher qu'une réparation après incident, et elle protège votre image.",
      },
    },
    {
      "@type": "Question",
      "name": "Quelle est la différence entre intervention ponctuelle et pack mensuel ?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "L'intervention ponctuelle (60€/h ou 350€/jour) résout un problème précis ou fait une évolution ciblée. Le pack mensuel (à partir de 30€/mois) inclut le monitoring proactif, les mises à jour régulières et le support pour anticiper les problèmes avant qu'ils ne cassent.",
      },
    },
    {
      "@type": "Question",
      "name": "Quelles technologies maintenez-vous ?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "WordPress, WooCommerce, React, Next.js, Astro, Vue, et la plupart des frameworks modernes. Le tarif du pack mensuel est adapté selon la technologie utilisée et la complexité du site.",
      },
    },
    {
      "@type": "Question",
      "name": "Que comprend le pack maintenance mensuel ?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Mises à jour du CMS et des dépendances, correctifs de sécurité, sauvegardes automatiques, monitoring uptime, support réactif sous 48h, et un rapport mensuel clair sur ce qui a été fait.",
      },
    },
    {
      "@type": "Question",
      "name": "Intervenez-vous en urgence si mon site tombe ?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Oui, en intervention ponctuelle à 60€/h. Les clients du pack mensuel bénéficient d'une priorité sur les incidents critiques.",
      },
    },
    {
      "@type": "Question",
      "name": "Travaillez-vous uniquement à Ajaccio ?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Je suis basé à Ajaccio, je me déplace dans toute la Corse pour mes clients (Porticcio, Propriano, Bastia, Calvi...). Pour le reste de la France, 90% de la maintenance se fait à distance avec les mêmes outils et la même réactivité.",
      },
    },
  ],
};

const breadcrumbStructuredData = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Accueil",
      "item": "https://www.davidbarbier.com/",
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Maintenance site internet Ajaccio",
      "item": "https://www.davidbarbier.com/maintenance-site-internet-ajaccio/",
    },
  ],
};
---

<Layout metadata={metadata}>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(serviceStructuredData)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(faqStructuredData)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbStructuredData)} />
  </Fragment>

  <section class="relative isolate overflow-hidden bg-[#030620]">
    <!-- Fil d'Ariane -->
    <div class="mx-auto max-w-7xl px-6 pt-8 lg:px-8">
      <nav aria-label="Fil d'Ariane" class="text-sm font-body">
        <ol class="flex items-center gap-2 text-gray-500 text-gray-400 flex-wrap">
          <li><a href="/" class="hover:text-green-700 hover:text-green-400 transition-colors">Accueil</a></li>
          <li><svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg></li>
          <li class="text-gray-900 text-white font-medium">Maintenance site internet Ajaccio</li>
        </ol>
      </nav>
    </div>

    <div class="mx-auto max-w-7xl px-6 pb-24 pt-4 sm:pb-12 lg:flex lg:px-8 lg:py-16">
      <div class="mx-auto max-w-2xl lg:mx-0 lg:shrink-0 lg:pt-8">
        <!-- Badge localisation -->
        <div class="mt-8 sm:mt-16 lg:mt-8">
          <span class="inline-flex items-center">
            <span class="rounded-full bg-green-800/10 bg-gray-700 px-3 py-1 text-sm font-semibold text-brown ring-1 ring-inset ring-green-950/10 mb-8">
              Ajaccio - Corse
            </span>
          </span>
        </div>

        <!-- Titre principal -->
        <h1 class="mt-10 text-pretty font-heading text-4xl font-semibold tracking-tight text-green-950 sm:text-5xl inline text-white">
          Maintenance site internet Ajaccio
        </h1>
        <span class="text-pretty text-4xl font-semibold tracking-tight text-green-950 sm:text-5xl inline text-gray-300">
          : gardez votre site performant et sécurisé
        </span>

        <!-- Paragraphes -->
        <p class="mt-8 text-pretty text-lg text-gray-600 text-gray-300">
          Un site internet, c'est comme une maison : sans entretien régulier, les fissures apparaissent. Mises à jour oubliées, failles de sécurité, plugins qui cassent, vitesse qui chute - et le référencement plonge avec.
        </p>

        <p class="mt-6 text-pretty text-lg text-gray-600 text-gray-300">
          Vous avez investi pour votre site. Ne le laissez pas devenir un boulet : une maintenance régulière le garde performant, sécurisé et prêt à convertir. Vous vous concentrez sur votre activité, je m'occupe du reste.
        </p>

        <!-- Call-to-action -->
        <div class="mt-10 flex items-center gap-x-6">
          <a
            href="tel:+33623565299"
            class="rounded-md bg-green-700 px-4 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-green-700/90 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brown"
          >
            On en discute ?
          </a>
          <a href="#services" class="inline-flex items-center gap-2 text-sm font-semibold text-gray-900 text-gray-300 whitespace-nowrap">
            Découvrir les offres <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
          </a>
        </div>
      </div>

      <!-- Image à droite -->
      <div class="mx-auto mt-16 flex max-w-2xl lg:ml-10 lg:mr-0 lg:mt-0 lg:max-w-none xl:ml-32">
        <div class="max-w-4xl flex-none sm:max-w-5xl lg:max-w-none">
          <div class="-m-2 rounded-xl bg-gray-900/5 p-2 ring-1 ring-inset ring-gray-900/10 lg:-m-4 lg:rounded-2xl lg:p-4">
            <img
              src="https://imagedelivery.net/4zDfTa1ovbR8nr2bLQ6Mxg/61ce5a9f-b7ea-43e0-1e10-3346fa4a8a00/public"
              alt="Développeur web en maintenance de site internet à Ajaccio"
              width="640"
              height="512"
              loading="eager"
              decoding="async"
              class="w-[40rem] rounded-md shadow-2xl ring-1 ring-gray-900/10 max-h-[80vh] object-cover object-left"
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Section Expertise -->
  <section class="px-6 py-16 lg:px-8">
    <div class="mx-auto max-w-3xl text-base/7">
      <p class="text-base/7 font-semibold text-green-950 text-green-300">Expertise technique</p>
      <h2 class="mt-2 text-pretty text-3xl font-semibold tracking-tight text-gray-900 text-gray-300 sm:text-4xl">
        Développeur web spécialiste de la maintenance
      </h2>

      <p class="mt-6 text-xl/8">
        Je ne suis pas une agence, mais un développeur web indépendant qui aime mettre les mains sous le capot. Cette expertise technique est votre meilleur atout : quand un problème survient (en général ça n'arrive pas, car je bosse en préventif), je résous directement, pas de "je vais voir avec l'équipe".
      </p>

      <div class="mt-10 max-w-2xl">
        <p>
          Mon approche de la maintenance est pragmatique et transparente. Chaque intervention est expliquée en langage clair. Vous savez exactement ce qui est fait sur votre site et pourquoi.
        </p>

        <ul role="list" class="mt-8 max-w-xl space-y-8 text-gray-600 text-gray-300">
          <li class="flex gap-x-3">
            <svg class="mt-1 size-5 flex-none text-green-800 text-green-300" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
              <path fill-rule="evenodd" d="M10 18a8 8 0 1 0 0-16 8 8 0 0 0 0 16Zm3.857-9.809a.75.75 0 0 0-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 1 0-1.06 1.061l2.5 2.5a.75.75 0 0 0 1.137-.089l4-5.5Z" clip-rule="evenodd"></path>
            </svg>
            <span><strong class="font-semibold text-gray-900 text-gray-100">Expert multi-technologies</strong> - WordPress, WooCommerce, React, Next.js, Astro, Vue et plus.</span>
          </li>
          <li class="flex gap-x-3">
            <svg class="mt-1 size-5 flex-none text-green-800 text-green-300" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
              <path fill-rule="evenodd" d="M10 18a8 8 0 1 0 0-16 8 8 0 0 0 0 16Zm3.857-9.809a.75.75 0 0 0-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 1 0-1.06 1.061l2.5 2.5a.75.75 0 0 0 1.137-.089l4-5.5Z" clip-rule="evenodd"></path>
            </svg>
            <span><strong class="font-semibold text-gray-900 text-gray-100">Intervention directe</strong> - Résolution sans intermédiaire, pas de chef de projet qui filtre.</span>
          </li>
          <li class="flex gap-x-3">
            <svg class="mt-1 size-5 flex-none text-green-800 text-green-300" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
              <path fill-rule="evenodd" d="M10 18a8 8 0 1 0 0-16 8 8 0 0 0 0 16Zm3.857-9.809a.75.75 0 0 0-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 1 0-1.06 1.061l2.5 2.5a.75.75 0 0 0 1.137-.089l4-5.5Z" clip-rule="evenodd"></path>
            </svg>
            <span><strong class="font-semibold text-gray-900 text-gray-100">Maintenance préventive</strong> - Anticiper les problèmes avant qu'ils n'impactent votre chiffre d'affaires.</span>
          </li>
        </ul>

        <blockquote class="mt-10 border-l-4 border-green-800 pl-8 font-semibold text-gray-900 text-gray-100">
          <p>
            "Basé à Ajaccio, je couvre toute la Corse pour la maintenance web. Que vous soyez restaurateur route des Sanguinaires, hôtel à Porticcio ou artisan à Mezzavia, je garde votre site performant - et je me déplace sur site quand il le faut."
          </p>
        </blockquote>

        <div class="mt-16">
          <h3 class="text-2xl font-semibold text-gray-900 text-gray-100">
            Faut-il vraiment un développeur pour maintenir son site ?
          </h3>
          <p class="mt-6">
            Non, pas toujours. Vous pouvez gérer la maintenance vous-même si vous avez les compétences techniques, le temps et l'envie de suivre les évolutions de votre CMS. Mais si vous préférez vous concentrer sur votre métier et dormir tranquille, je suis là.
          </p>
          <p class="mt-4">
            Pas de contrat ? Pas de souci. Je peux intervenir ponctuellement à <strong>60€/heure</strong> pour régler un problème précis.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Services -->
  <section class="mt-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6">
      <h2 class="mt-2 text-pretty text-3xl font-semibold tracking-tight text-gray-900 text-gray-100 sm:text-4xl scroll-mt-32" id="services">
        Deux offres de maintenance, selon vos besoins
      </h2>
      <p class="mt-6 text-lg/8 text-gray-600 text-gray-100">
        Je propose deux formules simples et transparentes, adaptées à la taille et à la technologie de votre site :
      </p>

      <ul class="mt-4 space-y-3 text-lg text-gray-800 text-gray-100">
        <li class="flex gap-x-3 text-gray-950 text-gray-100">
          <span class="font-bold text-black text-gray-100">→ Intervention ponctuelle :</span>
          Tarif simple et transparent : <strong>60€/heure</strong> ou forfait journée à <strong>350€</strong>
        </li>
        <li class="flex gap-x-3">
          <span class="font-semibold">→ Pack maintenance mensuel :</span>
          À partir de <strong>30€/mois</strong> après audit technique - tarif adapté à la technologie de votre site
        </li>
      </ul>
    </div>

    <article class="p-8 rounded-xl mt-6 md:mt-12">
      <div class="mx-auto max-w-7xl px-6 lg:px-8">
        <div class="mx-auto max-w-2xl lg:text-center">
          <h3 class="text-3xl font-semibold text-dark">La maintenance web en détail</h3>
          <p class="mt-6 text-lg/8 text-gray-600 text-gray-300">
            Je m'occupe de tous les aspects techniques de votre site pendant que vous vous concentrez sur votre activité.
          </p>
          <p class="mt-6 text-lg/8 text-gray-600 text-gray-300">
            Une maintenance efficace repose sur trois piliers :
          </p>
        </div>
        <div class="mx-auto mt-6 max-w-2xl sm:mt-12 lg:mt-16 lg:max-w-none">
          <dl class="grid max-w-xl grid-cols-1 gap-x-8 gap-y-16 lg:max-w-none lg:grid-cols-3">
            <div class="flex flex-col">
              <dt class="flex items-center gap-x-3 text-base/7 font-semibold text-gray-900 text-gray-300">
                <svg class="size-5 flex-none text-green-800" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                  <path fill-rule="evenodd" d="M5.5 17a4.5 4.5 0 0 1-1.44-8.765 4.5 4.5 0 0 1 8.302-3.046 3.5 3.5 0 0 1 4.504 4.272A4 4 0 0 1 15 17H5.5Z" clip-rule="evenodd"></path>
                </svg>
                Mises à jour & Sécurité
              </dt>
              <dd class="mt-4 flex flex-auto flex-col text-base/7 text-gray-600 text-gray-300">
                <p class="flex-auto">
                  Mises à jour CMS et dépendances, correctifs de sécurité, sauvegardes automatiques et monitoring proactif. Zéro faille qui traîne.
                </p>
              </dd>
            </div>
            <div class="flex flex-col">
              <dt class="flex items-center gap-x-3 text-base/7 font-semibold text-gray-900 text-gray-300">
                <svg class="size-5 flex-none text-green-800" viewBox="0 0 20 20" fill="currentColor">
                  <path d="M10 1a4.5 4.5 0 0 0-4.5 4.5V9H5a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-6a2 2 0 0 0-2-2h-.5V5.5A4.5 4.5 0 0 0 10 1Z"></path>
                </svg>
                Performance
              </dt>
              <dd class="mt-4 flex flex-auto flex-col text-base/7 text-gray-600 text-gray-300">
                <p class="flex-auto">
                  Optimisation continue : temps de chargement, Core Web Vitals, compatibilité mobile et résolution des régressions. Un site lent, c'est du SEO perdu.
                </p>
              </dd>
            </div>
            <div class="flex flex-col">
              <dt class="flex items-center gap-x-3 text-base/7 font-semibold text-gray-900 text-gray-300">
                <svg class="size-5 flex-none text-green-800 text-green-300" viewBox="0 0 20 20" fill="currentColor">
                  <path d="M15.312 11.424a5.5 5.5 0 0 1-9.201 2.466l-.312-.311h2.433a.75.75 0 0 0 0-1.5H3.989a.75.75 0 0 0-.75.75v4.242a.75.75 0 0 0 1.5 0l.31.31a7 7 0 0 0 11.712-3.138.75.75 0 0 0-1.449-.39Z"></path>
                </svg>
                Support technique
              </dt>
              <dd class="mt-4 flex flex-auto flex-col text-base/7 text-gray-600 text-gray-300">
                <p class="flex-auto">
                  Support réactif sous 48h, résolution des bugs, conseil technique et accompagnement dans l'évolution de votre site.
                </p>
              </dd>
            </div>
          </dl>
        </div>
      </div>

      <div class="px-8 py-12 mx-auto md:px-12 lg:px-24 max-w-7xl">
        <h4 class="text-2xl font-semibold text-gray-900 text-gray-300 mb-12">Comment on démarre ?</h4>
        <dl class="grid grid-cols-1 gap-x-4 gap-y-12 lg:grid-cols-3 lg:divide-x lg:border-x">
          <div class="lg:px-8">
            <div class="text-brown flex gap-3 items-center">
              <span>1.</span>
              <dt class="tracking-tight text-lg font-medium">
                <h5 class="text-xl font-medium">Audit initial gratuit</h5>
              </dt>
            </div>
            <dd class="mt-2">
              <p class="text-base text-gray-600 text-gray-300">
                Analyse de votre site et de sa stack pour définir le niveau de maintenance nécessaire et établir un tarif adapté.
              </p>
            </dd>
          </div>

          <div class="lg:px-8">
            <div class="text-brown flex gap-3 items-center">
              <span>2.</span>
              <dt class="tracking-tight text-lg font-medium">
                <h5 class="text-xl font-medium">Choix de la formule</h5>
              </dt>
            </div>
            <dd class="mt-2">
              <p class="text-base text-gray-600 text-gray-300">
                Intervention ponctuelle ou pack mensuel, selon vos besoins et la complexité de votre site.
              </p>
            </dd>
          </div>

          <div class="lg:px-8">
            <div class="text-brown flex gap-3 items-center">
              <span>3.</span>
              <dt class="tracking-tight text-lg font-medium">
                <h5 class="text-xl font-medium">Maintenance active</h5>
              </dt>
            </div>
            <dd class="mt-2">
              <p class="text-base text-gray-600 text-gray-300">
                Suivi proactif, mises à jour régulières et support selon la formule. Rapport mensuel clair, pas de bullshit.
              </p>
            </dd>
          </div>
        </dl>
      </div>

      <div class="bg-green-800/10 bg-gray-700 p-6 rounded-lg max-w-3xl mx-auto px-4 sm:px-6">
        <p class="font-bold mb-4">Tarifs :</p>
        <ul class="space-y-2">
          <li><strong>Intervention ponctuelle :</strong> 60€/heure ou 350€/jour</li>
          <li><strong>Pack maintenance mensuel :</strong> à partir de 30€/mois après audit technique</li>
        </ul>
        <p class="mt-4">Le tarif du pack mensuel est personnalisé selon :</p>
        <ul class="list-disc ml-6 mt-2">
          <li>La technologie utilisée (WordPress, React, Next, Astro...)</li>
          <li>La complexité et la taille de votre site</li>
          <li>La fréquence des mises à jour nécessaires</li>
        </ul>
      </div>
    </article>
  </section>

  <!-- Bloc contact -->
  <section class="px-6 py-16 lg:px-8">
    <div class="mx-auto max-w-7xl">
      <div class="md:flex md:gap-12 md:items-center">
        <div class="md:w-1/3 space-y-8">
          <div class="flex flex-col items-center">
            <Image
              src={HeroImage}
              height={192}
              width={192}
              alt="David Barbier - Développeur web et maintenance site internet à Ajaccio"
              class="size-48 rounded-full object-cover shadow-lg"
            />
            <h3 class="mt-4 text-xl font-semibold text-gray-900">David Barbier</h3>
            <p class="text-gray-600">Développeur web & maintenance à Ajaccio</p>
          </div>

          <form method="post" action="https://formspree.io/f/xayglvyo" class="mt-8 space-y-4 bg-gray-50 p-6 rounded-lg">
            <div>
              <label for="name" class="block text-sm font-medium text-gray-700">Votre nom</label>
              <input id="name" name="name" type="text" class="mt-1 w-full rounded-md border border-gray-300 p-2" />
            </div>
            <div>
              <label for="email" class="block text-sm font-medium text-gray-700">Votre email</label>
              <input id="email" name="email" type="email" class="mt-1 w-full rounded-md border border-gray-300 p-2" />
            </div>
            <div>
              <label for="techno" class="block text-sm font-medium text-gray-700">Technologie de votre site</label>
              <select id="techno" name="techno" class="mt-1 w-full rounded-md border border-gray-300 p-2">
                <option value="">Sélectionnez une technologie</option>
                <option value="wordpress">WordPress / WooCommerce</option>
                <option value="react">React / Next.js</option>
                <option value="astro">Astro</option>
                <option value="autre">Autre</option>
                <option value="je-sais-pas">Je ne sais pas</option>
              </select>
            </div>
            <div>
              <label for="message" class="block text-sm font-medium text-gray-700">Votre message</label>
