---
import type { GetStaticPaths } from 'astro';
import type { Post } from '~/types';
import Layout from '~/layouts/PageLayout.astro';
import BlogList from '~/components/blog/List.astro';
import Headline from '~/components/blog/Headline.astro';
import Pagination from '~/components/blog/Pagination.astro';
import PostTags from "~/components/blog/Tags.astro";

import { blogListRobots, getStaticPathsBlogList } from '~/utils/blog';

export const getStaticPaths = (async ({ paginate }) => {
  return await getStaticPathsBlogList({ paginate });
}) satisfies GetStaticPaths;

type Props = { page: { data: Post[]; currentPage: number; url: { prev?: string; next?: string } } };
const { page } = Astro.props as Props;
const currentPage = page.currentPage ?? 1;

const allCategories = ["blog", "portfolio"];
const allTags = page.data.reduce((acc: string[], post) => {
  post.tags?.forEach((tag: string) => {
    if (!acc.includes(tag)) {
      acc.push(tag);
    }
  });
  return acc;
}, [] as string[]);

const metadata = {
  title: `Blog SEO & web — Conseils TPE et experts-comptables${currentPage > 1 ? ` — Page ${currentPage}` : ''} | David Barbier`,
  description: `Conseils SEO et web pour TPE, artisans et cabinets d'experts-comptables. Guides pratiques par David Barbier, consultant à Ajaccio : SEO local, WordPress, Google Business.`,
  robots: {
    index: blogListRobots?.index && currentPage === 1,
    follow: blogListRobots?.follow,
  },
  openGraph: {
    type: 'blog',
  },
};

// Blog schema (page 1 uniquement, paginated pages sont noindex)
const blogSchema = currentPage === 1 ? {
  "@context": "https://schema.org",
  "@type": "Blog",
  "@id": "https://www.davidbarbier.com/blog/#blog",
  "name": "Blog David Barbier — Conseils SEO et web",
  "description": "Conseils pratiques SEO, WordPress, Google Business et stratégie web pour TPE en Corse et cabinets d'experts-comptables partout en France.",
  "url": "https://www.davidbarbier.com/blog/",
  "inLanguage": "fr-FR",
  "author": {
    "@type": "Person",
    "@id": "https://www.davidbarbier.com/#person",
    "name": "David Barbier"
  },
  "publisher": {
    "@type": "Person",
    "@id": "https://www.davidbarbier.com/#person",
    "name": "David Barbier"
  }
} : null;

// Breadcrumb schema
const breadcrumbSchema = currentPage === 1 ? {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Accueil",
      "item": "https://www.davidbarbier.com/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Blog",
      "item": "https://www.davidbarbier.com/blog/"
    }
  ]
} : null;

---

<Layout metadata={metadata}>
  {blogSchema && (
    <Fragment slot="head">
      <script is:inline type="application/ld+json" set:html={JSON.stringify(blogSchema)} />
      <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
    </Fragment>
  )}

  <section class="px-6 sm:px-6 py-12 sm:py-16 lg:py-20 mx-auto max-w-4xl">
    <Headline
      subtitle={"Ressources concrètes et guides pratiques pour gagner en visibilité sur Google : SEO local, WordPress, Google Business Profile. Pour TPE en Corse et cabinets d'experts-comptables partout en France."}
    >
      Conseils SEO &amp; web pour TPE et experts-comptables
    </Headline>
    <BlogList posts={page.data.filter(p => p.category != 'portfolio')} />
    <Pagination prevUrl={page.url.prev} nextUrl={page.url.next} prevText={"Précédent articles"} nextText={"Articles suivants"} />

    <PostTags tags={allCategories} class="mb-2" title={"Rechercher par catégories"} isCategory />
    <PostTags tags={allTags}  title={"Rechercher par tags"} />

  </section>
</Layout>
