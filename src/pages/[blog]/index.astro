---
import merge from 'lodash.merge';
import type { ImageMetadata } from 'astro';
import Layout from '~/layouts/PageLayout.astro';
import SinglePost from '~/components/blog/SinglePost.astro';
import ToBlogLink from '~/components/blog/ToBlogLink.astro';

import { getCanonical, getPermalink } from '~/utils/permalinks';
import { getStaticPathsBlogPost, blogPostRobots } from '~/utils/blog';
import { findImage } from '~/utils/images';

export async function getStaticPaths () {
  return await getStaticPathsBlogPost();
}

const { post } = Astro.props;

const url = getCanonical(getPermalink(post.permalink, 'post'));
const image = (await findImage(post.image)) as ImageMetadata | undefined;

const metadata = merge(
  {
    title: post.title,
    description: post.excerpt,
    robots: {
      index: blogPostRobots?.index,
      follow: blogPostRobots?.follow,
    },
    openGraph: {
      type: 'article',
      ...(image ? { images: [{ url: image, width: image?.width, height: image?.height }] } : {}),
    },
  },
  { ...(post?.metadata ? { ...post.metadata, canonical: post.metadata?.canonical || url } : {}) }
);
---

<Layout metadata={metadata}>
  {post.author && (
    <script is:inline type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Article",
      "headline": post.title,
      "description": post.excerpt,
      "datePublished": post.publishDate?.toISOString(),
      "dateModified": (post.updateDate || post.publishDate)?.toISOString(),
      ...(image ? { "image": image.src } : {}),
      "author": {
        "@type": "Person",
        "name": post.author,
        "url": "https://www.davidbarbier.com/a-propos/"
      },
      "publisher": {
        "@type": "Person",
        "name": "David Barbier",
        "url": "https://www.davidbarbier.com/"
      },
      "mainEntityOfPage": {
        "@type": "WebPage",
        "@id": url
      }
    })} />
  )}
  <script is:inline type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Accueil",
        "item": "https://www.davidbarbier.com/"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Blog",
        "item": "https://www.davidbarbier.com/blog/"
      },
      {
        "@type": "ListItem",
        "position": 3,
        "name": post.title,
        "item": String(url)
      }
    ]
  })} />
  <SinglePost post={{ ...post, image: image }} url={url} />
  <ToBlogLink />
</Layout>