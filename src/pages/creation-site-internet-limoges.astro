---
import Layout from '../layouts/PageLayout.astro';
import { Icon } from 'astro-icon/components';
import HeroImage from '../assets/images/DSCF7551-3.jpg';
import Image from '~/components/common/Image.astro';

const metadata = {
  title: 'Création site internet Limoges à 1800€ HT | David Barbier',
  description:
    "Une offre claire pour votre Création de site internet vitrine à Limoges. 1800€, adpaté à toutes les tailles d'écran, sans frais cachés, 100% administrable en 1 mois.",
};
---

<script>
  const form = document.querySelector('form');
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const formData = new FormData(form);
    fetch(form.action, {
      method: 'POST',
      headers: { Accept: 'application/json' },
      body: formData,
    })
      .then((response) => {
        if (response.ok) {
          form.reset();
        } else {
          return response.json().then((json) => Promise.reject(json));
        }
      })
      .then(() => {
        alert('Merci pour votre message! Je vous recontacte au plus vite.');
      })
      .catch((error) => {
        alert("Oups! Il y a eu un problème lors de l'envoi de votre message");
        console.error(error);
      });
  });
</script>
<Layout metadata={metadata}>
  <section class="relative isolate overflow-hidden dark:bg-[#030620]">
