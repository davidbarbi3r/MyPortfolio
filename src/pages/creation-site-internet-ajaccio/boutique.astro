---
import Layout from '~/layouts/PageLayout.astro';
import CreationServicePage from '~/components/widgets/CreationServicePage.astro';
import { localBusinessAjaccioNode, LOCAL_BUSINESS_AJACCIO_ID } from '~/utils/business-schema';

const metadata = {
  title: 'Création de site ecommerce à Ajaccio | David Barbier',
  description:
    "Création de site ecommerce à Ajaccio, sur devis. Catalogue, paiement et livraison. Boutique Shopify ou WooCommerce selon le projet. Devis sous 48 h.",
};

const FAQ = [
  {
    q: 'Je pourrai ajouter des produits moi-même ?',
    a: "Oui. Prix, stocks, photos : vous tenez le catalogue. La mise en ligne comprend une formation pour ajouter un produit et suivre une commande.",
  },
  {
    q: 'Quel est le prix ?',
    a: "Sur devis. Il dépend du nombre de produits, des moyens de paiement et des livraisons. Vous avez un chiffre sous 48 heures, pas une fourchette inventée.",
  },
  {
    q: 'Une vitrine suffit si je ne vends pas encore en ligne ?',
    a: 'Oui. Un <a href="/creation-site-internet-ajaccio/site-vitrine/">site vitrine à Ajaccio</a> présente l’activité sans catalogue. On ajoute la vente le jour où les commandes le justifient.',
  },
  {
    q: 'Shopify ou WooCommerce ?',
    a: "On choisit après avoir vu le catalogue, pas avant. Shopify quand vous voulez vendre vite, avec peu de technique à porter. WooCommerce quand la boutique doit vivre dans un site WordPress déjà là, ou quand le catalogue a des règles particulières.",
  },
];

const graph = {
  '@context': 'https://schema.org',
  '@graph': [
    localBusinessAjaccioNode,
    {
      '@type': 'Service',
      '@id': 'https://www.davidbarbier.com/creation-site-internet-ajaccio/boutique/#service',
      name: 'Création de site ecommerce à Ajaccio',
      url: 'https://www.davidbarbier.com/creation-site-internet-ajaccio/boutique/',
      provider: { '@id': LOCAL_BUSINESS_AJACCIO_ID },
      areaServed: { '@type': 'City', name: 'Ajaccio' },
      serviceType: 'Ecommerce',
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Accueil', item: 'https://www.davidbarbier.com/' },
        { '@type': 'ListItem', position: 2, name: 'Création de site internet', item: 'https://www.davidbarbier.com/creation-site-internet-ajaccio/' },
        { '@type': 'ListItem', position: 3, name: 'Site ecommerce', item: 'https://www.davidbarbier.com/creation-site-internet-ajaccio/boutique/' },
      ],
    },
    {
      '@type': 'FAQPage',
      mainEntity: FAQ.map((item) => ({
        '@type': 'Question',
        name: item.q,
        acceptedAnswer: { '@type': 'Answer', text: item.a.replace(/<[^>]+>/g, '') },
      })),
    },
  ],
};
---

<Layout metadata={metadata}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(graph)} />
  <CreationServicePage
    crumb="Site ecommerce"
    badge="Ecommerce"
    title="Création de site ecommerce"
    titleAccent="à Ajaccio"
    lede="Quelqu’un choisit un produit, paie, et sait comment il le reçoit. C’est ça, la boutique. Le prix se fixe sous 48 heures, une fois qu’on a vu ce que vous vendez."
    stats={[
      { value: 'Sur devis', label: 'selon le catalogue' },
      { value: '48 h', label: 'pour le chiffre' },
      { value: 'Vous', label: 'tenez les fiches' },
    ]}
    heroCardTitle="Vous tenez le catalogue"
    heroCardText="Prix, stocks, photos. La boutique reste à vous."
    whyTitle="Une commande doit pouvoir aboutir"
    whyParagraphs={[
      'Fiche produit, panier, paiement, livraison. Si l’une de ces étapes coince, le visiteur part. Le nom du logiciel ne rattrape pas ça.',
      'Shopify ou WooCommerce, on en parle après le catalogue. Si vous ne vendez pas encore, un <a href="/creation-site-internet-ajaccio/site-vitrine/" class="text-sage-dark underline underline-offset-2">site vitrine</a> suffit, à partir de 2 000 € HT.',
    ]}
    quote="Dites-moi ce que vous vendez, à qui, et comment ça part. Le devis sort de là."
    whyCards={[
      { icon: 'M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z', title: 'Le produit se comprend', desc: 'Photo, prix, variante, stock. Le visiteur sait ce qu’il achète avant de payer.' },
      { icon: 'M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z', title: 'Le paiement est clair', desc: 'Ce que le client peut payer, et où l’argent arrive. Cadré avant de construire.' },
      { icon: 'M13 16V6a1 1 0 00-1-1H4a1 1 0 00-1 1v10a1 1 0 001 1h1m8-1a1 1 0 01-1 1H9m4-1V8a1 1 0 011-1h2.586a1 1 0 01.707.293l3.414 3.414a1 1 0 01.293.707V16a1 1 0 01-1 1h-1m-6-1a1 1 0 001 1h1M5 17a2 2 0 104 0m-4 0a2 2 0 114 0m6 0a2 2 0 104 0m-4 0a2 2 0 114 0', title: 'La livraison se voit', desc: 'Retrait, envoi, ou les deux. Les frais apparaissent avant la commande, pas après.' },
      { icon: 'M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z', title: 'Vous ajoutez la suite', desc: 'Un nouveau produit, un prix, une photo. Vous n’avez pas à me rappeler pour ça.' },
    ]}
    stepsTitle="La boutique en 6 étapes"
    stepsIntro="On cadre, vous voyez le design, vous testez une commande, vous prenez la main. Ensuite, l’optimisation du référencement des fiches et des catégories."
    steps={[
      { n: '01', title: 'Ce que vous vendez', text: 'Produits, variantes, à qui, et comment ça part. Le devis sort de là, sous 48 heures.' },
      { n: '02', title: 'Vous voyez à quoi ça ressemble', text: 'Une version en ligne, pas un PDF. Vous commentez la boutique, sur téléphone comme sur ordinateur.' },
      { n: '03', title: 'Le chemin jusqu’au paiement', text: 'La fiche, le panier, le paiement, la livraison. Vous voyez le parcours avant qu’il encaisse.' },
      { n: '04', title: 'Une commande test', text: 'Vous passez une commande comme un client. On corrige ce qui bloque, fiches comprises.' },
      { n: '05', title: 'Vous prenez la main', text: 'Paiement réel, formation pour ajouter un produit, accès à votre nom.' },
      { n: '06', title: 'Optimisation du référencement', text: 'Titres, textes et structure des fiches produit et des catégories. Pour que Google et les IA comprennent ce que vous vendez, pas seulement le visiteur.' },
    ]}
    inclus={[
      { title: 'Les fiches', desc: 'La structure des produits, pour que vous puissiez en ajouter ensuite.' },
      { title: 'Le paiement', desc: 'Les moyens d’encaisser, branchés et testés.' },
      { title: 'La livraison', desc: 'Retrait, envoi, frais. Le client le voit avant de payer.' },
      { title: 'La formation', desc: 'Ajouter un produit, changer un prix, suivre une commande.' },
      { title: 'Le design', desc: 'Une version en ligne à commenter, sur téléphone et sur ordinateur. Pas un PDF.' },
      { title: 'Le référencement', desc: 'Fiches produit et catégories travaillées pour Google et les IA.' },
    ]}
    techTitle="Quatre questions, puis l’outil"
    techIntro="Le catalogue, le paiement et la livraison décident du chantier. Shopify ou WooCommerce vient après, pas à la place."
    techCards={[
      { icon: 'M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z', title: 'Combien de produits', desc: 'Dix fiches et le retrait au magasin, ce n’est pas le même travail que des variantes et des transporteurs.' },
      { icon: 'M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z', title: 'Comment on paie', desc: 'Carte, virement, paiement à la livraison. On ne construit pas tant que ce n’est pas dit.' },
      { icon: 'M13 16V6a1 1 0 00-1-1H4a1 1 0 00-1 1v10a1 1 0 001 1h1m8-1a1 1 0 01-1 1H9m4-1V8a1 1 0 011-1h2.586a1 1 0 01.707.293l3.414 3.414a1 1 0 01.293.707V16a1 1 0 01-1 1h-1m-6-1a1 1 0 001 1h1M5 17a2 2 0 104 0m-4 0a2 2 0 114 0m6 0a2 2 0 104 0m-4 0a2 2 0 114 0', title: 'Comment ça part', desc: 'Colis, retrait, zone limitée. Les frais font partie du prix affiché au client.' },
      { icon: 'M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z', title: 'L’outil, ensuite', desc: 'Shopify pour vendre vite, avec peu de technique. WooCommerce si la boutique doit vivre dans un WordPress déjà là.' },
    ]}
    priceTitle="Le prix d’un site ecommerce"
    priceName="Site ecommerce"
    priceValue="Sur devis"
    priceHint="chiffre sous 48 heures"
    priceNote="Pas de fourchette affichée. Le nombre de produits, les paiements et les livraisons changent le chantier. L’abonnement Shopify, s’il y en a un, est chez Shopify. De mon côté, rien à payer pour garder la boutique."
    priceIncludes={[
      'Design commenté en ligne, avant la construction',
      'Fiches, panier et paiement testés',
      'Livraison cadrée avant la mise en ligne',
      'Formation pour tenir le catalogue',
      'Fiches produit et catégories travaillées pour Google et les IA',
      'Accès à votre nom',
    ]}
    priceOptions={[
      { label: 'Site vitrine sans vente', value: 'dès 2 000 € HT' },
      { label: 'Maintenance', value: 'dès 30 €/mois HT' },
    ]}
    faqTitle="Questions avant de vendre"
    faq={FAQ}
    ctaTitle="Décrivez ce que vous vendez"
    ctaText="Nombre de produits, comment vous livrez, et si un site existe déjà. Le chiffre revient sous 48 heures."
    finalPoints={[
      { title: 'Un chiffre, pas une fourchette', desc: 'Le devis sort du catalogue, du paiement et de la livraison.' },
      { title: 'Vous tenez les fiches', desc: 'Prix, stocks, photos. Je ne garde pas le catalogue en otage.' },
      { title: 'À Ajaccio', desc: 'David Barbier, 13 boulevard Sampiero. 06 23 56 52 99.' },
    ]}
    source="creation-boutique-en-ligne-ajaccio"
  >
    <p slot="links">
      Cette page fait partie de la <a href="/creation-site-internet-ajaccio/" class="text-sage-dark underline underline-offset-2">création de site internet à Ajaccio</a>.
      Sans catalogue : <a href="/creation-site-internet-ajaccio/site-vitrine/" class="text-sage-dark underline underline-offset-2">site vitrine</a>
      ou <a href="/creation-site-internet-ajaccio/one-page/" class="text-sage-dark underline underline-offset-2">one page</a>.
      Un site WordPress à reprendre : <a href="/freelance-wordpress-ajaccio/" class="text-sage-dark underline underline-offset-2">freelance WordPress à Ajaccio</a>.
    </p>
  </CreationServicePage>
</Layout>
