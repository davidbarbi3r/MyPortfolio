---
import Layout from '../layouts/PageLayout.astro';
import Image from '../components/common/Image.astro';
import HeroImage from '../assets/images/DSCF7551-3.jpg';
import Activateur from "../assets/images/activateur.png"
import { aggregateRatingSchema } from '~/utils/reviews';
const metadata = {
  title: 'Consultant SEO Ajaccio : votre site 100% visible en ligne',
  description:
    'Consultant SEO à Ajaccio. Audit SEO gratuit pour votre site web en Corse. Progressez sur Google de façon saine et sans jargon.',
};

// JSON-LD Service schema
const serviceStructuredData = {
  "@context": "https://schema.org",
  "@type": "Service",
  "@id": "https://www.davidbarbier.com/consultant-seo-ajaccio/#service",
  "name": "Consultant SEO à Ajaccio",
  "description": "Référencement naturel à Ajaccio. Accompagnement SEO, audit technique et optimisation Google Business pour améliorer votre visibilité sur Google en Corse.",
  "provider": {
    "@type": "Person",
    "@id": "https://www.davidbarbier.com/#person",
    "name": "David Barbier",
    "jobTitle": "Consultant SEO & Développeur web"
  },
  "areaServed": [
    { "@type": "City", "name": "Ajaccio" },
    { "@type": "AdministrativeArea", "name": "Corse" }
  ],
  "serviceType": "Consultant SEO",
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": "Offres SEO Ajaccio",
    "itemListElement": [
      {
        "@type": "Offer",
        "name": "Accompagnement SEO mensuel",
        "description": "Stratégie SEO complète avec suivi mensuel",
        "priceSpecification": {
          "@type": "UnitPriceSpecification",
          "minPrice": "490",
          "priceCurrency": "EUR",
          "unitCode": "MON",
          "valueAddedTaxIncluded": false
        }
      },
      {
        "@type": "Offer",
        "name": "Audit SEO",
        "description": "Analyse complète de votre visibilité et plan d'action",
        "price": "690",
        "priceCurrency": "EUR"
      },
      {
        "@type": "Offer",
        "name": "Optimisation Google Business Profile",
        "description": "Optimisation de votre fiche Google pour la visibilité locale",
        "price": "350",
        "priceCurrency": "EUR"
      },
      {
        "@type": "Offer",
        "name": "Suivi & animation Google Business Profile mensuel",
        "description": "Animation mensuelle de votre fiche Google Business : posts, gestion des avis, monitoring",
        "priceSpecification": {
          "@type": "UnitPriceSpecification",
          "price": "100",
          "priceCurrency": "EUR",
          "unitCode": "MON",
          "valueAddedTaxIncluded": false
        }
      }
    ]
  }
};

// JSON-LD FAQ schema
const faqStructuredData = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Combien de temps faut-il pour voir des résultats en SEO ?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Les premiers mouvements sur vos mots-clés sont visibles entre 3 et 4 mois. Des résultats concrets en leads ou chiffre d'affaires arrivent entre 6 et 12 mois, selon la concurrence et l'état de départ. Je recommande un engagement minimum de 6 mois pour que la stratégie ait le temps de payer."
      }
    },
    {
      "@type": "Question",
      "name": "Mon activité est en B2B ou dans une niche, est-ce que ça marche quand même ?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Oui, et souvent mieux que pour les activités grand public. Moins de concurrence sur les requêtes de niche = plus facile de ranker, et le taux de conversion des visiteurs est nettement meilleur. J'accompagne déjà des experts-comptables, cabinets de gestion de patrimoine et artisans spécialisés."
      }
    },
    {
      "@type": "Question",
      "name": "Et si au bout de 6 mois je n'ai aucun résultat ?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Je ne prends que des projets viables sur le plan SEO — l'audit initial est justement là pour l'identifier avant de commencer. Si malgré ça les résultats tardent, on fait un point trimestriel où on peut arrêter sans pénalité. L'accompagnement mensuel n'est pas un abonnement piégé : pas de reconduction tacite, pas de frais de résiliation."
      }
    },
    {
      "@type": "Question",
      "name": "Est-ce que je garde la main sur mes comptes (Google, WordPress, hébergement) ?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Oui, sans exception. Tous vos comptes (Google Business Profile, Search Console, Analytics, WordPress, hébergeur) restent à votre nom, avec vos identifiants. Je travaille sur vos accès, je ne crée rien à mon nom. Si on arrête la collaboration, vous partez avec tout — et sans que ça casse quoi que ce soit."
      }
    },
    {
      "@type": "Question",
      "name": "Pourquoi choisir un consultant SEO à Ajaccio plutôt qu'une agence nationale ?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Trois raisons concrètes. Un : je connais les SERPs locales d'Ajaccio et de Corse, pas d'apprentissage à vos frais. Deux : vous parlez à celui qui fait le boulot, pas à un chef de projet qui descend la demande à une équipe offshore. Trois : coût 30 à 50% inférieur à une agence équivalente, parce que pas de structure à financer. Le tradeoff : je suis seul, donc indisponible pendant mes congés. C'est assumé."
      }
    },
    {
      "@type": "Question",
      "name": "Quelle différence entre l'audit gratuit et l'audit complet à 690€ ?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "L'audit gratuit est une analyse rapide et factuelle de votre site : je regarde ce qui est fait dans sa globalité et je vous dis ce qui est en place et ce qui manque. Pas d'analyse des backlinks, pas d'analyse de la concurrence, pas de réflexion stratégique. C'est utile pour savoir où vous en êtes avant d'investir. L'audit complet à 690€ va plus loin : audit technique approfondi, analyse des backlinks existants, étude de 3 à 5 concurrents directs, étude de mots-clés stratégiques, plan d'actions priorisé et séquencé, rapport visuel et restitution en visio. Livraison sous 5 jours ouvrés."
      }
    },
    {
      "@type": "Question",
      "name": "Quel est le tarif d'un consultant SEO à Ajaccio ?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Quatre formules transparentes. Accompagnement SEO mensuel : 490€ HT/jour, avec 1 à 3 jours/mois selon votre projet (à partir de 490€/mois, engagement 6 mois). Audit complet : 690€ HT (analyse approfondie + plan d'action, sans suivi). Optimisation Google Business Profile : 350€ HT (one shot). Suivi et animation Google Business mensuel : 100€ HT/mois (posts, avis, monitoring, sans engagement). Pour un besoin ponctuel, interventions à la demi-journée (245€ HT) ou à la journée (490€ HT) sans engagement. Tarifs HT, sans frais caché, sans reconduction tacite."
      }
    }
  ]
};

// JSON-LD Breadcrumb schema
const breadcrumbStructuredData = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Accueil",
      "item": "https://www.davidbarbier.com/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Consultant SEO Ajaccio",
      "item": "https://www.davidbarbier.com/consultant-seo-ajaccio/"
    }
  ]
};
---

<Layout metadata={metadata}>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(serviceStructuredData)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(faqStructuredData)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbStructuredData)} />
  </Fragment>

  <section class="relative isolate overflow-hidden dark:bg-[#030620]">
    <!-- Fil d'Ariane -->
    <div class="mx-auto max-w-7xl px-6 pt-8 lg:px-8">
      <nav aria-label="Fil d'Ariane" class="text-sm font-body">
        <ol class="flex items-center gap-2 text-gray-500 dark:text-gray-400 flex-wrap">
          <li><a href="/" class="hover:text-green-700 dark:hover:text-green-400 transition-colors">Accueil</a></li>
          <li><svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg></li>
          <li class="text-gray-900 dark:text-white font-medium">Consultant SEO Ajaccio</li>
        </ol>
      </nav>
    </div>

    <div class="mx-auto max-w-7xl px-6 pb-24 pt-4 sm:pb-12 lg:flex lg:px-8 lg:py-16">
      <div class="mx-auto max-w-2xl lg:mx-0 lg:shrink-0 lg:pt-8">
        <!-- Badge localisation -->
        <div class="mt-8 sm:mt-16 lg:mt-8">
          <span class="inline-flex items-center">
            <span
              class="rounded-full bg-green-800/10 dark:bg-gray-700 px-3 py-1 text-sm font-semibold text-brown ring-1 ring-inset ring-green-950/10"
            >
              Ajaccio — Corse
            </span>
          </span>
        </div>

        <!-- H1 en kicker (petit, SEO-focus) -->
        <h1 class="mt-6 text-base font-semibold uppercase tracking-wider text-emerald-700 dark:text-emerald-400">
          Consultant SEO Ajaccio
        </h1>

        <!-- Titre visuel commercial -->
        <p class="mt-3 text-pretty font-heading text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tight leading-[1.1]">
          <span class="text-green-950 dark:text-white">Plus haut sur Google,</span><br />
          <span class="text-emerald-700 dark:text-emerald-400">plus de clients trouvés.</span>
        </p>

        <!-- Trust line -->
        <p class="mt-6 text-sm text-gray-500 dark:text-gray-400">
          ⭐ 5/5 sur Google · 13 avis · +50 clients accompagnés · Basé à Ajaccio
        </p>

        <!-- Problem statement -->
        <p class="mt-8 text-pretty text-lg text-gray-600 dark:text-gray-300">
          Vous avez un site, vos concurrents sont devant vous sur Google, et vous ne savez pas comment changer ça. Je suis <strong>consultant SEO à Ajaccio</strong> et je m'occupe exactement de ce problème.
        </p>

        <p class="mt-6 text-pretty text-lg text-gray-600 dark:text-gray-300">
          Technique, contenu, liens — je travaille les 3 piliers du SEO pour vous installer durablement sur vos mots-clés stratégiques. Sans jargon, sans promesse bidon, avec un reporting mensuel clair.
        </p>

        <!-- Call-to-action -->
        <div class="mt-10 flex items-center gap-x-6">
          <a
            href="tel:+33623565299"
            class="rounded-md bg-green-700 px-4 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-green-700/90 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brown"
          >
            Demander un audit gratuit
          </a>
          <a href="#services" class="inline-flex items-center gap-2 text-sm font-semibold text-gray-900 dark:text-gray-300 whitespace-nowrap">
            Découvrir mes services <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
          </a>
        </div>
        <p class="mt-3 text-xs text-gray-500 dark:text-gray-400 max-w-md">
          Audit gratuit = analyse rapide et factuelle de votre site. <a href="#audits" class="underline hover:text-emerald-700 dark:hover:text-emerald-400">L'audit complet (690€)</a> va plus loin : backlinks, concurrence, stratégie.
        </p>
      </div>

      <!-- Image ou graphique à droite -->
      <div class="mx-auto mt-16 flex max-w-2xl lg:ml-10 lg:mr-0 lg:mt-0 lg:max-w-none xl:ml-32">
        <div class="max-w-3xl flex-none sm:max-w-5xl lg:max-w-none">
          <div
            class="-m-2 rounded-xl bg-gray-900/5 p-2 ring-1 ring-inset ring-gray-900/10 lg:-m-4 lg:rounded-2xl lg:p-4"
          >
            <img
              src="https://imagedelivery.net/4zDfTa1ovbR8nr2bLQ6Mxg/af43940c-7bc0-4088-bd7a-6f7002f9b200/public"
              alt="Visualisation des performances SEO dans la google search console"
              class="w-[76rem] rounded-md shadow-2xl ring-1 ring-gray-900/10 max-h-[80vh] object-contain object-left"
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Résultats concrets -->
  <section class="py-16 sm:py-20 px-6 lg:px-8 bg-gray-50 dark:bg-slate-800">
    <div class="mx-auto max-w-5xl">
      <!-- Header -->
      <div class="mb-12">
        <p class="text-xs font-semibold uppercase tracking-[0.2em] text-gray-400 dark:text-gray-500 mb-4 flex items-center gap-2">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
          Résultats concrets
        </p>
        <h2 class="text-3xl sm:text-4xl font-bold tracking-tight text-gray-900 dark:text-white">
          Des clients qui trouvent, <span class="text-emerald-700 dark:text-emerald-400">appellent, achètent.</span>
        </h2>
        <p class="mt-4 text-gray-600 dark:text-gray-300 max-w-2xl">
          J'ai déménagé à Ajaccio il y a 4 ans. Certains de mes cases chiffrés viennent de clients continentaux — la méthode est la même partout.
        </p>
      </div>

      <!-- Cards -->
      <div class="grid md:grid-cols-2 gap-6">
        <!-- Card 1: Endoajaccio (Ajaccio) -->
        <article class="bg-white dark:bg-gray-900 rounded-2xl p-8 shadow-sm border border-gray-100 dark:border-gray-800 flex flex-col">
          <div class="flex items-center gap-2 mb-4">
            <span class="inline-flex items-center gap-1.5 rounded-full bg-emerald-600/10 px-2.5 py-1 text-xs font-semibold text-emerald-700 dark:text-emerald-400">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
              Ajaccio
            </span>
            <span class="text-xs text-gray-500 dark:text-gray-400">Santé · Cabinet médical</span>
          </div>
          <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-3">
            Endoajaccio — endodontiste
          </h3>
          <p class="text-sm text-gray-600 dark:text-gray-300 mb-6">
            Site conçu from scratch + fondations SEO locales + Google Business Profile optimisé.
          </p>
          <div class="bg-emerald-50 dark:bg-emerald-900/20 rounded-xl p-4 mb-4 mt-auto">
            <p class="text-2xl font-bold text-emerald-700 dark:text-emerald-400">5 nouveaux patients / jour</p>
            <p class="text-xs text-gray-600 dark:text-gray-400 mt-1">depuis la mise en ligne</p>
          </div>
          <p class="text-xs text-gray-500 dark:text-gray-500 italic leading-relaxed">
            L'endodontie est peu représentée en Corse, ce qui a accéléré le positionnement. La méthode reste la même sur des secteurs plus compétitifs.
          </p>
        </article>

        <!-- Card 2: Restodom (Bordeaux) -->
        <article class="bg-white dark:bg-gray-900 rounded-2xl p-8 shadow-sm border border-gray-100 dark:border-gray-800 flex flex-col">
          <div class="flex items-center gap-2 mb-4">
            <span class="inline-flex items-center gap-1.5 rounded-full bg-amber-600/10 px-2.5 py-1 text-xs font-semibold text-amber-700 dark:text-amber-400">
              <span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span>
              Bordeaux
            </span>
            <span class="text-xs text-gray-500 dark:text-gray-400">Service à domicile · B2C</span>
          </div>
          <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-3">
            Restodom — portage de repas à Bordeaux
          </h3>
          <p class="text-sm text-gray-600 dark:text-gray-300 mb-6">
            Accompagnement SEO sur 12 mois : stratégie technique + éditoriale + netlinking.
          </p>
          <div class="bg-emerald-50 dark:bg-emerald-900/20 rounded-xl p-4 mb-4 mt-auto">
            <p class="text-2xl font-bold text-emerald-700 dark:text-emerald-400">Top 1 Google</p>
            <p class="text-xs text-gray-600 dark:text-gray-400 mt-1">sur "portage repas bordeaux" en 12 mois</p>
          </div>
          <p class="text-xs text-gray-500 dark:text-gray-500 italic leading-relaxed">
            Requête commerciale locale avec concurrence. Position tenue dans la durée — toujours en top 1 aujourd'hui.
          </p>
        </article>
      </div>

      <!-- CTA -->
      <div class="mt-12 text-center">
        <a
          href="tel:+33623565299"
          class="inline-flex items-center gap-2 text-emerald-700 dark:text-emerald-400 font-semibold hover:gap-3 transition-all"
        >
          Vous voulez ce type de résultat pour votre activité ? Réservons un échange
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
        </a>
      </div>
    </div>
  </section>

  <!-- Le problème que vous avez -->
  <section class="px-6 py-16 sm:py-20 lg:px-8">
    <div class="mx-auto max-w-3xl">
      <!-- H2 -->
      <h2 class="text-3xl sm:text-4xl font-bold tracking-tight text-gray-900 dark:text-white mb-8 leading-tight">
        Ce qui se passe quand vous n'êtes pas en <span class="text-emerald-700 dark:text-emerald-400">première page Google</span>
      </h2>

      <div class="space-y-6 text-lg text-gray-600 dark:text-gray-300 leading-relaxed">
        <p>
          Vos concurrents ramassent les appels que vous devriez recevoir. Les gens qui cherchent votre service à Ajaccio tombent sur eux, pas sur vous.
        </p>
        <p>
          Vous compensez comment ? En payant Google Ads — des clics à 15-30€ qui partent ailleurs dès que vous coupez la campagne. Ou vous laissez votre site sur sa page 3, et vous survivez grâce au bouche-à-oreille et aux passants.
        </p>
        <p class="font-semibold text-gray-900 dark:text-white">
          Pendant ce temps, votre site reste une jolie carte de visite qui ne ramène rien.
        </p>
      </div>

      <!-- Solution transition -->
      <h3 class="mt-16 text-2xl sm:text-3xl font-bold text-gray-900 dark:text-white mb-6 leading-tight">
        Le SEO règle ça — mais pas n'importe comment
      </h3>

      <p class="text-lg text-gray-600 dark:text-gray-300 leading-relaxed mb-10">
        La majorité des "consultants SEO" vendent des mots-clés bidon, des backlinks de spam, et un reporting PowerPoint qui cache qu'il ne se passe rien. Six mois plus tard, mêmes positions, zéro différence sur votre chiffre d'affaires.
      </p>

      <p class="text-lg font-semibold text-gray-900 dark:text-white mb-8">
        Ma méthode est différente sur trois points :
      </p>

      <div class="space-y-8">
        <div>
          <h4 class="text-lg sm:text-xl font-bold text-gray-900 dark:text-white mb-2">
            <span class="text-emerald-700 dark:text-emerald-400">01.</span> Développeur avant d'être SEO
          </h4>
          <p class="text-gray-600 dark:text-gray-300 leading-relaxed">
            Quand je détecte un problème technique qui freine votre référencement, je le résous moi-même, dans la journée. Pas de ping-pong avec "votre prestataire web" qui ne comprend pas ce qu'on lui demande.
          </p>
        </div>

        <div>
          <h4 class="text-lg sm:text-xl font-bold text-gray-900 dark:text-white mb-2">
            <span class="text-emerald-700 dark:text-emerald-400">02.</span> Je fais ce qui marche, pas ce qui impressionne
          </h4>
          <p class="text-gray-600 dark:text-gray-300 leading-relaxed">
            Pas de backlinks de masse, pas de contenu IA à la tonne. Travail sur les 3 piliers : technique, contenu utile, liens acquis proprement. Reporting mensuel clair, chiffres vérifiables dans votre Search Console.
          </p>
        </div>

        <div>
          <h4 class="text-lg sm:text-xl font-bold text-gray-900 dark:text-white mb-2">
            <span class="text-emerald-700 dark:text-emerald-400">03.</span> Je dis non si ça n'a pas de sens
          </h4>
          <p class="text-gray-600 dark:text-gray-300 leading-relaxed">
            Si le SEO n'est pas le bon levier pour votre business (niche trop petite, concurrence trop forte pour votre budget), je vous le dis avant qu'on signe. C'est plus rentable pour vous et pour moi à long terme.
          </p>
        </div>
      </div>
    </div>
  </section>
  
  <section class="mt-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6">
      <h2 class="mt-2 text-pretty text-3xl font-semibold tracking-tight text-gray-900  dark:text-gray-100 sm:text-4xl scroll-mt-32" id="services">
        Mes services de référencement
      </h2>
      <p class="mt-6 text-lg/8 text-gray-600  dark:text-gray-100">
        Je propose trois solutions SEO dont ma principale, l'accompagnement mensuel, pour des résultats durables et
        mesurables :
      </p>

      <ul class="mt-4 space-y-3 text-lg text-gray-800  dark:text-gray-100">
        <li class="flex gap-x-3 text-gray-950 dark:text-gray-100">
          <span class="font-bold text-black dark:text-gray-100">→ <strong>Accompagnement SEO :</strong></span> Je suis à vos cotés, partenaire de votre
          croissance en ligne (à partir de 490€/mois)
        </li>
        <li class="flex gap-x-3">
          <span class="font-semibold">→ Audit technique :</span> Une analyse approfondie pour guider vos actions SEO en autonomie.
          Obtenez votre feuille de route pour 690€.
        </li>
        <li class="flex gap-x-3">
          <span class="font-semibold">→ Optimisation fiche Google my Business :</span> Une solution rapide et accessible pour booster
          votre visibilité locale. Optimisation à 350€.
        </li>
        <li class="flex gap-x-3">
          <span class="font-semibold">→ Suivi mensuel Google Business :</span> Animation continue de votre fiche (posts, avis, monitoring). À partir de 100€/mois.
        </li>
      </ul>
    </div>
    <article class="p-8 rounded-xl mt-6 md:mt-12">
      <div class="mx-auto max-w-7xl px-6 lg:px-8">
        <div class="mx-auto max-w-2xl lg:text-center">
          <h3 class="text-3xl font-semibold text-dark">L'Accompagnement SEO personnalisé en détail</h3>
          <p class="mt-6 text-lg/8 text-gray-600  dark:text-gray-300">
            Je m'occupe de tous les aspects de votre <strong>référencement</strong> pendant que vous vous concentrez sur votre cœur de
            métier.
          </p>
          <p class="text-lg/8 text-gray-600 dark:text-gray-300">
            On se fait un point mensuel et vous voyez votre site grimper dans les résultats de Google.
          </p>
          <p class="mt-6 text-lg/8 text-gray-600 dark:text-gray-300">
            Une action commune sur les 3 piliers suivants est la clé d'un site bien référencé :
          </p>
        </div>
        <div class="mx-auto mt-6 max-w-2xl sm:mt-12 lg:mt-16 lg:max-w-none">
          <dl class="grid max-w-xl grid-cols-1 gap-x-8 gap-y-16 lg:max-w-none lg:grid-cols-3">
            <div class="flex flex-col">
              <dt class="flex items-center gap-x-3 text-base/7 font-semibold text-gray-900 dark:text-gray-300">
