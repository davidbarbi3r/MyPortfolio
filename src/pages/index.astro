---
import {useTranslations} from "~/i18n/translator";
import Layout from '~/layouts/PageLayout.astro';
import { Image } from 'astro:assets';
import HeroImage from '~/assets/images/DSCF7551-3.jpg'
import ServiceCreation from '~/assets/images/service-creation.jpg'
import ServiceDev from '~/assets/images/service-dev.jpg'
import ServiceMaintenance from '~/assets/images/service-maintenance.jpg'
import ServiceSeo from '~/assets/images/service-seo.jpg'
import RestodomScreen from '~/assets/images/restodom-screen.png';
import OdacioScreen from '~/assets/images/odacio-screen.png';
import EkiaScreen from '~/assets/images/ekia-screen.png';
import Hero2 from '~/components/widgets/Hero2.astro';
import HeroAnimations from '~/components/animations/HeroAnimations.astro';
import ProjectsFlip from '~/components/animations/ProjectsFlip.astro';
import Features2 from "~/components/widgets/Features2.astro";
import LogoMarquee from "~/components/widgets/LogoMarquee.astro";
import BlogLatestPosts from "~/components/widgets/BlogLatestPosts.astro";
import { Icon } from 'astro-icon/components';

// Imports logos clients
import LogoEndoajaccio from '~/assets/images/clients/endoajaccio.png';
import LogoRestodom from '~/assets/images/clients/restodom.svg';
import LogoMobincub from '~/assets/images/clients/mobincub.png';
import LogoJeuxOriginaux from '~/assets/images/clients/jeux-originaux.webp';
import LogoAltarys from '~/assets/images/clients/altarys.svg';
import LogoOdacio from '~/assets/images/clients/conseils.svg';
import LogoEchinard from '~/assets/images/clients/echinard.png';
import LogoPizzaCarmes from '~/assets/images/clients/pizza-carmes.webp';
import LogoAurarios from '~/assets/images/clients/aurarios.png';
import LogoLeadauco from '~/assets/images/clients/leadauco.png';

import { REVIEWS as reviews, aggregateRatingSchema } from '~/utils/reviews';

const locale = Astro.currentLocale ?? 'fr'
const { t, tList } = useTranslations(locale);
const metadata = {
  title: 'David Barbier | Concepteur de sites web à Ajaccio (Corse)',
  description: "Concepteur de sites web à Ajaccio : création, développement sur-mesure, SEO et maintenance. Ancien auditeur financier au service des TPE et cabinets EC.",
  lang: locale,
};

// JSON-LD LocalBusiness schema - Ajaccio (localisation principale)
const localBusinessSchema = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "@id": "https://www.davidbarbier.com/#localbusiness",
  "name": "David Barbier | Consultant SEO et site internet",
  "image": "https://www.davidbarbier.com/david-barbier-consultant-seo-ajaccio.jpg",
  "url": "https://www.davidbarbier.com/",
  "telephone": "+33623565299",
  "email": "hello@davidbarbier.com",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "13 Boulevard Sampiero",
    "addressLocality": "Ajaccio",
    "postalCode": "20000",
    "addressRegion": "Corse",
    "addressCountry": "FR"
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": 41.9192043,
    "longitude": 8.7386439
  },
  "openingHoursSpecification": {
    "@type": "OpeningHoursSpecification",
    "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"],
    "opens": "08:00",
    "closes": "20:00"
  },
  "areaServed": [
    { "@type": "City", "name": "Ajaccio" },
    { "@type": "City", "name": "Mezzavia" },
    { "@type": "City", "name": "Afa" },
    { "@type": "City", "name": "Cauro" },
    { "@type": "City", "name": "Alata" },
    { "@type": "City", "name": "Bastelicaccia" },
    { "@type": "City", "name": "Cannelle" },
    { "@type": "City", "name": "Appietto" },
    { "@type": "City", "name": "Villanova" },
    { "@type": "City", "name": "Casaglione" },
    { "@type": "City", "name": "Calcatoggio" },
    { "@type": "City", "name": "Valle-di-Mezzana" },
    { "@type": "City", "name": "Sarrola-Carcopino" },
    { "@type": "City", "name": "Cuttoli-Corticchiato" },
    { "@type": "City", "name": "Porticcio, Grosseto-Prugna" },
    { "@type": "AdministrativeArea", "name": "Corse" }
  ],
  "sameAs": [
    "https://twitter.com/daviddeveloppe",
    "https://www.linkedin.com/in/dbarbier/",
    "https://www.instagram.com/daviddeveloppe/",
    "https://www.facebook.com/daviddeveloppe",
    "https://www.malt.fr/profile/davidbarbier",
    "https://github.com/davidbarbi3r"
  ],
  "priceRange": "€€"
};

// Avis clients : importés depuis ~/utils/reviews (source unique de vérité)

// Projets récents
const projects = [
  {
    client: "Restodom",
    sector: "Portage de repas",
    offer: "Développement sur mesure + SEO",
    result: "1er sur Google à Bordeaux",
    tech: ["NextJS", "Cloudflare"],
    logo: LogoRestodom,
    url: "https://www.restodom.fr"
  },
  {
    client: "Odacio Conseils",
    sector: "Expert-comptable",
    offer: "Site vitrine performant",
    result: "5 prises de RDV / semaine",
    tech: ["Astro", "Cloudflare"],
    logo: LogoOdacio,
    url: "https://www.odacio-conseils.fr"
  },
  {
    client: "Ekia Advisory",
    sector: "Expert-comptable",
    offer: "Site vitrine performant",
    result: "Site multilingue FR/EN",
    tech: ["Astro", "Cloudflare"],
    logo: LogoAltarys,
    url: "https://www.ekia-advisory.com"
  },
  {
    client: "Endoajaccio",
    sector: "Endodontiste",
    offer: "Développement sur mesure",
    result: "5 nouveaux patients / jour",
    tech: ["NextJS", "AWS"],
    logo: LogoEndoajaccio,
    url: "https://www.endoajaccio.fr"
  },
  {
    client: "Winvias",
    sector: "Gestion de patrimoine",
    offer: "Développement sur mesure",
    result: "IA cadrage prospect 24h/24",
    tech: ["React Router v7", "Google Cloud"],
    logo: null,
    url: "https://www.winvias.com"
  },
  {
    client: "Cabinet Altarys",
    sector: "Expert-comptable",
    offer: "Site vitrine performant",
    result: "Site professionnel moderne",
    tech: ["Astro", "Cloudflare"],
    logo: LogoAltarys,
    url: "https://www.cabinet-altarys.fr"
  }
];

// Schema AggregateRating + Reviews pour SEO
const reviewsSchema = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "@id": "https://www.davidbarbier.com/#localbusiness",
  "name": "David Barbier | Consultant SEO et site internet",
  "aggregateRating": aggregateRatingSchema,
  "review": reviews.map(r => ({
    "@type": "Review",
    "author": {
      "@type": "Person",
      "name": r.author
    },
    "reviewRating": {
      "@type": "Rating",
      "ratingValue": r.rating.toString(),
      "bestRating": "5",
      "worstRating": "1"
    },
    "reviewBody": r.text
  }))
};
---

<Layout metadata={metadata}>
  <!-- JSON-LD LocalBusiness Schema -->
  <script is:inline type="application/ld+json" set:html={JSON.stringify(localBusinessSchema)} />

  <!-- Hero2 Widget ******************* -->

  <!--hero-->
  <Hero2
    tagline="Concepteur de sites web à Ajaccio - Corse"
    callToAction={{ text: t('portfolio.bookCall'), href: 'tel:+33623565299', icon: 'tabler:phone' }}
    image={{
      src: HeroImage,
      alt:"Portrait de David Barbier développeur web freelance à Ajaccio",
    }}
  >
    <Fragment slot="title">
      <span class="text-slate-800 dark:text-gray-200">Des sites performants</span><br />
      <span class="text-emerald-700 dark:text-emerald-400">qui vous ramènent des clients.</span>
    </Fragment>

    <Fragment slot="subtitle">
      Sites web sur-mesure, SEO et développement custom à Ajaccio.
    </Fragment>

    <Fragment slot="content">
      <div class="flex flex-row lg:flex-col gap-8 lg:gap-10">
        <div>
          <p class="text-4xl md:text-5xl font-bold text-amber-700 dark:text-amber-400 leading-none" data-hero-stat="+50">+50</p>
          <p class="text-sm text-slate-500 dark:text-slate-400 mt-1 uppercase tracking-wide">clients accompagnés</p>
        </div>
        <div>
          <p class="text-4xl md:text-5xl font-bold text-amber-700 dark:text-amber-400 leading-none" data-hero-stat="5">+5</p>
          <p class="text-sm text-slate-500 dark:text-slate-400 mt-1 uppercase tracking-wide">ans d'expérience</p>
        </div>
        <div>
          <div class="flex items-center gap-2">
            <p class="text-4xl md:text-5xl font-bold text-amber-700 dark:text-amber-400 leading-none" data-hero-stat="5/5">5/5</p>
            <svg class="w-5 h-5 text-amber-500" fill="currentColor" viewBox="0 0 20 20">
              <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
            </svg>
          </div>
          <p class="text-sm text-slate-500 dark:text-slate-400 mt-1 uppercase tracking-wide">étoiles sur Google</p>
        </div>
      </div>
    </Fragment>
  </Hero2>
  <HeroAnimations />

  <!-- Logo Marquee -->
  <LogoMarquee
    logos={[
      { src: LogoEndoajaccio, alt: "Endoajaccio", scale: 1.3 },
      { src: LogoRestodom, alt: "Restodom" },
      { src: LogoMobincub, alt: "Mobincub" },
      { src: LogoJeuxOriginaux, alt: "Jeux Originaux" },
      { src: LogoAltarys, alt: "Cabinet Altarys", scale: 0.75 },
      { src: LogoOdacio, alt: "Odacio Conseils" },
      { src: LogoEchinard, alt: "Cabinet Echinard", scale: 0.75 },
      { src: LogoPizzaCarmes, alt: "Pizza Carmes", scale: 0.75 },
      { src: LogoAurarios, alt: "Aurarios", scale: 1.3 },
      { src: LogoLeadauco, alt: "Leadauco", scale: 1.3 },
    ]}
    speed={30}
  />

  <!--services-->
  
  <Features2
    title={t('portfolio.services.title')}
    subtitle={t('portfolio.services.subtitle')}
    columns={3}
    items={[
      {
        title: tList('portfolio.services.servicesItems')[0].title,
        description: tList('portfolio.services.servicesItems')[0].description,
        servicesItems: tList('portfolio.services.servicesItems')[0].items,
        price: tList('portfolio.services.servicesItems')[0].price,
        image: {
          ...ServiceCreation,
          alt: locale === 'en' ? 'Abstract water ripple texture for website creation service' : 'Texture abstraite d\'ondulations pour le service de création de site web',
        },
        icon: 'tabler:devices',
                 callToAction: {
           text: "Site web Wordpress Ajaccio",
           href: '/creation-site-internet-ajaccio/',
           icon: 'tabler:chevron-right',
         },
        ecLink: {
          text: "Expert-comptable ? Site vitrine dédié EC",
          href: '/agence-web-expert-comptable/creation-site-vitrine-ec/',
        },

      },
      {
        title: tList('portfolio.services.servicesItems')[1].title,
        description: tList('portfolio.services.servicesItems')[1].description,
        servicesItems: tList('portfolio.services.servicesItems')[1].items,
        price: tList('portfolio.services.servicesItems')[1].price,
        image: {
          ...ServiceDev,
          alt: locale === 'en' ? 'Weathered wood grain texture for custom development service' : 'Texture de bois pour le service de développement sur-mesure',
        },
        icon: 'tabler:wand',
        ecLink: {
          text: "Expert-comptable ? Développeur spécialisé EC",
          href: '/agence-web-expert-comptable/developpeur-specialise/',
        },
      },
      {
        title: tList('portfolio.services.servicesItems')[2].title,
        description: tList('portfolio.services.servicesItems')[2].description,
        servicesItems: tList('portfolio.services.servicesItems')[2].items,
        price: tList('portfolio.services.servicesItems')[2].price,
        image: {
          ...ServiceMaintenance,
          alt: locale === 'en' ? 'Dark rock and moss texture for maintenance service' : 'Texture de roche et mousse pour le service de maintenance',
        },
        icon: 'tabler:tool',
        ecLink: {
          text: "Expert-comptable ? Refonte de votre site cabinet",
          href: '/agence-web-expert-comptable/refonte-site-internet/',
        },
      },
      {
        title: tList('portfolio.services.servicesItems')[3].title,
        description: tList('portfolio.services.servicesItems')[3].description,
        servicesItems: tList('portfolio.services.servicesItems')[3].items,
        price: tList('portfolio.services.servicesItems')[3].price,
        image: {
          ...ServiceSeo,
          alt: locale === 'en' ? 'Sunlight through leaves texture for SEO service' : 'Texture de lumière à travers le feuillage pour le service SEO',
        },
        icon: 'tabler:tool',
        callToAction2: {
          text: "Référencement en Corse",
          href: '/consultant-seo-ajaccio/',
          icon: 'tabler:chevron-right',
        },
        ecLink: {
          text: "Expert-comptable ? SEO spécialisé cabinet",
          href: '/agence-web-expert-comptable/consultant-seo-ec/',
        },
      },
    ]}
  />

  <!-- Bandeau Expert-Comptable (pont vers page dédiée) -->
  <section class="py-6 bg-emerald-800 dark:bg-emerald-900">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <div class="flex flex-col sm:flex-row items-center justify-between gap-4">
        <div class="flex items-center gap-3 text-white">
          <span class="hidden sm:inline-flex items-center justify-center w-10 h-10 rounded-full bg-amber-500/20">
            <svg class="w-5 h-5 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/>
            </svg>
          </span>
          <p class="text-center sm:text-left">
            <span class="font-semibold">Vous êtes Expert-Comptable ?</span>
            <span class="hidden md:inline text-green-100"> — Ancien EC mémorialiste, j'ai des offres dédiées à votre profession.</span>
          </p>
        </div>
        <a
          href="/agence-web-expert-comptable/"
          class="inline-flex items-center gap-2 px-5 py-2.5 bg-white text-green-800 font-semibold rounded-full hover:bg-green-50 transition-colors shadow-md whitespace-nowrap"
        >
          Découvrir mes offres EC
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- Section Avis Google - Schema SEO -->
  <script is:inline type="application/ld+json" set:html={JSON.stringify(reviewsSchema)} />

  <section class="py-20 md:py-28 bg-gray-50 dark:bg-slate-800" data-testimonials>
    <div class="max-w-3xl mx-auto px-4 sm:px-6 text-center">
      {/* Label */}
      <p class="text-xs font-semibold uppercase tracking-[0.2em] text-slate-400 dark:text-slate-500 mb-12 flex items-center justify-center gap-2">
        <span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span>
        Témoignages
      </p>

      {/* Carousel */}
      <div class="relative" id="reviews-carousel">
        <div class="overflow-hidden">
          <div class="reviews-track flex transition-transform duration-500 ease-in-out">
            {reviews.map((review, index) => (
              <div class="review-slide w-full flex-shrink-0 px-4" data-index={index}>
                <blockquote class="text-2xl md:text-3xl lg:text-4xl font-bold leading-snug tracking-tight text-slate-900 dark:text-white mb-10">
                  "{review.text}"
                </blockquote>
                <div class="flex items-center justify-center gap-3">
                  <div class="w-11 h-11 rounded-full bg-gradient-to-br from-amber-600 to-amber-400 flex items-center justify-center text-white font-semibold text-sm">
                    {review.author.charAt(0)}
                  </div>
                  <div class="text-left">
                    <p class="font-semibold text-slate-900 dark:text-white text-sm">{review.author}</p>
                    <p class="text-xs text-slate-500 dark:text-slate-400">{review.company}</p>
                  </div>
                </div>
              </div>
            ))}
          </div>
        </div>

        {/* Navigation arrows — centered below */}
        <div class="flex items-center justify-center gap-3 mt-10">
          <button
            type="button"
            class="review-prev w-10 h-10 rounded-lg bg-emerald-800 hover:bg-emerald-700 dark:bg-emerald-700 dark:hover:bg-emerald-600 flex items-center justify-center text-white transition-colors"
            aria-label="Avis précédent"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
            </svg>
          </button>
          <button
            type="button"
            class="review-next w-10 h-10 rounded-lg bg-emerald-800 hover:bg-emerald-700 dark:bg-emerald-700 dark:hover:bg-emerald-600 flex items-center justify-center text-white transition-colors"
            aria-label="Avis suivant"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
            </svg>
          </button>
        </div>
      </div>

      <p class="mt-10 text-sm text-slate-400 dark:text-slate-500">
        5/5 sur
        <a
          href="https://share.google/xsSWlxgBTnkZFTHgU"
          target="_blank"
          rel="noopener noreferrer"
          class="text-emerald-700 hover:text-emerald-600 dark:text-emerald-400 font-medium inline-flex items-center gap-1"
        >
          Google
          <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
        </a>
      </p>
    </div>
  </section>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const carousel = document.getElementById('reviews-carousel');
      if (!carousel) return;

      const track = carousel.querySelector('.reviews-track') as HTMLElement;
      const slides = carousel.querySelectorAll('.review-slide');
      const prevBtn = carousel.querySelector('.review-prev');
      const nextBtn = carousel.querySelector('.review-next');

      let currentIndex = 0;
      const totalSlides = slides.length;

      function updateCarousel() {
        track.style.transform = `translateX(-${currentIndex * 100}%)`;
      }

      prevBtn?.addEventListener('click', () => {
        currentIndex = (currentIndex - 1 + totalSlides) % totalSlides;
        updateCarousel();
      });

      nextBtn?.addEventListener('click', () => {
        currentIndex = (currentIndex + 1) % totalSlides;
        updateCarousel();
      });

      // Auto-play
      setInterval(() => {
        currentIndex = (currentIndex + 1) % totalSlides;
        updateCarousel();
      }, 8000);

      updateCarousel();
    });
  </script>

  <!-- Section Projets — Asymmetric editorial layout -->
  <section class="py-16 md:py-24 bg-white dark:bg-slate-900" data-projects>
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <!-- Header editorial -->
      <div class="mb-14">
        <h2 class="text-4xl md:text-5xl lg:text-6xl font-bold tracking-tight leading-[1.1] font-heading">
          <span class="text-slate-900 dark:text-white">Impact</span><br />
          <span class="text-emerald-700 dark:text-emerald-400">Mesurable.</span>
        </h2>
        <p class="mt-4 text-slate-500 dark:text-slate-400 max-w-md text-base">
          Solutions web haute performance aux résultats concrets.
        </p>
      </div>

      {/* Featured projects — asymmetric grid with Flip swap */}
      <div class="grid grid-cols-1 lg:grid-cols-5 gap-6 mb-8" data-project-grid>
        {/* Featured slot (3/5) */}
        <div class="lg:col-span-3 lg:self-start" data-featured-slot>
          {[{ project: projects[0], screen: RestodomScreen }].map(({ project, screen }) => (
            <article class="group relative bg-gray-50 dark:bg-slate-800 rounded-2xl overflow-hidden border border-gray-100 dark:border-slate-700 hover:shadow-xl transition-shadow duration-300" data-project-card data-flip-id={`project-${project.client}`}>
              <div class="browser-frame bg-gray-100 dark:bg-slate-700 px-4 py-2.5 flex items-center gap-2 border-b border-gray-200 dark:border-slate-600">
                <div class="flex gap-1.5">
                  <span class="w-3 h-3 rounded-full bg-red-400"></span>
                  <span class="w-3 h-3 rounded-full bg-amber-500"></span>
                  <span class="w-3 h-3 rounded-full bg-green-400"></span>
                </div>
                <div class="browser-url flex-1 bg-white dark:bg-slate-600 rounded-md px-3 py-1 text-xs text-gray-400 dark:text-slate-400 truncate ml-2">
                  {project.url.replace('https://', '')}
                </div>
              </div>
              <div class="screenshot-wrap h-64 md:h-80 overflow-hidden">
                <Image src={screen} alt={`Screenshot du site ${project.client}`} class="w-full h-full object-cover object-top" loading="lazy" />
              </div>
              <div class="card-body p-6">
                <div class="flex items-center gap-3 mb-4">
                  <span class="featured-badge text-xs font-semibold uppercase tracking-wider px-2.5 py-1 bg-amber-100 dark:bg-amber-900/40 text-amber-800 dark:text-amber-300 rounded-full">Featured</span>
                  {project.tech.map((t) => (
                    <span class="text-xs px-2 py-1 bg-gray-200 dark:bg-slate-700 text-gray-600 dark:text-gray-300 rounded-md">{t}</span>
                  ))}
                </div>
                <h3 class="card-title text-xl font-bold text-slate-900 dark:text-white mb-1">{project.client}</h3>
                <p class="card-sector text-sm text-slate-500 dark:text-slate-400 mb-2">Secteur : {project.sector}</p>
                <p class="card-offer text-sm text-slate-600 dark:text-slate-300 mb-4">{project.offer}</p>
                <p class="card-metric text-3xl md:text-4xl font-bold text-green-700 dark:text-green-400 leading-tight mb-4" data-project-metric>{project.result}</p>
                <a href={project.url} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 text-sm text-green-700 dark:text-green-400 font-medium hover:underline">
                  Voir le site <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
                </a>
              </div>
            </article>
          ))}
        </div>

        {/* Stack slot (2/5) */}
        <div class="lg:col-span-2 flex flex-col gap-6" data-stack-slot>
          {[{ project: projects[1], screen: OdacioScreen }, { project: projects[2], screen: EkiaScreen }].map(({ project, screen }) => (
            <article class="group cursor-pointer bg-gray-50 dark:bg-slate-800 rounded-2xl overflow-hidden border border-gray-100 dark:border-slate-700 hover:shadow-xl transition-shadow duration-300" data-project-card data-flip-id={`project-${project.client}`}>
              <div class="browser-frame hidden bg-gray-100 dark:bg-slate-700 px-4 py-2.5 flex items-center gap-2 border-b border-gray-200 dark:border-slate-600">
                <div class="flex gap-1.5">
                  <span class="w-3 h-3 rounded-full bg-red-400"></span>
                  <span class="w-3 h-3 rounded-full bg-amber-500"></span>
                  <span class="w-3 h-3 rounded-full bg-green-400"></span>
                </div>
                <div class="browser-url flex-1 bg-white dark:bg-slate-600 rounded-md px-3 py-1 text-xs text-gray-400 dark:text-slate-400 truncate ml-2">
                  {project.url.replace('https://', '')}
                </div>
              </div>
              <div class="screenshot-wrap h-40 md:h-48 overflow-hidden relative">
                <Image src={screen} alt={`Screenshot du site ${project.client}`} class="w-full h-full object-cover object-top group-hover:scale-105 transition-transform duration-500" loading="lazy" />
                {/* Expand hint — desktop only */}
                <div class="expand-hint hidden lg:flex absolute inset-0 bg-black/0 group-hover:bg-black/30 transition-colors duration-300 items-center justify-center">
                  <span class="opacity-0 group-hover:opacity-100 transition-opacity duration-300 bg-white/90 dark:bg-slate-800/90 text-slate-700 dark:text-slate-200 text-xs font-medium px-3 py-1.5 rounded-full backdrop-blur-sm flex items-center gap-1.5">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 8V4m0 0h4M4 4l5 5m11-1V4m0 0h-4m4 0l-5 5M4 16v4m0 0h4m-4 0l5-5m11 5v-4m0 4h-4m4 0l-5-5"/></svg>
                    Voir en détail
                  </span>
                </div>
              </div>
              <div class="card-body p-5">
                <div class="flex items-center gap-2 mb-2">
                  <span class="featured-badge hidden text-xs font-semibold uppercase tracking-wider px-2.5 py-1 bg-amber-100 dark:bg-amber-900/40 text-amber-800 dark:text-amber-300 rounded-full">Featured</span>
                  {project.tech.map((t) => (
                    <span class="text-xs px-2 py-1 bg-gray-200 dark:bg-slate-700 text-gray-600 dark:text-gray-300 rounded-md">{t}</span>
                  ))}
                </div>
                <h3 class="card-title text-lg font-bold text-slate-900 dark:text-white">{project.client}</h3>
                <p class="card-sector text-xs text-slate-500 dark:text-slate-400 mb-2">{project.sector}</p>
                <p class="card-offer hidden text-sm text-slate-600 dark:text-slate-300 mb-4">{project.offer}</p>
                <p class="card-metric text-xl md:text-2xl font-bold text-green-700 dark:text-green-400 leading-tight mb-2" data-project-metric>{project.result}</p>
                <a href={project.url} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 text-sm text-green-700 dark:text-green-400 font-medium hover:underline">
                  Voir le site <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
                </a>
              </div>
            </article>
          ))}
        </div>
      </div>

      {/* Autres réalisations — minimal list */}
      <div class="border-t border-gray-200 dark:border-slate-700 pt-8 mb-10">
        <p class="text-xs font-semibold uppercase tracking-[0.15em] text-slate-400 dark:text-slate-500 mb-6">Autres réalisations</p>
        <div class="space-y-4">
          {projects.slice(3).map((project) => (
            <div class="flex items-center justify-between py-3 border-b border-gray-100 dark:border-slate-800 group" data-project-row>
              <div class="flex items-center gap-6">
                <h4 class="font-bold text-slate-900 dark:text-white min-w-[120px]">{project.client}</h4>
                <span class="text-sm text-slate-500 dark:text-slate-400 hidden md:inline">{project.sector}</span>
                <span class="text-sm font-semibold text-green-700 dark:text-green-400">{project.result}</span>
              </div>
              <div class="flex items-center gap-3">
                <div class="hidden md:flex gap-1.5">
                  {project.tech.map((t) => (
                    <span class="text-xs px-2 py-1 bg-gray-100 dark:bg-slate-800 text-gray-500 dark:text-gray-400 rounded-md">{t}</span>
                  ))}
                </div>
                <a href={project.url} target="_blank" rel="noopener noreferrer" class="w-8 h-8 rounded-full border border-gray-200 dark:border-slate-600 flex items-center justify-center text-slate-400 hover:text-emerald-600 hover:border-emerald-300 transition-colors">
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
                </a>
              </div>
            </div>
          ))}
        </div>
      </div>

      {/* CTA */}
      <div class="text-center">
        <a
          href="tel:+33623565299"
          class="inline-flex items-center gap-2 px-8 py-4 bg-emerald-700 hover:bg-emerald-600 text-white font-semibold rounded-full shadow-lg hover:shadow-xl transition-all duration-300"
          data-magnetic
        >
          Discutons de votre projet
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
          </svg>
        </a>
      </div>
    </div>
  </section>
  <ProjectsFlip />

  <BlogLatestPosts
    title={t('index.blogLatestPosts.title')}
    information={t('index.blogLatestPosts.information')}
