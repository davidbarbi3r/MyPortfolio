  "@type": "LocalBusiness",
  "@id": "https://www.davidbarbier.com/#localbusiness",
  "name": "David Barbier | Création site web et SEO à Ajaccio",
  "image": "https://www.davidbarbier.com/_astro/DSCF7551-3.webp",
  "url": "https://www.davidbarbier.com/",
  "telephone": "+33623565299",
