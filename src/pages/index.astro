    { "@type": "City", "name": "Cannelle" },
    { "@type": "City", "name": "Appietto" },
    { "@type": "City", "name": "Villanova" },
    { "@type": "City", "name": "Casaglione" },
    { "@type": "City", "name": "Calcatoggio" },
    { "@type": "City", "name": "Valle-di-Mezzana" },
    { "@type": "City", "name": "Sarrola-Carcopino" },
    { "@type": "City", "name": "Cuttoli-Corticchiato" },
    { "@type": "City", "name": "Porticcio, Grosseto-Prugna" },
    { "@type": "AdministrativeArea", "name": "Corse" }
  ],
  "sameAs": [
    "https://twitter.com/daviddeveloppe",
    "https://www.linkedin.com/in/dbarbier/",
    "https://www.instagram.com/daviddeveloppe/",
    "https://www.facebook.com/daviddeveloppe",
    "https://www.malt.fr/profile/davidbarbier",
    "https://github.com/davidbarbi3r"
  ],
  "priceRange": "€€"
};

// Avis clients pour le carousel et le schema SEO
const reviews = [
  {
    author: "Matthias",
    company: "Odacio Conseils",
    rating: 5,
    text: "David a réalisé mon site internet et je suis très satisfait du résultat. Il a été à l'écoute, réactif et professionnel tout au long du projet. Il a su comprendre mes attentes et proposer des solutions adaptées. Le suivi est sérieux et il reste disponible quand on a besoin. Vous pouvez lui faire confiance les yeux fermés !"
  },
  {
    author: "Véronique",
    company: "La voie des sens",
    rating: 5,
    text: "David a réalisé un audit de mon site internet dont j'ai fait la réalisation en autonomie de façon un peu « bancale ». David m'a apporté un état des lieux très clair et précis quant à la façon d'améliorer le référencement et la performance. David a apporté aussi du calme, de la douceur et une bonne compréhension globale de mes besoins pour le site. C'est un vrai plus pour moi que de travailler avec un professionnel serein."
  },
  {
    author: "Marta",
    company: "Ekia Advisory",
    rating: 5,
    text: "David m'a accompagné dans la création de mon site internet pour mon cabinet d'expertise-comptable Ekia Advisory. Il est très professionnel, à l'écoute et s'adapte aux attentes du client ! Je recommande vivement !"
  },
  {
    author: "Cédric",
    company: "Restodom",
    rating: 5,
    text: "Je remercie David pour son travail de qualité dans la conception et la réalisation du site internet REST'Ô DOM. Son écoute, et son professionnalisme ont permis la bonne exécution du site. La collaboration se poursuit à l'heure actuelle, car il est SEO également me permettant ainsi de gagner grandement en visibilité grâce à ses compétences."
  },
  {
    author: "Aaron",
    company: "Action Conseils",
    rating: 5,
    text: "Véritable professionnel, réactif, compétent et sympathique ! Je recommande fortement."
  }
];

// Projets récents
const projects = [
  {
    client: "Restodom",
    sector: "Portage de repas",
    offer: "Développement sur mesure + SEO",
    result: "1er sur Google à Bordeaux",
    tech: ["NextJS", "Cloudflare"],
    logo: LogoRestodom,
    url: "https://www.restodom.fr"
  },
  {
    client: "Odacio Conseils",
    sector: "Expert-comptable",
    offer: "Site vitrine performant",
    result: "5 prises de RDV / semaine",
    tech: ["Astro", "Cloudflare"],
    logo: LogoOdacio,
    url: "https://www.odacio-conseils.fr"
  },
  {
    client: "Ekia Advisory",
    sector: "Expert-comptable",
    offer: "Site vitrine performant",
    result: "Site multilingue FR/EN",
    tech: ["Astro", "Cloudflare"],
    logo: LogoAltarys,
    url: "https://www.ekia-advisory.com"
  },
  {
    client: "Endoajaccio",
    sector: "Endodontiste",
    offer: "Développement sur mesure",
    result: "5 nouveaux patients / jour",
    tech: ["NextJS", "AWS"],
    logo: LogoEndoajaccio,
    url: "https://www.endoajaccio.fr"
  },
  {
    client: "Winvias",
    sector: "Gestion de patrimoine",
    offer: "Développement sur mesure",
    result: "IA cadrage prospect 24h/24",
    tech: ["React Router v7", "Google Cloud"],
    logo: null,
    url: "https://www.winvias.com"
  },
  {
    client: "Cabinet Altarys",
    sector: "Expert-comptable",
    offer: "Site vitrine performant",
    result: "Site professionnel moderne",
    tech: ["Astro", "Cloudflare"],
    logo: LogoAltarys,
    url: "https://www.cabinet-altarys.fr"
  }
];

// Schema AggregateRating + Reviews pour SEO
const reviewsSchema = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "@id": "https://www.davidbarbier.com/#localbusiness",
  "name": "David Barbier | Création site web et SEO à Ajaccio",
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "5",
    "reviewCount": "11",
    "bestRating": "5",
    "worstRating": "1"
  },
  "review": reviews.map(r => ({
    "@type": "Review",
    "author": {
      "@type": "Person",
      "name": r.author
    },
    "reviewRating": {
      "@type": "Rating",
      "ratingValue": r.rating.toString(),
      "bestRating": "5",
      "worstRating": "1"
    },
    "reviewBody": r.text
  }))
};
---

<Layout metadata={metadata}>
  <!-- Sticky CTA Desktop -->
  <div class="hidden md:block fixed bottom-0 bg-green-50 dark:bg-green-950 w-full z-[9999]">
    <div class="max-w-7xl mx-auto px-6 py-4 sm:px-8">
      <div class="flex items-center justify-center gap-4">
        Une question ? Vous souhaitez en savoir plus ? <a
        href="tel:0623565299"
        class="text-green-800 dark:text-green-300 font-semibold">06 23 56 52 99</a>
      </div>
    </div>
  </div>

  <!-- Sticky CTA Mobile (floating button) -->
  <a
    href="tel:0623565299"
    class="md:hidden fixed bottom-6 right-6 z-[9999] bg-emerald-600 hover:bg-emerald-700 text-white p-4 rounded-full shadow-lg hover:shadow-xl transition-all duration-300"
    aria-label="Appeler"
  >
    <Icon name="tabler:phone" class="w-6 h-6" />
  </a>

  <!-- JSON-LD LocalBusiness Schema -->
  <script is:inline type="application/ld+json" set:html={JSON.stringify(localBusinessSchema)} />

  <!-- Hero2 Widget ******************* -->

  <!--hero-->
  <Hero2
    tagline="David Barbier | Ajaccio"
    callToAction={{ text: t('portfolio.bookCall'), href: '/contact/', icon: 'tabler:phone' }}
    image={{
      src: HeroImage,
      alt: locale === 'en' ? "David Barbier's freelance web developer portrait sitting on a chair and smiling" : "Portrait de David Barbier consultant SEO et sites internet assis sur une chaise et souriant",
    }}
  >
    <Fragment slot="title">
      <span class="text-transparent bg-gradient-to-r from-emerald-800 to-emerald-600 bg-clip-text dark:text-white highlight">{t("portfolio.heroSide.accent")}</span><br />
      {t('portfolio.heroSide.title')}
    </Fragment>

    <Fragment slot="subtitle">
      <span class="hidden sm:inline">
      </span>
      {t('portfolio.heroSide.subtitle')}
    </Fragment>

    <Fragment slot="content">
      <div class="grid grid-cols-3 gap-4 md:gap-8 mt-8 pt-6 border-t border-gray-200 dark:border-gray-700">
        <div class="text-center">
          <p class="text-2xl md:text-3xl font-bold text-green-700 dark:text-green-400">+30</p>
          <p class="text-xs text-gray-600 dark:text-gray-400 mt-1">clients accompagnés</p>
        </div>
        <div class="text-center">
          <p class="text-2xl md:text-3xl font-bold text-green-700 dark:text-green-400">+5 ans</p>
          <p class="text-xs text-gray-600 dark:text-gray-400 mt-1">d'expérience</p>
        </div>
        <div class="text-center">
          <div class="flex items-center justify-center gap-1">
            <p class="text-2xl md:text-3xl font-bold text-green-700 dark:text-green-400">5/5</p>
            <svg class="w-5 h-5 text-yellow-400" fill="currentColor" viewBox="0 0 20 20">
              <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
            </svg>
          </div>
          <p class="text-xs text-gray-600 dark:text-gray-400 mt-1">sur Google</p>
        </div>
      </div>
    </Fragment>
  </Hero2>

  <!-- Logo Marquee -->
  <LogoMarquee
    logos={[
      { src: LogoEndoajaccio, alt: "Endoajaccio", scale: 1.3 },
      { src: LogoRestodom, alt: "Restodom" },
      { src: LogoMobincub, alt: "Mobincub" },
      { src: LogoJeuxOriginaux, alt: "Jeux Originaux" },
      { src: LogoAltarys, alt: "Cabinet Altarys", scale: 0.75 },
      { src: LogoOdacio, alt: "Odacio Conseils" },
      { src: LogoEchinard, alt: "Cabinet Echinard", scale: 0.75 },
      { src: LogoPizzaCarmes, alt: "Pizza Carmes", scale: 0.75 },
      { src: LogoAurarios, alt: "Aurarios", scale: 1.3 },
      { src: LogoLeadauco, alt: "Leadauco", scale: 1.3 },
    ]}
    speed={30}
  />

  <!--services-->
  
  <Features2
    title={t('portfolio.services.title')}
    subtitle={t('portfolio.services.subtitle')}
    columns={3}
    items={[
      {
        title: tList('portfolio.services.servicesItems')[0].title,
        description: tList('portfolio.services.servicesItems')[0].description,
        servicesItems: tList('portfolio.services.servicesItems')[0].items,
        price: tList('portfolio.services.servicesItems')[0].price,
        image: {
          ...Fidenza117,
          alt: locale === 'en' ? 'Green illustration of a fidenza NFT for website creation service' : 'Illustration verte d\'un NFT fidenza pour le service de création de site web',
        },
        icon: 'tabler:devices',
                 callToAction: {
           text: "Site web Wordpress Ajaccio",
           href: '/creation-site-internet-ajaccio/',
           icon: 'tabler:chevron-right',
         },
        ecLink: {
          text: "Expert-comptable ? Site vitrine dédié EC",
          href: '/agence-web-expert-comptable/creation-site-vitrine-ec/',
        },

      },
      {
        title: tList('portfolio.services.servicesItems')[1].title,
        description: tList('portfolio.services.servicesItems')[1].description,
        servicesItems: tList('portfolio.services.servicesItems')[1].items,
        price: tList('portfolio.services.servicesItems')[1].price,
        image: {
          ...Fidenza262,
          alt: locale === 'en' ? 'Green illustration of a fidenza NFT for custom feature development service' : 'Illustration verte d\'un NFT fidenza pour le service de développement de fonctionnalités personnalisées',
        },
        icon: 'tabler:wand',
        ecLink: {
          text: "Expert-comptable ? Développeur spécialisé EC",
          href: '/agence-web-expert-comptable/developpeur-specialise/',
        },
      },
      {
        title: tList('portfolio.services.servicesItems')[2].title,
        description: tList('portfolio.services.servicesItems')[2].description,
        servicesItems: tList('portfolio.services.servicesItems')[2].items,
        price: tList('portfolio.services.servicesItems')[2].price,
        image: {
          ...Fidenza2,
          alt: locale === 'en' ? 'Green illustration of a fidenza NFT for maintenance service' : 'Illustration verte d\'un NFT fidenza pour le service de maintenance de site web',
        },
        icon: 'tabler:tool',
        callToAction: {
          text: "Entretenez votre site",
          href: '/#',
          icon: 'tabler:chevron-right',
        },
        ecLink: {
          text: "Expert-comptable ? Refonte de votre site cabinet",
          href: '/agence-web-expert-comptable/refonte-site-internet/',
        },
      },
      {
        title: tList('portfolio.services.servicesItems')[3].title,
        description: tList('portfolio.services.servicesItems')[3].description,
        servicesItems: tList('portfolio.services.servicesItems')[3].items,
        price: tList('portfolio.services.servicesItems')[3].price,
        image: {
          ...Fidenza117,
          alt: locale === 'en' ? 'Green illustration of a fidenza NFT for maintenance service' : 'Illustration verte d\'un NFT fidenza pour le service de maintenance de site web',
        },
        icon: 'tabler:tool',
        callToAction2: {
          text: "Référencement en Corse",
          href: '/consultant-seo-ajaccio/',
          icon: 'tabler:chevron-right',
        },
        ecLink: {
          text: "Expert-comptable ? SEO spécialisé cabinet",
          href: '/agence-web-expert-comptable/consultant-seo-ec/',
        },
      },
    ]}
  />

  <!-- Bandeau Expert-Comptable (pont vers page dédiée) -->
  <section class="py-6 bg-gradient-to-r from-green-800 to-green-700 dark:from-green-900 dark:to-green-800">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <div class="flex flex-col sm:flex-row items-center justify-between gap-4">
        <div class="flex items-center gap-3 text-white">
          <span class="hidden sm:inline-flex items-center justify-center w-10 h-10 rounded-full bg-white/20">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
              <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
            </svg>
          </span>
          <p class="text-center sm:text-left">
            <span class="font-semibold">Vous êtes Expert-Comptable ?</span>
            <span class="hidden md:inline text-green-100"> — Ancien EC mémorialiste, j'ai des offres dédiées à votre profession.</span>
          </p>
        </div>
        <a
          href="/agence-web-expert-comptable/"
          class="inline-flex items-center gap-2 px-5 py-2.5 bg-white text-green-800 font-semibold rounded-full hover:bg-green-50 transition-colors shadow-md whitespace-nowrap"
        >
          Découvrir mes offres EC
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- Section Avis Google - Schema SEO -->
  <script is:inline type="application/ld+json" set:html={JSON.stringify(reviewsSchema)} />

  <section class="py-12 md:py-16 bg-gray-50 dark:bg-slate-800">
    <div class="max-w-4xl mx-auto px-4 sm:px-6">
      <div class="text-center mb-8">
        <h2 class="text-2xl font-bold tracking-tight text-gray-900 dark:text-white sm:text-3xl mb-2">
          Ce que disent mes clients
        </h2>
        <div class="flex items-center justify-center gap-1 mb-2">
          {[1,2,3,4,5].map(() => (
            <svg class="w-5 h-5 text-yellow-400" fill="currentColor" viewBox="0 0 20 20">
              <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
            </svg>
          ))}
          <span class="ml-2 text-sm text-gray-600 dark:text-gray-400">5/5 basé sur 9 avis Google</span>
        </div>
      </div>

      <!-- Carousel Container -->
      <div class="relative" id="reviews-carousel">
        <!-- Review Cards -->
        <div class="overflow-hidden">
          <div class="reviews-track flex transition-transform duration-500 ease-in-out">
            {reviews.map((review, index) => (
              <div class="review-slide w-full flex-shrink-0 px-4" data-index={index}>
                <div class="bg-white dark:bg-slate-900 rounded-2xl shadow-lg p-8 max-w-2xl mx-auto">
                  <div class="flex items-center gap-1 mb-4">
                    {[1,2,3,4,5].map(() => (
                      <svg class="w-4 h-4 text-yellow-400" fill="currentColor" viewBox="0 0 20 20">
                        <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                      </svg>
                    ))}
                  </div>
                  <blockquote class="text-gray-700 dark:text-gray-300 text-lg leading-relaxed mb-6">
                    "{review.text}"
                  </blockquote>
                  <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-full bg-green-700 flex items-center justify-center text-white font-semibold">
                      {review.author.charAt(0)}
                    </div>
                    <div>
                      <p class="font-semibold text-gray-900 dark:text-white">{review.author}</p>
                      <p class="text-sm text-gray-500 dark:text-gray-400">{review.company}</p>
                    </div>
                  </div>
                </div>
              </div>
            ))}
          </div>
        </div>

        <!-- Navigation Arrows -->
        <button
          type="button"
          class="review-prev absolute left-0 top-1/2 -translate-y-1/2 -translate-x-2 md:-translate-x-6 w-10 h-10 md:w-12 md:h-12 bg-white dark:bg-slate-700 rounded-full shadow-lg flex items-center justify-center text-gray-600 dark:text-gray-300 hover:bg-gray-50 dark:hover:bg-slate-600 transition-colors z-10"
          aria-label="Avis précédent"
        >
          <svg class="w-5 h-5 md:w-6 md:h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
          </svg>
        </button>
        <button
          type="button"
          class="review-next absolute right-0 top-1/2 -translate-y-1/2 translate-x-2 md:translate-x-6 w-10 h-10 md:w-12 md:h-12 bg-white dark:bg-slate-700 rounded-full shadow-lg flex items-center justify-center text-gray-600 dark:text-gray-300 hover:bg-gray-50 dark:hover:bg-slate-600 transition-colors z-10"
          aria-label="Avis suivant"
        >
          <svg class="w-5 h-5 md:w-6 md:h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
          </svg>
        </button>

        <!-- Dots Indicator -->
