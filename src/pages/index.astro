---
import {useTranslations} from "~/i18n/translator";
import Layout from '~/layouts/PageLayout.astro';
import { Image } from 'astro:assets';
import HeroImage from '~/assets/images/barbicaja-ajaccio-sanguinaires.jpeg'
import ServiceCreation from '~/assets/images/service-creation.jpg'
import ServiceSeo from '~/assets/images/service-seo.jpg'
import CorseParata from '~/assets/images/corse-parata-sanguinaires.jpg'
import CorseBonifacio from '~/assets/images/corse-bonifacio-citadelle.jpg'
import CorseFalaises from '~/assets/images/corse-falaises-bonifacio.jpg'
import CorseGolfePorto from '~/assets/images/corse-golfe-porto.jpg'
import RestodomScreen from '~/assets/images/restodom-screen.png';
import OdacioScreen from '~/assets/images/odacio-screen.png';
import EkiaScreen from '~/assets/images/ekia-screen.png';
import HeroAnimations from '~/components/animations/HeroAnimations.astro';
import ProjectsFlip from '~/components/animations/ProjectsFlip.astro';
import MontegrappaFx from '~/components/animations/MontegrappaFx.astro';
import PillBadge from '~/components/ui/PillBadge.astro';
import StatBig from '~/components/ui/StatBig.astro';
import SectionHeader from '~/components/ui/SectionHeader.astro';
import CheckList from '~/components/ui/CheckList.astro';
import ArrowLink from '~/components/ui/ArrowLink.astro';
import ArrowRight from '~/components/ui/ArrowRight.astro';
import FaqItems from '~/components/ui/FaqItems.astro';
import ImageStrip from '~/components/widgets/ImageStrip.astro';
import CardSlider from '~/components/widgets/CardSlider.astro';
import ProjectCard from '~/components/widgets/ProjectCard.astro';
import LogoMarquee from "~/components/widgets/LogoMarquee.astro";
import ServicesShowcase from '~/components/widgets/ServicesShowcase.astro';
import BlogLatestPosts from "~/components/widgets/BlogLatestPosts.astro";

// Imports logos clients
import LogoEndoajaccio from '~/assets/images/clients/endoajaccio.png';
import LogoRestodom from '~/assets/images/clients/restodom.svg';
import LogoMobincub from '~/assets/images/clients/mobincub.png';
import LogoJeuxOriginaux from '~/assets/images/clients/jeux-originaux.webp';
import LogoAltarys from '~/assets/images/clients/altarys.svg';
import LogoOdacio from '~/assets/images/clients/conseils.svg';
import LogoEchinard from '~/assets/images/clients/echinard.png';
import LogoPizzaCarmes from '~/assets/images/clients/pizza-carmes.webp';
import LogoAurarios from '~/assets/images/clients/aurarios.png';
import LogoLeadauco from '~/assets/images/clients/leadauco.png';

import { REVIEWS as reviews, aggregateRatingSchema } from '~/utils/reviews';
import { BUSINESS_NAME } from '~/utils/business-schema';

const locale = Astro.currentLocale ?? 'fr'
const { t } = useTranslations(locale);
// La home porte « Développeur freelance à Ajaccio : sites, SEO, sur-mesure ».
// La requête création vit sur /creation-site-internet-ajaccio/.
// Le nom commercial du schema reste BUSINESS_NAME.
const metadata = {
  title: 'Développeur freelance à Ajaccio : sites, SEO, sur-mesure | David Barbier',
  description:
    "David Barbier, développeur freelance à Ajaccio. Sites, SEO et sur-mesure, en direct. Devis sous 48 h.",
  openGraph: {
    title: 'Développeur freelance à Ajaccio : sites, SEO, sur-mesure | David Barbier',
    description:
      "David Barbier, développeur freelance à Ajaccio. Sites, SEO et sur-mesure, en direct. Devis sous 48 h.",
  },
  lang: locale,
};

// JSON-LD LocalBusiness schema - Ajaccio (localisation principale)
const socialProfiles = [
  "https://twitter.com/daviddeveloppe",
  "https://www.linkedin.com/in/dbarbier/",
  "https://www.instagram.com/daviddeveloppe/",
  "https://www.facebook.com/daviddeveloppe",
  "https://www.malt.fr/profile/davidbarbier",
  "https://github.com/davidbarbi3r"
];

const localBusinessSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "LocalBusiness",
      "@id": "https://www.davidbarbier.com/#localbusiness",
      "name": BUSINESS_NAME,
      "image": "https://www.davidbarbier.com/david-barbier-consultant-seo-ajaccio.jpg",
      "url": "https://www.davidbarbier.com/",
      "founder": { "@id": "https://www.davidbarbier.com/#person" },
      "telephone": "+33623565299",
      "email": "hello@davidbarbier.com",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "13 Bd Sampiero",
        "addressLocality": "Ajaccio",
        "postalCode": "20000",
        "addressRegion": "Corse",
        "addressCountry": "FR"
      },
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": 41.9192043,
        "longitude": 8.7386439
      },
      "openingHoursSpecification": {
        "@type": "OpeningHoursSpecification",
        "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"],
        "opens": "08:00",
        "closes": "20:00"
      },
      "areaServed": [
        { "@type": "City", "name": "Ajaccio" },
        { "@type": "City", "name": "Mezzavia" },
        { "@type": "City", "name": "Afa" },
        { "@type": "City", "name": "Cauro" },
        { "@type": "City", "name": "Alata" },
        { "@type": "City", "name": "Bastelicaccia" },
        { "@type": "City", "name": "Cannelle" },
        { "@type": "City", "name": "Appietto" },
        { "@type": "City", "name": "Villanova" },
        { "@type": "City", "name": "Casaglione" },
        { "@type": "City", "name": "Calcatoggio" },
        { "@type": "City", "name": "Valle-di-Mezzana" },
        { "@type": "City", "name": "Sarrola-Carcopino" },
        { "@type": "City", "name": "Cuttoli-Corticchiato" },
        { "@type": "City", "name": "Porticcio, Grosseto-Prugna" },
        { "@type": "AdministrativeArea", "name": "Corse" }
      ],
      "sameAs": socialProfiles,
      "priceRange": "€€",
      "aggregateRating": aggregateRatingSchema,
      "review": reviews.map(r => ({
        "@type": "Review",
        "author": {
          "@type": "Person",
          "name": r.author
        },
        "reviewRating": {
          "@type": "Rating",
          "ratingValue": r.rating.toString(),
          "bestRating": "5",
          "worstRating": "1"
        },
        "reviewBody": r.text
      }))
    },
    {
      "@type": "Person",
      "@id": "https://www.davidbarbier.com/#person",
      "name": "David Barbier",
      "url": "https://www.davidbarbier.com/",
      "image": "https://www.davidbarbier.com/david-barbier-consultant-seo-ajaccio.jpg",
      "jobTitle": "Développeur freelance à Ajaccio",
      "telephone": "+33623565299",
      "email": "hello@davidbarbier.com",
      "worksFor": { "@id": "https://www.davidbarbier.com/#localbusiness" },
      "sameAs": socialProfiles
    }
  ]
};

// Avis clients : importés depuis ~/utils/reviews (source unique de vérité)

// FAQ. Source unique : elle alimente à la fois l'affichage et le balisage FAQPage,
// pour qu'ils ne puissent pas diverger.
const HOME_FAQ = [
  {
    q: 'Vous êtes vraiment basé à Ajaccio ?',
    a: "Oui, j'y vis et j'y travaille. Si vous êtes sur place, on peut se voir pour le premier rendez-vous. Sinon tout se passe en visio, partout en France.",
  },
  {
    q: 'Vous créez les sites vous-même ?',
    a: 'Oui. La <a href="/creation-site-internet-ajaccio/">création de site internet à Ajaccio</a> est détaillée à part. Le <a href="/referencement-seo-ajaccio/">référencement naturel</a> et la <a href="/maintenance-site-internet-ajaccio/">maintenance</a> aussi.',
  },
];

const faqStructuredData = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: HOME_FAQ.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
};

// Projets récents
const projects = [
  {
    client: "Restodom",
    sector: "Portage de repas",
    offer: "Développement sur mesure + SEO",
    result: "1er sur Google à Bordeaux",
    tech: ["NextJS", "Cloudflare"],
    logo: LogoRestodom,
    url: "https://www.restodom.fr"
  },
  {
    client: "Odacio Conseils",
    sector: "Expert-comptable",
    offer: "Site vitrine performant",
    result: "5 prises de RDV / semaine",
    tech: ["Astro", "Cloudflare"],
    logo: LogoOdacio,
    url: "https://www.odacio-conseils.fr"
  },
  {
    client: "Ekia Advisory",
    sector: "Expert-comptable",
    offer: "Site vitrine performant",
    result: "Site multilingue FR/EN",
    tech: ["Astro", "Cloudflare"],
    logo: LogoAltarys,
    url: "https://www.ekia-advisory.com"
  },
  {
    client: "Endoajaccio",
    sector: "Endodontiste",
    offer: "Développement sur mesure",
    result: "5 nouveaux patients / jour",
    tech: ["NextJS", "AWS"],
    logo: LogoEndoajaccio,
    url: "https://www.endoajaccio.fr"
  },
  {
    client: "Winvias",
    sector: "Gestion de patrimoine",
    offer: "Développement sur mesure",
    result: "IA cadrage prospect 24h/24",
    tech: ["React Router v7", "Google Cloud"],
    logo: null,
    url: "https://www.winvias.com"
  },
  {
    client: "Cabinet Altarys",
    sector: "Expert-comptable",
    offer: "Site vitrine performant",
    result: "Site professionnel moderne",
    tech: ["Astro", "Cloudflare"],
    logo: LogoAltarys,
    url: "https://www.cabinet-altarys.fr"
  }
];

---

<Layout metadata={metadata}>
  <!-- JSON-LD LocalBusiness Schema -->
  <script is:inline type="application/ld+json" set:html={JSON.stringify(localBusinessSchema)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqStructuredData)} />

  <!--hero-->
  <section class="relative bg-cream pt-16 md:pt-24 pb-12 overflow-hidden" data-hero>
    <div class="max-w-5xl mx-auto px-4 sm:px-6 text-center">
      <p class="mb-8" data-hero-tagline><PillBadge text="David Barbier · Freelance, ancien auditeur EC" /></p>
      <h1 class="text-charcoal text-[clamp(2.2rem,4.5vw,4.25rem)] leading-[1.05]" data-hero-title>
        Développeur freelance à Ajaccio : sites, SEO, sur-mesure
      </h1>
      <p class="mt-6 text-lg text-muted max-w-2xl mx-auto leading-relaxed" data-hero-subtitle>
        Je conçois les sites et le référencement des TPE, en direct. Je commence par votre métier, votre histoire, vos valeurs.
      </p>
      <div class="mt-10 flex flex-col items-center gap-5" data-hero-cta>
        <a href="tel:+33623565299" class="btn btn-primary">
          {t('portfolio.bookCall')}
        </a>
        <a href="/creation-site-internet-ajaccio/" class="font-medium text-sage-dark hover:underline">
          Création de site internet à Ajaccio
        </a>
      </div>
    </div>
    <div class="mt-16">
      <ImageStrip
        images={[
          { src: HeroImage, alt: "Plage de Barbicaja sur la route des Sanguinaires, près d'Ajaccio en Corse" },
          { src: CorseParata, alt: "La tour génoise de la Parata face aux îles Sanguinaires, à Ajaccio" },
          { src: ServiceSeo, alt: 'Texture de lumière à travers le feuillage pour le service SEO' },
          { src: CorseBonifacio, alt: 'La citadelle de Bonifacio au crépuscule, en Corse-du-Sud' },
          { src: CorseFalaises, alt: 'Les falaises calcaires de Bonifacio et leur eau turquoise, en Corse' },
        ]}
      />
    </div>
  </section>
  <HeroAnimations />
  <MontegrappaFx />

  <!--bande stats-->
  <section class="bg-cream py-14 md:py-20">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 grid grid-cols-1 sm:grid-cols-3 gap-10">
      <StatBig value="+50" label="clients accompagnés" />
      <StatBig value="+5" label="ans d'expérience" />
      <StatBig value="5/5" label="étoiles sur Google" />
    </div>
  </section>

  <!-- Logo Marquee -->
  <LogoMarquee
    logos={[
      { src: LogoEndoajaccio, alt: "Endoajaccio", scale: 1.3 },
      { src: LogoRestodom, alt: "Restodom" },
      { src: LogoMobincub, alt: "Mobincub" },
      { src: LogoJeuxOriginaux, alt: "Jeux Originaux" },
      { src: LogoAltarys, alt: "Cabinet Altarys", scale: 0.75 },
      { src: LogoOdacio, alt: "Odacio Conseils" },
      { src: LogoEchinard, alt: "Cabinet Echinard", scale: 0.75 },
      { src: LogoPizzaCarmes, alt: "Pizza Carmes", scale: 0.75 },
      { src: LogoAurarios, alt: "Aurarios", scale: 1.3 },
      { src: LogoLeadauco, alt: "Leadauco", scale: 1.3 },
    ]}
    speed={30}
  />

  <ServicesShowcase
    badge="Services"
    title="Sites et référencement"
    subtitle="Deux portes. Le détail est sur chaque page."
    items={[
      {
        title: 'Création / refonte de site',
        description: 'Vitrine, one page, boutique, ou un site à reprendre.',
        image: ServiceCreation,
        alt: "Texture abstraite d'ondulations, évoquant la création de sites internet",
        links: [{ text: 'Voir les offres', href: '/creation-site-internet-ajaccio/' }],
      },
      {
        title: 'Référencement & suivi',
        description: 'Être trouvé sur Google, puis tenir le cap.',
        image: ServiceSeo,
        alt: 'Texture de lumière à travers le feuillage, évoquant le référencement SEO',
        links: [{ text: "Voir l'accompagnement", href: '/referencement-seo-ajaccio/' }],
      },
    ]}
  />

  <!-- Bandeau Expert-Comptable (pont vers page dédiée) -->
  <section class="py-6 bg-sage">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <div class="flex flex-col sm:flex-row items-center justify-between gap-4">
        <div class="flex items-center gap-3 text-white">
          <span class="hidden sm:inline-flex items-center justify-center w-10 h-10 rounded-full bg-white/20">
            <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/>
            </svg>
          </span>
          <p class="text-center sm:text-left">
            <span class="font-semibold">Vous êtes Expert-Comptable ?</span>
            <span class="hidden md:inline text-white/80"> - Ancien EC mémorialiste, j'ai des offres dédiées à votre profession.</span>
          </p>
        </div>
        <a href="/experts-comptables/" class="btn btn-cream gap-2 whitespace-nowrap">
          Découvrir mes offres EC
          <ArrowRight class="w-4 h-4" />
        </a>
      </div>
    </div>
  </section>

  <!-- Freelance vs agence - version compacte -->
  <section class="py-16 md:py-24 px-6 lg:px-8 bg-sand">
    <div class="mx-auto max-w-5xl">
      <SectionHeader
        kicker="Agence vs freelance - le vrai débat"
        subtitle="Solo sur l'opérationnel vous parlez à celui qui exécute. Quand un projet demande des compétences qui me manquent, j'active un réseau de freelances seniors. Pas de stagiaire, pas de sous traitance à l'étranger."
        class="mb-10"
      >
        Ma vision : freelance avec <span class="text-sage-dark">la fiabilité d'une agence</span>
      </SectionHeader>

      <div class="grid md:grid-cols-2 gap-6">
        <div class="rounded-xl border border-black/10 bg-cream p-6">
          <p class="text-sm font-semibold uppercase tracking-wide text-muted mb-3">Agence classique</p>
          <h3 class="text-lg font-bold text-charcoal mb-4">Vous payez la structure</h3>
          <CheckList
            mark="✕"
            markClass="text-charcoal/40"
            items={[
              "Commercial qui prend soin de vous jusqu'à la signature",
              'Dossier transféré ensuite à un junior',
              'Tarif gonflé pour financer locaux et marges',
              'Reporting cosmétique pour justifier la facture',
            ]}
          />
        </div>

        <div class="rounded-xl bg-sage p-6">
          <p class="text-sm font-semibold uppercase tracking-wide text-white/80 mb-3">Freelance + collectif</p>
          <h3 class="text-lg font-bold text-white mb-4">Vous payez l'expertise</h3>
          <CheckList
            markClass="text-white"
            textClass="text-white"
            items={[
              'Vous parlez directement à celui qui exécute',
              "Senior sur la stratégie ET sur l'exécution",
              'Tarif 30 à 50% sous une agence équivalente',
              'Reporting clair, chiffres vérifiables côté client',
            ]}
          />
        </div>
      </div>

      <div class="mt-10 text-center">
        <ArrowLink href="/referencement-seo-ajaccio/" text="En savoir plus sur l'accompagnement SEO" />
      </div>
    </div>
  </section>

  <!-- Section Avis Google - layout Montegrappa : titre à gauche, flèches à droite, cartes en défilement horizontal -->
  <section class="py-20 md:py-28 bg-cream overflow-hidden">
    <CardSlider prevLabel="Avis précédent" nextLabel="Avis suivant">
      <Fragment slot="header">
        <div class="max-w-2xl">
          <SectionHeader
            align="left"
            kicker="Témoignages"
            subtitle="Je ne livre pas tant que vous n'êtes pas satisfait."
          >
            100% de clients <span class="text-sage-dark">satisfaits</span>
          </SectionHeader>
        </div>
      </Fragment>

      {reviews.map((review, index) => (
        <figure
          class:list={[
            'snap-start flex-none w-[85%] sm:w-[400px] rounded-xl p-8 flex flex-col justify-between',
            index % 2 === 1 ? 'bg-sage text-white' : 'bg-white/60 border border-black/10 text-charcoal',
          ]}
        >
          <blockquote>
            <span class:list={['block text-5xl leading-none mb-4 font-serif', index % 2 === 1 ? 'text-white/60' : 'text-sage']} aria-hidden="true">"</span>
            <p class:list={['text-base leading-relaxed', index % 2 === 1 ? 'text-white/95' : 'text-default']}>{review.text}</p>
          </blockquote>
          <figcaption class="flex items-center gap-3 mt-8">
            <div class:list={['w-11 h-11 rounded-full flex items-center justify-center font-semibold text-sm', index % 2 === 1 ? 'bg-white/20 text-white' : 'bg-sage text-white']}>
              {review.author.charAt(0)}
            </div>
            <div class="text-left">
              <p class:list={['font-semibold text-sm', index % 2 === 1 ? 'text-white' : 'text-charcoal']}>{review.author}</p>
              <p class:list={['text-xs', index % 2 === 1 ? 'text-white/70' : 'text-muted']}>{review.company}</p>
            </div>
          </figcaption>
        </figure>
      ))}
    </CardSlider>

    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <p class="mt-8 text-sm text-muted">
        5/5 sur
        <a
          href="https://share.google/xsSWlxgBTnkZFTHgU"
          target="_blank"
          rel="noopener noreferrer"
          class="text-sage-dark hover:text-charcoal font-medium inline-flex items-center gap-1"
        >
          Google
          <ArrowRight class="w-3 h-3" />
        </a>
      </p>
    </div>
  </section>

  <!-- Section Projets - Asymmetric editorial layout -->
  <section class="py-16 md:py-24 bg-cream" data-projects>
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <!-- Header editorial -->
      <div class="mb-14">
        <h2 class="text-4xl md:text-5xl lg:text-6xl font-bold tracking-tight leading-[1.1] font-heading">
          <span class="text-charcoal">Mon portfolio de projets</span><br />
          <span class="text-sage-dark">à Ajaccio, en Corse et sur le continent</span>
        </h2>
        <p class="mt-4 text-muted max-w-md text-base">
          Solutions web haute performance aux résultats concrets.
        </p>
        <ArrowLink href="/realisations/" text="Voir les études de cas" class="mt-6" />
      </div>

      {/* Featured projects - asymmetric grid with Flip swap */}
      <div class="grid grid-cols-1 lg:grid-cols-5 gap-6 mb-8" data-project-grid>
        {/* Featured slot (3/5) */}
        <div class="lg:col-span-3 lg:self-start" data-featured-slot>
          <ProjectCard project={projects[0]} screen={RestodomScreen} variant="featured" />
        </div>

        {/* Stack slot (2/5) */}
        <div class="lg:col-span-2 flex flex-col gap-6" data-stack-slot>
          <ProjectCard project={projects[1]} screen={OdacioScreen} />
          <ProjectCard project={projects[2]} screen={EkiaScreen} />
        </div>
      </div>

      {/* Autres réalisations - minimal list */}
      <div class="border-t border-black/10 pt-8 mb-10">
        <p class="text-xs font-semibold uppercase tracking-[0.15em] text-muted mb-6">Autres réalisations</p>
        <div class="space-y-4">
          {projects.slice(3).map((project) => (
            <div class="flex items-center justify-between py-3 border-b border-black/5 group" data-project-row>
              <div class="flex items-center gap-6">
                <h4 class="font-bold text-charcoal min-w-[120px]">{project.client}</h4>
                <span class="text-sm text-muted hidden md:inline">{project.sector}</span>
                <span class="text-sm font-semibold text-sage-dark">{project.result}</span>
              </div>
              <div class="flex items-center gap-3">
                <div class="hidden md:flex gap-1.5">
                  {project.tech.map((t) => (
                    <span class="text-xs px-2 py-1 bg-sand text-muted rounded-md">{t}</span>
                  ))}
                </div>
                <a href={project.url} target="_blank" rel="noopener noreferrer" class="w-8 h-8 rounded-full border border-black/15 flex items-center justify-center text-muted hover:text-sage-dark hover:border-sage transition-colors">
                  <ArrowRight class="w-3.5 h-3.5" />
                </a>
              </div>
            </div>
          ))}
        </div>
      </div>

      {/* CTA */}
      <div class="text-center">
        <a href="tel:+33623565299" class="btn btn-primary gap-2" data-magnetic>
          Discutons de votre projet
          <ArrowRight class="w-5 h-5" />
        </a>
      </div>
    </div>
  </section>
  <ProjectsFlip />

  <section id="faq" class="py-16 md:py-24 px-6 lg:px-8 bg-cream scroll-mt-20">
    <div class="mx-auto max-w-3xl mb-12">
      <SectionHeader kicker="FAQ" kickerVariant="pill">
        Les questions qu'on me pose souvent
      </SectionHeader>
    </div>

    <FaqItems items={HOME_FAQ} class="mx-auto max-w-6xl" />
  </section>

  <BlogLatestPosts
    title={t('index.blogLatestPosts.title')}
    information={t('index.blogLatestPosts.information')}
    linkText={t('index.blogLatestPosts.linkText')}
    count={3}
  />
  
