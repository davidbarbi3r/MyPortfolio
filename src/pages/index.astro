---
import {useTranslations} from "~/i18n/translator";
import Layout from '~/layouts/PageLayout.astro';
import HeroImage from '~/assets/images/DSCF7551-3.jpg'
import Fidenza2 from '~/assets/images/000002fidenzaPP.png'
import Fidenza117 from '~/assets/images/000117fidenzaPP.png'
import Fidenza262 from '~/assets/images/000262fidenzaPP.png'
import RestodomMock from '~/assets/images/restodommock.jpg'
import Matchings from '~/assets/images/agilytic.jpeg'
import Hero2 from '~/components/widgets/Hero2.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import Content from '~/components/widgets/Content.astro';
import Features2 from "~/components/widgets/Features2.astro";
import Logos from "~/components/widgets/Logos.astro";
import BlogLatestPosts from "~/components/widgets/BlogLatestPosts.astro";

const locale = Astro.currentLocale ?? 'fr'
const { t, tList } = useTranslations(locale);
const metadata = {
  description: locale === "en" ? 
  'Freelance web developer specialized in eco-friendly website creation, website redesign and local SEO in Limoges, Ajaccio and remotely.' : 
  "Consultant SEO & Création de site web. La rigueur d'un ex-auditeur financier au service de votre digital. Des solutions techniques fiables et performantes.",
  lang: locale,
};
---

<Layout metadata={metadata}>
  <!-- Hero2 Widget ******************* -->

  <!--hero-->
  <Hero2
    tagline="David Barbier | David Développe"
    callToAction={{ text: t('portfolio.bookCall'), href: '/call/', icon: 'tabler:phone' }}
    callToAction2={{ text: 'Contact', href: '/contact/' }}
    image={{
      src: HeroImage,
      alt: locale === 'en' ? "David Barbier's freelance web developer portrait sitting on a chair and smiling" : "Portrait de David Barbier développeur web freelance assis sur une chaise et souriant",
    }}
  >
    <Fragment slot="title">
      <span class="text-transparent bg-gradient-to-r from-emerald-800 to-emerald-600 bg-clip-text dark:text-white highlight">{t("portfolio.heroSide.accent")}</span><br />
      {t('portfolio.heroSide.title')}
    </Fragment>

    <Fragment slot="subtitle">
      <span class="hidden sm:inline">
      </span>
      {t('portfolio.heroSide.subtitle')}
    </Fragment>
  </Hero2>

  <!--services-->
  
  <Features2
    title={t('portfolio.services.title')}
    subtitle={t('portfolio.services.subtitle')}
    columns={3}
    items={[
      {
        title: tList('portfolio.services.servicesItems')[0].title,
        description: tList('portfolio.services.servicesItems')[0].description,
        servicesItems: tList('portfolio.services.servicesItems')[0].items,
        price: tList('portfolio.services.servicesItems')[0].price,
        image: {
          ...Fidenza117,
          alt: locale === 'en' ? 'Green illustration of a fidenza NFT for website creation service' : 'Illustration verte d\'un NFT fidenza pour le service de création de site web',
        },
        icon: 'tabler:devices',
                 callToAction: {
           text: "Site web Wordpress Ajaccio",
           href: '/creation-site-internet-ajaccio/',
           icon: 'tabler:chevron-right',
         },
        callToAction2: {
          text: "Site web Wordpress Limoges",
          href: '/creation-site-internet-limoges/',
          icon: 'tabler:chevron-right',
        },
        ecLink: {
          text: "Expert-comptable ? Site vitrine dédié EC",
          href: '/agence-web-expert-comptable/creation-site-vitrine-ec/',
        },

      },
      {
        title: tList('portfolio.services.servicesItems')[1].title,
        description: tList('portfolio.services.servicesItems')[1].description,
        servicesItems: tList('portfolio.services.servicesItems')[1].items,
        price: tList('portfolio.services.servicesItems')[1].price,
        image: {
          ...Fidenza262,
          alt: locale === 'en' ? 'Green illustration of a fidenza NFT for custom feature development service' : 'Illustration verte d\'un NFT fidenza pour le service de développement de fonctionnalités personnalisées',
        },
        icon: 'tabler:wand',
        ecLink: {
          text: "Expert-comptable ? Développeur spécialisé EC",
          href: '/agence-web-expert-comptable/developpeur-specialise/',
        },
      },
      {
        title: tList('portfolio.services.servicesItems')[2].title,
        description: tList('portfolio.services.servicesItems')[2].description,
        servicesItems: tList('portfolio.services.servicesItems')[2].items,
        price: tList('portfolio.services.servicesItems')[2].price,
        image: {
          ...Fidenza2,
          alt: locale === 'en' ? 'Green illustration of a fidenza NFT for maintenance service' : 'Illustration verte d\'un NFT fidenza pour le service de maintenance de site web',
        },
        icon: 'tabler:tool',
        callToAction: {
          text: "Entretenez votre site",
          href: '/maintenance-site-web-limoges/',
          icon: 'tabler:chevron-right',
        },
        ecLink: {
          text: "Expert-comptable ? Refonte de votre site cabinet",
          href: '/agence-web-expert-comptable/refonte-site-internet/',
        },
      },
      {
        title: tList('portfolio.services.servicesItems')[3].title,
        description: tList('portfolio.services.servicesItems')[3].description,
        servicesItems: tList('portfolio.services.servicesItems')[3].items,
        price: tList('portfolio.services.servicesItems')[3].price,
        image: {
          ...Fidenza117,
          alt: locale === 'en' ? 'Green illustration of a fidenza NFT for maintenance service' : 'Illustration verte d\'un NFT fidenza pour le service de maintenance de site web',
        },
        icon: 'tabler:tool',
        callToAction2: {
          text: "Référencement en Corse",
          href: '/consultant-seo-ajaccio/',
          icon: 'tabler:chevron-right',
        },
        callToAction: {
          text: "SEO à Limoges",
          href: '/expert-referencement-limoges/',
          icon: 'tabler:chevron-right',
        },
        ecLink: {
          text: "Expert-comptable ? SEO spécialisé cabinet",
          href: '/agence-web-expert-comptable/consultant-seo-ec/',
        },
      },
    ]}
  />

  <!-- Bandeau Expert-Comptable (pont vers page dédiée) -->
  <section class="py-6 bg-gradient-to-r from-green-800 to-green-700 dark:from-green-900 dark:to-green-800">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <div class="flex flex-col sm:flex-row items-center justify-between gap-4">
        <div class="flex items-center gap-3 text-white">
          <span class="hidden sm:inline-flex items-center justify-center w-10 h-10 rounded-full bg-white/20">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
              <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
            </svg>
          </span>
          <p class="text-center sm:text-left">
            <span class="font-semibold">Vous êtes Expert-Comptable ?</span>
            <span class="hidden md:inline text-green-100"> — Ancien EC mémorialiste, j'ai des offres dédiées à votre profession.</span>
          </p>
        </div>
        <a
          href="/agence-web-expert-comptable/"
          class="inline-flex items-center gap-2 px-5 py-2.5 bg-white text-green-800 font-semibold rounded-full hover:bg-green-50 transition-colors shadow-md whitespace-nowrap"
        >
          Découvrir mes offres EC
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- case study -->
  <Content
    isReversed
    tagline={t('portfolio.caseStudies1.tagline')}
    title={t('portfolio.caseStudies1.title')}
    subtitle={t('portfolio.caseStudies1.subtitle')}
    items={tList('portfolio.caseStudies1.items')}
    cta={{
      text: t('portfolio.caseStudies1.callToAction'),
      href: "/restodom/",
      icon: "tabler:chevron-right",
    }}
    image={{
      src: RestodomMock,
      alt: locale === 'en' ? 'Mockup of Restodom website project on a laptop' : 'Mockup du projet de site web Restodom sur un ordinateur portable',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-0">
        {t('portfolio.caseStudies1.additionalTitle')}
      </h3>
      {t('portfolio.caseStudies1.additionalDescription')}
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-[#f6fcf7] dark:bg-slate-900"></div>
    </Fragment>
  </Content>

  <!-- Content Widget **************** -->

  <Content
    isAfterContent
    items={tList('portfolio.caseStudies2.items')}
    image={{
      src: Matchings,
      alt: locale === 'en' ? 'Matchings project illustration, piture of tyres on a yellow background' : 'Illustration du projet Matchings, photo de pneus sur un fond jaune',
    }}
    cta={{
      text: t('portfolio.caseStudies2.callToAction'),
      href: "/matchings/",
      icon: "tabler:chevron-right",
    }}
    endCTA={{
      text: t('portfolio.caseStudies2.endCallToAction'),
      href: "/category/portfolio/",
      icon: "tabler:chevron-right",
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">
        {t('portfolio.caseStudies2.additionalTitle')}
      </h3>
      {t('portfolio.caseStudies2.additionalDescription')}
    </Fragment>
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-[#f6fcf7] dark:bg-slate-900"></div>
    </Fragment>
  </Content>

  <!--Tech stack-->
  <Logos
    title={t('portfolio.logos.title')}
    subtitle={t('portfolio.logos.subtitle')}
    items={[{
      icon: 'tabler:brand-react',
      title: 'React',
    }, {
      icon: 'tabler:brand-typescript',
      title: 'TypeScript',
    }, {
      icon: 'tabler:brand-nodejs',
      title: 'NodeJS',
    }, {
      icon: 'tabler:brand-wordpress',
      title: 'Wordpress',
    }, {
      icon: 'tabler:brand-docker',
      title: 'Docker',
    }, {
      icon: 'tabler:brand-nextjs',
      title: 'Next.js',
    }]}
  />
  
  <BlogLatestPosts
    title={t('index.blogLatestPosts.title')}
    information={t('index.blogLatestPosts.information')}
    linkText={t('index.blogLatestPosts.linkText')}
    count={3}
  />
  
  <CallToAction
    title={t('portfolio.callToAction.title')}
    subtitle={t('portfolio.callToAction.subtitle')}
    callToAction={{
      text: t('portfolio.callToAction.cta'),
      href: '/call/',
      icon: 'tabler:phone',
    }}
  />
</Layout>
