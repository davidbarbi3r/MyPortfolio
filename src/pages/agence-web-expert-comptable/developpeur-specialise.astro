---
import Layout from '../../layouts/PageLayout.astro';
import Image from '../../components/common/Image.astro';
import HeroImage from '../../assets/images/DSCF7551-3.jpg';
import { professionalServiceEcNode, PROFESSIONAL_SERVICE_EC_ID } from '~/utils/business-schema';
import MontegrappaFx from '~/components/animations/MontegrappaFx.astro';
import PillBadge from '~/components/ui/PillBadge.astro';
import StatBig from '~/components/ui/StatBig.astro';
import SectionHeader from '~/components/ui/SectionHeader.astro';
import ArrowLink from '~/components/ui/ArrowLink.astro';
import ArrowRight from '~/components/ui/ArrowRight.astro';

const metadata = {
  title: "Développeur web spécialisé expert-comptable | David Barbier",
  description:
    'Ancien EC mémorialiste devenu développeur web. Outils sur mesure pour cabinets comptables : simulateurs, modules IA, onboarding client.',
};

// JSON-LD Service schema
const serviceStructuredData = {
  "@context": "https://schema.org",
  "@graph": [
    professionalServiceEcNode,
    {
      // Service seul, pas Product : aucun prix ni avis n'est affiché sur cette
      // page, donc rien à mettre dans offers/review/aggregateRating (exigés
      // par Google pour un Product, cf. erreur GSC sur maintenance Limoges).
      "@type": "Service",
      "@id": "https://www.davidbarbier.com/agence-web-expert-comptable/developpeur-specialise/#service",
      "name": "Développeur web spécialisé expert-comptable",
      "description": "Développement sur mesure pour cabinets d'expertise comptable. Simulateurs, modules IA, onboarding client, intégrations métier avec Astro.",
      "provider": { "@id": PROFESSIONAL_SERVICE_EC_ID },
      "areaServed": {
        "@type": "Country",
        "name": "France"
      },
      "serviceType": "Développement web sur mesure",
      "audience": {
        "@type": "Audience",
        "audienceType": "Experts-comptables, Cabinets comptables"
      }
    }
  ]
};

// JSON-LD Breadcrumb schema
const breadcrumbStructuredData = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Accueil",
      "item": "https://www.davidbarbier.com/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Agence Web Expert-Comptable",
      "item": "https://www.davidbarbier.com/agence-web-expert-comptable/"
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": "Développeur spécialisé",
      "item": "https://www.davidbarbier.com/agence-web-expert-comptable/developpeur-specialise/"
    }
  ]
};

// Cartes de la section « La double casquette »
const CASQUETTE_CARDS = [
  {
    title: 'Vocabulaire commun',
    desc: 'Obligations, saisonnalité, outils métier (Pennylane, Cegid, Dext...) - pas besoin de tout réexpliquer.',
    icon: 'M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2',
  },
  {
    title: 'Cadrage plus court',
    desc: 'Moins de réunions pour se comprendre, plus de temps passé sur la solution.',
    icon: 'M13 10V3L4 14h7v7l9-11h-7z',
  },
  {
    title: 'Déontologie intégrée',
    desc: 'Les contraintes de communication et de démarchage de la profession sont prises en compte dès la conception.',
    icon: 'M3 6l3 1m0 0l-3 9a5.002 5.002 0 006.001 0M6 7l3 9M6 7l6-2m6 2l3-1m-3 1l-3 9a5.002 5.002 0 006.001 0M18 7l3 9m-3-9l-6-2m0-2v2m0 16V5m0 16H9m3 0h3',
  },
  {
    title: 'Pensé pour le cabinet',
    desc: "L'objectif c'est la valeur ajoutée pour votre cabinet et vos clients, pas la prouesse technique.",
    icon: 'M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z',
  },
];

// Cartes de compétences (hors carte mise en avant « Simulateurs »)
const SKILL_CARDS = [
  {
    title: 'Onboarding client',
    desc: 'Formulaires multi-étapes pour collecter les pièces et informations de vos nouveaux clients de manière fluide et structurée.',
    icon: 'M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z',
  },
  {
    title: 'Qualification prospects',
    desc: 'Formulaires intelligents qui qualifient automatiquement vos prospects : type de structure, CA, besoins spécifiques.',
    icon: 'M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01',
  },
  {
    title: 'Modules IA',
    desc: "Chatbot de pré-qualification, génération de contenus assistée pour votre blog, automatisation de tâches. L'IA quand elle a du sens.",
    icon: 'M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z',
  },
  {
    title: 'Intégrations métier',
    desc: 'Lien vers Pennylane, Cegid, Dext, ou tout autre outil utilisé par vos clients. Espace client dédié avec accès direct.',
    icon: 'M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1',
  },
];

// Arguments de la section contact
const CONTACT_POINTS = [
  {
    title: 'Échange gratuit et sans engagement',
    desc: 'On discute de votre idée, je vous dis ce qui est possible.',
    icon: 'M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z',
  },
  {
    title: 'Réponse sous 48h',
    desc: 'Avec une première estimation de faisabilité et de budget.',
    icon: 'M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z',
  },
  {
    title: 'Ancien EC, je parle votre langage',
    desc: "Pas besoin de m'expliquer ce qu'est un FEC ou une liasse fiscale.",
    icon: 'M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z',
  },
];
---

<Layout metadata={metadata}>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(serviceStructuredData)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbStructuredData)} />
  </Fragment>

  <!-- Hero -->
  <section class="relative bg-cream overflow-hidden">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 py-16 md:py-24">
      <!-- Fil d'Ariane -->
      <nav aria-label="Fil d'Ariane" class="mb-8 text-sm" data-fade-up>
        <ol class="flex items-center gap-2 text-muted flex-wrap">
          <li><a href="/" class="hover:text-sage-dark transition-colors">Accueil</a></li>
          <li><svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg></li>
          <li><a href="/agence-web-expert-comptable/" class="hover:text-sage-dark transition-colors">Agence Web EC</a></li>
          <li><svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg></li>
          <li class="text-charcoal font-medium">Développeur spécialisé</li>
        </ol>
      </nav>

      <div class="grid lg:grid-cols-2 gap-12 lg:gap-20 items-center">

        <!-- Colonne texte -->
        <div class="order-2 lg:order-1">
          <p data-fade-up><PillBadge text="Ancien EC mémorialiste & développeur" /></p>

          <h1 class="mt-8" data-fade-up>
            <span class="block text-charcoal text-[clamp(2.6rem,5vw,4.5rem)] leading-[1.05] tracking-tight">
              Développeur web
            </span>
            <span class="block text-sage-dark text-[clamp(2.2rem,4vw,3.75rem)] leading-[1.05] mt-2">
              spécialisé expert-comptable
            </span>
          </h1>

          <p class="mt-8 text-lg sm:text-xl text-muted leading-relaxed" data-fade-up>
            Ancien EC mémorialiste, je suis <strong class="text-charcoal font-medium">à l'écoute de toute idée de développement</strong> pour servir la profession comptable. Prestataire ou partenaire, j'ai à cœur de créer des solutions utiles et efficaces qui améliorent le quotidien des experts-comptables.
          </p>

          <!-- Stats rapides -->
          <div class="mt-10 grid grid-cols-3 gap-6">
            <StatBig value="EC" label="Mémorialiste" size="md" />
            <StatBig value="5+" label="Ans en cabinet" size="md" />
            <StatBig value="Dev" label="Full-stack" size="md" />
          </div>

          <!-- CTA -->
          <div class="mt-10 flex flex-wrap items-center gap-6" data-fade-up>
            <a href="tel:+33623565299" class="btn btn-primary gap-2">
              Discuter de votre projet
              <ArrowRight class="w-5 h-5" />
            </a>
            <ArrowLink href="#realisations" text="Voir ce que je sais faire" />
          </div>
        </div>

        <!-- Colonne image -->
        <div class="order-1 lg:order-2 w-full" data-fade-up>
          <div class="relative rounded-xl overflow-hidden">
            <Image
              src={HeroImage}
              alt="David Barbier - Développeur spécialisé expert-comptable"
              class="w-full aspect-[4/5] object-cover"
              width={1024}
              height={1280}
            />

            <!-- Carte flottante -->
            <div class="absolute bottom-6 left-6 right-6 bg-cream/95 backdrop-blur-sm rounded-xl p-4">
              <div class="flex items-center gap-4">
                <div class="flex-shrink-0 w-12 h-12 bg-sage rounded-full flex items-center justify-center">
                  <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"/>
                  </svg>
                </div>
                <div>
                  <div class="font-medium text-charcoal">Outils sur mesure</div>
                  <div class="text-sm text-muted">Par un ancien expert-comptable</div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Section 01 : La double casquette -->
  <section class="py-16 md:py-24 bg-sand">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <div class="grid lg:grid-cols-12 gap-12 lg:gap-20">

        <!-- Colonne gauche - Numéro et titre -->
        <div class="lg:col-span-4">
          <div class="lg:sticky lg:top-32">
            <SectionHeader number="01" kicker="La double casquette" align="left">
              Pourquoi un développeur qui connaît votre métier ?
            </SectionHeader>
          </div>
        </div>

        <!-- Colonne droite - Contenu -->
        <div class="lg:col-span-8">
          <p class="text-xl text-muted leading-relaxed">
            Quand un développeur classique construit un outil pour un cabinet comptable, il part de zéro sur le métier. Le FEC, la période fiscale, le DAF externalisé - tout ça doit lui être expliqué. C'est du temps et des allers-retours en plus.
          </p>

          <p class="text-muted leading-relaxed mt-6">
            Un parcours en cabinet d'expertise comptable et en audit financier avant le développement web, ça change la donne : les échanges sont plus fluides, le cadrage plus court, et le résultat plus juste dès les premières itérations.
          </p>

          <div class="grid sm:grid-cols-2 gap-6 mt-12">
            {CASQUETTE_CARDS.map((card) => (
              <div class="rounded-xl border border-black/10 bg-cream p-6" data-fade-up>
                <div class="inline-flex w-12 h-12 items-center justify-center rounded-full bg-sage/15 text-sage-dark mb-4">
                  <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={card.icon} />
                  </svg>
                </div>
                <h3 class="text-lg text-charcoal">{card.title}</h3>
                <p class="text-sm text-muted mt-2">{card.desc}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Section 02 : Ce que je sais faire -->
  <section id="realisations" class="py-16 md:py-24 scroll-mt-32 bg-cream">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">

      <SectionHeader
        number="02"
        kicker="Compétences"
        subtitle="Des exemples concrets, mais cette liste n'est pas figée. Chaque cabinet a ses propres besoins - parlons des vôtres."
        class="max-w-3xl mx-auto mb-16"
      >
        Ce que je peux développer pour votre cabinet
      </SectionHeader>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">

        <!-- Carte mise en avant : Simulateurs -->
        <div class="lg:col-span-2 bg-sage text-white rounded-xl p-8 lg:p-10" data-fade-up>
          <div class="w-14 h-14 rounded-xl bg-white/20 text-white flex items-center justify-center mb-6">
            <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z"/>
            </svg>
          </div>
          <h3 class="text-2xl lg:text-3xl text-white mb-4">Simulateurs & calculateurs</h3>
          <p class="text-white/90 text-lg leading-relaxed max-w-xl">
            Simulateurs de charges sociales, de TVA, d'impôt sur les sociétés, de coût salarial... Des outils interactifs qui attirent du trafic qualifié sur votre site et démontrent votre expertise.
          </p>
        </div>

        {SKILL_CARDS.map((card) => (
          <div class="rounded-xl border border-black/10 bg-white/60 p-8" data-fade-up>
            <div class="w-12 h-12 rounded-xl bg-sage/15 text-sage-dark flex items-center justify-center mb-6">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={card.icon} />
              </svg>
            </div>
            <h3 class="text-xl text-charcoal mb-3">{card.title}</h3>
            <p class="text-muted leading-relaxed">{card.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Section CTA Final -->
  <section id="formulaire" class="py-16 md:py-24 bg-sand mb-16 scroll-mt-20">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">

      <div class="grid lg:grid-cols-2 gap-16 items-start">

        <!-- Colonne gauche - Texte -->
        <div>
          <SectionHeader number="03" kicker="On en parle ?" align="left">
            Un projet en tête ?
          </SectionHeader>

          <p class="text-xl text-muted mt-8 leading-relaxed">
            Vous avez une idée pour améliorer le fonctionnement de votre cabinet, faciliter la relation client ou automatiser une tâche ? Même si le projet est encore flou, discutons-en. En tant que prestataire ou partenaire, je m'investis pour créer des solutions qui ont un vrai impact sur votre quotidien.
          </p>

          <ul class="mt-10 space-y-6">
            {CONTACT_POINTS.map((point) => (
              <li class="flex gap-4" data-fade-up>
                <div class="flex-shrink-0 w-12 h-12 rounded-full bg-sage/15 text-sage-dark flex items-center justify-center">
                  <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={point.icon} />
                  </svg>
                </div>
                <div>
                  <h3 class="font-medium text-charcoal">{point.title}</h3>
                  <p class="text-muted mt-1">{point.desc}</p>
                </div>
              </li>
            ))}
          </ul>
        </div>

        <!-- Colonne droite - Formulaire -->
        <div class="bg-cream border border-black/10 rounded-xl p-8 lg:p-10" data-fade-up>

          <div class="flex items-center gap-4 mb-8">
            <Image
              src={HeroImage}
              height={64}
              width={64}
              alt="David Barbier"
              class="w-16 h-16 rounded-full object-cover ring-4 ring-sage/30"
            />
            <div>
              <div class="font-medium text-charcoal">David Barbier</div>
              <div class="text-sm text-muted">Ancien EC & Développeur Web</div>
            </div>
          </div>

          <form method="post" action="https://formspree.io/f/xayglvyo" class="space-y-6">
            <div class="grid sm:grid-cols-2 gap-6">
              <div>
                <label for="name" class="block text-sm font-medium text-default mb-2">Votre nom</label>
                <input
                  id="name"
                  name="name"
                  type="text"
                  required
                  class="w-full px-4 py-3 rounded-lg border border-black/10 bg-white/70 text-charcoal focus:ring-2 focus:ring-sage focus:border-transparent transition-all"
                  placeholder="Jean Dupont"
                />
              </div>
              <div>
                <label for="email" class="block text-sm font-medium text-default mb-2">Votre email</label>
                <input
                  id="email"
                  name="email"
                  type="email"
                  required
                  class="w-full px-4 py-3 rounded-lg border border-black/10 bg-white/70 text-charcoal focus:ring-2 focus:ring-sage focus:border-transparent transition-all"
                  placeholder="jean@cabinet.fr"
                />
              </div>
            </div>

            <div>
              <label for="textarea" class="block text-sm font-medium text-default mb-2">Décrivez votre projet</label>
              <textarea
                id="textarea"
                name="textarea"
                rows="4"
                required
                class="w-full px-4 py-3 rounded-lg border border-black/10 bg-white/70 text-charcoal focus:ring-2 focus:ring-sage focus:border-transparent transition-all resize-none"
                placeholder="Simulateur de charges, onboarding client, module IA..."
              ></textarea>
            </div>

            <div class="flex items-start gap-3">
              <input
                id="disclaimer"
                name="disclaimer"
                type="checkbox"
                required
                class="mt-1 w-5 h-5 rounded border-black/20 text-sage-dark focus:ring-sage"
              />
              <label for="disclaimer" class="text-sm text-muted cursor-pointer">
                En soumettant ce formulaire, vous acceptez que vos données soient traitées conformément à notre politique de confidentialité.
              </label>
            </div>

            <input type="hidden" name="source" value="developpeur-specialise-ec" />

            <button type="submit" class="btn btn-primary w-full gap-2">
              Discuter de mon projet
              <ArrowRight class="w-5 h-5" />
            </button>
          </form>
        </div>
      </div>
    </div>
  </section>

  <MontegrappaFx />
</Layout>
