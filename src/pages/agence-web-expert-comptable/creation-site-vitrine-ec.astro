---
import Layout from '../../layouts/PageLayout.astro';
import Image from '../../components/common/Image.astro';
import HeroImage from '../../assets/images/DSCF7551-3.jpg';
import { aggregateRatingSchemaGlobal } from '~/utils/reviews';

const metadata = {
  title: "Conception & création de site internet Expert-Comptable",
  description:
    'Création de site internet pour cabinets d\'expertise comptable. Design professionnel, optimisé SEO, livré en 6 semaines. Devis gratuit.',
};

// JSON-LD Service schema
const serviceStructuredData = {
  "@context": "https://schema.org",
  "@type": "Service",
  "@id": "https://www.davidbarbier.com/agence-web-expert-comptable/creation-site-vitrine-ec/#service",
  "name": "Création de site vitrine expert-comptable",
  "description": "Création de site vitrine sur mesure pour cabinets d'expertise comptable. Design professionnel, optimisation SEO, performances maximales avec Astro.",
  "provider": {
    "@type": "ProfessionalService",
    "@id": "https://www.davidbarbier.com/#organization",
    "name": "David Barbier",
    "url": "https://www.davidbarbier.com/"
  },
  "areaServed": {
    "@type": "Country",
    "name": "France"
  },
  "serviceType": "Création de site vitrine",
  "audience": {
    "@type": "Audience",
    "audienceType": "Experts-comptables, Cabinets comptables"
  },
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": "Offres création site expert-comptable",
    "itemListElement": [
      {
        "@type": "Offer",
        "name": "Forfait création site vitrine expert-comptable",
        "description": "Création sur mesure incluant design, développement Astro, SEO et formation. One page dès 1200€ HT, site multi-pages dès 2000€ HT.",
        "price": "1200",
        "priceCurrency": "EUR",
        "priceSpecification": {
          "@type": "PriceSpecification",
          "price": "1200",
          "priceCurrency": "EUR",
          "valueAddedTaxIncluded": false
        }
      },
      {
        "@type": "Offer",
        "name": "Maintenance mensuelle",
        "description": "Maintenance technique, mises à jour de sécurité et support",
        "price": "30",
        "priceCurrency": "EUR",
        "priceSpecification": {
          "@type": "UnitPriceSpecification",
          "price": "30",
          "priceCurrency": "EUR",
          "unitCode": "MON",
          "valueAddedTaxIncluded": false
        }
      }
    ]
  },
};

// JSON-LD FAQ schema
const faqStructuredData = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Pourquoi un site vitrine Astro et pas WordPress ?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "WordPress est parfait pour les blogs et sites nécessitant des mises à jour fréquentes par des non-techniciens. Mais pour un site vitrine d'expert-comptable, Astro offre des avantages décisifs : des performances 10x supérieures (score PageSpeed >80), une sécurité renforcée (pas de base de données à pirater, pas de plugins vulnérables), zéro maintenance technique (pas de mises à jour WordPress/plugins à gérer), et des coûts d'hébergement réduits."
      }
    },
    {
      "@type": "Question",
      "name": "Puis-je modifier le contenu moi-même ?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Oui. PagesCMS, un CMS git-based léger, est intégré à votre site. Vous pouvez modifier vos textes, ajouter des articles de blog et mettre à jour vos informations depuis une interface simple, sans toucher au code. Pas de base de données supplémentaire, tout reste dans votre dépôt Git : c'est frugal et transparent. Une formation est incluse dans la prestation."
      }
    },
    {
      "@type": "Question",
      "name": "Le site sera-t-il optimisé pour le référencement Google ?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Absolument. L'optimisation SEO est intégrée dès la conception : structure sémantique optimisée (balises H1-H6, meta descriptions), sitemap XML et données structurées, performances techniques excellentes (facteur de ranking Google), et contenus optimisés pour vos mots-clés cibles (expert-comptable + ville, création entreprise...)."
      }
    },
    {
      "@type": "Question",
      "name": "Quel hébergement recommandez-vous ?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Je recommande Cloudflare Pages pour sa rapidité, sa fiabilité et son coût (gratuit pour la majorité des sites vitrines). L'hébergement est éco-responsable avec une empreinte carbone minimale grâce aux fichiers statiques ultra-légers générés par Astro."
      }
    },
    {
      "@type": "Question",
      "name": "Proposez-vous la maintenance du site ?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Oui, je propose un forfait maintenance mensuel à partir de 30€/mois HT. Au-delà de la surveillance et des sauvegardes, la maintenance vous permet de bénéficier des avancées techniques d'Astro (View Transitions, optimisations d'images, nouvelles fonctionnalités) au fil des mises à jour du framework."
      }
    },
    {
      "@type": "Question",
      "name": "Combien de pages sont incluses dans le forfait ?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Le forfait de base inclut les pages essentielles d'un cabinet : accueil, à propos / équipe, missions et expertises, actualités / blog, et contact. Des pages supplémentaires (recrutement, simulateurs, espace client...) peuvent être ajoutées sur devis."
      }
    }
  ]
};

// JSON-LD Breadcrumb schema
const breadcrumbStructuredData = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Accueil",
      "item": "https://www.davidbarbier.com/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Agence Web Expert-Comptable",
      "item": "https://www.davidbarbier.com/agence-web-expert-comptable/"
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": "Création site vitrine",
      "item": "https://www.davidbarbier.com/agence-web-expert-comptable/creation-site-vitrine-ec/"
    }
  ]
};
---

<Layout metadata={metadata}>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(serviceStructuredData)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(faqStructuredData)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbStructuredData)} />
  </Fragment>

  <style>
    .font-editorial { font-family: var(--aw-font-heading), system-ui, sans-serif; }
    .font-body { font-family: var(--aw-font-sans), system-ui, sans-serif; }

    @keyframes fadeInUp {
      from { opacity: 0; transform: translateY(30px); }
      to { opacity: 1; transform: translateY(0); }
    }

    @keyframes scaleIn {
      from { opacity: 0; transform: scale(0.95); }
      to { opacity: 1; transform: scale(1); }
    }

    @keyframes shimmer {
      0% { background-position: -200% center; }
      100% { background-position: 200% center; }
    }

    @keyframes float {
      0%, 100% { transform: translateY(0); }
      50% { transform: translateY(-10px); }
    }

    .animate-fade-up { animation: fadeInUp 0.8s ease-out forwards; }
    .animate-scale { animation: scaleIn 0.6s ease-out forwards; }
    .animate-float { animation: float 6s ease-in-out infinite; }

    .delay-100 { animation-delay: 0.1s; opacity: 0; }
    .delay-200 { animation-delay: 0.2s; opacity: 0; }
    .delay-300 { animation-delay: 0.3s; opacity: 0; }
    .delay-400 { animation-delay: 0.4s; opacity: 0; }
    .delay-500 { animation-delay: 0.5s; opacity: 0; }

    .btn-shimmer {
      background: linear-gradient(90deg,
        var(--btn-bg) 0%,
        var(--btn-shimmer) 50%,
        var(--btn-bg) 100%);
      background-size: 200% 100%;
      --btn-bg: rgb(21, 128, 61);
      --btn-shimmer: rgb(34, 197, 94);
    }

    .btn-shimmer:hover {
      animation: shimmer 1.5s ease-in-out infinite;
    }

    .decorative-line {
      position: relative;
    }

    .decorative-line::after {
      content: '';
      position: absolute;
      bottom: -8px;
      left: 0;
      width: 60px;
      height: 3px;
      background: linear-gradient(90deg, #15803d, #22c55e, #86efac);
      border-radius: 2px;
    }

    .card-subtle {
      transition: all 0.3s ease;
    }

    .card-subtle:hover {
      border-color: rgba(21, 128, 61, 0.3);
    }

    .dark .card-subtle:hover {
      border-color: rgba(34, 197, 94, 0.3);
    }

    .styled-number {
      font-family: var(--aw-font-heading), system-ui, sans-serif;
      font-size: 4rem;
      font-weight: 700;
      line-height: 1;
      background: linear-gradient(135deg, #166534 0%, #15803d 50%, #22c55e 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }

    .hover-underline {
      position: relative;
    }

    .hover-underline::after {
      content: '';
      position: absolute;
      width: 0;
      height: 2px;
      bottom: -2px;
      left: 0;
      background: linear-gradient(90deg, #15803d, #22c55e);
      transition: width 0.3s ease;
    }

    .hover-underline:hover::after {
      width: 100%;
    }

    .texture-bg {
      background-image:
        radial-gradient(circle at 25% 25%, rgba(21, 128, 61, 0.03) 0%, transparent 50%),
        radial-gradient(circle at 75% 75%, rgba(180, 83, 9, 0.03) 0%, transparent 50%);
    }

    .badge-premium {
      background: linear-gradient(135deg, #dcfce7 0%, #bbf7d0 100%);
      border: 1px solid #22c55e;
      color: #166534;
    }

    .dark .badge-premium {
      background: linear-gradient(135deg, #14532d 0%, #166534 100%);
      border-color: #22c55e;
      color: #86efac;
    }

    .quote-mark {
      font-family: Georgia, serif;
      font-size: 6rem;
      line-height: 0;
      color: rgba(21, 128, 61, 0.15);
      position: absolute;
      top: 0;
      left: -10px;
    }

    .dark .quote-mark {
      color: rgba(34, 197, 94, 0.15);
    }

    .glow-on-hover {
      transition: all 0.3s ease;
    }

    .glow-on-hover:hover {
      box-shadow: 0 0 30px rgba(21, 128, 61, 0.3);
    }

    .stat-value {
      font-family: var(--aw-font-heading), system-ui, sans-serif;
      background: linear-gradient(135deg, #166534 0%, #22c55e 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }
  </style>

  <!-- Hero Section -->
  <section class="relative min-h-[90vh] flex items-center overflow-hidden texture-bg">
    <div class="absolute inset-0 overflow-hidden pointer-events-none">
      <div class="absolute -top-40 -right-40 w-96 h-96 bg-gradient-to-br from-green-100/50 to-emerald-100/30 dark:from-green-900/20 dark:to-emerald-900/10 rounded-full blur-3xl animate-float"></div>
      <div class="absolute -bottom-20 -left-20 w-72 h-72 bg-gradient-to-tr from-teal-100/40 to-green-100/20 dark:from-teal-900/10 dark:to-green-900/5 rounded-full blur-3xl" style="animation: float 8s ease-in-out infinite reverse;"></div>
    </div>

    <div class="relative mx-auto max-w-7xl px-6 py-20 lg:px-8">
      <!-- Fil d'Ariane -->
      <nav aria-label="Fil d'Ariane" class="mb-8 text-sm font-body animate-fade-up">
        <ol class="flex items-center gap-2 text-gray-500 dark:text-gray-400 flex-wrap">
          <li><a href="/" class="hover:text-green-700 dark:hover:text-green-400 transition-colors">Accueil</a></li>
          <li><svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg></li>
          <li><a href="/agence-web-expert-comptable/" class="hover:text-green-700 dark:hover:text-green-400 transition-colors">Agence Web EC</a></li>
          <li><svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg></li>
          <li class="text-gray-900 dark:text-white font-medium">Création site vitrine</li>
        </ol>
      </nav>

      <div class="grid lg:grid-cols-2 gap-12 lg:gap-20 items-center">

        <div class="order-2 lg:order-1">
          <div class="animate-fade-up delay-100">
            <span class="badge-premium inline-flex items-center gap-2 px-4 py-2 rounded-full text-sm font-medium font-body">
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                <path d="M10 2a8 8 0 100 16 8 8 0 000-16zm1 11H9v-2h2v2zm0-4H9V5h2v4z"/>
              </svg>
              EC Mémorialiste reconverti
            </span>
          </div>

          <h1 class="mt-8 animate-fade-up delay-200">
            <span class="block font-editorial text-4xl sm:text-5xl lg:text-6xl font-bold text-gray-900 dark:text-white leading-[1.1] tracking-tight">
              Conception & création de site internet
            </span>
            <span class="block font-editorial text-3xl sm:text-4xl lg:text-5xl font-medium text-emerald-700 dark:text-emerald-400 mt-2">
              pour expert-comptable
            </span>
          </h1>

          <p class="mt-8 font-body text-xl sm:text-2xl text-gray-600 dark:text-gray-300 leading-relaxed animate-fade-up delay-300">
            Ancien expert-comptable mémorialiste, je conçois et crée des <strong class="text-gray-900 dark:text-white">sites internet sur mesure</strong> pour les cabinets qui veulent se démarquer et attirer de nouveaux clients.
          </p>

          <div class="mt-10 flex flex-wrap gap-8 animate-fade-up delay-400">
            <div class="text-center">
              <div class="stat-value text-4xl font-bold">6</div>
              <div class="font-body text-sm text-gray-500 dark:text-gray-400 mt-1">Semaines</div>
            </div>
            <div class="text-center">
              <div class="stat-value text-4xl font-bold">>80</div>
              <div class="font-body text-sm text-gray-500 dark:text-gray-400 mt-1">PageSpeed</div>
            </div>
            <div class="text-center">
              <div class="stat-value text-4xl font-bold">100%</div>
              <div class="font-body text-sm text-gray-500 dark:text-gray-400 mt-1">Sur mesure</div>
            </div>
          </div>

          <div class="mt-10 flex flex-wrap items-center gap-4 animate-fade-up delay-500">
            <a
              href="tel:+33623565299"
              class="btn-shimmer inline-flex items-center gap-2 px-8 py-4 rounded-full text-white font-body font-semibold text-lg shadow-lg shadow-green-700/25 hover:shadow-xl hover:shadow-green-700/30 transition-all duration-300 glow-on-hover"
            >
              Demander un devis gratuit
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
              </svg>
            </a>
            <a href="#processus" class="group inline-flex items-center gap-2 px-6 py-4 font-body font-medium text-gray-700 dark:text-gray-300 hover:text-green-700 dark:hover:text-green-400 transition-colors">
              Voir le processus
              <svg class="w-4 h-4 transition-transform group-hover:translate-y-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
              </svg>
            </a>
          </div>
        </div>

        <div class="order-1 lg:order-2 w-full animate-scale delay-200">
          <div class="relative w-full">
            <div class="absolute -inset-4 bg-gradient-to-br from-green-200/50 via-transparent to-emerald-200/50 dark:from-green-800/30 dark:to-emerald-800/30 rounded-3xl transform rotate-3"></div>
            <div class="absolute -inset-4 bg-gradient-to-tr from-teal-200/30 via-transparent to-green-200/30 dark:from-teal-800/20 dark:to-green-800/20 rounded-3xl transform -rotate-2"></div>

            <div class="relative rounded-2xl overflow-hidden shadow-2xl w-full">
              <Image
                src={HeroImage}
                alt="David Barbier - Création site expert-comptable"
                class="w-full aspect-[4/5] object-cover grayscale"
                width={1024}
                height={1280}
              />
              <div class="absolute inset-0 bg-gradient-to-t from-gray-900/60 via-transparent to-transparent"></div>

              <div class="absolute bottom-6 left-6 right-6 bg-white/95 dark:bg-gray-800/95 backdrop-blur-sm rounded-xl p-4 shadow-lg">
                <div class="flex items-center gap-4">
                  <div class="flex-shrink-0 w-12 h-12 bg-gradient-to-br from-green-500 to-green-700 rounded-full flex items-center justify-center">
                    <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"/>
                    </svg>
                  </div>
                  <div>
                    <div class="font-editorial font-semibold text-gray-900 dark:text-white">Site internet sur mesure</div>
                    <div class="font-body text-sm text-gray-500 dark:text-gray-400">Par un ancien expert-comptable</div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

  </section>

  <!-- Section 01 : Pourquoi créer un site vitrine -->
  <section class="py-24 lg:py-32 bg-gradient-to-b from-gray-50 to-white dark:from-gray-900 dark:to-gray-900">
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
      <div class="grid lg:grid-cols-12 gap-12 lg:gap-20">

        <div class="lg:col-span-4">
          <div class="lg:sticky lg:top-32">
            <span class="styled-number">01</span>
            <p class="font-body text-sm font-semibold tracking-widest text-amber-600 dark:text-amber-500 uppercase mt-4">Pourquoi ?</p>
            <h2 class="font-editorial text-3xl sm:text-4xl font-bold text-gray-900 dark:text-white mt-3 decorative-line">
              Pourquoi concevoir un site internet pour votre cabinet ?
            </h2>
          </div>
        </div>

        <div class="lg:col-span-8">
          <div class="prose prose-lg dark:prose-invert max-w-none font-body">
            <p class="text-xl text-gray-600 dark:text-gray-300 leading-relaxed">
              Après un premier échange ou une recommandation, <strong class="text-gray-900 dark:text-white">vos prospects vont systématiquement consulter votre site avant de vous confier leur comptabilité</strong>. C'est l'étape de validation : un site professionnel rassure et conforte la décision, un site absent ou daté sème le doute.
            </p>

            <p class="text-gray-600 dark:text-gray-300 leading-relaxed mt-6">
              Au-delà de la visibilité, c'est aussi une question de <strong class="text-gray-900 dark:text-white">crédibilité et de confiance</strong>. Un site soigné rassure vos prospects et reflète le sérieux de votre cabinet. C'est votre vitrine 24h/24, accessible depuis n'importe quel appareil.
            </p>
          </div>

          <div class="relative mt-12 pl-8 py-6">
            <span class="quote-mark">"</span>
            <blockquote class="relative font-editorial text-2xl sm:text-3xl font-medium text-gray-900 dark:text-white italic leading-relaxed">
              Un site web, c'est votre premier collaborateur commercial : il travaille pour vous 24h/24, 7j/7.
            </blockquote>
          </div>

          <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6 mt-12">
            <div class="card-subtle bg-white dark:bg-gray-800 rounded-2xl p-6 border border-gray-100 dark:border-gray-700">
              <div class="inline-flex w-12 h-12 items-center justify-center rounded-full bg-blue-100 dark:bg-blue-900/50 text-blue-700 dark:text-blue-400 mb-4">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
                </svg>
              </div>
              <h3 class="font-editorial font-semibold text-gray-900 dark:text-white">Visibilité locale</h3>
              <p class="font-body text-sm text-gray-600 dark:text-gray-400 mt-2">Apparaissez sur "expert-comptable + ville" quand vos prospects cherchent un cabinet</p>
            </div>

            <div class="card-subtle bg-white dark:bg-gray-800 rounded-2xl p-6 border border-gray-100 dark:border-gray-700">
              <div class="inline-flex w-12 h-12 items-center justify-center rounded-full bg-purple-100 dark:bg-purple-900/50 text-purple-700 dark:text-purple-400 mb-4">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
                </svg>
              </div>
              <h3 class="font-editorial font-semibold text-gray-900 dark:text-white">Crédibilité</h3>
              <p class="font-body text-sm text-gray-600 dark:text-gray-400 mt-2">Un site professionnel inspire confiance et reflète le sérieux de votre cabinet</p>
            </div>

            <div class="card-subtle bg-white dark:bg-gray-800 rounded-2xl p-6 border border-gray-100 dark:border-gray-700">
              <div class="inline-flex w-12 h-12 items-center justify-center rounded-full bg-orange-100 dark:bg-orange-900/50 text-orange-700 dark:text-orange-400 mb-4">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/>
                </svg>
              </div>
              <h3 class="font-editorial font-semibold text-gray-900 dark:text-white">Acquisition clients</h3>
              <p class="font-body text-sm text-gray-600 dark:text-gray-400 mt-2">Convertissez vos visiteurs en prospects avec un parcours pensé pour la prise de contact</p>
            </div>

            <div class="card-subtle bg-white dark:bg-gray-800 rounded-2xl p-6 border border-gray-100 dark:border-gray-700">
              <div class="inline-flex w-12 h-12 items-center justify-center rounded-full bg-green-100 dark:bg-green-900/50 text-green-700 dark:text-green-400 mb-4">
