---

<Layout metadata={metadata}>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(serviceStructuredData)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(faqStructuredData)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbStructuredData)} />
  </Fragment>

  <!-- Hero -->
  <section class="relative bg-cream overflow-hidden">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 py-16 md:py-24">
      <!-- Fil d'Ariane -->
      <nav aria-label="Fil d'Ariane" class="mb-8 text-sm" data-fade-up>
        <ol class="flex items-center gap-2 text-muted flex-wrap">
          <li><a href="/" class="hover:text-sage-dark transition-colors">Accueil</a></li>
          <li><svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg></li>
          <li><a href="/agence-web-expert-comptable/" class="hover:text-sage-dark transition-colors">Agence Web EC</a></li>
          <li><svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg></li>
          <li class="text-charcoal font-medium">Création site vitrine</li>
        </ol>
      </nav>

      <div class="grid lg:grid-cols-2 gap-12 lg:gap-20 items-center">

        <!-- Colonne texte -->
        <div class="order-2 lg:order-1">
          <p data-fade-up><PillBadge text="EC Mémorialiste reconverti" /></p>

          <h1 class="mt-8" data-fade-up>
            <span class="block text-charcoal text-[clamp(2.6rem,5vw,4.5rem)] leading-[1.05] tracking-tight">
              Conception & création de site internet
            </span>
            <span class="block text-sage-dark text-[clamp(2.2rem,4vw,3.75rem)] leading-[1.05] mt-2">
              pour expert-comptable
            </span>
          </h1>

          <p class="mt-8 text-xl sm:text-2xl text-muted leading-relaxed" data-fade-up>
            Ancien expert-comptable mémorialiste, je conçois et crée des <strong class="text-charcoal font-medium">sites internet sur mesure</strong> pour les cabinets qui veulent se démarquer et attirer de nouveaux clients.
          </p>

          <!-- Stats rapides -->
          <div class="mt-10 grid grid-cols-3 gap-6">
            <StatBig value="6" label="Semaines" size="md" />
            <StatBig value=">80" label="PageSpeed" size="md" />
            <StatBig value="100%" label="Sur mesure" size="md" />
          </div>

          <!-- CTA -->
          <div class="mt-10 flex flex-wrap items-center gap-6" data-fade-up>
            <a href="tel:+33623565299" class="btn btn-primary gap-2">
              Demander un devis gratuit
              <ArrowRight class="w-5 h-5" />
            </a>
            <ArrowLink href="#processus" text="Voir le processus" />
          </div>
        </div>

        <!-- Colonne image -->
        <div class="order-1 lg:order-2 w-full" data-fade-up>
          <div class="relative rounded-xl overflow-hidden">
            <Image
              src={HeroImage}
              alt="David Barbier - Création site expert-comptable"
              class="w-full aspect-[4/5] object-cover"
              width={1024}
              height={1280}
            />

            <!-- Carte flottante -->
            <div class="absolute bottom-6 left-6 right-6 bg-cream/95 backdrop-blur-sm rounded-xl p-4">
              <div class="flex items-center gap-4">
                <div class="flex-shrink-0 w-12 h-12 bg-sage rounded-full flex items-center justify-center">
                  <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"/>
                  </svg>
                </div>
                <div>
                  <div class="font-medium text-charcoal">Site internet sur mesure</div>
                  <div class="text-sm text-muted">Par un ancien expert-comptable</div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Section 01 : Pourquoi créer un site vitrine -->
  <section class="py-16 md:py-24 bg-sand">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <div class="grid lg:grid-cols-12 gap-12 lg:gap-20">

        <div class="lg:col-span-4">
          <div class="lg:sticky lg:top-32">
            <SectionHeader number="01" kicker="Pourquoi ?" align="left">
              Pourquoi concevoir un site internet pour votre cabinet ?
            </SectionHeader>
          </div>
        </div>

        <div class="lg:col-span-8">
          <p class="text-xl text-muted leading-relaxed">
            Après un premier échange ou une recommandation, <strong class="text-charcoal font-medium">vos prospects vont systématiquement consulter votre site avant de vous confier leur comptabilité</strong>. C'est l'étape de validation : un site professionnel rassure et conforte la décision, un site absent ou daté sème le doute.
          </p>

          <p class="text-muted leading-relaxed mt-6">
            Au-delà de la visibilité, c'est aussi une question de <strong class="text-charcoal font-medium">crédibilité et de confiance</strong>. Un site soigné rassure vos prospects et reflète le sérieux de votre cabinet. C'est votre vitrine 24h/24, accessible depuis n'importe quel appareil.
          </p>

          <!-- Citation mise en valeur -->
          <div class="mt-12" data-fade-up>
            <span class="block text-5xl leading-none mb-4 font-serif text-sage" aria-hidden="true">"</span>
            <blockquote class="text-2xl sm:text-3xl font-light text-charcoal italic leading-relaxed">
