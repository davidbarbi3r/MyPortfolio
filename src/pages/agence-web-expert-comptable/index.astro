---
import Layout from '../../layouts/PageLayout.astro';
import Image from '../../components/common/Image.astro';
import HeroImage from '../../assets/images/DSCF7551-3.jpg';
import LeadMagnetForm from '../../components/widgets/LeadMagnetForm.astro';

const metadata = {
  title: "Agence Web Expert-Comptable | Agence Digitale pour Cabinet Comptable",
  description:
    'Agence web spécialisée experts-comptables : création de site, refonte, SEO. Par un ancien EC mémorialiste qui connaît votre métier. Devis gratuit.',
};

// JSON-LD Service schema
const serviceStructuredData = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  "@id": "https://www.davidbarbier.com/agence-web-expert-comptable/#service",
  "name": "Agence web pour experts-comptables",
  "description": "Agence web spécialisée pour cabinets d'expertise comptable. Création de site sur mesure, refonte, SEO et maintenance par un ancien expert-comptable mémorialiste.",
  "url": "https://www.davidbarbier.com/agence-web-expert-comptable/",
  "provider": {
    "@type": "Person",
    "@id": "https://www.davidbarbier.com/#person",
    "name": "David Barbier",
    "jobTitle": "Développeur web & ancien expert-comptable mémorialiste",
    "url": "https://www.davidbarbier.com/"
  },
  "areaServed": {
    "@type": "Country",
    "name": "France"
  },
  "serviceType": ["Création de site internet", "Refonte de site", "SEO", "Maintenance web"],
  "audience": {
    "@type": "Audience",
    "audienceType": "Experts-comptables, Cabinets comptables, Commissaires aux comptes"
  },
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": "Offres agence web expert-comptable",
    "itemListElement": [
      {
        "@type": "Offer",
        "name": "Création site expert-comptable",
        "description": "Site vitrine sur mesure optimisé SEO pour cabinets d'expertise comptable",
        "priceSpecification": {
          "@type": "PriceSpecification",
          "minPrice": "1500",
          "priceCurrency": "EUR",
          "valueAddedTaxIncluded": false
        }
      },
      {
        "@type": "Offer",
        "name": "Refonte site expert-comptable",
        "description": "Modernisation et optimisation de site existant avec migration SEO",
        "url": "https://www.davidbarbier.com/agence-web-expert-comptable/refonte-site-internet/",
        "priceSpecification": {
          "@type": "PriceSpecification",
          "minPrice": "2000",
          "priceCurrency": "EUR",
          "valueAddedTaxIncluded": false
        }
      },
      {
        "@type": "Offer",
        "name": "SEO Expert-Comptable",
        "description": "Référencement naturel pour cabinets EC : visibilité locale et nationale",
        "priceSpecification": {
          "@type": "UnitPriceSpecification",
          "minPrice": "400",
          "priceCurrency": "EUR",
          "unitCode": "MON",
          "valueAddedTaxIncluded": false
        }
      }
    ]
  },
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "5",
    "reviewCount": "13",
    "bestRating": "5",
    "worstRating": "1"
  }
};

// JSON-LD FAQ schema
const faqStructuredData = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Pourquoi un expert-comptable a-t-il besoin d'un site internet ?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Aujourd'hui, 80% des clients recherchent leur expert-comptable en ligne. Un site professionnel est votre vitrine digitale : il rassure les prospects, présente vos services et vous différencie. C'est aussi un outil de SEO local pour apparaître sur \"expert-comptable + votre ville\"."
      }
    },
    {
      "@type": "Question",
      "name": "Combien coûte la création d'un site pour un cabinet EC ?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Un site vitrine simple démarre à 1 500€. Un site complet avec blog et fonctionnalités avancées : 3 000€ à 5 000€. Je propose toujours un devis personnalisé après avoir compris vos besoins. Pas de mauvaise surprise."
      }
    },
    {
      "@type": "Question",
      "name": "Qu'est-ce que le SEO peut apporter à mon cabinet ?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Le SEO permet d'apparaître dans les premiers résultats Google quand des prospects recherchent un expert-comptable. C'est un flux de clients qualifiés sans payer de publicité. Requêtes stratégiques : \"expert-comptable [ville]\", \"création entreprise comptable\", \"bilan annuel\"."
      }
    },
    {
      "@type": "Question",
      "name": "Pourquoi travailler avec un ancien EC mémorialiste plutôt qu'une agence ?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Je connais votre métier de l'intérieur : contraintes (périodes fiscales, déontologie), vocabulaire, attentes de vos clients. Cette compréhension permet de créer des contenus et un site qui parlent vraiment à vos prospects."
      }
    },
    {
      "@type": "Question",
      "name": "Pouvez-vous refondre mon site existant ?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Absolument. Je réalise des audits pour identifier les points d'amélioration : design, performance, SEO, contenu. Je propose soit une refonte complète, soit des optimisations ciblées selon votre budget."
      }
    },
    {
      "@type": "Question",
      "name": "Proposez-vous un accompagnement après la mise en ligne ?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Oui, je propose des contrats de maintenance pour garder votre site à jour, sécurisé et performant. Je peux aussi vous accompagner avec un suivi SEO mensuel pour améliorer continuellement votre visibilité."
      }
    }
  ]
};

// JSON-LD Breadcrumb schema
const breadcrumbStructuredData = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Accueil",
      "item": "https://www.davidbarbier.com/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Agence Web Expert-Comptable",
      "item": "https://www.davidbarbier.com/agence-web-expert-comptable/"
    }
  ]
};
---

<Layout metadata={metadata}>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(serviceStructuredData)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(faqStructuredData)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbStructuredData)} />
  </Fragment>

  <style>
    /* Utilisation des polices du site (Inter) */
    .font-editorial { font-family: var(--aw-font-heading), system-ui, sans-serif; }
    .font-body { font-family: var(--aw-font-sans), system-ui, sans-serif; }

    /* Animations d'entrée */
    @keyframes fadeInUp {
      from { opacity: 0; transform: translateY(30px); }
      to { opacity: 1; transform: translateY(0); }
    }

    @keyframes fadeInLeft {
      from { opacity: 0; transform: translateX(-30px); }
      to { opacity: 1; transform: translateX(0); }
    }

    @keyframes scaleIn {
      from { opacity: 0; transform: scale(0.95); }
      to { opacity: 1; transform: scale(1); }
    }

    @keyframes shimmer {
      0% { background-position: -200% center; }
      100% { background-position: 200% center; }
    }

    @keyframes float {
      0%, 100% { transform: translateY(0); }
      50% { transform: translateY(-10px); }
    }

    .animate-fade-up { animation: fadeInUp 0.8s ease-out forwards; }
    .animate-fade-left { animation: fadeInLeft 0.8s ease-out forwards; }
    .animate-scale { animation: scaleIn 0.6s ease-out forwards; }
    .animate-float { animation: float 6s ease-in-out infinite; }

    .delay-100 { animation-delay: 0.1s; opacity: 0; }
    .delay-200 { animation-delay: 0.2s; opacity: 0; }
    .delay-300 { animation-delay: 0.3s; opacity: 0; }
    .delay-400 { animation-delay: 0.4s; opacity: 0; }
    .delay-500 { animation-delay: 0.5s; opacity: 0; }

    /* Effet de shimmer sur les CTA */
    .btn-shimmer {
      background: linear-gradient(90deg,
        var(--btn-bg) 0%,
        var(--btn-shimmer) 50%,
        var(--btn-bg) 100%);
      background-size: 200% 100%;
      --btn-bg: rgb(21, 128, 61);
      --btn-shimmer: rgb(34, 197, 94);
    }

    .btn-shimmer:hover {
      animation: shimmer 1.5s ease-in-out infinite;
    }

    /* Ligne décorative animée */
    .decorative-line {
      position: relative;
    }

    .decorative-line::after {
      content: '';
      position: absolute;
      bottom: -8px;
      left: 0;
      width: 60px;
      height: 3px;
      background: linear-gradient(90deg, #15803d, #22c55e, #86efac);
      border-radius: 2px;
      transition: width 0.4s ease;
    }

    .decorative-line:hover::after {
      width: 100px;
    }

    /* Cartes avec transition subtile */
    .card-subtle {
      transition: all 0.3s ease;
    }

    .card-subtle:hover {
      border-color: rgba(21, 128, 61, 0.3);
    }

    .dark .card-subtle:hover {
      border-color: rgba(34, 197, 94, 0.3);
    }

    /* Numéros stylisés */
    .styled-number {
      font-family: var(--aw-font-heading), system-ui, sans-serif;
      font-size: 4rem;
      font-weight: 700;
      line-height: 1;
      background: linear-gradient(135deg, #166534 0%, #15803d 50%, #22c55e 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }

    /* Effet de soulignement progressif */
    .hover-underline {
      position: relative;
    }

    .hover-underline::after {
      content: '';
      position: absolute;
      width: 0;
      height: 2px;
      bottom: -2px;
      left: 0;
      background: linear-gradient(90deg, #15803d, #22c55e);
      transition: width 0.3s ease;
    }

    .hover-underline:hover::after {
      width: 100%;
    }

    /* Texture de fond subtile */
    .texture-bg {
      background-image:
        radial-gradient(circle at 25% 25%, rgba(21, 128, 61, 0.03) 0%, transparent 50%),
        radial-gradient(circle at 75% 75%, rgba(180, 83, 9, 0.03) 0%, transparent 50%);
    }

    /* Badge premium */
    .badge-premium {
      background: linear-gradient(135deg, #dcfce7 0%, #bbf7d0 100%);
      border: 1px solid #22c55e;
      color: #166534;
    }

    .dark .badge-premium {
      background: linear-gradient(135deg, #14532d 0%, #166534 100%);
      border-color: #22c55e;
      color: #86efac;
    }

    /* Badge accent jaune subtil */
    .badge-accent {
      background: linear-gradient(135deg, #fef9c3 0%, #fef08a 100%);
      border: 1px solid #eab308;
      color: #854d0e;
    }

    .dark .badge-accent {
      background: linear-gradient(135deg, #422006 0%, #713f12 100%);
      border-color: #ca8a04;
      color: #fde047;
    }

    /* Icônes avec cercle décoratif */
    .icon-circle {
      position: relative;
    }

    .icon-circle::before {
      content: '';
      position: absolute;
      inset: -8px;
      border-radius: 50%;
      background: linear-gradient(135deg, rgba(21, 128, 61, 0.1) 0%, rgba(180, 83, 9, 0.1) 100%);
      z-index: -1;
    }

    /* Quote stylisée */
    .quote-mark {
      font-family: Georgia, serif;
      font-size: 6rem;
      line-height: 0;
      color: rgba(21, 128, 61, 0.15);
      position: absolute;
      top: 0;
      left: -10px;
    }

    .dark .quote-mark {
      color: rgba(34, 197, 94, 0.15);
    }

    /* Séparateur stylisé */
    .styled-divider {
      display: flex;
      align-items: center;
      gap: 1rem;
    }

    .styled-divider::before,
    .styled-divider::after {
      content: '';
      flex: 1;
      height: 1px;
      background: linear-gradient(90deg, transparent, rgba(21, 128, 61, 0.3), transparent);
    }

    /* Effet de glow sur hover */
    .glow-on-hover {
      transition: all 0.3s ease;
    }

    .glow-on-hover:hover {
      box-shadow: 0 0 30px rgba(21, 128, 61, 0.3);
    }

    /* Stats counter style */
    .stat-value {
      font-family: var(--aw-font-heading), system-ui, sans-serif;
      background: linear-gradient(135deg, #166534 0%, #22c55e 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }
  </style>

  <!-- Hero Section avec design éditorial -->
  <section class="relative min-h-[90vh] flex items-center overflow-hidden texture-bg">
    <!-- Éléments décoratifs de fond -->
    <div class="absolute inset-0 overflow-hidden pointer-events-none">
      <div class="absolute -top-40 -right-40 w-96 h-96 bg-gradient-to-br from-green-100/50 to-emerald-100/30 dark:from-green-900/20 dark:to-emerald-900/10 rounded-full blur-3xl animate-float"></div>
      <div class="absolute -bottom-20 -left-20 w-72 h-72 bg-gradient-to-tr from-teal-100/40 to-green-100/20 dark:from-teal-900/10 dark:to-green-900/5 rounded-full blur-3xl" style="animation: float 8s ease-in-out infinite reverse;"></div>
    </div>

    <!-- Contenu principal -->
    <div class="relative mx-auto max-w-7xl px-6 py-20 lg:px-8">
      <div class="grid lg:grid-cols-2 gap-12 lg:gap-20 items-center">

        <!-- Colonne texte -->
        <div class="order-2 lg:order-1">
          <!-- Badge premium -->
          <div class="animate-fade-up delay-100">
            <span class="badge-premium inline-flex items-center gap-2 px-4 py-2 rounded-full text-sm font-medium font-body">
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
              </svg>
              EC Mémorialiste reconverti Développeur Web
            </span>
          </div>

          <!-- Titre principal -->
          <h1 class="mt-8 animate-fade-up delay-200">
            <span class="block font-editorial text-5xl sm:text-6xl lg:text-7xl font-bold text-gray-900 dark:text-white leading-[1.1] tracking-tight">
              Agence Web
            </span>
            <span class="block font-editorial text-4xl sm:text-5xl lg:text-6xl font-medium text-emerald-700 dark:text-emerald-400 mt-2">
              pour Experts-Comptables
            </span>
          </h1>

          <!-- Sous-titre -->
          <p class="mt-8 font-body text-xl sm:text-2xl text-gray-600 dark:text-gray-300 leading-relaxed animate-fade-up delay-300">
            Pas une simple <strong class="text-gray-900 dark:text-white">agence web pour experts-comptables</strong> — une agence digitale spécialisée, par un interlocuteur unique qui connaît votre métier de l'intérieur.
            <span class="text-green-700 dark:text-green-400">Performances et évolutivité garanties.</span>
          </p>

          <!-- Stats rapides -->
          <div class="mt-10 flex flex-wrap gap-8 animate-fade-up delay-400">
            <div class="text-center">
              <div class="stat-value text-4xl font-bold">100%</div>
              <div class="font-body text-sm text-gray-500 dark:text-gray-400 mt-1">Code sur mesure</div>
            </div>
            <div class="text-center">
              <div class="stat-value text-4xl font-bold">EC</div>
              <div class="font-body text-sm text-gray-500 dark:text-gray-400 mt-1">Ancien Mémorialiste<br/> et auditeur financier</div>
            </div>
            <div class="text-center">
              <div class="stat-value text-4xl font-bold">4</div>
              <div class="font-body text-sm text-gray-500 dark:text-gray-400 mt-1">Offres dédiées EC</div>
            </div>
          </div>

          <!-- CTA -->
          <div class="mt-10 flex flex-wrap items-center gap-4 animate-fade-up delay-500">
            <a
              href="tel:+33623565299"
              class="btn-shimmer inline-flex items-center gap-2 px-8 py-4 rounded-full text-white font-body font-semibold text-lg shadow-lg shadow-green-700/25 hover:shadow-xl hover:shadow-green-700/30 transition-all duration-300 glow-on-hover"
            >
              Discutons de votre projet
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
              </svg>
            </a>
            <a href="#offres" class="group inline-flex items-center gap-2 px-6 py-4 font-body font-medium text-gray-700 dark:text-gray-300 hover:text-green-700 dark:hover:text-green-400 transition-colors">
              Découvrir mes offres
              <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
              </svg>
            </a>
          </div>
        </div>

        <!-- Colonne image -->
        <div class="order-1 lg:order-2 w-full animate-scale delay-200">
          <div class="relative w-full">
            <!-- Cadre décoratif -->
            <div class="absolute -inset-4 bg-gradient-to-br from-green-200/50 via-transparent to-emerald-200/50 dark:from-green-800/30 dark:to-emerald-800/30 rounded-3xl transform rotate-3"></div>
            <div class="absolute -inset-4 bg-gradient-to-tr from-teal-200/30 via-transparent to-green-200/30 dark:from-teal-800/20 dark:to-green-800/20 rounded-3xl transform -rotate-2"></div>

            <!-- Image principale -->
            <div class="relative rounded-2xl overflow-hidden shadow-2xl w-full">
              <Image
                src={HeroImage}
                alt="David Barbier - Ancien expert-comptable mémorialiste devenu développeur web"
                class="w-full aspect-[4/5] object-cover grayscale"
                width={1024}
                height={1280}
              />

              <!-- Overlay gradient -->
              <div class="absolute inset-0 bg-gradient-to-t from-gray-900/60 via-transparent to-transparent"></div>

              <!-- Carte flottante -->
              <div class="absolute bottom-6 left-6 right-6 bg-white/95 dark:bg-gray-800/95 backdrop-blur-sm rounded-xl p-4 shadow-lg">
                <div class="flex items-center gap-4">
                  <div class="flex-shrink-0 w-12 h-12 bg-gradient-to-br from-green-500 to-green-700 rounded-full flex items-center justify-center">
                    <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                    </svg>
                  </div>
                  <div>
                    <div class="font-editorial font-semibold text-gray-900 dark:text-white">David Barbier</div>
                    <div class="font-body text-sm text-gray-500 dark:text-gray-400">EC Mémorialiste & Développeur Web</div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

  </section>

  <!-- Section Histoire avec design éditorial -->
  <section class="py-24 lg:py-32 bg-gradient-to-b from-gray-50 to-white dark:from-gray-900 dark:to-gray-900">
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
      <div class="grid lg:grid-cols-12 gap-12 lg:gap-20">

        <!-- Colonne gauche - Numéro et titre -->
        <div class="lg:col-span-4">
          <div class="lg:sticky lg:top-32">
            <span class="styled-number">01</span>
            <p class="font-body text-sm font-semibold tracking-widest text-amber-600 dark:text-amber-500 uppercase mt-4">Mon parcours</p>
            <h2 class="font-editorial text-3xl sm:text-4xl font-bold text-gray-900 dark:text-white mt-3 decorative-line">
              Du mémoire d'expertise comptable au code
            </h2>
          </div>
        </div>

        <!-- Colonne droite - Contenu -->
        <div class="lg:col-span-8">
          <div class="prose prose-lg dark:prose-invert max-w-none font-body">
            <p class="text-xl text-gray-600 dark:text-gray-300 leading-relaxed">
              Après plusieurs années en <strong class="text-gray-900 dark:text-white">cabinet d'expertise comptable</strong> en tant que mémorialiste et auditeur, j'ai pu faire mon expérience dans une typologie de cabinets divers (régionaux et big 4). Ma passion pour <strong class="text-gray-900 dark:text-white">l'informatique</strong> m'a rattrappé et je suis devenu développeur freelance épanoui.
            </p>

            <p class="text-gray-600 dark:text-gray-300 leading-relaxed mt-6">
              Ce besoin de créativité que je ne trouvais plus dans les chiffres, je l'exprime aujourd'hui à travers le <strong class="text-gray-900 dark:text-white">développement web</strong>. Je combine désormais ma connaissance approfondie du métier avec mes compétences techniques pour créer des solutions digitales adaptées aux cabinets.
            </p>
          </div>

          <!-- Citation mise en valeur -->
          <div class="relative mt-12 pl-8 py-6">
            <span class="quote-mark">"</span>
            <blockquote class="relative font-editorial text-2xl sm:text-3xl font-medium text-gray-900 dark:text-white italic leading-relaxed">
              Je me vois comme l'allié des cabinets locaux et des experts-comptables solopreneurs qui souhaitent rayonner.
            </blockquote>
          </div>

          <!-- Avantages en grille -->
          <div class="grid sm:grid-cols-3 gap-6 mt-12">
            <div class="card-subtle bg-white dark:bg-gray-800 rounded-2xl p-6 border border-gray-100 dark:border-gray-700">
              <div class="icon-circle inline-flex w-12 h-12 items-center justify-center rounded-full bg-green-100 dark:bg-green-900/50 text-green-700 dark:text-green-400 mb-4">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"/>
                </svg>
              </div>
              <h3 class="font-editorial font-semibold text-gray-900 dark:text-white">100% code sur mesure</h3>
              <p class="font-body text-sm text-gray-600 dark:text-gray-400 mt-2">Sites codés avec Astro, pas de template générique</p>
            </div>

            <div class="card-subtle bg-white dark:bg-gray-800 rounded-2xl p-6 border border-gray-100 dark:border-gray-700">
