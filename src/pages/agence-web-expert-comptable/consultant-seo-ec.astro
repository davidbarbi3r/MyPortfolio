---
import Layout from '../../layouts/PageLayout.astro';
import Image from '../../components/common/Image.astro';
import HeroImage from '../../assets/images/DSCF7551-3.jpg';

const metadata = {
  title: 'Consultant SEO Expert Comptable | Référencement Naturel pour Cabinet Comptable',
  description:
    'Vous êtes expert-comptable et votre site n\'attire pas de clients ? Je référence les sites de cabinets comptables sur Google. Résultats mesurables.',
};

// JSON-LD Service schema
const serviceStructuredData = {
  "@context": "https://schema.org",
  "@type": "Service",
  "@id": "https://www.davidbarbier.com/agence-web-expert-comptable/consultant-seo-ec/#service",
  "name": "Consultant SEO pour Expert-Comptable",
  "description": "Référencement naturel pour cabinets d'expertise comptable. Audit SEO, optimisation, contenu ciblé et suivi mensuel des positions.",
  "provider": {
    "@type": "Person",
    "@id": "https://www.davidbarbier.com/#person",
    "name": "David Barbier",
    "jobTitle": "Consultant SEO & ancien expert-comptable mémorialiste"
  },
  "areaServed": {
    "@type": "Country",
    "name": "France"
  },
  "serviceType": "Consultant SEO pour Expert-Comptable",
  "audience": {
    "@type": "Audience",
    "audienceType": "Experts-comptables, Cabinets comptables"
  },
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": "Offres Consultant SEO pour Expert-Comptable",
    "itemListElement": [
      {
        "@type": "Offer",
        "name": "Accompagnement SEO mensuel",
        "description": "Stratégie SEO complète avec suivi mensuel",
        "priceSpecification": {
          "@type": "UnitPriceSpecification",
          "minPrice": "400",
          "priceCurrency": "EUR",
          "unitCode": "MON",
          "valueAddedTaxIncluded": false
        }
      },
      {
        "@type": "Offer",
        "name": "Audit SEO",
        "description": "Analyse complète de votre visibilité et plan d'action",
        "price": "250",
        "priceCurrency": "EUR"
      }
    ]
  }
};

// JSON-LD FAQ schema
const faqStructuredData = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Combien de temps pour voir des résultats en SEO ?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Les premiers résultats sont généralement visibles après 3 à 4 mois de travail régulier. C'est pourquoi je recommande un engagement minimum de 6 mois. L'avantage : contrairement à la publicité, les résultats perdurent dans le temps."
      }
    },
    {
      "@type": "Question",
      "name": "Quel budget prévoir pour le référencement d'un cabinet comptable ?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "L'accompagnement SEO mensuel démarre à 400€/mois HT, incluant stratégie, optimisations et reporting. L'audit SEO à 250€ HT vous donne une feuille de route complète. Ces investissements sont rentabilisés dès l'acquisition de quelques nouveaux clients."
      }
    },
    {
      "@type": "Question",
      "name": "Sur quel type de site intervenez-vous ?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "J'interviens sur tous les types de sites : WordPress, Wix, Squarespace, sites sur-mesure. L'audit initial permet d'identifier les leviers disponibles selon votre plateforme."
      }
    },
    {
      "@type": "Question",
      "name": "Quelle différence avec une agence SEO généraliste ?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Une agence généraliste doit apprendre votre métier avant de pouvoir travailler efficacement. Ancien expert-comptable mémorialiste, je connais déjà le vocabulaire (liasse fiscale, bilan, commissariat aux comptes), les requêtes de vos clients et les contraintes de la profession. Pas de courbe d'apprentissage = résultats plus rapides."
      }
    }
  ]
};

// JSON-LD Breadcrumb schema
const breadcrumbStructuredData = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Accueil",
      "item": "https://www.davidbarbier.com"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Agence Web Expert-Comptable",
      "item": "https://www.davidbarbier.com/agence-web-expert-comptable/"
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": "SEO Expert-Comptable",
      "item": "https://www.davidbarbier.com/agence-web-expert-comptable/consultant-seo-ec/"
    }
  ]
};
---

<Layout metadata={metadata}>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(serviceStructuredData)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(faqStructuredData)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbStructuredData)} />
  </Fragment>

  <!-- Bloc 1 : Le problème (above the fold) -->
  <section class="relative isolate overflow-hidden dark:bg-[#030620]">
    <!-- Fil d'Ariane -->
    <div class="mx-auto max-w-7xl px-6 pt-8 lg:px-8">
      <nav aria-label="Fil d'Ariane" class="text-sm font-body">
        <ol class="flex items-center gap-2 text-gray-500 dark:text-gray-400 flex-wrap">
          <li><a href="/" class="hover:text-green-700 dark:hover:text-green-400 transition-colors">Accueil</a></li>
          <li><svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg></li>
          <li><a href="/agence-web-expert-comptable/" class="hover:text-green-700 dark:hover:text-green-400 transition-colors">Agence Web EC</a></li>
          <li><svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg></li>
          <li class="text-gray-900 dark:text-white font-medium">SEO Expert-Comptable</li>
        </ol>
      </nav>
    </div>

    <div class="mx-auto max-w-7xl px-6 pb-24 pt-4 sm:pb-12 lg:flex lg:px-8 lg:py-16">
      <div class="mx-auto max-w-2xl lg:mx-0 lg:shrink-0 lg:pt-8">
        <!-- Badge -->
        <div class="mt-8 sm:mt-16 lg:mt-8">
          <span class="inline-flex items-center">
            <span
              class="rounded-full bg-green-800/10 dark:bg-gray-700 px-3 py-1 text-sm font-semibold text-brown ring-1 ring-inset ring-green-950/10 mb-8"
            >
              Par un ancien EC mémorialiste
            </span>
          </span>
        </div>

        <!-- Titre principal -->
        <h1
          class="mt-10 text-pretty font-heading text-4xl font-semibold tracking-tight text-green-950 sm:text-5xl dark:text-white"
        >
          Référencement naturel pour experts comptables
        </h1>

        <!-- Bloc problème -->
        <h2 class="mt-6 text-pretty text-xl font-semibold text-gray-700 dark:text-gray-300">
          Pourquoi le site de votre cabinet n'apparaît pas sur Google
        </h2>
        <p class="mt-4 text-pretty text-lg text-gray-600 dark:text-gray-300">
          La plupart des cabinets ont un site. Presque aucun ne reçoit de clients grâce à lui.
          Votre site existe, mais il n'est pas trouvé — ni par vos prospects, ni par Google.
          Je m'occupe de ça pour vous.
        </p>

        <!-- Call-to-action -->
        <div class="mt-10 flex items-center gap-x-6">
          <a
            href="tel:+33623565299"
            class="rounded-md bg-green-700 px-4 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-green-700/90 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brown"
          >
            Demander un audit gratuit
          </a>
          <a href="#services" class="inline-flex items-center gap-2 text-sm font-semibold text-gray-900 dark:text-gray-300 whitespace-nowrap">
            Découvrir l'offre SEO <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
          </a>
        </div>
      </div>

      <!-- Image à droite -->
      <div class="mx-auto mt-16 flex max-w-2xl lg:ml-10 lg:mr-0 lg:mt-0 lg:max-w-none xl:ml-32">
        <div class="max-w-3xl flex-none sm:max-w-5xl lg:max-w-none">
          <div
            class="-m-2 rounded-xl bg-gray-900/5 p-2 ring-1 ring-inset ring-gray-900/10 lg:-m-4 lg:rounded-2xl lg:p-4"
          >
            <img
              src="https://imagedelivery.net/4zDfTa1ovbR8nr2bLQ6Mxg/af43940c-7bc0-4088-bd7a-6f7002f9b200/public"
              alt="Visualisation des performances SEO dans la Google Search Console"
              class="w-[76rem] rounded-md shadow-2xl ring-1 ring-gray-900/10 max-h-[80vh] object-contain object-left"
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Bloc 2 : Ce que comprend le référencement -->
  <section class="px-6 py-16 lg:px-8 bg-green-50 dark:bg-gray-900" id="services">
    <div class="mx-auto max-w-3xl text-base/7">
      <p class="text-base/7 font-semibold text-green-950 dark:text-green-300">La prestation concrète</p>
      <h2 class="mt-2 text-pretty text-3xl font-semibold tracking-tight text-gray-900 dark:text-gray-300 sm:text-4xl scroll-mt-32">
        Ce que comprend le référencement du site de votre cabinet comptable
      </h2>

      <p class="mt-6 text-xl/8 text-gray-700 dark:text-gray-300">
        Je prends en charge l'ensemble du référencement de votre cabinet pendant que vous vous concentrez sur vos missions.
      </p>

      <ul role="list" class="mt-8 max-w-xl space-y-6 text-gray-600 dark:text-gray-300">
        <li class="flex gap-x-3">
          <svg class="mt-1 size-5 flex-none text-green-800 dark:text-green-300" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
            <path fill-rule="evenodd" d="M10 18a8 8 0 1 0 0-16 8 8 0 0 0 0 16Zm3.857-9.809a.75.75 0 0 0-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 1 0-1.06 1.061l2.5 2.5a.75.75 0 0 0 1.137-.089l4-5.5Z" clip-rule="evenodd"></path>
          </svg>
          <span>
            <span class="font-semibold text-gray-900 dark:text-gray-100">Audit SEO du site existant</span> — état des lieux complet de votre visibilité actuelle
          </span>
        </li>
        <li class="flex gap-x-3">
          <svg class="mt-1 size-5 flex-none text-green-800 dark:text-green-300" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
            <path fill-rule="evenodd" d="M10 18a8 8 0 1 0 0-16 8 8 0 0 0 0 16Zm3.857-9.809a.75.75 0 0 0-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 1 0-1.06 1.061l2.5 2.5a.75.75 0 0 0 1.137-.089l4-5.5Z" clip-rule="evenodd"></path>
          </svg>
          <span>
            <span class="font-semibold text-gray-900 dark:text-gray-100">Optimisation des pages</span> — vitesse, structure, balisage et mots-clés de votre cabinet
          </span>
        </li>
        <li class="flex gap-x-3">
          <svg class="mt-1 size-5 flex-none text-green-800 dark:text-green-300" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
            <path fill-rule="evenodd" d="M10 18a8 8 0 1 0 0-16 8 8 0 0 0 0 16Zm3.857-9.809a.75.75 0 0 0-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 1 0-1.06 1.061l2.5 2.5a.75.75 0 0 0 1.137-.089l4-5.5Z" clip-rule="evenodd"></path>
          </svg>
          <span>
            <span class="font-semibold text-gray-900 dark:text-gray-100">Création de contenu ciblé</span> — pages et articles sur les requêtes de vos prospects (liasse fiscale, bilan, création société…)
          </span>
        </li>
        <li class="flex gap-x-3">
          <svg class="mt-1 size-5 flex-none text-green-800 dark:text-green-300" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
            <path fill-rule="evenodd" d="M10 18a8 8 0 1 0 0-16 8 8 0 0 0 0 16Zm3.857-9.809a.75.75 0 0 0-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 1 0-1.06 1.061l2.5 2.5a.75.75 0 0 0 1.137-.089l4-5.5Z" clip-rule="evenodd"></path>
          </svg>
          <span>
            <span class="font-semibold text-gray-900 dark:text-gray-100">Suivi mensuel des positions</span> — reporting clair, vous voyez vos progrès sans jargon
          </span>
        </li>
      </ul>
    </div>

    <div class="mx-auto max-w-3xl mt-12">
      <div class="mx-auto max-w-2xl lg:text-center">
        <p class="text-lg/8 text-gray-600 dark:text-gray-300">
          Une action commune sur les 3 piliers suivants est la clé d'un site bien référencé :
        </p>
      </div>
      <div class="mx-auto mt-6 max-w-2xl sm:mt-12 lg:mt-16 lg:max-w-none">
        <dl class="grid max-w-xl grid-cols-1 gap-x-8 gap-y-16 lg:max-w-none lg:grid-cols-3">
          <div class="flex flex-col">
            <dt class="flex items-center gap-x-3 text-base/7 font-semibold text-gray-900 dark:text-gray-300">
              <svg class="size-5 flex-none text-green-800" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                <path fill-rule="evenodd" d="M5.5 17a4.5 4.5 0 0 1-1.44-8.765 4.5 4.5 0 0 1 8.302-3.046 3.5 3.5 0 0 1 4.504 4.272A4 4 0 0 1 15 17H5.5Z" clip-rule="evenodd"></path>
              </svg>
              Technique
            </dt>
            <dd class="mt-4 flex flex-auto flex-col text-base/7 text-gray-600 dark:text-gray-300">
              <p class="flex-auto">
                Vitesse, structure, mobile, balisage sémantique. Une base technique solide pour que Google comprenne et valorise votre contenu.
              </p>
            </dd>
          </div>
          <div class="flex flex-col">
            <dt class="flex items-center gap-x-3 text-base/7 font-semibold text-gray-900 dark:text-gray-300">
              <svg class="size-5 flex-none text-green-800" viewBox="0 0 20 20" fill="currentColor">
                <path d="M10 1a4.5 4.5 0 0 0-4.5 4.5V9H5a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-6a2 2 0 0 0-2-2h-.5V5.5A4.5 4.5 0 0 0 10 1Z"></path>
              </svg>
              Contenu
            </dt>
            <dd class="mt-4 flex flex-auto flex-col text-base/7 text-gray-600 dark:text-gray-300">
              <p class="flex-auto">
                Fini les articles génériques. On cible les requêtes exactes que tapent vos prospects : par besoin, par statut, par ville.
              </p>
            </dd>
          </div>
          <div class="flex flex-col">
            <dt class="flex items-center gap-x-3 text-base/7 font-semibold text-gray-900 dark:text-gray-300">
              <svg class="size-5 flex-none text-green-800 dark:text-green-300" viewBox="0 0 20 20" fill="currentColor">
                <path d="M15.312 11.424a5.5 5.5 0 0 1-9.201 2.466l-.312-.311h2.433a.75.75 0 0 0 0-1.5H3.989a.75.75 0 0 0-.75.75v4.242a.75.75 0 0 0 1.5 0l.31.31a7 7 0 0 0 11.712-3.138.75.75 0 0 0-1.449-.39Z"></path>
              </svg>
              Autorité
            </dt>
            <dd class="mt-4 flex flex-auto flex-col text-base/7 text-gray-600 dark:text-gray-300">
              <p class="flex-auto">
                Maillage interne optimisé et acquisition de liens de qualité pour renforcer la crédibilité de votre site aux yeux de Google.
              </p>
            </dd>
          </div>
        </dl>
      </div>
    </div>
  </section>

  <!-- Bloc 3 : Pourquoi un spécialiste secteur -->
  <section class="px-6 py-16 lg:px-8">
    <div class="mx-auto max-w-3xl text-base/7">
      <p class="text-base/7 font-semibold text-green-950 dark:text-green-300">Expertise unique</p>
      <h2 class="mt-2 text-pretty text-3xl font-semibold tracking-tight text-gray-900 dark:text-gray-300 sm:text-4xl">
        Pourquoi choisir un consultant SEO spécialisé en expertise comptable
      </h2>

      <p class="mt-6 text-xl/8">
        Une agence généraliste doit apprendre votre métier avant de commencer à travailler.
        Ancien expert-comptable mémorialiste et auditeur financier, je connais déjà votre secteur de l'intérieur.
      </p>

      <div class="mt-10 max-w-2xl">
        <ul role="list" class="mt-6 max-w-xl space-y-4 text-gray-600 dark:text-gray-300">
          <li class="flex gap-x-3">
            <span class="font-semibold text-gray-900 dark:text-gray-100">→</span>
            <span>Je connais le vocabulaire métier : bilan, liasse fiscale, IS/IR, commissariat aux comptes…</span>
          </li>
          <li class="flex gap-x-3">
            <span class="font-semibold text-gray-900 dark:text-gray-100">→</span>
            <span>Je sais ce que tapent vos clients sur Google avant de choisir un expert-comptable</span>
          </li>
          <li class="flex gap-x-3">
            <span class="font-semibold text-gray-900 dark:text-gray-100">→</span>
            <span>Je peux créer du contenu expert qui vous positionne comme référence dans votre zone</span>
          </li>
          <li class="flex gap-x-3">
            <span class="font-semibold text-gray-900 dark:text-gray-100">→</span>
            <span><strong>Pas de courbe d'apprentissage = résultats plus rapides</strong></span>
          </li>
        </ul>
      </div>
    </div>
  </section>

  <!-- Bloc 4 : Résultats obtenus -->
  <section class="px-6 py-16 lg:px-8 bg-green-50 dark:bg-gray-900">
    <div class="mx-auto max-w-3xl text-base/7">
      <p class="text-base/7 font-semibold text-green-950 dark:text-green-300">Preuve concrète</p>
      <h2 class="mt-2 text-pretty text-3xl font-semibold tracking-tight text-gray-900 dark:text-gray-300 sm:text-4xl">
        Résultats obtenus pour des cabinets comptables
      </h2>

      <p class="mt-6 text-xl/8">
        Ce site (davidbarbier.com) est lui-même la démonstration de la méthode. Positionné sur des requêtes compétitives
        dans le secteur de l'expertise comptable, il génère des contacts entrants chaque semaine — sans publicité.
      </p>

      <div class="mt-10 grid sm:grid-cols-3 gap-8">
        <div class="bg-white dark:bg-gray-800 rounded-xl p-6 text-center shadow-sm ring-1 ring-gray-200 dark:ring-gray-700">
          <p class="text-4xl font-bold text-green-800 dark:text-green-400">+150</p>
          <p class="mt-2 text-sm text-gray-600 dark:text-gray-300">mots-clés positionnés sur le secteur EC</p>
        </div>
        <div class="bg-white dark:bg-gray-800 rounded-xl p-6 text-center shadow-sm ring-1 ring-gray-200 dark:ring-gray-700">
          <p class="text-4xl font-bold text-green-800 dark:text-green-400">100%</p>
          <p class="mt-2 text-sm text-gray-600 dark:text-gray-300">acquisition organique, sans budget pub</p>
        </div>
        <div class="bg-white dark:bg-gray-800 rounded-xl p-6 text-center shadow-sm ring-1 ring-gray-200 dark:ring-gray-700">
          <p class="text-4xl font-bold text-green-800 dark:text-green-400">0€</p>
          <p class="mt-2 text-sm text-gray-600 dark:text-gray-300">dépensé en publicité Google ou Meta</p>
        </div>
      </div>

      <blockquote class="mt-10 border-l-4 border-green-800 pl-8 font-semibold text-gray-900 dark:text-gray-100">
        <p>
          "Quelques nouveaux clients par an suffisent à rentabiliser un accompagnement SEO. Le reste, c'est du bonus pour votre cabinet."
        </p>
      </blockquote>
    </div>
  </section>

  <!-- Bloc 5 : Process -->
  <section class="px-6 py-16 lg:px-8">
    <div class="mx-auto max-w-7xl">
      <p class="text-base/7 font-semibold text-green-950 dark:text-green-300">Simple et sans friction</p>
      <h2 class="mt-2 text-pretty text-3xl font-semibold tracking-tight text-gray-900 dark:text-gray-300 sm:text-4xl">
        Comment se passe une mission SEO pour votre cabinet
      </h2>

      <div class="px-4 py-12 mx-auto md:px-12 lg:px-0 max-w-7xl mt-6">
        <dl class="grid grid-cols-1 gap-x-4 gap-y-12 lg:grid-cols-3 lg:divide-x lg:border-x">
          <div class="lg:px-8">
            <div class="text-brown flex gap-3 items-center">
              <span>1.</span>
              <dt class="tracking-tight text-lg font-medium">
                <h3 class="text-xl font-medium">Audit gratuit de votre site</h3>
              </dt>
            </div>
            <dd class="mt-2">
              <p class="text-base text-gray-600 dark:text-gray-300">
                Vous renseignez votre site dans le formulaire ci-dessous. Je vous envoie une analyse de votre visibilité actuelle, sans engagement.
              </p>
            </dd>
          </div>

          <div class="lg:px-8">
            <div class="text-brown flex gap-3 items-center">
              <span>2.</span>
              <dt class="tracking-tight text-lg font-medium">
                <h3 class="text-xl font-medium">Stratégie personnalisée</h3>
              </dt>
            </div>
            <dd class="mt-2">
              <p class="text-base text-gray-600 dark:text-gray-300">
                Étude de vos concurrents locaux, sélection des mots-clés prioritaires, calendrier adapté à votre activité.
              </p>
            </dd>
          </div>

          <div class="lg:px-8">
            <div class="text-brown flex gap-3 items-center">
              <span>3.</span>
              <dt class="tracking-tight text-lg font-medium">
                <h3 class="text-xl font-medium">Mise en œuvre + suivi</h3>
              </dt>
            </div>
            <dd class="mt-2">
              <p class="text-base text-gray-600 dark:text-gray-300">
                Actions mensuelles sur les 3 piliers SEO. Reporting clair chaque mois, vous voyez les positions progresser.
              </p>
            </dd>
          </div>
        </dl>
      </div>
    </div>
  </section>

  <!-- CTA final -->
  <section class="px-6 py-16 lg:px-8 bg-green-50 dark:bg-gray-900">
    <div class="mx-auto max-w-7xl">
      <div class="md:flex md:gap-12 md:items-center">
        <div class="md:w-1/3 space-y-8">
          <div class="flex flex-col items-center">
            <Image
              src={HeroImage}
              height={192}
              width={192}
