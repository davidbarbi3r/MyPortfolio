---
import Layout from '../../layouts/PageLayout.astro';
import Image from '../../components/common/Image.astro';
import LeadMagnetForm from '../../components/widgets/LeadMagnetForm.astro';
import HeroImage from '../../assets/images/DSCF7551-3.jpg';
import MontegrappaFx from '~/components/animations/MontegrappaFx.astro';
import PillBadge from '~/components/ui/PillBadge.astro';
import StatBig from '~/components/ui/StatBig.astro';
import SectionHeader from '~/components/ui/SectionHeader.astro';
import ArrowLink from '~/components/ui/ArrowLink.astro';
import ArrowRight from '~/components/ui/ArrowRight.astro';
import FaqItems from '~/components/ui/FaqItems.astro';

const metadata = {
  title: 'Consultant SEO Expert Comptable | Référencement Naturel pour Cabinet Comptable',
  description:
    'Vous êtes expert-comptable et votre site n\'attire pas de clients ? Je référence les sites de cabinets comptables sur Google. Résultats mesurables.',
};

// JSON-LD Service schema
const serviceStructuredData = {
  "@context": "https://schema.org",
  "@type": "Service",
  "@id": "https://www.davidbarbier.com/agence-web-expert-comptable/consultant-seo-ec/#service",
  "name": "Consultant SEO pour Expert-Comptable",
  "description": "Référencement naturel pour cabinets d'expertise comptable. Audit SEO, optimisation, contenu ciblé et suivi mensuel des positions.",
  "provider": {
    "@type": "Person",
    "@id": "https://www.davidbarbier.com/#person",
    "name": "David Barbier",
    "jobTitle": "Consultant SEO & ancien expert-comptable mémorialiste"
  },
  "areaServed": {
    "@type": "Country",
    "name": "France"
  },
  "serviceType": "Consultant SEO pour Expert-Comptable",
  "audience": {
    "@type": "Audience",
    "audienceType": "Experts-comptables, Cabinets comptables"
  },
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": "Offres Consultant SEO pour Expert-Comptable",
    "itemListElement": [
      {
        "@type": "Offer",
        "name": "Accompagnement SEO mensuel",
        "description": "Stratégie SEO complète avec suivi mensuel",
        "priceSpecification": {
          "@type": "UnitPriceSpecification",
          "minPrice": "490",
          "priceCurrency": "EUR",
          "unitCode": "MON",
          "valueAddedTaxIncluded": false
        }
      },
      {
        "@type": "Offer",
        "name": "Audit SEO",
        "description": "Analyse complète de votre visibilité et plan d'action",
        "price": "690",
        "priceCurrency": "EUR"
      }
    ]
  },
};

// JSON-LD FAQ schema
const faqStructuredData = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Combien de temps pour voir des résultats en SEO ?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Les premiers résultats sont généralement visibles après 3 à 4 mois de travail régulier. C'est pourquoi je recommande un engagement minimum de 6 mois. L'avantage : contrairement à la publicité, les résultats perdurent dans le temps."
      }
    },
    {
      "@type": "Question",
      "name": "Quel budget prévoir pour le référencement d'un cabinet comptable ?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "L'accompagnement SEO mensuel démarre à 490€/mois HT (TJM 490€/jour, 1 à 3 jours/mois selon l'ampleur de votre cabinet). L'audit SEO complet à 690€ HT vous donne une feuille de route à suivre en autonomie. Pour commencer sans engagement : demi-journée à 245€ HT ou journée à 490€ HT. Si votre cabinet a un bureau physique visible, le suivi mensuel Google Business Profile à 100€/mois HT maintient votre visibilité locale. Ces investissements sont rentabilisés dès l'acquisition de quelques nouveaux clients."
      }
    },
    {
      "@type": "Question",
      "name": "Sur quel type de site intervenez-vous ?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "J'interviens sur tous les types de sites : WordPress, Wix, Squarespace, sites sur-mesure. L'audit initial permet d'identifier les leviers disponibles selon votre plateforme."
      }
    },
    {
      "@type": "Question",
      "name": "Quelle différence avec une agence SEO généraliste ?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Une agence généraliste doit apprendre votre métier avant de pouvoir travailler efficacement. Ancien expert-comptable mémorialiste, je connais déjà le vocabulaire (liasse fiscale, bilan, commissariat aux comptes), les requêtes de vos clients et les contraintes de la profession. Pas de courbe d'apprentissage = résultats plus rapides."
      }
    }
  ]
};

// JSON-LD Breadcrumb schema
const breadcrumbStructuredData = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Accueil",
      "item": "https://www.davidbarbier.com/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Agence Web Expert-Comptable",
      "item": "https://www.davidbarbier.com/agence-web-expert-comptable/"
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": "SEO Expert-Comptable",
      "item": "https://www.davidbarbier.com/agence-web-expert-comptable/consultant-seo-ec/"
    }
  ]
};

// Prestations incluses : partie en gras + suite de phrase (textes d'origine verbatim)
const SERVICES_INCLUS = [
  { strong: 'Audit SEO du site existant', rest: '- état des lieux complet de votre visibilité actuelle' },
  { strong: 'Optimisation des pages', rest: '- vitesse, structure, balisage et mots-clés de votre cabinet' },
  {
    strong: 'Création de contenu ciblé',
    rest: '- pages et articles sur les requêtes de vos prospects (liasse fiscale, bilan, création société…)',
  },
  { strong: 'Suivi mensuel des positions', rest: '- reporting clair, vous voyez vos progrès sans jargon' },
];

// Les 3 étapes de la mission
const PROCESS_STEPS = [
  {
    num: '1.',
    title: 'Audit gratuit de votre site',
    text: 'Vous renseignez votre site dans le formulaire ci-dessous. Je vous envoie une analyse de votre visibilité actuelle, sans engagement.',
  },
  {
    num: '2.',
    title: 'Stratégie personnalisée',
    text: 'Étude de vos concurrents locaux, sélection des mots-clés prioritaires, calendrier adapté à votre activité.',
  },
  {
    num: '3.',
    title: 'Mise en œuvre + suivi',
    text: 'Actions mensuelles sur les 3 piliers SEO. Reporting clair chaque mois, vous voyez les positions progresser.',
  },
];

// Arguments du bloc audit gratuit : partie en gras + suite de phrase
const AUDIT_POINTS = [
  { strong: 'Gratuit et sans engagement', rest: '- analyse envoyée sous 48h' },
  { strong: 'Résultats mesurables', rest: '- positions Google, trafic, leads générés' },
  { strong: 'Tarifs transparents', rest: '- accompagnement mensuel à partir de 490€/mois HT' },
];

// FAQ affichée : réponses en HTML de confiance (paragraphes + liste), rendues par FaqItems via set:html.
const SEO_FAQ = [
  {
    q: 'Combien de temps pour voir des résultats ?',
    a: `<p>Les premiers résultats sont généralement visibles après 3 à 4 mois de travail régulier. C'est pourquoi je recommande un engagement minimum de 6 mois pour mon accompagnement mensuel. L'avantage du référencement naturel : contrairement à la publicité, les positions gagnées perdurent dans le temps.</p>`,
  },
  {
    q: 'Quel budget prévoir ?',
    a: `<p>Toutes les formules sont transparentes, HT, sans frais caché :</p><ul class="list-disc ml-6 space-y-2"><li><strong>Accompagnement SEO mensuel</strong> à <strong>490€/jour HT</strong> - 1 à 3 jours/mois selon l'ampleur de votre cabinet (à partir de 490€/mois, engagement 6 mois, stratégie + optimisations + contenu + reporting)</li><li><strong>Audit SEO complet</strong> à <strong>690€ HT</strong> - feuille de route détaillée à suivre en autonomie</li><li><strong>Demi-journée / Journée ponctuelle</strong> : 245€ / 490€ HT - pour un besoin ciblé sans engagement</li><li><strong>Suivi mensuel Google Business Profile</strong> à <strong>100€/mois HT</strong> - animation continue de votre fiche (posts, avis, monitoring), utile si votre cabinet a un bureau physique visible</li></ul><p>Ces investissements sont généralement rentabilisés dès l'acquisition de quelques nouveaux clients.</p>`,
  },
  {
    q: 'Vous intervenez sur quel type de site ?',
    a: `<p>J'interviens sur tous les types de sites : WordPress, Wix, Squarespace, Webflow, ou site développé sur mesure. L'audit initial permet d'identifier les leviers disponibles selon votre plateforme et de prioriser les actions à fort impact.</p>`,
  },
  {
    q: 'Quelle différence avec une agence SEO généraliste ?',
    a: `<p>Une agence généraliste doit apprendre votre métier avant de commencer. Ancien expert-comptable mémorialiste, je connais déjà le vocabulaire (liasse fiscale, bilan, commissariat aux comptes), les requêtes de vos clients et les spécificités de la profession.</p><p>Pas de courbe d'apprentissage = résultats plus rapides, contenus plus pertinents, et aucune explication à fournir sur votre métier.</p>`,
  },
];
---

<Layout metadata={metadata}>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(serviceStructuredData)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(faqStructuredData)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbStructuredData)} />
  </Fragment>

  <!-- Bloc 1 : Le problème (above the fold) -->
  <section class="relative bg-cream overflow-hidden">
    <!-- Fil d'Ariane -->
    <div class="mx-auto max-w-6xl px-4 sm:px-6 pt-8">
      <nav aria-label="Fil d'Ariane" class="text-sm">
        <ol class="flex items-center gap-2 text-muted flex-wrap">
          <li><a href="/" class="hover:text-sage-dark transition-colors">Accueil</a></li>
          <li><svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg></li>
          <li><a href="/agence-web-expert-comptable/" class="hover:text-sage-dark transition-colors">Agence Web EC</a></li>
          <li><svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg></li>
          <li class="text-charcoal font-medium">SEO Expert-Comptable</li>
        </ol>
      </nav>
    </div>

    <div class="mx-auto max-w-6xl px-4 sm:px-6 py-16 md:py-24">
      <div class="grid lg:grid-cols-2 gap-12 lg:gap-20 items-center">

        <!-- Colonne texte -->
        <div>
          <p data-fade-up><PillBadge text="Par un ancien EC mémorialiste" /></p>

          <!-- Titre principal -->
          <h1 class="mt-8 text-charcoal text-[clamp(2.4rem,4.5vw,3.75rem)] leading-[1.05] tracking-tight" data-fade-up>
            Référencement naturel pour experts comptables
          </h1>

          <!-- Bloc problème -->
          <h2 class="mt-6 text-xl sm:text-2xl font-medium text-charcoal" data-fade-up>
            Pourquoi le site de votre cabinet n'apparaît pas sur Google
          </h2>
          <p class="mt-4 text-lg text-muted leading-relaxed" data-fade-up>
            La plupart des cabinets ont un site. Presque aucun ne reçoit de clients grâce à lui.
            Votre site existe, mais il n'est pas trouvé - ni par vos prospects, ni par Google.
            Je m'occupe de ça pour vous.
          </p>

          <!-- Call-to-action -->
          <div class="mt-10 flex flex-wrap items-center gap-6" data-fade-up>
            <a href="tel:+33623565299" class="btn btn-primary gap-2">
              Demander un audit gratuit
              <ArrowRight class="w-5 h-5" />
            </a>
            <ArrowLink href="#services" text="Découvrir l'offre SEO" />
          </div>
        </div>

        <!-- Colonne image -->
        <div class="w-full" data-fade-up>
          <div class="rounded-xl border border-black/10 bg-white/60 p-2 overflow-hidden">
            <img
              src="https://imagedelivery.net/4zDfTa1ovbR8nr2bLQ6Mxg/af43940c-7bc0-4088-bd7a-6f7002f9b200/public"
              alt="Visualisation des performances SEO dans la Google Search Console"
              class="w-full rounded-lg max-h-[80vh] object-contain object-left"
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Bloc 2 : Ce que comprend le référencement -->
  <section class="py-16 md:py-24 bg-sand scroll-mt-24" id="services">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <div class="max-w-3xl">
        <SectionHeader number="01" kicker="La prestation concrète" align="left">
          Ce que comprend le référencement du site de votre cabinet comptable
        </SectionHeader>

        <p class="mt-6 text-xl text-muted leading-relaxed">
          Je prends en charge l'ensemble du référencement de votre cabinet pendant que vous vous concentrez sur vos missions.
        </p>

        <ul role="list" class="mt-8 max-w-xl space-y-6 text-default" data-fade-up>
          {SERVICES_INCLUS.map((item) => (
            <li class="flex gap-x-3">
              <span class="text-sage-dark flex-shrink-0">✓</span>
              <span>
                <span class="font-semibold text-charcoal">{item.strong}</span> {item.rest}
              </span>
            </li>
          ))}
        </ul>
      </div>

      <div class="mt-16">
        <p class="text-lg text-muted text-center max-w-2xl mx-auto">
          Une action commune sur les 3 piliers suivants est la clé d'un site bien référencé :
        </p>
        <dl class="mt-12 grid md:grid-cols-3 gap-6">
          <div class="rounded-xl border border-black/10 bg-cream p-6" data-fade-up>
            <dt class="flex items-center gap-x-3 font-medium text-charcoal">
              <span class="inline-flex w-10 h-10 flex-none items-center justify-center rounded-full bg-sage/15 text-sage-dark">
                <svg class="w-5 h-5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                  <path fill-rule="evenodd" d="M5.5 17a4.5 4.5 0 0 1-1.44-8.765 4.5 4.5 0 0 1 8.302-3.046 3.5 3.5 0 0 1 4.504 4.272A4 4 0 0 1 15 17H5.5Z" clip-rule="evenodd"></path>
                </svg>
              </span>
              Technique
            </dt>
            <dd class="mt-4 text-muted leading-relaxed">
              <p>
                Vitesse, structure, mobile, balisage sémantique. Une base technique solide pour que Google comprenne et valorise votre contenu.
              </p>
            </dd>
          </div>
          <div class="rounded-xl border border-black/10 bg-cream p-6" data-fade-up>
            <dt class="flex items-center gap-x-3 font-medium text-charcoal">
              <span class="inline-flex w-10 h-10 flex-none items-center justify-center rounded-full bg-sage/15 text-sage-dark">
                <svg class="w-5 h-5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                  <path d="M10 1a4.5 4.5 0 0 0-4.5 4.5V9H5a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-6a2 2 0 0 0-2-2h-.5V5.5A4.5 4.5 0 0 0 10 1Z"></path>
                </svg>
              </span>
              Contenu
            </dt>
            <dd class="mt-4 text-muted leading-relaxed">
              <p>
                Fini les articles génériques. On cible les requêtes exactes que tapent vos prospects : par besoin, par statut, par ville.
              </p>
            </dd>
          </div>
          <div class="rounded-xl border border-black/10 bg-cream p-6" data-fade-up>
            <dt class="flex items-center gap-x-3 font-medium text-charcoal">
              <span class="inline-flex w-10 h-10 flex-none items-center justify-center rounded-full bg-sage/15 text-sage-dark">
                <svg class="w-5 h-5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                  <path d="M15.312 11.424a5.5 5.5 0 0 1-9.201 2.466l-.312-.311h2.433a.75.75 0 0 0 0-1.5H3.989a.75.75 0 0 0-.75.75v4.242a.75.75 0 0 0 1.5 0l.31.31a7 7 0 0 0 11.712-3.138.75.75 0 0 0-1.449-.39Z"></path>
                </svg>
              </span>
              Autorité
            </dt>
            <dd class="mt-4 text-muted leading-relaxed">
              <p>
                Maillage interne optimisé et acquisition de liens de qualité pour renforcer la crédibilité de votre site aux yeux de Google.
              </p>
            </dd>
          </div>
        </dl>
      </div>
    </div>
  </section>

  <!-- Bloc 3 : Pourquoi un spécialiste secteur -->
  <section class="py-16 md:py-24 bg-cream">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <div class="max-w-3xl">
        <SectionHeader number="02" kicker="Expertise unique" align="left">
          Pourquoi choisir un consultant SEO spécialisé en expertise comptable
        </SectionHeader>

        <p class="mt-6 text-xl text-muted leading-relaxed">
          Une agence généraliste doit apprendre votre métier avant de commencer à travailler.
          Ancien expert-comptable mémorialiste et auditeur financier, je connais déjà votre secteur de l'intérieur.
        </p>

        <ul role="list" class="mt-10 max-w-xl space-y-4 text-default" data-fade-up>
          <li class="flex gap-x-3">
            <span class="font-semibold text-sage-dark flex-shrink-0">→</span>
            <span>Je connais le vocabulaire métier : bilan, liasse fiscale, IS/IR, commissariat aux comptes…</span>
          </li>
          <li class="flex gap-x-3">
            <span class="font-semibold text-sage-dark flex-shrink-0">→</span>
            <span>Je sais ce que tapent vos clients sur Google avant de choisir un expert-comptable</span>
          </li>
          <li class="flex gap-x-3">
            <span class="font-semibold text-sage-dark flex-shrink-0">→</span>
            <span>Je peux créer du contenu expert qui vous positionne comme référence dans votre zone</span>
          </li>
          <li class="flex gap-x-3">
            <span class="font-semibold text-sage-dark flex-shrink-0">→</span>
            <span><strong class="text-charcoal">Pas de courbe d'apprentissage = résultats plus rapides</strong></span>
          </li>
        </ul>
      </div>
    </div>
  </section>

  <!-- Bloc 4 : Résultats obtenus -->
  <section class="py-16 md:py-24 bg-sand">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <div class="max-w-3xl">
        <SectionHeader number="03" kicker="Preuve concrète" align="left">
          Résultats obtenus pour des cabinets comptables
        </SectionHeader>

        <p class="mt-6 text-xl text-muted leading-relaxed">
          Ce site (davidbarbier.com) est lui-même la démonstration de la méthode. Positionné sur des requêtes compétitives
          dans le secteur de l'expertise comptable, il génère des contacts entrants chaque semaine - sans publicité.
        </p>
      </div>

      <div class="mt-12 grid sm:grid-cols-3 gap-8">
        <StatBig value="+150" label="mots-clés positionnés sur le secteur EC" size="md" />
        <StatBig value="100%" label="acquisition organique, sans budget pub" size="md" />
        <StatBig value="0€" label="dépensé en publicité Google ou Meta" size="md" />
      </div>

      <blockquote class="mt-12 max-w-3xl text-xl sm:text-2xl font-light text-charcoal italic leading-relaxed" data-fade-up>
        <p>
          "Quelques nouveaux clients par an suffisent à rentabiliser un accompagnement SEO. Le reste, c'est du bonus pour votre cabinet."
        </p>
      </blockquote>
    </div>
  </section>

  <!-- Bloc 5 : Process -->
  <section class="py-16 md:py-24 bg-cream">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <div class="max-w-3xl">
        <SectionHeader number="04" kicker="Simple et sans friction" align="left">
          Comment se passe une mission SEO pour votre cabinet
        </SectionHeader>
      </div>

      <div class="mt-16 grid md:grid-cols-3 gap-6">
        {PROCESS_STEPS.map((step) => (
          <div class="rounded-xl border border-black/10 bg-white/60 p-6" data-fade-up>
            <div class="flex items-center gap-3">
              <span class="text-2xl font-light text-sage-dark leading-none" aria-hidden="true">{step.num}</span>
              <h3 class="text-xl font-medium text-charcoal">{step.title}</h3>
            </div>
            <p class="mt-4 text-muted leading-relaxed">{step.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA final -->
  <section class="py-16 md:py-24 bg-sand">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <div class="grid lg:grid-cols-3 gap-12 items-start">

        <!-- Colonne gauche : photo + formulaire -->
        <div class="space-y-8">
          <div class="flex flex-col items-center" data-fade-up>
            <Image
              src={HeroImage}
              height={192}
              width={192}
              alt="David Barbier - Consultant SEO pour experts-comptables"
              class="size-48 rounded-full object-cover ring-4 ring-sage/30"
            />
            <h3 class="mt-4 text-xl font-medium text-charcoal">SEO Expert-Comptable</h3>
            <p class="text-muted">Ancien EC mémorialiste & développeur web</p>
          </div>

          <form method="post" action="https://formspree.io/f/xayglvyo" class="space-y-4 bg-cream border border-black/10 rounded-xl p-6" data-fade-up>
            <div>
              <label for="name" class="block text-sm font-medium text-default mb-2">Votre nom</label>
              <input
                id="name"
                name="name"
                type="text"
                required
                class="w-full px-4 py-3 rounded-lg border border-black/10 bg-white/70 text-charcoal focus:ring-2 focus:ring-sage focus:border-transparent transition-all"
              />
            </div>
            <div>
              <label for="website" class="block text-sm font-medium text-default mb-2">URL de votre site</label>
              <input
                id="website"
                name="website"
                type="url"
                class="w-full px-4 py-3 rounded-lg border border-black/10 bg-white/70 text-charcoal focus:ring-2 focus:ring-sage focus:border-transparent transition-all"
                placeholder="https://www.votre-cabinet.fr"
              />
            </div>
            <div>
              <label for="email" class="block text-sm font-medium text-default mb-2">Votre email</label>
              <input
                id="email"
                name="email"
                type="email"
                required
                class="w-full px-4 py-3 rounded-lg border border-black/10 bg-white/70 text-charcoal focus:ring-2 focus:ring-sage focus:border-transparent transition-all"
              />
            </div>
            <div class="flex items-start gap-3">
              <input
                id="disclaimer"
                name="disclaimer"
                type="checkbox"
                required
                class="mt-1 w-5 h-5 rounded border-black/20 text-sage-dark focus:ring-sage cursor-pointer"
              />
              <label for="disclaimer" class="cursor-pointer select-none text-sm text-muted">
                En soumettant ce formulaire, vous acceptez que vos données soient traitées conformément à notre politique de confidentialité.
              </label>
            </div>
            <input type="hidden" name="source" value="seo-expert-comptable" />
            <button class="btn btn-primary w-full gap-2">
