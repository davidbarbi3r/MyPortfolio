          <div class="bg-sage text-white rounded-xl p-8 text-center" data-fade-up>
            <div class="w-16 h-16 mx-auto rounded-full bg-white/20 flex items-center justify-center mb-6">
              <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={item.icon} />
              </svg>
            </div>
            <h3 class="text-xl text-white">{item.title}</h3>
            <p class="text-sm text-white/90 mt-4 leading-relaxed">
              {item.desc}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Section Fonctionnalités -->
  <section class="py-16 md:py-24 bg-cream overflow-hidden">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">

      <SectionHeader
        number="04"
        kicker="Fonctionnalités"
        class="max-w-3xl mx-auto mb-16"
        subtitle="Votre site peut devenir bien plus qu'une simple vitrine. Voici quelques possibilités selon vos besoins."
      >
        Des idées pour aller plus loin
      </SectionHeader>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">

        <!-- Carte principale : Recrutement -->
        <div class="lg:col-span-2 bg-sage text-white rounded-xl p-8 lg:p-10" data-fade-up>
          <div class="w-14 h-14 rounded-xl bg-white/20 flex items-center justify-center mb-6">
            <svg class="w-7 h-7 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/>
            </svg>
          </div>
          <h3 class="text-2xl lg:text-3xl text-white mb-4">Page recrutement / Marque employeur</h3>
          <p class="text-white/90 text-lg leading-relaxed max-w-xl">
