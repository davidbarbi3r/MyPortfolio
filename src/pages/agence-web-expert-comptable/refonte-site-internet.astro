                <p class="text-sm text-muted mt-2">{card.desc}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Section Processus -->
  <section id="processus" class="py-16 md:py-24 scroll-mt-32 bg-cream">
