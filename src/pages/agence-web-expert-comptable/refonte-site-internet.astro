// JSON-LD FAQ schema
const faqStructuredData = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Combien coûte une refonte de site expert-comptable ?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Une refonte de site expert-comptable démarre à 2 000€ HT. Le tarif final dépend de l'ampleur du projet : un simple portage sur Astro en conservant design et textes coûtera moins cher qu'une refonte complète avec nouvelle identité et réécriture des contenus. Je vous propose toujours un devis détaillé et transparent après avoir analysé votre site actuel et compris vos objectifs."
      }
    },
    {
      "@type": "Question",
      "name": "Quel est le délai pour refondre un site ?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Comptez en moyenne 6 à 8 semaines pour une refonte complète. Ce délai inclut l'audit, la stratégie, le développement et les tests. Votre site actuel reste en ligne pendant toute la durée du projet. La bascule se fait en quelques heures, sans interruption de service pour vos visiteurs."
      }
    },
    {
      "@type": "Question",
      "name": "Mon site sera-t-il optimisé pour Google ?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Absolument. L'optimisation SEO est au cœur de chaque refonte. Je mets en place une structure sémantique optimisée (balises H1-H6, meta descriptions), des redirections 301 pour préserver votre référencement existant, un sitemap XML et des données structurées, ainsi que des performances techniques excellentes (facteur de ranking Google)."
      }
    },
    {
      "@type": "Question",
      "name": "Que devient mon ancien site ?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Votre ancien site reste en ligne pendant toute la phase de développement. Une fois le nouveau site validé et testé, la bascule se fait en remplaçant les fichiers sur votre hébergement. Je conserve une sauvegarde de votre ancien site pendant 3 mois au cas où vous auriez besoin de récupérer des éléments."
      }
    },
    {
      "@type": "Question",
      "name": "Puis-je garder mon nom de domaine ?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Oui, bien sûr ! Votre nom de domaine vous appartient et reste inchangé. C'est d'ailleurs essentiel pour préserver votre référencement et votre notoriété. Si vous souhaitez changer de nom de domaine (rebranding), je peux également vous accompagner dans cette transition avec les redirections appropriées."
      }
    },
    {
      "@type": "Question",
      "name": "Pourquoi Astro et pas WordPress ?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "WordPress est parfait pour les blogs et sites nécessitant des mises à jour fréquentes par des non-techniciens. Mais pour un site vitrine d'expert-comptable, Astro offre des avantages décisifs : des performances 10x supérieures (score PageSpeed >90), une sécurité renforcée (pas de base de données à pirater, pas de plugins vulnérables), zéro maintenance technique (pas de mises à jour WordPress/plugins à gérer), et des coûts d'hébergement réduits. Votre site charge instantanément et vous n'avez plus à vous soucier des failles de sécurité."
      }
    }
  ]
};

