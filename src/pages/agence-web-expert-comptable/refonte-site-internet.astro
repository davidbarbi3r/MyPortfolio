<Layout metadata={metadata}>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(serviceStructuredData)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(faqStructuredData)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbStructuredData)} />
  </Fragment>

  <!-- Hero -->
  <section class="relative bg-cream overflow-hidden">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 py-16 md:py-24">
      <!-- Fil d'Ariane -->
      <nav aria-label="Fil d'Ariane" class="mb-8 text-sm" data-fade-up>
        <ol class="flex items-center gap-2 text-muted flex-wrap">
          <li><a href="/" class="hover:text-sage-dark transition-colors">Accueil</a></li>
          <li><svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg></li>
          <li><a href="/agence-web-expert-comptable/" class="hover:text-sage-dark transition-colors">Agence Web EC</a></li>
          <li><svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg></li>
          <li class="text-charcoal font-medium">Refonte site internet</li>
        </ol>
      </nav>

      <div class="grid lg:grid-cols-2 gap-12 lg:gap-20 items-center">

        <div class="order-2 lg:order-1">
          <p data-fade-up><PillBadge text="Refonte complète par un ancien EC mémorialiste" /></p>

          <h1 class="mt-8" data-fade-up>
            <span class="block text-charcoal text-[clamp(2.6rem,5vw,4.5rem)] leading-[1.05] tracking-tight">
              Refonte site internet expert-comptable
            </span>
            <span class="block text-sage-dark text-[clamp(2.2rem,4vw,3.75rem)] leading-[1.05] mt-2">
              Modernisation + SEO
            </span>
          </h1>

          <p class="mt-8 text-lg sm:text-xl text-muted leading-relaxed" data-fade-up>
            Votre site actuel ne reflète plus l'image de votre cabinet ? Je le transforme en une <strong class="text-charcoal font-medium">vitrine moderne et performante</strong>, optimisée pour Google et vos futurs clients.
          </p>

          <div class="mt-10 grid grid-cols-3 gap-6">
            <StatBig value="8" label="Semaines max" size="md" />
            <StatBig value=">80" label="Score PageSpeed" size="md" />
            <StatBig value="SEO" label="Optimisé Google" size="md" />
          </div>

          <div class="mt-10 flex flex-wrap items-center gap-6" data-fade-up>
            <a href="tel:+33623565299" class="btn btn-primary gap-2">
              Demander un audit gratuit
              <ArrowRight class="w-5 h-5" />
            </a>
            <ArrowLink href="#processus" text="Voir le processus" />
          </div>
        </div>

        <div class="order-1 lg:order-2 w-full" data-fade-up>
          <div class="relative rounded-xl overflow-hidden">
            <Image
              src={HeroImage}
              alt="David Barbier - Refonte site expert-comptable"
              class="w-full aspect-[4/5] object-cover"
              width={1024}
              height={1280}
            />

            <div class="absolute bottom-6 left-6 right-6 bg-cream/95 backdrop-blur-sm rounded-xl p-4">
              <div class="flex items-center gap-4">
                <div class="flex-shrink-0 w-12 h-12 bg-sage rounded-full flex items-center justify-center">
                  <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/>
                  </svg>
                </div>
                <div>
                  <div class="font-medium text-charcoal">Refonte sur mesure</div>
                  <div class="text-sm text-muted">Par un ancien expert-comptable</div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Section Introduction -->
  <section class="py-16 md:py-24 bg-sand">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <div class="grid lg:grid-cols-12 gap-12 lg:gap-20">

        <div class="lg:col-span-4">
          <div class="lg:sticky lg:top-32">
            <SectionHeader number="01" kicker="Introduction" align="left">
              Pourquoi refondre votre site ?
            </SectionHeader>
          </div>
        </div>

        <div class="lg:col-span-8">
          <p class="text-xl text-muted leading-relaxed">
            Rapprochement entre cabinets, nouvelle direction à affirmer, besoin de vous démarquer de la concurrence... Les raisons de refondre votre site sont nombreuses. C'est l'occasion d'<strong class="text-charcoal font-medium">acter un nouveau chapitre</strong> dans l'histoire de votre cabinet.
          </p>

          <p class="text-muted leading-relaxed mt-6">
            Au-delà de l'image, c'est aussi le moment de corriger les problèmes techniques : un site lent qui fait fuir les visiteurs, un design dépassé qui ne reflète plus votre professionnalisme, ou une <strong class="text-charcoal font-medium">absence de visibilité sur Google</strong> qui vous prive de prospects qualifiés.
          </p>

          <div class="mt-12" data-fade-up>
            <span class="block text-5xl leading-none mb-4 font-serif text-sage" aria-hidden="true">"</span>
            <blockquote class="text-2xl sm:text-3xl font-light text-charcoal italic leading-relaxed">
