      <div class="grid lg:grid-cols-2 gap-16 items-start">

        <div>
          <SectionHeader number="08" kicker="Prêt ?" align="left">
            Prêt à refondre votre site ?
          </SectionHeader>

          <p class="text-xl text-muted mt-8 leading-relaxed">
            Votre site actuel mérite une seconde vie. Discutons de votre projet et voyons ensemble comment moderniser votre présence en ligne.
          </p>

          <ul class="mt-10 space-y-6">
            {CTA_POINTS.map((point) => (
              <li class="flex gap-4" data-fade-up>
                <div class="flex-shrink-0 w-12 h-12 rounded-full bg-sage/15 text-sage-dark flex items-center justify-center">
                  <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={point.icon} />
                  </svg>
                </div>
                <div>
                  <h3 class="font-medium text-charcoal">{point.title}</h3>
                  <p class="text-muted mt-1">{point.desc}</p>
                </div>
              </li>
            ))}
          </ul>
        </div>

        <div class="bg-cream border border-black/10 rounded-xl p-8 lg:p-10" data-fade-up>

          <div class="flex items-center gap-4 mb-8">
            <Image
              src={HeroImage}
              height={64}
              width={64}
              alt="David Barbier"
              class="w-16 h-16 rounded-full object-cover ring-4 ring-sage/30"
            />
            <div>
              <div class="font-medium text-charcoal">David Barbier</div>
              <div class="text-sm text-muted">Ancien EC & Développeur Web</div>
            </div>
          </div>

          <form method="post" action="https://formspree.io/f/xayglvyo" class="space-y-6">
            <div class="grid sm:grid-cols-2 gap-6">
              <div>
                <label for="name" class="block text-sm font-medium text-default mb-2">Votre nom</label>
                <input
                  id="name"
                  name="name"
                  type="text"
                  required
                  class="w-full px-4 py-3 rounded-lg border border-black/10 bg-white/70 text-charcoal focus:ring-2 focus:ring-sage focus:border-transparent transition-all"
                  placeholder="Jean Dupont"
                />
              </div>
              <div>
                <label for="email" class="block text-sm font-medium text-default mb-2">Votre email</label>
                <input
                  id="email"
                  name="email"
                  type="email"
                  required
                  class="w-full px-4 py-3 rounded-lg border border-black/10 bg-white/70 text-charcoal focus:ring-2 focus:ring-sage focus:border-transparent transition-all"
                  placeholder="jean@cabinet.fr"
                />
              </div>
            </div>

            <div>
              <label for="website" class="block text-sm font-medium text-default mb-2">URL de votre site actuel</label>
              <input
                id="website"
                name="website"
                type="url"
                class="w-full px-4 py-3 rounded-lg border border-black/10 bg-white/70 text-charcoal focus:ring-2 focus:ring-sage focus:border-transparent transition-all"
                placeholder="https://www.votre-cabinet.fr"
              />
            </div>

            <div>
              <label for="textarea" class="block text-sm font-medium text-default mb-2">Qu'est-ce qui ne vous convient plus ?</label>
              <textarea
                id="textarea"
                name="textarea"
                rows="4"
                required
                class="w-full px-4 py-3 rounded-lg border border-black/10 bg-white/70 text-charcoal focus:ring-2 focus:ring-sage focus:border-transparent transition-all resize-none"
                placeholder="Design obsolète, site lent, pas visible sur Google..."
              ></textarea>
            </div>

            <div class="flex items-start gap-3">
              <input
                id="disclaimer"
                name="disclaimer"
                type="checkbox"
                required
                class="mt-1 w-5 h-5 rounded border-black/20 text-sage-dark focus:ring-sage"
              />
              <label for="disclaimer" class="text-sm text-muted cursor-pointer">
                En soumettant ce formulaire, vous acceptez que vos données soient traitées conformément à notre politique de confidentialité.
              </label>
            </div>

            <input type="hidden" name="source" value="refonte-site-expert-comptable" />

            <button type="submit" class="btn btn-primary w-full gap-2">
              Demander mon audit gratuit
              <ArrowRight class="w-5 h-5" />
            </button>
          </form>
        </div>
      </div>
    </div>
  </section>

  <MontegrappaFx />
</Layout>
