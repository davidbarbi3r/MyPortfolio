          <div data-fade-up>
            <div class="flex items-baseline gap-2">
              <span class="text-2xl leading-tight tracking-tight sm:text-3xl md:text-4xl text-sage-dark font-light">
                {step.num}
              </span>
              <dt>
                <h3 class="text-base leading-normal sm:text-lg md:text-xl text-charcoal font-medium">
                  {step.title}
                </h3>
              </dt>
            </div>
            <dd class="mt-4">
              <p class="text-base leading-normal text-muted">
                {step.desc}
              </p>
            </dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <!-- Section Livrables -->
  <section class="py-16 md:py-24 bg-sand">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
