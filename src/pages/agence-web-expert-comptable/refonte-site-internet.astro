---
import Layout from '../../layouts/PageLayout.astro';
import Image from '../../components/common/Image.astro';
import HeroImage from '../../assets/images/DSCF7551-3.jpg';

const metadata = {
  title: "Refonte site internet expert-comptable | Modernisation + SEO",
  description:
    'Refonte de site expert-comptable par un ancien EC mémorialiste. Modernisez votre site avec un design professionnel, SEO optimisé et performances maximales.',
};
---

<Layout metadata={metadata}>
  <style>
    .font-editorial { font-family: var(--aw-font-heading), system-ui, sans-serif; }
    .font-body { font-family: var(--aw-font-sans), system-ui, sans-serif; }

    @keyframes fadeInUp {
      from { opacity: 0; transform: translateY(30px); }
      to { opacity: 1; transform: translateY(0); }
    }

    @keyframes scaleIn {
      from { opacity: 0; transform: scale(0.95); }
      to { opacity: 1; transform: scale(1); }
    }

    @keyframes shimmer {
      0% { background-position: -200% center; }
      100% { background-position: 200% center; }
    }

    @keyframes float {
      0%, 100% { transform: translateY(0); }
      50% { transform: translateY(-10px); }
    }

    .animate-fade-up { animation: fadeInUp 0.8s ease-out forwards; }
    .animate-scale { animation: scaleIn 0.6s ease-out forwards; }
    .animate-float { animation: float 6s ease-in-out infinite; }

    .delay-100 { animation-delay: 0.1s; opacity: 0; }
    .delay-200 { animation-delay: 0.2s; opacity: 0; }
    .delay-300 { animation-delay: 0.3s; opacity: 0; }
    .delay-400 { animation-delay: 0.4s; opacity: 0; }
    .delay-500 { animation-delay: 0.5s; opacity: 0; }

    .btn-shimmer {
      background: linear-gradient(90deg,
        var(--btn-bg) 0%,
        var(--btn-shimmer) 50%,
        var(--btn-bg) 100%);
      background-size: 200% 100%;
      --btn-bg: rgb(21, 128, 61);
      --btn-shimmer: rgb(34, 197, 94);
    }

    .btn-shimmer:hover {
      animation: shimmer 1.5s ease-in-out infinite;
    }

    .decorative-line {
      position: relative;
    }

    .decorative-line::after {
      content: '';
      position: absolute;
      bottom: -8px;
      left: 0;
      width: 60px;
      height: 3px;
      background: linear-gradient(90deg, #15803d, #22c55e, #86efac);
      border-radius: 2px;
    }

    .card-subtle {
      transition: all 0.3s ease;
    }

    .card-subtle:hover {
      border-color: rgba(21, 128, 61, 0.3);
    }

    .dark .card-subtle:hover {
      border-color: rgba(34, 197, 94, 0.3);
    }

    .styled-number {
      font-family: var(--aw-font-heading), system-ui, sans-serif;
      font-size: 4rem;
      font-weight: 700;
      line-height: 1;
      background: linear-gradient(135deg, #166534 0%, #15803d 50%, #22c55e 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }

    .hover-underline {
      position: relative;
      display: inline-block;
    }

    .hover-underline::after {
      content: '';
      position: absolute;
      width: 0;
      height: 2px;
      bottom: -2px;
      left: 0;
      background: linear-gradient(90deg, #15803d, #22c55e);
      transition: width 0.3s ease;
    }

    .hover-underline:hover::after {
      width: 100%;
    }

    .texture-bg {
      background-image:
        radial-gradient(circle at 25% 25%, rgba(21, 128, 61, 0.03) 0%, transparent 50%),
        radial-gradient(circle at 75% 75%, rgba(180, 83, 9, 0.03) 0%, transparent 50%);
    }

    .badge-premium {
      background: linear-gradient(135deg, #dcfce7 0%, #bbf7d0 100%);
      border: 1px solid #22c55e;
      color: #166534;
    }

    .dark .badge-premium {
      background: linear-gradient(135deg, #14532d 0%, #166534 100%);
      border-color: #22c55e;
      color: #86efac;
    }

    .quote-mark {
      font-family: Georgia, serif;
      font-size: 6rem;
      line-height: 0;
      color: rgba(21, 128, 61, 0.15);
      position: absolute;
      top: 0;
      left: -10px;
    }

    .dark .quote-mark {
      color: rgba(34, 197, 94, 0.15);
    }

    .glow-on-hover {
      transition: all 0.3s ease;
    }

    .glow-on-hover:hover {
      box-shadow: 0 0 30px rgba(21, 128, 61, 0.3);
    }

    .stat-value {
      font-family: var(--aw-font-heading), system-ui, sans-serif;
      background: linear-gradient(135deg, #166534 0%, #22c55e 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }
  </style>

  <!-- Hero Section -->
  <section class="relative min-h-[85vh] flex items-center overflow-hidden texture-bg">
    <div class="absolute inset-0 overflow-hidden pointer-events-none">
      <div class="absolute -top-40 -right-40 w-96 h-96 bg-gradient-to-br from-green-100/50 to-emerald-100/30 dark:from-green-900/20 dark:to-emerald-900/10 rounded-full blur-3xl animate-float"></div>
      <div class="absolute -bottom-20 -left-20 w-72 h-72 bg-gradient-to-tr from-teal-100/40 to-green-100/20 dark:from-teal-900/10 dark:to-green-900/5 rounded-full blur-3xl" style="animation: float 8s ease-in-out infinite reverse;"></div>
    </div>

    <div class="relative mx-auto max-w-7xl px-6 py-20 lg:px-8">
      <div class="grid lg:grid-cols-2 gap-12 lg:gap-20 items-center">

        <div class="order-2 lg:order-1">
          <div class="animate-fade-up delay-100">
            <span class="badge-premium inline-flex items-center gap-2 px-4 py-2 rounded-full text-sm font-medium font-body">
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                <path d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/>
              </svg>
              Refonte complète par un ancien EC mémorialiste
            </span>
          </div>

          <h1 class="mt-8 animate-fade-up delay-200">
            <span class="block font-editorial text-4xl sm:text-5xl lg:text-6xl font-bold text-gray-900 dark:text-white leading-[1.1] tracking-tight">
              Refonte site internet expert-comptable
            </span>
            <span class="block font-editorial text-3xl sm:text-4xl lg:text-5xl font-medium text-transparent bg-clip-text bg-gradient-to-r from-green-700 via-green-600 to-emerald-500 dark:from-green-400 dark:via-green-300 dark:to-emerald-300 mt-2">
              Modernisation + SEO
            </span>
          </h1>

          <p class="mt-8 font-body text-xl sm:text-2xl text-gray-600 dark:text-gray-300 leading-relaxed animate-fade-up delay-300">
            Votre site actuel ne reflète plus l'image de votre cabinet ? Je le transforme en une <strong class="text-gray-900 dark:text-white">vitrine moderne et performante</strong>, optimisée pour Google et vos futurs clients.
          </p>

          <div class="mt-10 flex flex-wrap gap-8 animate-fade-up delay-400">
            <div class="text-center">
              <div class="stat-value text-4xl font-bold">8</div>
              <div class="font-body text-sm text-gray-500 dark:text-gray-400 mt-1">Semaines max</div>
            </div>
            <div class="text-center">
              <div class="stat-value text-4xl font-bold">>80</div>
              <div class="font-body text-sm text-gray-500 dark:text-gray-400 mt-1">Score PageSpeed</div>
            </div>
            <div class="text-center">
              <div class="stat-value text-4xl font-bold">SEO</div>
              <div class="font-body text-sm text-gray-500 dark:text-gray-400 mt-1">Optimisé Google</div>
            </div>
          </div>

          <div class="mt-10 flex flex-wrap items-center gap-4 animate-fade-up delay-500">
            <a
              href="/contact"
              class="btn-shimmer inline-flex items-center gap-2 px-8 py-4 rounded-full text-white font-body font-semibold text-lg shadow-lg shadow-green-700/25 hover:shadow-xl hover:shadow-green-700/30 transition-all duration-300 glow-on-hover"
            >
              Demander un audit gratuit
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
              </svg>
            </a>
            <a href="#processus" class="group inline-flex items-center gap-2 px-6 py-4 font-body font-medium text-gray-700 dark:text-gray-300 hover:text-green-700 dark:hover:text-green-400 transition-colors">
              Voir le processus
              <svg class="w-4 h-4 transition-transform group-hover:translate-y-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
              </svg>
            </a>
          </div>
        </div>

        <div class="order-1 lg:order-2 animate-scale delay-200">
          <div class="relative">
            <div class="absolute -inset-4 bg-gradient-to-br from-green-200/50 via-transparent to-emerald-200/50 dark:from-green-800/30 dark:to-emerald-800/30 rounded-3xl transform rotate-3"></div>
            <div class="absolute -inset-4 bg-gradient-to-tr from-teal-200/30 via-transparent to-green-200/30 dark:from-teal-800/20 dark:to-green-800/20 rounded-3xl transform -rotate-2"></div>

            <div class="relative rounded-2xl overflow-hidden shadow-2xl">
              <Image
                src={HeroImage}
                alt="David Barbier - Refonte site expert-comptable"
                class="w-full aspect-[4/5] object-cover"
                width={600}
                height={750}
              />
              <div class="absolute inset-0 bg-gradient-to-t from-gray-900/60 via-transparent to-transparent"></div>

              <div class="absolute bottom-6 left-6 right-6 bg-white/95 dark:bg-gray-800/95 backdrop-blur-sm rounded-xl p-4 shadow-lg">
                <div class="flex items-center gap-4">
                  <div class="flex-shrink-0 w-12 h-12 bg-gradient-to-br from-green-500 to-green-700 rounded-full flex items-center justify-center">
                    <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/>
                    </svg>
                  </div>
                  <div>
                    <div class="font-editorial font-semibold text-gray-900 dark:text-white">Refonte sur mesure</div>
                    <div class="font-body text-sm text-gray-500 dark:text-gray-400">Par un ancien expert-comptable</div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Barre CTA fixe -->
    <div class="fixed bottom-0 left-0 right-0 bg-gradient-to-r from-green-800 to-green-700 dark:from-green-900 dark:to-green-800 z-[9999] shadow-lg shadow-green-900/30">
      <div class="max-w-7xl mx-auto px-6 py-3">
        <div class="flex items-center justify-center gap-3 sm:gap-6 text-sm md:text-base">
          <span class="hidden lg:inline text-green-100 font-body">Audit gratuit de votre site actuel</span>
          <a
            href="tel:0623565299"
            class="inline-flex items-center gap-2 text-white font-body font-semibold text-sm hover:text-green-200 transition-colors"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
            </svg>
            <span>06 23 56 52 99</span>
          </a>
          <span class="text-green-300/50 hidden sm:inline">|</span>
          <a
            href="#formulaire"
            class="inline-flex items-center gap-2 bg-white text-green-800 px-5 py-2 rounded-full font-body font-semibold text-sm hover:bg-green-50 transition-colors shadow-md"
          >
            <span>Audit gratuit</span>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
            </svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Section Introduction -->
  <section class="py-24 lg:py-32 bg-gradient-to-b from-gray-50 to-white dark:from-gray-900 dark:to-gray-900">
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
      <div class="grid lg:grid-cols-12 gap-12 lg:gap-20">

        <div class="lg:col-span-4">
          <div class="lg:sticky lg:top-32">
            <span class="styled-number">01</span>
            <p class="font-body text-sm font-semibold tracking-widest text-yellow-600 dark:text-yellow-500 uppercase mt-4">Introduction</p>
            <h2 class="font-editorial text-3xl sm:text-4xl font-bold text-gray-900 dark:text-white mt-3 decorative-line">
              Pourquoi refondre votre site ?
            </h2>
          </div>
        </div>

        <div class="lg:col-span-8">
          <div class="prose prose-lg dark:prose-invert max-w-none font-body">
            <p class="text-xl text-gray-600 dark:text-gray-300 leading-relaxed">
              Rapprochement entre cabinets, nouvelle direction à affirmer, besoin de vous démarquer de la concurrence... Les raisons de refondre votre site sont nombreuses. C'est l'occasion d'<strong class="text-gray-900 dark:text-white">acter un nouveau chapitre</strong> dans l'histoire de votre cabinet.
            </p>

            <p class="text-gray-600 dark:text-gray-300 leading-relaxed mt-6">
              Au-delà de l'image, c'est aussi le moment de corriger les problèmes techniques : un site lent qui fait fuir les visiteurs, un design dépassé qui ne reflète plus votre professionnalisme, ou une <strong class="text-gray-900 dark:text-white">absence de visibilité sur Google</strong> qui vous prive de prospects qualifiés.
            </p>
          </div>

          <div class="relative mt-12 pl-8 py-6">
            <span class="quote-mark">"</span>
            <blockquote class="relative font-editorial text-2xl sm:text-3xl font-medium text-gray-900 dark:text-white italic leading-relaxed">
              Une refonte, c'est l'opportunité de repartir sur des bases solides et d'affirmer votre positionnement.
            </blockquote>
          </div>

          <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6 mt-12">
            <div class="card-subtle bg-white dark:bg-gray-800 rounded-2xl p-6 border border-gray-100 dark:border-gray-700">
              <div class="inline-flex w-12 h-12 items-center justify-center rounded-full bg-blue-100 dark:bg-blue-900/50 text-blue-700 dark:text-blue-400 mb-4">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/>
                </svg>
              </div>
              <h3 class="font-editorial font-semibold text-gray-900 dark:text-white">Rapprochement de cabinets</h3>
              <p class="font-body text-sm text-gray-600 dark:text-gray-400 mt-2">Fusion ou association ? Un nouveau site pour une nouvelle identité commune</p>
            </div>

            <div class="card-subtle bg-white dark:bg-gray-800 rounded-2xl p-6 border border-gray-100 dark:border-gray-700">
              <div class="inline-flex w-12 h-12 items-center justify-center rounded-full bg-purple-100 dark:bg-purple-900/50 text-purple-700 dark:text-purple-400 mb-4">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"/>
                </svg>
              </div>
              <h3 class="font-editorial font-semibold text-gray-900 dark:text-white">Nouvelle direction</h3>
              <p class="font-body text-sm text-gray-600 dark:text-gray-400 mt-2">Acter une rupture, affirmer un repositionnement ou marquer un tournant</p>
            </div>

            <div class="card-subtle bg-white dark:bg-gray-800 rounded-2xl p-6 border border-gray-100 dark:border-gray-700">
              <div class="inline-flex w-12 h-12 items-center justify-center rounded-full bg-orange-100 dark:bg-orange-900/50 text-orange-700 dark:text-orange-400 mb-4">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
              </div>
              <h3 class="font-editorial font-semibold text-gray-900 dark:text-white">Site lent ou obsolète</h3>
              <p class="font-body text-sm text-gray-600 dark:text-gray-400 mt-2">Design dépassé, performances médiocres : il est temps de moderniser</p>
            </div>

            <div class="card-subtle bg-white dark:bg-gray-800 rounded-2xl p-6 border border-gray-100 dark:border-gray-700">
              <div class="inline-flex w-12 h-12 items-center justify-center rounded-full bg-green-100 dark:bg-green-900/50 text-green-700 dark:text-green-400 mb-4">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
                </svg>
              </div>
              <h3 class="font-editorial font-semibold text-gray-900 dark:text-white">Stratégie de visibilité</h3>
              <p class="font-body text-sm text-gray-600 dark:text-gray-400 mt-2">Améliorer votre référencement pour attirer des prospects qualifiés</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Section Processus -->
  <section id="processus" class="py-24 lg:py-32 scroll-mt-32 texture-bg">
    <div class="mx-auto max-w-7xl px-6 lg:px-8">

      <div class="text-center max-w-3xl mx-auto">
        <span class="styled-number">02</span>
        <p class="font-body text-sm font-semibold tracking-widest text-yellow-600 dark:text-yellow-500 uppercase mt-4">Processus complet</p>
        <h2 class="font-editorial text-4xl sm:text-5xl font-bold text-gray-900 dark:text-white mt-3">
          Les étapes de ma méthodologie de refonte
        </h2>
        <p class="font-body text-xl text-gray-600 dark:text-gray-300 mt-6 leading-relaxed">
          Une méthodologie éprouvée en 4 étapes pour transformer votre site sans perdre votre référencement existant.
        </p>
      </div>

      <div class="mt-20 grid md:grid-cols-2 gap-8">

        <!-- Étape 1 -->
        <article class="group card-subtle bg-white dark:bg-gray-800 rounded-3xl overflow-hidden border border-gray-100 dark:border-gray-700">
          <div class="h-2 bg-gradient-to-r from-green-500 to-green-600"></div>
          <div class="p-8">
            <div class="flex items-center gap-4 mb-6">
              <div class="w-14 h-14 rounded-2xl bg-gradient-to-br from-green-500 to-green-700 flex items-center justify-center shadow-lg shadow-green-500/25">
                <span class="text-white font-editorial font-bold text-xl">1</span>
              </div>
              <div>
                <span class="font-body text-sm text-green-600 dark:text-green-400 font-medium">Étape 1</span>
                <h3 class="font-editorial text-xl font-semibold text-gray-900 dark:text-white">Audit de votre site actuel</h3>
              </div>
            </div>
            <p class="font-body text-gray-600 dark:text-gray-400 leading-relaxed">
              J'analyse votre site : design, performances techniques, SEO, contenu. Cet audit permet d'identifier ce qui fonctionne (à conserver) et ce qui freine votre visibilité (à améliorer).
            </p>
            <ul class="mt-4 space-y-2">
              <li class="flex items-center gap-2 font-body text-sm text-gray-600 dark:text-gray-300">
                <svg class="w-4 h-4 text-green-600" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
                Audit technique (vitesse, mobile, sécurité)
              </li>
              <li class="flex items-center gap-2 font-body text-sm text-gray-600 dark:text-gray-300">
                <svg class="w-4 h-4 text-green-600" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
                Audit SEO (mots-clés, positions, backlinks)
              </li>
              <li class="flex items-center gap-2 font-body text-sm text-gray-600 dark:text-gray-300">
                <svg class="w-4 h-4 text-green-600" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
                Analyse de l'expérience utilisateur
              </li>
            </ul>
          </div>
        </article>

        <!-- Étape 2 -->
        <article class="group card-subtle bg-white dark:bg-gray-800 rounded-3xl overflow-hidden border border-gray-100 dark:border-gray-700">
          <div class="h-2 bg-gradient-to-r from-green-600 to-emerald-500"></div>
          <div class="p-8">
            <div class="flex items-center gap-4 mb-6">
              <div class="w-14 h-14 rounded-2xl bg-gradient-to-br from-green-600 to-emerald-600 flex items-center justify-center shadow-lg shadow-green-500/25">
                <span class="text-white font-editorial font-bold text-xl">2</span>
              </div>
              <div>
                <span class="font-body text-sm text-green-600 dark:text-green-400 font-medium">Étape 2</span>
                <h3 class="font-editorial text-xl font-semibold text-gray-900 dark:text-white">Stratégie de refonte (design + SEO)</h3>
              </div>
            </div>
            <p class="font-body text-gray-600 dark:text-gray-400 leading-relaxed">
              Sur base de l'audit, je définis une stratégie complète : nouvelle arborescence, mots-clés cibles, direction artistique. Vous validez chaque élément avant le développement.
            </p>
