---
import Layout from '../../layouts/PageLayout.astro';
import Image from '../../components/common/Image.astro';
import HeroImage from '../../assets/images/DSCF7551-3.jpg';
import LeadMagnetForm from '../../components/widgets/LeadMagnetForm.astro';
import MontegrappaFx from '~/components/animations/MontegrappaFx.astro';
import PillBadge from '~/components/ui/PillBadge.astro';
import StatBig from '~/components/ui/StatBig.astro';
import SectionHeader from '~/components/ui/SectionHeader.astro';
import CheckList from '~/components/ui/CheckList.astro';
import ArrowLink from '~/components/ui/ArrowLink.astro';
import ArrowRight from '~/components/ui/ArrowRight.astro';
import FaqItems from '~/components/ui/FaqItems.astro';
import ServicesShowcase from '~/components/widgets/ServicesShowcase.astro';
import CardSlider from '~/components/widgets/CardSlider.astro';
import ServiceCreation from '~/assets/images/service-creation.jpg';
import ServiceDev from '~/assets/images/service-dev.jpg';
import ServiceMaintenance from '~/assets/images/service-maintenance.jpg';
import ServiceSeo from '~/assets/images/service-seo.jpg';

const metadata = {
  title: "Partenaire des experts-comptables : site internet et SEO de cabinet",
  description:
    "Partenaire des cabinets d'expertise comptable : création de site, refonte, SEO. Ancien EC mémorialiste, un seul interlocuteur. Devis sous 48 h.",
};

// JSON-LD Service schema
const serviceStructuredData = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  "@id": "https://www.davidbarbier.com/experts-comptables/#service",
  "name": "David Barbier, partenaire des experts-comptables",
  "description": "Partenaire des cabinets d'expertise comptable : création de site, refonte, SEO et maintenance. Ancien expert-comptable mémorialiste, un seul interlocuteur.",
  "url": "https://www.davidbarbier.com/experts-comptables/",
  "founder": { "@id": "https://www.davidbarbier.com/#person" },
  "provider": {
    "@type": "Person",
    "@id": "https://www.davidbarbier.com/#person",
    "name": "David Barbier",
    "jobTitle": "Développeur web & ancien expert-comptable mémorialiste",
    "url": "https://www.davidbarbier.com/"
  },
  "areaServed": {
    "@type": "Country",
    "name": "France"
  },
  "serviceType": ["Création de site internet", "Refonte de site", "SEO", "Maintenance web"],
  "audience": {
    "@type": "Audience",
    "audienceType": "Experts-comptables, Cabinets comptables, Commissaires aux comptes"
  },
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": "Offres pour experts-comptables",
    "itemListElement": [
      {
        "@type": "Offer",
        "name": "Création site expert-comptable",
        "description": "Site vitrine sur mesure optimisé SEO pour cabinets d'expertise comptable",
        "priceSpecification": {
          "@type": "PriceSpecification",
          "minPrice": "1500",
          "priceCurrency": "EUR",
          "valueAddedTaxIncluded": false
        }
      },
      {
        "@type": "Offer",
        "name": "Refonte site expert-comptable",
        "description": "Modernisation et optimisation de site existant avec migration SEO",
        "url": "https://www.davidbarbier.com/experts-comptables/refonte-site-internet/",
        "priceSpecification": {
          "@type": "PriceSpecification",
          "minPrice": "2000",
          "priceCurrency": "EUR",
          "valueAddedTaxIncluded": false
        }
      },
      {
        "@type": "Offer",
        "name": "SEO Expert-Comptable",
        "description": "Référencement naturel pour cabinets EC : visibilité locale et nationale",
        "priceSpecification": {
          "@type": "UnitPriceSpecification",
          "minPrice": "490",
          "priceCurrency": "EUR",
          "unitCode": "MON",
          "valueAddedTaxIncluded": false
        }
      }
    ]
  }
};

// JSON-LD FAQ schema
const faqStructuredData = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Pourquoi un expert-comptable a-t-il besoin d'un site internet ?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Aujourd'hui, 80% des clients recherchent leur expert-comptable en ligne. Un site professionnel est votre vitrine digitale : il rassure les prospects, présente vos services et vous différencie. C'est aussi un outil de SEO local pour apparaître sur \"expert-comptable + votre ville\"."
      }
    },
    {
      "@type": "Question",
      "name": "Combien coûte la création d'un site pour un cabinet EC ?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Un site vitrine simple démarre à 1 500€. Un site complet avec blog et fonctionnalités avancées : 3 000€ à 5 000€. Je propose toujours un devis personnalisé après avoir compris vos besoins. Pas de mauvaise surprise."
      }
    },
    {
      "@type": "Question",
      "name": "Qu'est-ce que le SEO peut apporter à mon cabinet ?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Le SEO permet d'apparaître dans les premiers résultats Google quand des prospects recherchent un expert-comptable. C'est un flux de clients qualifiés sans payer de publicité. Requêtes stratégiques : \"expert-comptable [ville]\", \"création entreprise comptable\", \"bilan annuel\"."
      }
    },
    {
      "@type": "Question",
      "name": "Pourquoi travailler avec un ancien EC mémorialiste plutôt qu'une agence ?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Je connais votre métier de l'intérieur : contraintes (périodes fiscales, déontologie), vocabulaire, attentes de vos clients. Cette compréhension permet de créer des contenus et un site qui parlent vraiment à vos prospects."
      }
    },
    {
      "@type": "Question",
      "name": "Pouvez-vous refondre mon site existant ?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Absolument. Je réalise des audits pour identifier les points d'amélioration : design, performance, SEO, contenu. Je propose soit une refonte complète, soit des optimisations ciblées selon votre budget."
      }
    },
    {
      "@type": "Question",
      "name": "Proposez-vous un accompagnement après la mise en ligne ?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Oui, je propose des contrats de maintenance pour garder votre site à jour, sécurisé et performant. Je peux aussi vous accompagner avec un suivi SEO mensuel pour améliorer continuellement votre visibilité."
      }
    }
  ]
};

// JSON-LD Breadcrumb schema
const breadcrumbStructuredData = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Accueil",
      "item": "https://www.davidbarbier.com/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Experts-comptables",
      "item": "https://www.davidbarbier.com/experts-comptables/"
    }
  ]
};

// FAQ affichée : mêmes questions que le schema, réponses en HTML de confiance
// (paragraphes + liens internes), rendues par FaqItems via set:html.
const linkClass = 'text-sage-dark hover:text-charcoal underline underline-offset-2';
const EC_FAQ = [
  {
    q: "Pourquoi un expert-comptable a-t-il besoin d'un site internet ?",
    a: `<p>Aujourd'hui, 80% des clients recherchent leur expert-comptable en ligne. Un site professionnel est votre vitrine digitale : il rassure les prospects, présente vos services et vous différencie.</p><p>C'est aussi un outil de SEO local pour apparaître sur "expert-comptable + votre ville".</p>`,
  },
  {
    q: "Combien coûte la création d'un site pour un cabinet EC ?",
    a: `<p>Un site vitrine simple démarre à 1 500€. Un site complet avec blog et fonctionnalités avancées : 3 000€ à 5 000€.</p><p>Je propose toujours un devis personnalisé après avoir compris vos besoins. Pas de mauvaise surprise.</p>`,
  },
  {
    q: "Qu'est-ce que le SEO peut apporter à mon cabinet ?",
    a: `<p>Le SEO permet d'apparaître dans les premiers résultats Google quand des prospects recherchent un expert-comptable. C'est un flux de clients qualifiés sans payer de publicité.</p><p>Requêtes stratégiques : "expert-comptable [ville]", "création entreprise comptable", "bilan annuel".</p>`,
  },
  {
    q: 'Pourquoi travailler avec un ancien EC mémorialiste plutôt qu\'une agence ?',
    a: `<p>Je connais votre métier de l'intérieur : contraintes (périodes fiscales, déontologie), vocabulaire, attentes de vos clients.</p><p>Cette compréhension permet de créer des contenus et un site qui parlent vraiment à vos prospects.</p>`,
  },
  {
    q: 'Pouvez-vous refondre mon site existant ?',
    a: `<p>Absolument. Je réalise des audits pour identifier les points d'amélioration : design, performance, SEO, contenu.</p><p>Je propose soit une refonte complète, soit des optimisations ciblées selon votre budget.</p>`,
  },
  {
    q: 'Proposez-vous un accompagnement après la mise en ligne ?',
    a: `<p>Oui, je propose des contrats de <a href="/maintenance-site-internet-ajaccio/" class="${linkClass}">maintenance</a> pour garder votre site à jour, sécurisé et performant.</p><p>Je peux aussi vous accompagner avec un <a href="/referencement-seo-ajaccio/" class="${linkClass}">suivi SEO mensuel</a> pour améliorer continuellement votre visibilité.</p>`,
  },
];

// Grille d'articles : sélection éditoriale maintenue à la main
const ARTICLES = [
  {
    cat: 'SEO',
    catClass: 'text-sage-dark',
    title: 'Conseils SEO pour expert-comptable : le guide 2026',
    desc: 'Les actions concrètes pour rendre votre cabinet visible sur Google et attirer des clients qualifiés.',
    href: '/blog/conseils-seo-expert-comptable/',
  },
  {
    cat: 'SEO',
    catClass: 'text-sage-dark',
    title: 'Netlinking gratuit pour expert-comptable',
    desc: 'Les backlinks institutionnels que la plupart des cabinets négligent. Gratuits et puissants.',
    href: '/blog/netlinking-cabinet-expertise-comptable/',
  },
  {
    cat: 'Portfolio',
    catClass: 'text-muted',
    title: "Étude de cas : le site vitrine d'une experte-comptable qui lance son cabinet (LBG Expertise)",
    desc: "Retour d'expérience sur la création d'un site vitrine professionnel pour le lancement d'un cabinet indépendant à Marseille.",
    href: '/realisations/lbg-expertise-ec-marseille/',
  },
  {
    cat: 'Portfolio',
    catClass: 'text-muted',
    title: 'Étude de cas : le site d\'un cabinet créé de zéro (Odacio Conseils)',
    desc: "Un expert-comptable qui se lance sans rachat de clientèle : comment son site et sa fiche Google génèrent 4 à 5 appels qualifiés par mois.",
    href: '/realisations/odacio-conseils-expert-comptable-allauch/',
  },
  {
    cat: 'Blog',
    catClass: 'text-sage-dark',
    title: 'Blog ou site internet : que choisir ?',
    desc: 'Découvrez pourquoi un blog est essentiel pour la visibilité de votre cabinet.',
    href: '/blog/blog-ou-site-internet/',
  },
  {
    cat: 'Blog',
    catClass: 'text-sage-dark',
    title: 'Mon site internet est lent, que faire ?',
    desc: 'Un site lent nuit à votre image et votre référencement. Découvrez les solutions.',
    href: '/blog/site-internet-lent-que-faire/',
  },
  {
    cat: 'Blog',
    catClass: 'text-sage-dark',
    title: 'Choisir son extension de domaine',
    desc: 'Guide pratique pour choisir entre .fr, .com ou une extension régionale.',
    href: '/blog/choisir-extension-domaine/',
  },
  {
    cat: 'Blog',
    catClass: 'text-sage-dark',
    title: 'Le nom de domaine de votre cabinet',
    desc: '.fr, .com ou .experts-comptables.fr ? Choisir le bon domaine pour votre cabinet.',
    href: '/blog/nom-domaine-cabinet-expert-comptable/',
  },
];

// Petites tuiles de la section « Ce qui me différencie »
const DIFF_TILES = [
  {
    title: "Pas d'abonnement coûteux",
    desc: 'Vous êtes propriétaire de votre site. Pas de frais mensuels cachés.',
    icon: 'M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z',
  },
  {
    title: 'Pro mais pas ennuyeux',
    desc: 'Un site qui reflète vraiment les valeurs de votre cabinet et de ses fondateurs.',
    icon: 'M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z',
  },
  {
    title: 'Prêt à évoluer',
    desc: 'Un site qui grandit avec votre cabinet et facilite le recrutement.',
    icon: 'M13 7h8m0 0v8m0-8l-8 8-4-4-6 6',
  },
  {
    title: 'Fluide et rapide',
    desc: 'Score PageSpeed >80. Vos visiteurs ne patientent pas.',
    icon: 'M13 10V3L4 14h7v7l9-11h-7z',
  },
  {
    title: 'Réactivité',
    desc: 'Réponses sous 24h, livraison dans les délais.',
    icon: 'M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z',
  },
  {
    title: 'Transparence',
    desc: 'Devis détaillé, pas de surprise.',
    icon: 'M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z',
  },
];
---

<Layout metadata={metadata}>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(serviceStructuredData)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(faqStructuredData)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbStructuredData)} />
  </Fragment>

  <!-- Hero -->
  <section class="relative bg-cream overflow-hidden">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 py-16 md:py-24">
      <div class="grid lg:grid-cols-2 gap-12 lg:gap-20 items-center">

        <!-- Colonne texte -->
        <div class="order-2 lg:order-1">
          <p data-fade-up><PillBadge text="Ancien expert-comptable mémorialiste" /></p>

          <h1 class="mt-8" data-fade-up>
            <span class="block text-charcoal text-[clamp(2.6rem,5vw,4.5rem)] leading-[1.05] tracking-tight">
              Vos clients cherchent
            </span>
            <span class="block text-sage-dark text-[clamp(2.2rem,4vw,3.75rem)] leading-[1.05] mt-2">
              un expert-comptable en ligne
            </span>
          </h1>

          <p class="mt-8 text-lg sm:text-xl text-muted leading-relaxed" data-fade-up>
            Ils tapent <strong class="text-charcoal font-medium">« expert-comptable » et le nom de votre ville</strong>. Si le site ne ressemble plus au cabinet, ou s'il n'apparaît pas, ils appellent un confrère.
            <span class="text-sage-dark">Site, refonte ou référencement : le cabinet reprend sa place.</span>
          </p>

          <!-- Stats rapides -->
          <div class="mt-10 grid grid-cols-3 gap-6">
            <StatBig value="80%" label="des clients cherchent en ligne" size="md" />
            <StatBig value="4–6" label="semaines jusqu'à la mise en ligne" size="md" />
            <StatBig value="1" label="interlocuteur, du premier appel à la livraison" size="md" />
          </div>

          <!-- CTA -->
          <div class="mt-10 flex flex-wrap items-center gap-6" data-fade-up>
            <a href="#offres" class="btn btn-primary gap-2">
              Voir les quatre offres
              <ArrowRight class="w-5 h-5" />
            </a>
            <ArrowLink href="tel:+33623565299" text="Discutons de votre projet" />
          </div>
        </div>

        <!-- Colonne image -->
        <div class="order-1 lg:order-2 w-full" data-fade-up>
          <div class="relative rounded-xl overflow-hidden">
            <Image
              src={HeroImage}
              alt="David Barbier - Ancien expert-comptable mémorialiste devenu développeur web"
              class="w-full aspect-[4/5] object-cover"
              width={1024}
              height={1280}
            />

            <!-- Carte flottante -->
            <div class="absolute bottom-6 left-6 right-6 bg-cream/95 backdrop-blur-sm rounded-xl p-4">
              <div class="flex items-center gap-4">
                <div class="flex-shrink-0 w-12 h-12 bg-sage rounded-full flex items-center justify-center">
                  <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                  </svg>
                </div>
                <div>
                  <div class="font-medium text-charcoal">David Barbier</div>
                  <div class="text-sm text-muted">Partenaire des experts-comptables</div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* Section Offres - même composant que la home : accordéon exclusif, la photo change au clic */}
  <ServicesShowcase
    id="offres"
    badge="Solutions dédiées EC"
    title="4 offres pour digitaliser votre cabinet"
    subtitle="Création, refonte, référencement ou outils métier. Le cabinet choisit ce dont il a besoin."
    items={[
      {
        title: 'Création de site vitrine EC',
        description:
          "Un site professionnel 100% codé sur mesure qui reflète l'expertise de votre cabinet. Design unique, performances optimales, SEO intégré.",
        image: ServiceCreation,
        alt: "Texture abstraite d'ondulations, évoquant la création de sites internet",
        links: [{ text: "Découvrir l'offre", href: '/experts-comptables/creation-site-vitrine-ec/' }],
      },
      {
        title: 'Refonte de site EC',
        description:
          'Votre site actuel ne vous ressemble plus ? Je le transforme en une vitrine moderne et performante, adaptée aux attentes de vos clients.',
        image: ServiceMaintenance,
        alt: 'Texture de roche et de mousse, évoquant la refonte de site',
        links: [{ text: "Découvrir l'offre", href: '/experts-comptables/refonte-site-internet/' }],
      },
      {
        title: 'Accompagnement SEO EC',
        description:
          'Positionnez votre cabinet sur "expert-comptable + ville", "création entreprise"... Attirez des prospects qualifiés durablement.',
        image: ServiceSeo,
        alt: 'Texture de lumière à travers le feuillage, évoquant le référencement SEO',
        links: [{ text: "Découvrir l'offre", href: '/experts-comptables/consultant-seo-ec/' }],
      },
      {
        title: 'Développeur web pour EC',
        description:
          'Simulateurs, onboarding client, intégrations métier : des outils pour le quotidien du cabinet.',
        image: ServiceDev,
        alt: 'Texture de bois, évoquant le développement sur-mesure',
        links: [{ text: "Découvrir l'offre", href: '/experts-comptables/developpeur-specialise/' }],
      },
    ]}
  />

  <!-- Section Cas Client -->
  <section class="py-16 md:py-24 bg-sand">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">

      <SectionHeader number="01" kicker="Un cabinet à Marseille" class="max-w-3xl mx-auto mb-16">
        LBG Expertise, au lancement
      </SectionHeader>

      <!-- Carte cas client -->
      <article class="max-w-5xl mx-auto">
        <div class="bg-cream border border-black/10 rounded-xl overflow-hidden" data-fade-up>
          <div class="grid lg:grid-cols-2">

            <!-- Image -->
            <div class="relative h-64 lg:h-auto">
              <img
                src="https://imagedelivery.net/4zDfTa1ovbR8nr2bLQ6Mxg/af43940c-7bc0-4088-bd7a-6f7002f9b200/public"
                alt="Site LBG Expertise"
                class="absolute inset-0 w-full h-full object-cover"
              />
              <div class="absolute inset-0 bg-charcoal/30 lg:bg-gradient-to-t lg:from-charcoal/40 lg:to-transparent"></div>

              <!-- Badge performance -->
              <div class="absolute top-6 left-6 bg-cream/95 backdrop-blur rounded-full px-4 py-2 flex items-center gap-2">
                <span class="w-3 h-3 bg-sage rounded-full animate-pulse"></span>
                <span class="text-sm font-medium text-charcoal">PageSpeed &gt;80</span>
              </div>
            </div>

            <!-- Contenu -->
            <div class="p-8 lg:p-12">
              <PillBadge variant="outline" text="Cabinet d'expertise comptable" />

              <h3 class="text-2xl sm:text-3xl text-charcoal mt-4">
                LBG Expertise
              </h3>
              <p class="text-muted">Marseille</p>

              <p class="text-muted mt-4 leading-relaxed">
                Création d'un site vitrine professionnel pour le lancement d'un cabinet d'expertise comptable indépendant.
              </p>

              <CheckList
                class="mt-6"
                items={[
                  'Design sobre et professionnel',
                  'CMS intégré pour autonomie totale',
                  'Hébergement éco-responsable',
                ]}
              />

              <ArrowLink href="/realisations/lbg-expertise-ec-marseille/" text="Voir l'étude de cas complète" class="mt-8" />
            </div>
          </div>
        </div>

        <!-- Témoignage -->
        <div class="mt-12 max-w-3xl mx-auto" data-fade-up>
          <span class="block text-5xl leading-none mb-4 font-serif text-sage" aria-hidden="true">"</span>
          <blockquote class="text-xl sm:text-2xl font-light text-charcoal italic leading-relaxed">
            David a parfaitement compris mes besoins dès le premier échange. Son passé en cabinet d'expertise comptable a fait toute la différence.
          </blockquote>
          <footer class="mt-6 flex items-center gap-4">
            <div class="w-12 h-12 rounded-full bg-sage flex items-center justify-center text-white font-medium">
              LB
            </div>
            <div>
              <div class="font-medium text-charcoal">Laetitia B.</div>
              <div class="text-sm text-muted">Expert-Comptable, Marseille</div>
            </div>
          </footer>
        </div>
      </article>
    </div>
  </section>

  <!-- Preuve courte, le parcours complet reste sur À propos -->
  <section class="py-16 md:py-24 bg-cream">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <SectionHeader number="02" kicker="Qui vous accompagne" class="max-w-3xl mx-auto">
        Ancien mémorialiste, un seul interlocuteur
      </SectionHeader>
      <p class="mt-8 max-w-3xl mx-auto text-center text-lg text-muted leading-relaxed">
        Ancien expert-comptable mémorialiste et auditeur. Vous échangez avec la même personne, du premier appel à la mise en ligne.
        <a href="/a-propos/" class="text-sage-dark hover:text-charcoal underline underline-offset-2">Le parcours complet est sur la page À propos.</a>
      </p>

      <div class="mt-16 grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        {DIFF_TILES.map((tile) => (
          <div class="rounded-xl border border-black/10 bg-cream p-6 text-center" data-fade-up>
            <div class="w-14 h-14 mx-auto rounded-full bg-sage/15 text-sage-dark flex items-center justify-center mb-4">
              <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={tile.icon} />
              </svg>
            </div>
            <h3 class="text-lg text-charcoal">{tile.title}</h3>
            <p class="text-sm text-muted mt-3 leading-relaxed">{tile.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="py-16 md:py-24 bg-cream overflow-hidden">
    <CardSlider prevLabel="Articles précédents" nextLabel="Articles suivants">
      <Fragment slot="header">
        <div class="max-w-2xl">
          <SectionHeader kicker="Ressources" kickerVariant="pill" align="left">
            Articles utiles
          </SectionHeader>
        </div>
      </Fragment>

      {ARTICLES.map((article) => (
        <article class="snap-start flex-none w-[85%] sm:w-[380px] rounded-xl border border-black/10 bg-white/60 overflow-hidden flex flex-col">
          <div class="h-1.5 bg-sage" aria-hidden="true"></div>
          <div class="p-6 md:p-8 flex flex-col flex-1">
            <h3 class="text-xl text-charcoal">
              <a href={article.href} class="hover:text-sage-dark transition-colors">{article.title}</a>
            </h3>
            <p class="text-sm text-muted mt-3 leading-relaxed">{article.desc}</p>
            <a href={article.href} class="inline-flex items-center gap-1.5 mt-4 text-sm font-medium text-sage-dark hover:gap-2.5 transition-all">
              Lire
              <ArrowRight class="w-4 h-4" />
            </a>
            <p class:list={['mt-auto pt-4 border-t border-black/10 text-xs font-semibold tracking-wider uppercase', article.catClass]}>
              {article.cat}
            </p>
          </div>
        </article>
      ))}
    </CardSlider>

    <div class="max-w-6xl mx-auto px-4 sm:px-6 mt-4">
      <ArrowLink href="/blog/" text="Voir tous les articles" />
    </div>
  </section>

  <!-- Section Contact -->
  <section class="py-16 md:py-24 bg-sand">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">

      <div class="grid lg:grid-cols-2 gap-16 items-start">

        <!-- Colonne gauche - Texte -->
        <div>
          <SectionHeader number="03" kicker="Prêt ?" align="left">
            Discutons de votre projet
          </SectionHeader>

          <p class="text-xl text-muted mt-8 leading-relaxed">
            Que vous lanciez votre cabinet ou souhaitiez moderniser votre présence en ligne, je vous accompagne avec une compréhension unique de votre métier.
          </p>

          <ul class="mt-10 space-y-6">
            <li class="flex gap-4" data-fade-up>
              <div class="flex-shrink-0 w-12 h-12 rounded-full bg-sage/15 text-sage-dark flex items-center justify-center">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/>
                </svg>
              </div>
              <div>
                <h3 class="font-medium text-charcoal">Premier échange gratuit</h3>
                <p class="text-muted mt-1">Pour comprendre vos besoins et vous proposer une solution adaptée.</p>
              </div>
            </li>
            <li class="flex gap-4" data-fade-up>
              <div class="flex-shrink-0 w-12 h-12 rounded-full bg-sage/15 text-sage-dark flex items-center justify-center">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                </svg>
              </div>
              <div>
                <h3 class="font-medium text-charcoal">Devis détaillé sous 48h</h3>
                <p class="text-muted mt-1">Planning et livrables clairement définis. Pas de surprise.</p>
              </div>
            </li>
            <li class="flex gap-4" data-fade-up>
              <div class="flex-shrink-0 w-12 h-12 rounded-full bg-sage/15 text-sage-dark flex items-center justify-center">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/>
                </svg>
              </div>
              <div>
                <h3 class="font-medium text-charcoal">Accompagnement personnalisé</h3>
                <p class="text-muted mt-1">De A à Z, avec un interlocuteur unique.</p>
              </div>
            </li>
          </ul>
        </div>

        <!-- Colonne droite - Formulaire -->
        <div class="bg-cream border border-black/10 rounded-xl p-8 lg:p-10" data-fade-up>

          <div class="flex items-center gap-4 mb-8">
            <Image
              src={HeroImage}
              height={64}
              width={64}
              alt="David Barbier"
              class="w-16 h-16 rounded-full object-cover ring-4 ring-sage/30"
            />
            <div>
              <div class="font-medium text-charcoal">David Barbier</div>
              <div class="text-sm text-muted">Ancien EC & Développeur Web</div>
            </div>
          </div>

          <form method="post" action="https://formspree.io/f/xayglvyo" class="space-y-6">
            <div class="grid sm:grid-cols-2 gap-6">
              <div>
                <label for="name" class="block text-sm font-medium text-default mb-2">Votre nom</label>
                <input
                  id="name"
                  name="name"
                  type="text"
                  required
                  class="w-full px-4 py-3 rounded-lg border border-black/10 bg-white/70 text-charcoal focus:ring-2 focus:ring-sage focus:border-transparent transition-all"
                  placeholder="Jean Dupont"
                />
              </div>
              <div>
                <label for="email" class="block text-sm font-medium text-default mb-2">Votre email</label>
                <input
                  id="email"
                  name="email"
                  type="email"
                  required
                  class="w-full px-4 py-3 rounded-lg border border-black/10 bg-white/70 text-charcoal focus:ring-2 focus:ring-sage focus:border-transparent transition-all"
                  placeholder="jean@cabinet.fr"
                />
              </div>
            </div>

            <div>
              <label for="cabinet" class="block text-sm font-medium text-default mb-2">Nom du cabinet <span class="text-muted">(optionnel)</span></label>
              <input
                id="cabinet"
                name="cabinet"
                type="text"
                class="w-full px-4 py-3 rounded-lg border border-black/10 bg-white/70 text-charcoal focus:ring-2 focus:ring-sage focus:border-transparent transition-all"
                placeholder="Cabinet Dupont & Associés"
              />
            </div>

            <div>
              <label for="textarea" class="block text-sm font-medium text-default mb-2">Votre projet</label>
              <textarea
                id="textarea"
                name="textarea"
                rows="4"
                required
                class="w-full px-4 py-3 rounded-lg border border-black/10 bg-white/70 text-charcoal focus:ring-2 focus:ring-sage focus:border-transparent transition-all resize-none"
                placeholder="Décrivez brièvement votre besoin : création de site, refonte, SEO..."
              ></textarea>
            </div>

            <div class="flex items-start gap-3">
              <input
                id="disclaimer"
                name="disclaimer"
                type="checkbox"
                required
                class="mt-1 w-5 h-5 rounded border-black/20 text-sage-dark focus:ring-sage"
              />
              <label for="disclaimer" class="text-sm text-muted cursor-pointer">
                En soumettant ce formulaire, vous acceptez que vos données soient traitées conformément à notre politique de confidentialité.
              </label>
            </div>

            <input type="hidden" name="source" value="experts-comptables" />

            <button type="submit" class="btn btn-primary w-full gap-2">
              Discutons de votre projet
              <ArrowRight class="w-5 h-5" />
            </button>
          </form>
        </div>
      </div>
    </div>
  </section>

  <!-- Section FAQ -->
  <section id="faq" class="py-16 md:py-24 bg-cream scroll-mt-20 mb-16">
    <div class="mx-auto max-w-4xl px-4 sm:px-6">

      <SectionHeader number="04" kicker="FAQ" class="mb-16">
        Questions fréquentes
      </SectionHeader>

      <FaqItems items={EC_FAQ} />
    </div>
  </section>

  <section class="px-4 sm:px-6 py-12">
    <LeadMagnetForm />
  </section>

  <MontegrappaFx />
</Layout>
