---
import Layout from '../layouts/PageLayout.astro';
import { localBusinessAjaccioNode, LOCAL_BUSINESS_AJACCIO_ID } from '~/utils/business-schema';
import { aggregateRatingSchemaAjaccio } from '~/utils/reviews';

const metadata = {
  title: 'Audit SEO gratuit : où en est votre site, sans filtre',
  description:
    "Audit SEO gratuit à Ajaccio : 15-20 min en visio pour savoir ce qui est en place sur votre site et ce qui manque. Sans engagement, sans relance commerciale.",
};

const serviceStructuredData = {
  "@context": "https://schema.org",
  "@graph": [
    localBusinessAjaccioNode,
    {
      "@type": "Service",
      "@id": "https://www.davidbarbier.com/audit-seo-gratuit-ajaccio/#service",
      "name": "Audit SEO gratuit à Ajaccio",
      "description": "Analyse rapide et factuelle de votre site internet : ce qui est en place, ce qui manque. Restitution en 15-20 min en visio. Sans engagement.",
      "provider": { "@id": LOCAL_BUSINESS_AJACCIO_ID },
      "aggregateRating": aggregateRatingSchemaAjaccio,
      "isRelatedTo": { "@id": "https://www.davidbarbier.com/agence-seo-ajaccio/#service" },
      "areaServed": [
        { "@type": "City", "name": "Ajaccio" },
        { "@type": "AdministrativeArea", "name": "Corse" }
      ],
      "serviceType": "Audit SEO",
      "offers": {
        "@type": "Offer",
        "name": "Audit SEO gratuit",
        "price": "0",
        "priceCurrency": "EUR",
        "availability": "https://schema.org/InStock"
      }
    }
  ]
};

const faqStructuredData = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Pourquoi proposez-vous cet audit gratuitement ?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Parce que sans regarder votre site, je ne peux pas vous dire si une prestation SEO a du sens pour vous. C'est aussi un filtre dans les deux sens : si je vois que vous n'êtes pas un bon profil pour mon offre, je vous le dis et je vous oriente. Pas de devis bidon, pas de proposition forcée."
      }
    },
    {
      "@type": "Question",
      "name": "Concrètement, je reçois quoi à la fin ?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Un constat oral en visio : ce qui est en place sur votre site (technique de base, balises principales, présence Google Business), ce qui manque visiblement, et un avis franc sur la viabilité d'une démarche SEO sur votre niche. Pas de rapport PDF, pas de plan d'action chiffré - c'est ce qui distingue cet audit gratuit de l'audit complet à 690€."
      }
    },
    {
      "@type": "Question",
      "name": "Est-ce que je vais être harcelé après par des relances commerciales ?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Non. Une seule relance par email 7 à 10 jours après l'audit, pour savoir si vous voulez aller plus loin. Pas de séquence automatique, pas d'inscription newsletter, pas de retargeting publicitaire."
      }
    },
    {
      "@type": "Question",
      "name": "Combien de temps prend l'audit ?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "15 à 20 minutes en visio. Je regarde votre site en partage d'écran, je commente ce que je vois, vous posez vos questions. C'est volontairement court - pour aller plus loin, c'est l'audit complet à 690€."
      }
    },
    {
      "@type": "Question",
      "name": "Puis-je avoir un audit complet ensuite si je veux aller plus loin ?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Oui. Si vous voulez un plan d'action priorisé, l'analyse de vos backlinks, l'étude de vos concurrents et un rapport visuel détaillé, vous prenez l'audit complet à 690€ HT, livré sous 5 jours ouvrés. Le montant de l'audit gratuit n'est pas déductible - c'est gratuit pour de bon."
      }
    }
  ]
};

const breadcrumbStructuredData = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Accueil", "item": "https://www.davidbarbier.com/" },
    { "@type": "ListItem", "position": 2, "name": "Agence SEO Ajaccio", "item": "https://www.davidbarbier.com/agence-seo-ajaccio/" },
    { "@type": "ListItem", "position": 3, "name": "Audit SEO gratuit Ajaccio", "item": "https://www.davidbarbier.com/audit-seo-gratuit-ajaccio/" }
  ]
};
---

<Layout metadata={metadata}>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(serviceStructuredData)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(faqStructuredData)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbStructuredData)} />
  </Fragment>

  <section class="relative isolate overflow-hidden dark:bg-[#030620]">
    <!-- Fil d'Ariane -->
    <div class="mx-auto max-w-7xl px-6 pt-8 lg:px-8">
      <nav aria-label="Fil d'Ariane" class="text-sm font-body">
        <ol class="flex items-center gap-2 text-gray-500 dark:text-gray-400 flex-wrap">
          <li><a href="/" class="hover:text-green-700 dark:hover:text-green-400 transition-colors">Accueil</a></li>
          <li><svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg></li>
          <li><a href="/agence-seo-ajaccio/" class="hover:text-green-700 dark:hover:text-green-400 transition-colors">Agence SEO Ajaccio</a></li>
          <li><svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg></li>
          <li class="text-gray-900 dark:text-white font-medium">Audit SEO gratuit</li>
        </ol>
      </nav>
    </div>

    <div class="mx-auto max-w-3xl px-6 pb-16 pt-8 lg:py-20">
      <div class="mt-4">
        <span class="inline-flex items-center rounded-full bg-emerald-600/10 px-3 py-1 text-sm font-semibold text-emerald-700 dark:text-emerald-400 ring-1 ring-inset ring-emerald-600/20">
          Gratuit · Sans engagement · 15-20 min
        </span>
      </div>

      <h1 class="mt-6 text-base font-semibold uppercase tracking-wider text-emerald-700 dark:text-emerald-400">
        Audit SEO gratuit
      </h1>

      <p class="mt-3 text-pretty font-heading text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tight leading-[1.1]">
        <span class="text-green-950 dark:text-white">Où en est votre site,</span><br />
        <span class="text-emerald-700 dark:text-emerald-400">sans filtre.</span>
      </p>

      <p class="mt-6 text-sm text-gray-500 dark:text-gray-400">
        ⭐ 5/5 sur Google · 16 avis · +50 clients accompagnés · Basé à Ajaccio
      </p>

      <p class="mt-6 text-lg text-gray-600 dark:text-gray-300 leading-relaxed">
        Avant d'investir le moindre euro en SEO, savoir où vous en êtes vraiment. C'est exactement ce que fait cet audit : 15-20 minutes en visio, votre site passé en revue avec vous, ce qui est en place et ce qui manque. Sans rapport PDF cosmétique, sans devis forcé derrière.
      </p>

      <div class="mt-10 flex items-center gap-x-6 flex-wrap">
        <a
          href="tel:+33623565299"
          class="rounded-md bg-green-700 px-5 py-3 text-sm font-semibold text-white shadow-sm hover:bg-green-700/90"
        >
          Réserver mon audit gratuit
        </a>
        <a href="/audit-seo-ajaccio/" class="inline-flex items-center gap-2 text-sm font-semibold text-gray-900 dark:text-gray-300">
          Plutôt l'audit complet 690€ ?
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
        </a>
      </div>
    </div>
  </section>

  <!-- Ce que c'est / ce que ce n'est pas -->
  <section class="px-6 py-16 lg:px-8">
    <div class="mx-auto max-w-5xl">
      <h2 class="text-3xl sm:text-4xl font-bold text-gray-900 dark:text-white mb-12">
        Ce que je fais. Ce que je <span class="text-emerald-700 dark:text-emerald-400">ne fais pas.</span>
      </h2>

      <div class="grid md:grid-cols-2 gap-6">
        <div class="rounded-2xl border border-emerald-200 dark:border-emerald-800 bg-emerald-50/50 dark:bg-emerald-900/20 p-8">
          <p class="text-sm font-semibold uppercase tracking-wide text-emerald-700 dark:text-emerald-400 mb-4">Ce que je fais</p>
          <ul class="space-y-3 text-gray-700 dark:text-gray-300">
            <li class="flex gap-2"><span class="text-emerald-600 flex-shrink-0">✓</span>Tour d'horizon visuel de votre site (structure, lisibilité, mobile)</li>
            <li class="flex gap-2"><span class="text-emerald-600 flex-shrink-0">✓</span>Check des fondamentaux techniques (titres, balises, vitesse, indexation)</li>
            <li class="flex gap-2"><span class="text-emerald-600 flex-shrink-0">✓</span>Coup d'œil sur votre fiche Google Business (catégorie, services, avis)</li>
            <li class="flex gap-2"><span class="text-emerald-600 flex-shrink-0">✓</span>Identification rapide des gros points bloquants</li>
            <li class="flex gap-2"><span class="text-emerald-600 flex-shrink-0">✓</span>Avis franc sur la viabilité SEO de votre niche</li>
          </ul>
        </div>

        <div class="rounded-2xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-slate-900 p-8">
          <p class="text-sm font-semibold uppercase tracking-wide text-gray-500 dark:text-gray-400 mb-4">Ce que je ne fais pas</p>
          <ul class="space-y-3 text-gray-600 dark:text-gray-300">
            <li class="flex gap-2"><span class="text-red-500 flex-shrink-0">✕</span>Analyse des backlinks (Ahrefs/Majestic)</li>
            <li class="flex gap-2"><span class="text-red-500 flex-shrink-0">✕</span>Étude des concurrents directs</li>
            <li class="flex gap-2"><span class="text-red-500 flex-shrink-0">✕</span>Étude de mots-clés stratégiques</li>
            <li class="flex gap-2"><span class="text-red-500 flex-shrink-0">✕</span>Plan d'action priorisé et chiffré</li>
            <li class="flex gap-2"><span class="text-red-500 flex-shrink-0">✕</span>Rapport visuel ou document écrit</li>
          </ul>
          <p class="mt-5 text-sm text-gray-500 dark:text-gray-400 italic">
            Pour ces livrables, c'est l'<a href="/audit-seo-ajaccio/" class="text-emerald-700 dark:text-emerald-400 hover:underline">audit complet à 690€ HT</a>, livré sous 5 jours.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Comment ça se passe -->
  <section id="process" class="px-6 py-16 lg:px-8 bg-gray-50 dark:bg-slate-800 scroll-mt-32">
    <div class="mx-auto max-w-3xl">
      <h2 class="text-3xl sm:text-4xl font-bold text-gray-900 dark:text-white mb-12">
        Comment ça se passe
      </h2>

      <ol class="space-y-8">
        <li class="flex gap-6">
          <span class="flex-shrink-0 size-10 rounded-full bg-emerald-600 text-white font-bold flex items-center justify-center">1</span>
          <div>
            <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-2">Vous me partagez l'URL de votre site</h3>
            <p class="text-gray-600 dark:text-gray-300">Par téléphone ou par mail. Si vous avez un compte Search Console, c'est encore mieux - un accès en lecture seule m'aide à voir ce que Google voit vraiment.</p>
          </div>
        </li>
        <li class="flex gap-6">
          <span class="flex-shrink-0 size-10 rounded-full bg-emerald-600 text-white font-bold flex items-center justify-center">2</span>
          <div>
            <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-2">On cale 15-20 minutes en visio</h3>
            <p class="text-gray-600 dark:text-gray-300">Visio, téléphone, ou les deux. En partage d'écran je passe en revue votre site et votre fiche Google Business, je commente en direct ce que je vois.</p>
          </div>
        </li>
        <li class="flex gap-6">
          <span class="flex-shrink-0 size-10 rounded-full bg-emerald-600 text-white font-bold flex items-center justify-center">3</span>
          <div>
            <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-2">Je vous dis ce que je pense - sans filtre</h3>
            <p class="text-gray-600 dark:text-gray-300">Y compris si je pense que le SEO n'est pas le bon levier pour vous. Y compris si votre site n'a pas besoin d'un consultant. Le but c'est que vous repartiez avec une vision claire, pas avec un devis.</p>
          </div>
        </li>
        <li class="flex gap-6">
          <span class="flex-shrink-0 size-10 rounded-full bg-emerald-600 text-white font-bold flex items-center justify-center">4</span>
          <div>
            <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-2">Une seule relance, 7 à 10 jours après</h3>
            <p class="text-gray-600 dark:text-gray-300">Un email pour savoir si vous voulez aller plus loin (audit complet, accompagnement, optimisation GBP). Pas de séquence automatique, pas de retargeting.</p>
          </div>
        </li>
      </ol>
    </div>
  </section>

  <!-- Pour qui c'est utile -->
  <section class="px-6 py-16 lg:px-8">
    <div class="mx-auto max-w-3xl">
      <h2 class="text-3xl sm:text-4xl font-bold text-gray-900 dark:text-white mb-8">
        Cet audit est utile si vous êtes dans une de ces situations
      </h2>

      <ul class="space-y-5 text-lg text-gray-600 dark:text-gray-300">
        <li class="flex gap-3"><span class="text-emerald-600 flex-shrink-0 mt-1">→</span>Votre site existe depuis plus de 6 mois et vous n'avez aucune idée de ses performances SEO réelles.</li>
        <li class="flex gap-3"><span class="text-emerald-600 flex-shrink-0 mt-1">→</span>Une agence vous a vendu une prestation SEO et vous voulez un deuxième avis avant de signer.</li>
        <li class="flex gap-3"><span class="text-emerald-600 flex-shrink-0 mt-1">→</span>Vos concurrents apparaissent en première page, vous non, et vous ne comprenez pas pourquoi.</li>
        <li class="flex gap-3"><span class="text-emerald-600 flex-shrink-0 mt-1">→</span>Vous hésitez à investir dans le SEO et vous voulez savoir si ça vaut le coup pour votre activité.</li>
      </ul>

      <p class="mt-10 text-gray-600 dark:text-gray-300 italic">
        Si vous lancez votre site la semaine prochaine, l'audit gratuit est moins pertinent - il y a peu à analyser. Dans ce cas on parle plutôt directement de l'<a href="/creation-site-internet-ajaccio/" class="text-emerald-700 dark:text-emerald-400 font-semibold hover:underline">offre création de site</a>.
      </p>
    </div>
  </section>

  <!-- CTA -->
  <section class="px-6 py-16 lg:px-8 bg-gray-50 dark:bg-slate-800">
    <div class="mx-auto max-w-3xl">
      <div class="text-center mb-10">
        <h2 class="text-3xl sm:text-4xl font-bold text-gray-900 dark:text-white mb-4">
          Prêt à savoir où vous en êtes ?
        </h2>
        <p class="text-lg text-gray-600 dark:text-gray-300">
          Téléphone, email, ou formulaire - au choix.
        </p>
      </div>

      <div class="grid md:grid-cols-2 gap-6">
        <!-- Direct contact -->
        <div class="bg-white dark:bg-gray-900 rounded-2xl p-6 border border-gray-100 dark:border-gray-800 flex flex-col justify-center text-center">
          <p class="text-sm font-semibold uppercase tracking-wide text-emerald-700 dark:text-emerald-400 mb-3">Direct</p>
          <a href="tel:+33623565299" class="block text-2xl font-bold text-gray-900 dark:text-white hover:text-emerald-700 dark:hover:text-emerald-400 transition-colors mb-3">
            06 23 56 52 99
          </a>
          <a href="mailto:hello@davidbarbier.com" class="block text-base text-gray-600 dark:text-gray-300 hover:text-emerald-700 dark:hover:text-emerald-400 transition-colors">
            hello@davidbarbier.com
          </a>
          <p class="text-xs text-gray-500 dark:text-gray-400 mt-4 italic">
            Réponse sous 48h ouvrées.
          </p>
        </div>

        <!-- Form compact -->
        <form method="post" action="https://formspree.io/f/xayglvyo" class="bg-white dark:bg-gray-900 rounded-2xl p-6 border border-gray-100 dark:border-gray-800 space-y-4">
          <p class="text-sm font-semibold uppercase tracking-wide text-emerald-700 dark:text-emerald-400">Réservez en 30 secondes</p>
          <input type="hidden" name="_subject" value="[Audit SEO gratuit] Nouvelle demande" />
          <input type="hidden" name="source" value="audit-seo-gratuit-ajaccio" />
          <div>
            <label for="g_name" class="sr-only">Votre nom</label>
            <input id="g_name" name="name" type="text" required placeholder="Votre nom" class="w-full rounded-md border border-gray-300 dark:border-gray-700 dark:bg-slate-900 dark:text-white p-2.5 text-sm" />
          </div>
          <div>
            <label for="g_email" class="sr-only">Votre email</label>
            <input id="g_email" name="email" type="email" required placeholder="Votre email" class="w-full rounded-md border border-gray-300 dark:border-gray-700 dark:bg-slate-900 dark:text-white p-2.5 text-sm" />
          </div>
          <div>
            <label for="g_url" class="sr-only">URL de votre site</label>
            <input id="g_url" name="site_url" type="url" required placeholder="https://votresite.fr" class="w-full rounded-md border border-gray-300 dark:border-gray-700 dark:bg-slate-900 dark:text-white p-2.5 text-sm" />
          </div>
          <button type="submit" class="w-full bg-emerald-700 hover:bg-emerald-600 text-white py-2.5 px-4 rounded-md text-sm font-semibold transition">
            Réserver mon audit gratuit
          </button>
          <p class="text-xs text-gray-500 dark:text-gray-400">
            Je vous recontacte pour caler 20 min en visio.
          </p>
        </form>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 my-16">
    <h2 class="font-bold tracking-tight text-3xl mb-4">FAQ - Audit SEO gratuit</h2>
    <div>
      <details class="mb-4">
        <summary class="font-semibold text-lg hover:cursor-pointer"><h3 class="inline">Pourquoi proposez-vous cet audit gratuitement ?</h3></summary>
        <p class="pl-4 mt-2">Sans regarder votre site, je ne peux pas vous dire si une prestation SEO a du sens pour vous. C'est aussi un filtre dans les deux sens : si je vois que vous n'êtes pas un bon profil pour mon offre, je vous le dis et je vous oriente. Pas de devis bidon, pas de proposition forcée.</p>
      </details>
      <details class="mb-4">
        <summary class="font-semibold text-lg hover:cursor-pointer"><h3 class="inline">Concrètement, je reçois quoi à la fin ?</h3></summary>
        <p class="pl-4 mt-2">Un constat oral en visio : ce qui est en place sur votre site, ce qui manque visiblement, et un avis franc sur la viabilité d'une démarche SEO sur votre niche.</p>
        <p class="pl-4 mt-2">Pas de rapport PDF, pas de plan d'action chiffré - c'est ce qui distingue cet audit gratuit de l'<a href="/audit-seo-ajaccio/" class="text-emerald-700 dark:text-emerald-400 hover:underline">audit complet à 690€</a>.</p>
      </details>
      <details class="mb-4">
        <summary class="font-semibold text-lg hover:cursor-pointer"><h3 class="inline">Est-ce que je vais être harcelé après par des relances commerciales ?</h3></summary>
        <p class="pl-4 mt-2">Non. Une seule relance par email 7 à 10 jours après l'audit, pour savoir si vous voulez aller plus loin. Pas de séquence automatique, pas d'inscription newsletter, pas de retargeting publicitaire.</p>
      </details>
      <details class="mb-4">
        <summary class="font-semibold text-lg hover:cursor-pointer"><h3 class="inline">Combien de temps prend l'audit ?</h3></summary>
        <p class="pl-4 mt-2">15 à 20 minutes en visio. Je regarde votre site en partage d'écran, je commente ce que je vois, vous posez vos questions. Pour aller plus loin, c'est l'audit complet à 690€.</p>
      </details>
      <details class="mb-4">
        <summary class="font-semibold text-lg hover:cursor-pointer"><h3 class="inline">Puis-je avoir un audit complet ensuite si je veux aller plus loin ?</h3></summary>
        <p class="pl-4 mt-2">Oui. Si vous voulez un plan d'action priorisé, l'analyse de vos backlinks, l'étude de vos concurrents et un rapport visuel détaillé, vous prenez l'<a href="/audit-seo-ajaccio/" class="text-emerald-700 dark:text-emerald-400 hover:underline">audit complet à 690€ HT</a>, livré sous 5 jours ouvrés.</p>
        <p class="pl-4 mt-2">Le montant de l'audit gratuit n'est pas déductible - c'est gratuit pour de bon.</p>
      </details>
    </div>
  </section>

  <!-- Cross-link pilier -->
  <section class="px-6 py-12 lg:px-8 border-t border-gray-200 dark:border-gray-800">
    <div class="mx-auto max-w-3xl text-center">
      <p class="text-gray-600 dark:text-gray-300 mb-4">
        L'audit gratuit n'est qu'un point d'entrée. Pour comprendre l'offre complète :
      </p>
      <a href="/agence-seo-ajaccio/" class="inline-flex items-center gap-2 font-semibold text-emerald-700 dark:text-emerald-400 hover:gap-3 transition-all">
        Voir tous mes services SEO à Ajaccio
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
      </a>
    </div>
  </section>
</Layout>
