---
import { UI, I18N, SITE } from '~/utils/config';
---

<script is:inline define:vars={{ defaultTheme: UI.theme, locales:I18N.locales, trailingSlash:SITE.trailingSlash }}>
  function applyTheme(theme) {
    if (theme === 'dark') {
      document.documentElement.classList.add('dark');
    } else {
      document.documentElement.classList.remove('dark');
    }
  }

  if ((defaultTheme && defaultTheme.endsWith(':only')) || (!localStorage.theme && defaultTheme !== 'system')) {
    applyTheme(defaultTheme.replace(':only', ''));
  } else if (
    localStorage.theme === 'dark' ||
    (!('theme' in localStorage) && window.matchMedia('(prefers-color-scheme: dark)').matches)
  ) {
    applyTheme('dark');
  } else {
    applyTheme('light');
  }

  function initScripts() {
    // Nettoyer l'état du menu mobile
    document.body.classList.remove("overflow-hidden");
    document.getElementById("header")?.classList.remove("h-screen", "expanded", "bg-page");
    document.querySelector("#header nav")?.classList.add("hidden");
    document.querySelector("#header > div > div:last-child")?.classList.add("hidden");
    var toggleMenuBtn = document.querySelector('[data-aw-toggle-menu]');
    if (toggleMenuBtn) { toggleMenuBtn.classList.remove('expanded'); }

    document.documentElement.classList.add('motion-safe:scroll-smooth');

    // Cloner et remplacer les éléments pour supprimer les anciens listeners
    document.querySelectorAll('[data-aw-toggle-menu]').forEach(function(el) {
      var clone = el.cloneNode(true);
      el.parentNode.replaceChild(clone, el);
    });

    document.querySelectorAll('#header nav').forEach(function(el) {
      var clone = el.cloneNode(true);
      el.parentNode.replaceChild(clone, el);
    });

    // Toggle menu mobile
    document.querySelectorAll('[data-aw-toggle-menu]').forEach(function(elem) {
      elem.addEventListener('click', function () {
        document.body.classList.toggle("overflow-hidden");
        document.getElementById("header")?.classList.toggle("h-screen");
        document.getElementById("header")?.classList.toggle("expanded");
        document.getElementById("header")?.classList.toggle("bg-page");
        document.querySelector("#header nav")?.classList.toggle("hidden");
        document.querySelector("#header > div > div:last-child")?.classList.toggle("hidden");
      });
    });

    // Fermer menu au clic sur un lien de navigation
    document.querySelectorAll('#header nav').forEach(function(elem) {
      elem.addEventListener('click', function () {
        document.querySelector("[data-aw-toggle-menu]")?.classList.remove("expanded");
        document.body.classList.remove("overflow-hidden");
        document.getElementById("header")?.classList.remove("h-screen", "expanded", "bg-page");
        document.querySelector("#header nav")?.classList.add("hidden");
        document.querySelector("#header > div > div:last-child")?.classList.add("hidden");
      });
    });

    // Toggle dark mode
    document.querySelectorAll('[data-aw-toggle-color-scheme]').forEach(function(elem) {
      elem.addEventListener('click', function () {
        if (defaultTheme.endsWith(':only')) { return; }
        document.documentElement.classList.toggle('dark');
        localStorage.theme = document.documentElement.classList.contains('dark') ? 'dark' : 'light';
      });
    });

    // Social share
    document.querySelectorAll('[data-aw-social-share]').forEach(function(elem) {
      elem.addEventListener('click', function () {
        var network = elem.getAttribute('data-aw-social-share');
        var url = encodeURIComponent(elem.getAttribute('data-aw-url'));
        var text = encodeURIComponent(elem.getAttribute('data-aw-text'));

        var href;
        switch (network) {
          case 'facebook':
            href = 'https://www.facebook.com/sharer.php?u=' + url;
            break;
          case 'twitter':
            href = 'https://twitter.com/intent/tweet?url=' + url + '&text=' + text;
            break;
          case 'linkedin':
            href = 'https://www.linkedin.com/shareArticle?mini=true&url=' + url + '&title=' + text;
            break;
          case 'whatsapp':
            href = 'https://wa.me/?text=' + text + '%20' + url;
            break;
          case 'mail':
            href = 'mailto:?subject=%22' + text + '%22&body=' + text + '%20' + url;
            break;
          default:
            return;
        }

        var newlink = document.createElement('a');
        newlink.target = '_blank';
        newlink.href = href;
        newlink.click();
      });
    });

    // Scroll header style
    var lastKnownScrollPosition = window.scrollY;
    var ticking = true;

    function appyHeaderStylesOnScroll() {
      var header = document.getElementById('header');
      if (!header) return;
      if (lastKnownScrollPosition > 60 && !header.classList.contains('scroll')) {
        header.classList.add('scroll');
      } else if (lastKnownScrollPosition <= 60 && header.classList.contains('scroll')) {
        header.classList.remove('scroll');
      }
      ticking = false;
    }
    appyHeaderStylesOnScroll();

    // Éviter d'empiler les scroll listeners
    if (window._awScrollHandler) {
      document.removeEventListener('scroll', window._awScrollHandler);
    }
    window._awScrollHandler = function () {
      lastKnownScrollPosition = window.scrollY;
      if (!ticking) {
        window.requestAnimationFrame(function () {
          appyHeaderStylesOnScroll();
        });
        ticking = true;
      }
    };
    document.addEventListener('scroll', window._awScrollHandler);
  }

  // Écouter astro:page-load (se déclenche aussi au premier chargement)
  document.addEventListener('astro:page-load', initScripts);
</script>
