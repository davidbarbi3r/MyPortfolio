---
const currentLocale = Astro.currentLocale ?? 'fr'

---

<script>
  const langButton = document.getElementById('toggleLang')
  langButton?.addEventListener("click", (e) => {
    const newLang = langButton.textContent?.trim() === "fr" ? "/en" : "";
    langButton.textContent = langButton.textContent?.trim() === 'fr' ? 'en' : 'fr';
    const oldUrl = window.location.href;

    const urlWithoutOrigin = oldUrl.replace(window.location.origin, '');
    const urlWithoutOriginLang = urlWithoutOrigin.replace('/en', '')

    const newUrl = `${newLang}${urlWithoutOriginLang}`;
    console.log("urlwithout ori", newUrl)
    window.location.pathname = newUrl;
})
</script>
<button
  id="toggleLang"
  class="px-4 py-2 rounded-md text-sm font-medium bg-white bg-dark text-gray-700 text-gray-300 focus:ring-1 focus:ring-blue-500 focus:border-blue-500 hover:bg-gray-100 hover:bg-gray-700 transition duration-150 ease-in-out uppercase"
>
  {currentLocale}
</button>
