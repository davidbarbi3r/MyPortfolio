---
import { Icon } from 'astro-icon/components';

import Image from '~/components/common/Image.astro';
import PostTags from '~/components/blog/Tags.astro';
import SocialShare from '~/components/common/SocialShare.astro';
import AuthorBox from '~/components/blog/AuthorBox.astro';
import TableOfContents from '~/components/blog/TableOfContents.astro';
import LeadMagnetForm from '~/components/widgets/LeadMagnetForm.astro';
import type { ImageMetadata } from 'astro';

import { getPermalink } from '~/utils/permalinks';
import { getFormattedDate } from '~/utils/utils';

import type { Post } from '~/types';

export interface Props {
  post: Post;
  url: string | URL | ImageMetadata;
}

const { post, url } = Astro.props;
const Content = post?.Content || null;
const postId = post.id;
const isECPost = post.tags?.some(tag => tag.toLowerCase().includes('expert-comptable'));
---

<section class="py-8 sm:py-16 lg:py-20 mx-auto">
  <article>
    <header class={post.image ? '' : ''}>
      <div class="flex justify-between flex-col sm:flex-row max-w-4xl mx-auto mt-0 mb-2 px-4 sm:px-6 sm:items-center">
        <p>
          <Icon name="tabler:clock" class="w-4 h-4 inline-block -mt-0.5 dark:text-gray-400" />
          <span class="inline-block">Publié le <time datetime={String(post.publishDate)}>{getFormattedDate(post.publishDate)}</time></span>
          {
            post.updateDate && String(post.updateDate) !== String(post.publishDate) && (
              <>
                {' '}
                ·{' '}
                <span class="inline-block">Mis à jour le <time datetime={String(post.updateDate)}>{getFormattedDate(post.updateDate)}</time></span>
              </>
            )
          }
          {
            post.category && (
              <>
                {' '}
                ·{' '}
                <a class="capitalize hover:underline inline-block" href={getPermalink(post.category, 'category')}>
                  {post.category.replaceAll('-', ' ')}
                </a>
              </>
            )
          }
          {post.readingTime && <> · {post.readingTime} min de lecture</>}
        </p>
      </div>
      <h1
        class="px-4 sm:px-6 max-w-4xl mx-auto text-4xl md:text-5xl font-bold leading-tighter tracking-tighter font-heading"
        transition:name={`blog-title-${postId}`}
      >
        {post.title}
      </h1>
      <p
        class="max-w-4xl mx-auto mt-4 mb-8 px-4 sm:px-6 text-lg md:text-xl text-muted dark:text-slate-400 text-justify"
      >
        {post.excerpt}
      </p>

      {
        post.image ? (
          <Image
            src={post.image}
            class="max-w-full lg:max-w-[900px] mx-auto mb-6 sm:rounded-md bg-gray-400 dark:bg-slate-700"
            widths={[400, 900]}
            sizes="(max-width: 900px) 400px, 900px"
            alt={post?.excerpt || ''}
            loading="eager"
            width={900}
            height={506}
            loading="eager"
            decoding="async"
            transition:name={`blog-image-${postId}`}
          />
        ) : (
          <div class="max-w-3xl mx-auto px-4 sm:px-6">
            <div class="border-t dark:border-slate-700" />
          </div>
        )
      }
    </header>
    <div class="relative">
      <div
        class="mx-auto px-6 sm:px-6 max-w-4xl prose lg:prose-lg dark:prose-invert dark:prose-headings:text-slate-300 prose-md prose-headings:font-heading prose-headings:leading-tighter prose-headings:tracking-tighter prose-headings:font-bold prose-headings:scroll-mt-28 prose-a:text-primary dark:prose-a:text-blue-400 prose-img:rounded-md prose-img:shadow-lg mt-4"
      >
        {
          Content ? (
            <Content />
          ) : (
            <Fragment set:html={post.content} />
          )
        }
      </div>
      {post.headings && <TableOfContents headings={post.headings} />}
    </div>
    {post.author && <AuthorBox author={post.author} />}
    {isECPost && (
      <div class="max-w-4xl mx-auto px-4 sm:px-6 mt-8">
        <LeadMagnetForm />
      </div>
    )}
    <div class="mx-auto px-6 sm:px-6 max-w-3xl mt-8 flex justify-between flex-col sm:flex-row">
      <PostTags tags={post.tags} class="mr-5 rtl:mr-0 rtl:ml-5" />
      <SocialShare url={url} text={post.title} class="mt-5 sm:mt-1 align-middle text-gray-500 dark:text-slate-600" />
    </div>
  </article>
</section>
