---
---

<style is:inline is:global>
  /* Clash Display - titres (test : 400 pour rester proche de l'esprit light Montegrappa) */
  @font-face {
    font-family: 'Clash Display';
    src: url('/fonts/clash-display-400.woff2') format('woff2');
    font-weight: 400;
    font-display: swap;
    font-style: normal;
  }
  @font-face {
    font-family: 'Clash Display';
    src: url('/fonts/clash-display-500.woff2') format('woff2');
    font-weight: 500;
    font-display: swap;
    font-style: normal;
  }

  /* Switzer - corps de texte (300/400/500) */
  @font-face {
    font-family: 'Switzer';
    src: url('/fonts/switzer-300.woff2') format('woff2');
    font-weight: 300;
    font-display: swap;
    font-style: normal;
  }
  @font-face {
    font-family: 'Switzer';
    src: url('/fonts/switzer-400.woff2') format('woff2');
    font-weight: 400;
    font-display: swap;
    font-style: normal;
  }
  @font-face {
    font-family: 'Switzer';
    src: url('/fonts/switzer-500.woff2') format('woff2');
    font-weight: 500;
    font-display: swap;
    font-style: normal;
  }

  :root {
    /* Design system Montegrappa (spec docs/superpowers/specs/2026-07-10) */
    --mg-cream: #F2F0EB;
    --mg-sand: #E5E2D9;
    /* Vert du logo DB (#6CAB7E) en accent ; déclinaison foncée #427050 pour les textes (5:1 sur crème) */
    --mg-sage: #6CAB7E;
    --mg-sage-dark: #427050;
    --mg-charcoal: #1D1D1B;
    --mg-text: #3B3B38;

    /* Triplets RGB : nécessaires aux modificateurs d'opacité Tailwind (bg-cream/90) */
    --mg-cream-rgb: 242 240 235;
    --mg-sand-rgb: 229 226 217;
    --mg-sage-rgb: 108 171 126;
    --mg-sage-dark-rgb: 66 112 80;
    --mg-charcoal-rgb: 29 29 27;

    --aw-font-sans: 'Switzer';
    --aw-font-serif: 'Clash Display';
    --aw-font-heading: 'Clash Display';

    --aw-color-primary: var(--mg-sage-dark);
    --aw-color-secondary: var(--mg-charcoal);
    --aw-color-accent: var(--mg-sage);
    --aw-color-accent-light: var(--mg-sand);

    --aw-color-text-heading: var(--mg-charcoal);
    --aw-color-text-default: var(--mg-text);
    --aw-color-text-muted: rgb(59 59 56 / 62%);
    --aw-color-bg-page: var(--mg-cream);

    /* Conservé : des classes bg-dark subsistent sur les pages internes */
    --aw-color-bg-page-dark: var(--mg-charcoal);
  }

  /* Titres en Clash Display 500 (test) : un cran plus gras */
  h1, h2, h3, h4, h5, h6,
  .font-heading {
    font-family: var(--aw-font-heading), system-ui, sans-serif !important;
    font-weight: 500 !important;
    letter-spacing: -0.01em;
  }

  /* Spans/strongs inside headings inherit the heading font */
  h1 *, h2 *, h3 *, h4 * {
    font-family: inherit !important;
    font-weight: inherit !important;
  }
</style>
