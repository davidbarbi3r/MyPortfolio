---
---

<style is:inline is:global>
  /* Clash Display - headings */
  @font-face {
    font-family: 'Clash Display';
    src: url('/fonts/clash-display-400.woff2') format('woff2');
    font-weight: 400;
    font-display: swap;
    font-style: normal;
  }
  @font-face {
    font-family: 'Clash Display';
    src: url('/fonts/clash-display-500.woff2') format('woff2');
    font-weight: 500;
    font-display: swap;
    font-style: normal;
  }

  /* Switzer - body */
  @font-face {
    font-family: 'Switzer';
    src: url('/fonts/switzer-400.woff2') format('woff2');
    font-weight: 400;
    font-display: swap;
    font-style: normal;
  }
  @font-face {
    font-family: 'Switzer';
    src: url('/fonts/switzer-500.woff2') format('woff2');
    font-weight: 500;
    font-display: swap;
    font-style: normal;
  }

  :root {
    --aw-font-sans: 'Switzer';
    --aw-font-serif: 'Clash Display';
    --aw-font-heading: 'Clash Display';

    --aw-color-primary: rgb(5 102 73);
    --aw-color-secondary: rgb(30 58 138);
    --aw-color-accent: rgb(180 83 9);
    --aw-color-accent-light: rgb(251 191 36);

    --aw-color-text-heading: rgb(15 23 42);
    --aw-color-text-default: rgb(30 30 30);
    --aw-color-text-muted: rgb(30 30 30 / 60%);
    --aw-color-bg-page: rgb(255 255 255);

    --aw-color-bg-page-dark: rgb(3 6 32);
  }

  /* Clash Display for all headings - cap at weight 500 */
  h1, h2, h3, h4, h5, h6,
  .font-heading {
    font-family: var(--aw-font-heading), system-ui, sans-serif !important;
    font-weight: 500 !important;
  }

  /* Spans/strongs inside headings inherit the heading font */
  h1 *, h2 *, h3 *, h4 * {
    font-family: inherit !important;
    font-weight: inherit !important;
  }

  .dark {
    --aw-font-sans: 'Switzer';
    --aw-font-serif: 'Clash Display';
    --aw-font-heading: 'Clash Display';

    --aw-color-primary: rgb(5 102 73);
    --aw-color-secondary: rgb(30 58 138);
    --aw-color-accent: rgb(217 119 6);
    --aw-color-accent-light: rgb(251 191 36);

    --aw-color-text-heading: rgb(241 245 249);
    --aw-color-text-default: rgb(229 236 246);
    --aw-color-text-muted: rgb(229 236 246 / 60%);
    --aw-color-bg-page: var(--aw-color-bg-page-dark);
  }
</style>