---
// ProjectsFlip - GSAP Flip animation for swapping featured/stack project cards
// Desktop only - disabled on mobile where cards stack vertically
---

<script>
  import gsap from 'gsap';
  import { Flip } from 'gsap/Flip';

  gsap.registerPlugin(Flip);

  function initProjectsFlip() {
    const grid = document.querySelector('[data-project-grid]');
    if (!grid) return;

    // Desktop only (matches lg: breakpoint = 1024px)
    const mql = window.matchMedia('(min-width: 1024px)');
    if (!mql.matches) return;

    const featuredSlot = grid.querySelector('[data-featured-slot]') as HTMLElement;
    const stackSlot = grid.querySelector('[data-stack-slot]') as HTMLElement;
    if (!featuredSlot || !stackSlot) return;

    let isAnimating = false;

    // Les classes des deux variantes vivent dans ProjectCard.astro (source
    // unique) : chaque élément qui change porte data-featured-class /
    // data-stack-class, on ne fait que basculer de l'une à l'autre.
    function applyVariant(card: HTMLElement, variant: 'featured' | 'stack') {
      const key = variant === 'featured' ? 'featuredClass' : 'stackClass';
      const els = [card, ...Array.from(card.querySelectorAll<HTMLElement>('[data-featured-class]'))];
      for (const el of els) {
        const cls = el.dataset[key];
        if (cls !== undefined) el.className = cls;
      }
    }

    function swapCards(clickedCard: HTMLElement) {
      if (isAnimating) return;
      isAnimating = true;

      const featuredCard = featuredSlot.querySelector('[data-project-card]') as HTMLElement;
      if (!featuredCard || clickedCard === featuredCard) {
        isAnimating = false;
        return;
      }

      // Remember clicked card position in stack
      const stackCards = Array.from(stackSlot.querySelectorAll('[data-project-card]'));
      const clickedIndex = stackCards.indexOf(clickedCard);

      // Lock grid height to prevent content jump
      const gridEl = grid as HTMLElement;
      const gridRect = gridEl.getBoundingClientRect();
      gridEl.style.minHeight = gridRect.height + 'px';

      // Capture state before DOM change
      const allCards = grid.querySelectorAll('[data-project-card]');
      const state = Flip.getState(allCards);

      // DOM swap
      featuredSlot.appendChild(clickedCard);
      if (clickedIndex === 0) {
        stackSlot.prepend(featuredCard);
      } else {
        stackSlot.appendChild(featuredCard);
      }

      // Apply styles after swap
      applyVariant(clickedCard, 'featured');
      applyVariant(featuredCard, 'stack');

      // Animate
      Flip.from(state, {
        duration: 0.6,
        ease: 'power2.inOut',
        absolute: true,
        onComplete: () => {
          gridEl.style.minHeight = '';
          isAnimating = false;
        }
      });
    }

    // Prevent link clicks from triggering swap
    stackSlot.addEventListener('click', (e: Event) => {
      const target = e.target as HTMLElement;
      // Don't swap if clicking a link
      if (target.closest('a')) return;

      const card = target.closest('[data-project-card]') as HTMLElement;
      if (card && stackSlot.contains(card)) {
        swapCards(card);
      }
    });
  }

  // Support View Transitions + standard load
  document.addEventListener('astro:page-load', initProjectsFlip);
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initProjectsFlip);
  } else {
    initProjectsFlip();
  }
</script>
