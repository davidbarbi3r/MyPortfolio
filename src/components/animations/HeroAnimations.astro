---
// HeroAnimations - clip-path reveal, mask wipe, counter, magnetic button
---

<script>
  import gsap from 'gsap';
  import { SplitText } from 'gsap/SplitText';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(SplitText, ScrollTrigger);

  function initHeroAnimations() {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    const hero = document.querySelector('[data-hero]');
    if (!hero) return;

    const tl = gsap.timeline({ defaults: { ease: 'power3.out' } });

    // --- 1. Tagline fade-in + underline draw ---
    const tagline = hero.querySelector('[data-hero-tagline]');
    if (tagline) {
      const line = tagline.querySelector('span');
      gsap.set(tagline, { opacity: 0, y: 10 });
      tl.to(tagline, { opacity: 1, y: 0, duration: 0.6 });
      if (line) {
        gsap.set(line, { scaleX: 0, transformOrigin: 'left center' });
        tl.to(line, { scaleX: 1, duration: 0.4 }, '-=0.3');
      }
    }

    // --- 2. Title - clip-path reveal line by line ---
    const title = hero.querySelector('[data-hero-title]');
    if (title) {
      const split = new SplitText(title, { type: 'lines', linesClass: 'hero-line' });

      // Wrap each line in a clip container
      split.lines.forEach((line: HTMLElement) => {
        const wrapper = document.createElement('div');
        wrapper.style.overflow = 'hidden';
        wrapper.style.position = 'relative';
        line.parentNode?.insertBefore(wrapper, line);
        wrapper.appendChild(line);
      });

      gsap.set(split.lines, { y: '100%', opacity: 0 });
      tl.to(split.lines, {
        y: '0%',
        opacity: 1,
        duration: 0.8,
        stagger: 0.15,
        ease: 'power4.out',
      }, '-=0.2');
    }

    // --- 3. Photo - mask wipe (emerald overlay slides away) ---
    const photoWrapper = hero.querySelector('[data-hero-photo]');
    if (photoWrapper) {
      const overlay = document.createElement('div');
      overlay.className = 'hero-photo-mask';
      Object.assign(overlay.style, {
        position: 'absolute',
        inset: '0',
        background: 'linear-gradient(135deg, #427050, #6CAB7E)',
        zIndex: '10',
        borderRadius: 'inherit',
      });
      (photoWrapper as HTMLElement).style.position = 'relative';
      photoWrapper.appendChild(overlay);

      gsap.set(photoWrapper, { opacity: 1 });
      tl.to(overlay, {
        yPercent: 100,
        duration: 1,
        ease: 'power3.inOut',
      }, '-=0.4');
    }

    // --- 4. Subtitle + CTA fade-in ---
    const subtitle = hero.querySelector('[data-hero-subtitle]');
    const cta = hero.querySelector('[data-hero-cta]');
    if (subtitle) {
      gsap.set(subtitle, { opacity: 0, y: 20 });
      tl.to(subtitle, { opacity: 1, y: 0, duration: 0.6 }, '-=0.5');
    }
    if (cta) {
      gsap.set(cta, { opacity: 0, y: 15 });
      tl.to(cta, { opacity: 1, y: 0, duration: 0.5 }, '-=0.3');
    }

    // --- 5. Stats - counter animation + stagger ---
    const statNumbers = hero.querySelectorAll('[data-hero-stat]');
    if (statNumbers.length) {
      statNumbers.forEach((stat) => {
        gsap.set(stat.parentElement!, { opacity: 0, y: 20 });
      });

      tl.to(
        Array.from(statNumbers).map((s) => s.parentElement!),
        { opacity: 1, y: 0, duration: 0.5, stagger: 0.15 },
        '-=0.2'
      );

      // Animate numbers
      statNumbers.forEach((stat) => {
        const htmlStat = stat as HTMLElement;
        const target = htmlStat.dataset.heroStat || '0';
        const isFloat = target.includes('/');

        if (isFloat) {
          // For "5/5" type stats - just reveal, no counter
          return;
        }

        const numericValue = parseInt(target.replace(/\D/g, ''));
        const prefix = target.match(/^[^\d]*/)?.[0] || '';

        gsap.from(htmlStat, {
          textContent: 0,
          duration: 1.5,
          delay: 0.3,
          ease: 'power2.out',
          snap: { textContent: 1 },
          onUpdate: function () {
            const val = Math.round(parseFloat(htmlStat.textContent || '0'));
            htmlStat.textContent = prefix + val;
          },
        });
      });
    }

    // --- 6. Magnetic button ---
    const magneticBtn = hero.querySelector('[data-magnetic]');
    if (magneticBtn) {
      const btn = magneticBtn as HTMLElement;
      const strength = 0.3;

      btn.addEventListener('mousemove', (e: MouseEvent) => {
        const rect = btn.getBoundingClientRect();
        const x = e.clientX - rect.left - rect.width / 2;
        const y = e.clientY - rect.top - rect.height / 2;
        gsap.to(btn, {
          x: x * strength,
          y: y * strength,
          duration: 0.3,
          ease: 'power2.out',
        });
      });

      btn.addEventListener('mouseleave', () => {
        gsap.to(btn, { x: 0, y: 0, duration: 0.5, ease: 'elastic.out(1, 0.5)' });
      });
    }
  }

  // Run on page load (works with Astro View Transitions)
  document.addEventListener('astro:page-load', initHeroAnimations);
</script>
