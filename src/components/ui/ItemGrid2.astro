---
import { Icon } from 'astro-icon/components';
import { twMerge } from 'tailwind-merge';
import type { ItemGrid } from '~/types';
import CTA from './CTA.astro';
import { Image } from 'astro:assets'
import type { ImageMetadata } from 'astro';

const { items = [], columns, defaultIcon = '', classes = {} } = Astro.props as ItemGrid;

const {
  container: containerClass = "sm:grid-cols-1 md:grid-cols-2 lg:grid-cols-4",
  panel: panelClass = '',
  title: titleClass = '',
  description: descriptionClass = '',
  icon: defaultIconClass = 'text-primary',
} = classes;
---

{/* Mobile : scroll horizontal (inchangé) */}
{
  items && (
    <div
      class="flex flex-auto overflow-x-scroll gap-4 p-4 md:hidden"
    >
      {items.map(
        ({ title, description, icon, callToAction, callToAction2, image, servicesItems, price, ecLink, classes: itemClasses = {} }, index) => (
          <div class={twMerge('relative flex flex-col', panelClass, itemClasses?.panel, 'p-0 min-w-[85%]')}>
            {image && (
              <div class="service-image-wrapper relative overflow-hidden rounded-t-lg">
                <Image
                  src={image as ImageMetadata}
                  class="service-image object-cover w-full h-24 mb-0"
                  alt={image.alt || ''}
                  height={350}
                  width={450}
                />
              </div>
            )}
            <div class="p-4 flex flex-col justify-between grow">
              <div>
                {(icon || defaultIcon) && (
                  <Icon
                    name={icon || defaultIcon}
                    class={twMerge('hidden mb-2 w-10 h-10 text-emerald-800', defaultIconClass, itemClasses?.icon, 'text-emerald-800')}
                  />
                )}
                <h3 class={twMerge('text-xl font-bold', titleClass, itemClasses?.title)}>{title}</h3>
                {description && (
                  <p class={twMerge('text-muted mt-2', descriptionClass, itemClasses?.description)} set:html={description} />
                )}
                {servicesItems && (
                  <ul class="mt-2 pl-2 list-disc">
                    {servicesItems.map((item) => (
                      <li class="mt-2">
                        <h4 class="font-bold mb-1">{item.title}</h4>
                        <p>{item.description}</p>
                      </li>
                    ))}
                  </ul>
                )}
              </div>
              <div>
                {price && <div class="mt-2 text-xl"><strong>{price}</strong></div>}
                {callToAction && <div class="mt-2 text-emerald-900 cursor-pointer"><CTA callToAction={callToAction} /></div>}
                {callToAction2 && <div class="mt-2 text-emerald-900 cursor-pointer"><CTA callToAction={callToAction2} /></div>}
                {ecLink && (
                  <a href={ecLink.href} class="mt-3 block rounded-lg border border-emerald-200 bg-emerald-50 dark:bg-emerald-900/30 dark:border-emerald-800 px-4 py-3 text-sm text-emerald-800 dark:text-emerald-300 hover:bg-emerald-100 dark:hover:bg-emerald-900/50 transition-colors">
                    <span class="font-semibold">{ecLink.text}</span>
                    <span class="inline-block ml-1">&rarr;</span>
                  </a>
                )}
              </div>
            </div>
          </div>
        )
      )}
    </div>
  )
}

{/* Desktop : accordéon horizontal */}
{
  items && (
    <div
      class="hidden md:flex gap-4 p-4"
      data-haccordion
    >
      {items.map(
        ({ title, description, icon, callToAction, callToAction2, image, servicesItems, price, ecLink, classes: itemClasses = {} }, index) => (
          <div
            class={twMerge('relative flex flex-col overflow-hidden transition-all duration-500 ease-in-out', panelClass, itemClasses?.panel, 'p-0')}
            data-haccordion-item
            data-index={index}
          >
            {image && (
              <div class="service-image-wrapper relative overflow-hidden rounded-t-lg">
                <Image
                  src={image as ImageMetadata}
                  class="service-image object-cover w-full h-48"
                  alt={image.alt || ''}
                  height={350}
                  width={450}
                />
              </div>
            )}
            <div class="p-4 flex flex-col justify-between grow">
              <div>
                {(icon || defaultIcon) && (
                  <Icon
                    name={icon || defaultIcon}
                    class={twMerge('hidden mb-2 w-10 h-10 text-emerald-800', defaultIconClass, itemClasses?.icon, 'text-emerald-800')}
                  />
                )}
                <h3 class={twMerge('text-xl font-bold whitespace-nowrap', titleClass, itemClasses?.title)}>{title}</h3>
                <div class="haccordion-body">
                  {description && (
                    <p class={twMerge('text-muted mt-2', descriptionClass, itemClasses?.description)} set:html={description} />
                  )}
                  {servicesItems && (
                    <ul class="mt-2 pl-2 list-disc">
                      {servicesItems.map((item) => (
                        <li class="mt-2">
                          <h4 class="font-bold mb-1">{item.title}</h4>
                          <p>{item.description}</p>
                        </li>
                      ))}
                    </ul>
                  )}
                </div>
              </div>
              <div class="haccordion-body">
                {price && <div class="mt-2 text-xl"><strong>{price}</strong></div>}
                {callToAction && <div class="mt-2 text-emerald-900 cursor-pointer"><CTA callToAction={callToAction} /></div>}
                {callToAction2 && <div class="mt-2 text-emerald-900 cursor-pointer"><CTA callToAction={callToAction2} /></div>}
                {ecLink && (
                  <a href={ecLink.href} class="mt-3 block rounded-lg border border-emerald-200 bg-emerald-50 dark:bg-emerald-900/30 dark:border-emerald-800 px-4 py-3 text-sm text-emerald-800 dark:text-emerald-300 hover:bg-emerald-100 dark:hover:bg-emerald-900/50 transition-colors">
                    <span class="font-semibold">{ecLink.text}</span>
                    <span class="inline-block ml-1">&rarr;</span>
                  </a>
                )}
              </div>
            </div>
          </div>
        )
      )}
    </div>
  )
}

<style is:global>
  /* Duotone emerald overlay */
  .service-image-wrapper::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, #065f46, #34d399);
    mix-blend-mode: color;
    opacity: 0.1;
    pointer-events: none;
  }

  .service-image {
    filter: grayscale(10%) contrast(1.05) brightness(0.95);
  }

  /* Desktop horizontal accordion */
  [data-haccordion] {
    align-items: stretch;
    max-height: 650px;
  }

  [data-haccordion-item] {
    flex: 0 0 120px;
    cursor: pointer;
    opacity: 0.6;
    transition: flex 0.5s cubic-bezier(0.4, 0, 0.2, 1), opacity 0.4s ease;
    min-width: 0;
    overflow: hidden;
    max-height: 650px;
  }

  [data-haccordion-item]:hover:not(.haccordion-open) {
    opacity: 0.85;
    flex-basis: 140px;
  }

  [data-haccordion-item]:hover:not(.haccordion-open) .overflow-hidden img {
    transform: scale(1.05);
  }

  [data-haccordion-item] .overflow-hidden img {
    transition: transform 0.4s ease;
  }

  [data-haccordion-item].haccordion-open {
    flex: 1 1 0%;
    cursor: default;
    opacity: 1;
  }

  [data-haccordion-item] .haccordion-body {
    opacity: 0;
    overflow: hidden;
    max-height: 0;
    transition: opacity 0.3s ease, max-height 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  }

  [data-haccordion-item].haccordion-open .haccordion-body {
    opacity: 1;
    max-height: 600px;
    transition: opacity 0.3s ease 0.35s, max-height 0.4s cubic-bezier(0.4, 0, 0.2, 1) 0.25s;
  }

  /* Collapsed: titre vertical */
  [data-haccordion-item]:not(.haccordion-open) h3 {
    writing-mode: vertical-rl;
    text-orientation: mixed;
    white-space: nowrap;
    font-size: 0.875rem;
    letter-spacing: 0.05em;
    transition: writing-mode 0s 0.3s;
  }

  [data-haccordion-item].haccordion-open h3 {
    writing-mode: horizontal-tb;
    transition: writing-mode 0s;
  }
</style>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  function initHAccordion() {
    document.querySelectorAll('[data-haccordion]').forEach(function(grid) {
      var items = grid.querySelectorAll('[data-haccordion-item]');
      if (!items.length) return;

      // Open first by default
      var hasOpen = grid.querySelector('.haccordion-open');
      if (!hasOpen) {
        items[0].classList.add('haccordion-open');
      }

      // Clone first (removes old listeners), then animate the clones
      items.forEach(function(item) {
        var clone = item.cloneNode(true) as HTMLElement;
        item.parentNode!.replaceChild(clone, item);

        clone.addEventListener('click', function(e: Event) {
          var target = e.target as HTMLElement;
          if (clone.classList.contains('haccordion-open') && (target.closest('a') || target.closest('button'))) {
            return;
          }

          grid.querySelectorAll('[data-haccordion-item]').forEach(function(i) {
            i.classList.remove('haccordion-open');
          });
          clone.classList.add('haccordion-open');

          // --- C. Content fade-in on open ---
          var bodies = clone.querySelectorAll('.haccordion-body');
          bodies.forEach(function(body: Element) {
            gsap.fromTo(body,
              { opacity: 0, y: 10 },
              { opacity: 1, y: 0, duration: 0.4, delay: 0.35, ease: 'power2.out' }
            );
          });

          // Title horizontal slide
          var title = clone.querySelector('h3');
          if (title) {
            gsap.fromTo(title,
              { opacity: 0, x: -15 },
              { opacity: 1, x: 0, duration: 0.3, delay: 0.1, ease: 'power2.out' }
            );
          }
        });
      });

      // --- A. Scroll reveal stagger (on the NEW cloned items) ---
      var freshItems = grid.querySelectorAll('[data-haccordion-item]');
      gsap.fromTo(
        Array.from(freshItems),
        { opacity: 0, y: 40 },
        {
          opacity: 1,
          y: 0,
          duration: 0.6,
          stagger: 0.12,
          ease: 'power3.out',
          scrollTrigger: {
            trigger: grid,
            start: 'top 85%',
            once: true,
          },
          onComplete: function() {
            freshItems.forEach(function(item) {
              // Let CSS handle opacity after reveal
              (item as HTMLElement).style.removeProperty('opacity');
            });
          },
        }
      );
    });

    // --- A. Mobile cards scroll reveal ---
    var mobileCards = document.querySelectorAll('.flex.overflow-x-scroll > div');
    if (mobileCards.length) {
      gsap.fromTo(
        Array.from(mobileCards),
        { opacity: 0, x: 30 },
        {
          opacity: 1,
          x: 0,
          duration: 0.5,
          stagger: 0.1,
          ease: 'power3.out',
          scrollTrigger: {
            trigger: mobileCards[0].parentElement,
            start: 'top 85%',
            once: true,
          },
        }
      );
    }
  }

  document.addEventListener('astro:page-load', initHAccordion);
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initHAccordion);
  } else {
    initHAccordion();
  }
</script>
