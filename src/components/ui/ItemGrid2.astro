---
import { Icon } from 'astro-icon/components';
import { twMerge } from 'tailwind-merge';
import type { ItemGrid } from '~/types';
import CTA from './CTA.astro';
import { Image } from 'astro:assets'
import type { ImageMetadata } from 'astro';

const { items = [], defaultIcon = '', classes = {} } = Astro.props as ItemGrid;

const {
  panel: panelClass = '',
  title: titleClass = '',
  description: descriptionClass = '',
  icon: defaultIconClass = 'text-primary',
} = classes;
---

{/* Mobile : scroll horizontal */}
{
  items && (
    <div class="flex flex-auto overflow-x-scroll gap-4 p-4 md:hidden">
      {items.map(
        ({ title, description, icon, callToAction, callToAction2, image, servicesItems, price, ecLink, classes: itemClasses = {} }) => (
          <div class={twMerge('relative flex flex-col', panelClass, itemClasses?.panel, 'p-0 min-w-[85%]')}>
            {image && (
              <div class="service-image-wrapper relative overflow-hidden rounded-t-lg">
                <Image
                  src={image as ImageMetadata}
                  class="service-image object-cover w-full h-24 mb-0"
                  alt={image.alt || ''}
                  height={350}
                  width={450}
                />
              </div>
            )}
            <div class="p-4 flex flex-col justify-between grow">
              <div>
                {(icon || defaultIcon) && (
                  <Icon
                    name={icon || defaultIcon}
                    class={twMerge('hidden mb-2 w-10 h-10 text-emerald-800', defaultIconClass, itemClasses?.icon, 'text-emerald-800')}
                  />
                )}
                <h3 class={twMerge('text-xl font-bold', titleClass, itemClasses?.title)}>{title}</h3>
                {description && (
                  <p class={twMerge('text-muted mt-2', descriptionClass, itemClasses?.description)} set:html={description} />
                )}
                {servicesItems && (
                  <ul class="mt-2 pl-2 list-disc">
                    {servicesItems.map((item) => (
                      <li class="mt-2">
                        <h4 class="font-bold mb-1">{item.title}</h4>
                        <p>{item.description}</p>
                      </li>
                    ))}
                  </ul>
                )}
              </div>
              <div>
                {price && <div class="mt-2 text-xl"><strong>{price}</strong></div>}
                {callToAction && <div class="mt-2 text-emerald-900 cursor-pointer"><CTA callToAction={callToAction} /></div>}
                {callToAction2 && <div class="mt-2 text-emerald-900 cursor-pointer"><CTA callToAction={callToAction2} /></div>}
                {ecLink && (
                  <a href={ecLink.href} class="mt-3 block rounded-lg border border-emerald-200 bg-emerald-50 dark:bg-emerald-900/30 dark:border-emerald-800 px-4 py-3 text-sm text-emerald-800 dark:text-emerald-300 hover:bg-emerald-100 dark:hover:bg-emerald-900/50 transition-colors">
                    <span class="font-semibold">{ecLink.text}</span>
                    <span class="inline-block ml-1">&rarr;</span>
                  </a>
                )}
              </div>
            </div>
          </div>
        )
      )}
    </div>
  )
}

{/* Desktop : accordéon horizontal — GSAP gère tout */}
{
  items && (
    <div
      class="hidden md:flex gap-4 p-4"
      data-haccordion
    >
      {items.map(
        ({ title, description, icon, callToAction, callToAction2, image, servicesItems, price, ecLink, classes: itemClasses = {} }, index) => (
          <div
            class={twMerge(
              'relative flex flex-col overflow-hidden rounded-lg shadow-[0_4px_30px_rgba(0,0,0,0.1)] backdrop-blur border border-[#ffffff29] bg-white dark:bg-slate-900 cursor-pointer',
              itemClasses?.panel
            )}
            data-haccordion-item
            data-index={index}
          >
            {image && (
              <div class="service-image-wrapper relative overflow-hidden rounded-t-lg">
                <Image
                  src={image as ImageMetadata}
                  class="service-image object-cover w-full h-48"
                  alt={image.alt || ''}
                  height={350}
                  width={450}
                />
              </div>
            )}
            <div class="p-4 flex flex-col justify-between grow">
              <div>
                {(icon || defaultIcon) && (
                  <Icon
                    name={icon || defaultIcon}
                    class={twMerge('hidden mb-2 w-10 h-10 text-emerald-800', defaultIconClass, itemClasses?.icon, 'text-emerald-800')}
                  />
                )}
                <h3 class={twMerge('text-xl font-bold whitespace-nowrap', titleClass, itemClasses?.title)}>{title}</h3>
                <div class="haccordion-body" style="overflow:hidden;">
                  {description && (
                    <p class={twMerge('text-muted mt-2', descriptionClass, itemClasses?.description)} set:html={description} />
                  )}
                  {servicesItems && (
                    <ul class="mt-2 pl-2 list-disc">
                      {servicesItems.map((item) => (
                        <li class="mt-2">
                          <h4 class="font-bold mb-1">{item.title}</h4>
                          <p>{item.description}</p>
                        </li>
                      ))}
                    </ul>
                  )}
                </div>
              </div>
              <div class="haccordion-body" style="overflow:hidden;">
                {price && <div class="mt-2 text-xl"><strong>{price}</strong></div>}
                {callToAction && <div class="mt-2 text-emerald-900 cursor-pointer"><CTA callToAction={callToAction} /></div>}
                {callToAction2 && <div class="mt-2 text-emerald-900 cursor-pointer"><CTA callToAction={callToAction2} /></div>}
                {ecLink && (
                  <a href={ecLink.href} class="mt-3 block rounded-lg border border-emerald-200 bg-emerald-50 dark:bg-emerald-900/30 dark:border-emerald-800 px-4 py-3 text-sm text-emerald-800 dark:text-emerald-300 hover:bg-emerald-100 dark:hover:bg-emerald-900/50 transition-colors">
                    <span class="font-semibold">{ecLink.text}</span>
                    <span class="inline-block ml-1">&rarr;</span>
                  </a>
                )}
              </div>
            </div>
          </div>
        )
      )}
    </div>
  )
}

<style is:global>
  .service-image-wrapper::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, #065f46, #34d399);
    mix-blend-mode: color;
    opacity: 0.1;
    pointer-events: none;
  }

  .service-image {
    filter: grayscale(10%) contrast(1.05) brightness(0.95);
  }

  [data-haccordion] {
    align-items: stretch;
  }

  /* État initial CSS — évite le flash avant que GSAP prenne le relais */
  [data-haccordion-item] {
    flex: 0 0 120px;
    opacity: 0.6;
    cursor: pointer;
    min-width: 0;
    overflow: hidden;
  }

  [data-haccordion-item]:first-child {
    flex: 1 1 0%;
    opacity: 1;
    cursor: default;
  }

  [data-haccordion-item] .haccordion-body {
    height: 0;
    opacity: 0;
    overflow: hidden;
  }

  [data-haccordion-item]:first-child .haccordion-body {
    height: auto;
    opacity: 1;
  }

  [data-haccordion-item] h3 {
    writing-mode: vertical-rl;
    text-orientation: mixed;
    white-space: nowrap;
    font-size: 0.875rem;
    letter-spacing: 0.05em;
  }

  [data-haccordion-item]:first-child h3 {
    writing-mode: horizontal-tb;
    font-size: revert;
    letter-spacing: normal;
  }

  [data-haccordion-item] .service-image-wrapper img {
    transition: transform 0.4s ease;
  }

  [data-haccordion-item]:hover .service-image-wrapper img {
    transform: scale(1.05);
  }
</style>

<script>
  import gsap from 'gsap';

  function initHAccordion() {
    const grids = document.querySelectorAll<HTMLElement>('[data-haccordion]');

    grids.forEach((grid) => {
      if (grid.dataset.haccordionInit) return;
      grid.dataset.haccordionInit = '1';

      let activeIndex = 0;
      const collapsedWidth = 120;

      function getItems() {
        return Array.from(grid.querySelectorAll<HTMLElement>('[data-haccordion-item]'));
      }

      // --- Initial state via GSAP (reinforces CSS) ---
      getItems().forEach((item, i) => {
        const bodies = item.querySelectorAll<HTMLElement>('.haccordion-body');
        const h3 = item.querySelector('h3') as HTMLElement;

        if (i === 0) {
          gsap.set(item, { flexGrow: 1, flexShrink: 1, flexBasis: '0%', opacity: 1, cursor: 'default' });
          gsap.set(bodies, { height: 'auto', opacity: 1 });
          if (h3) {
            h3.style.writingMode = 'horizontal-tb';
            h3.style.fontSize = '';
            h3.style.letterSpacing = '';
          }
        } else {
          gsap.set(item, { flexGrow: 0, flexShrink: 0, flexBasis: collapsedWidth + 'px', opacity: 0.6 });
          gsap.set(bodies, { height: 0, opacity: 0 });
          if (h3) {
            h3.style.writingMode = 'vertical-rl';
            h3.style.fontSize = '0.875rem';
            h3.style.letterSpacing = '0.05em';
          }
        }
      });

      // --- Click: use data-index, re-query each time ---
      grid.addEventListener('click', (e: Event) => {
        const target = e.target as HTMLElement;

        // Allow links/buttons
        if (target.closest('a') || target.closest('button')) return;

        const card = target.closest('[data-haccordion-item]') as HTMLElement;
        if (!card) return;

        const clickedIndex = parseInt(card.dataset.index || '-1');
        if (clickedIndex === -1 || clickedIndex === activeIndex) return;

        // Re-query to always have fresh references
        const allItems = getItems();
        const prevCard = allItems[activeIndex];
        if (!prevCard) return;

        const prevBodies = prevCard.querySelectorAll<HTMLElement>('.haccordion-body');
        const prevH3 = prevCard.querySelector('h3') as HTMLElement;
        const newBodies = card.querySelectorAll<HTMLElement>('.haccordion-body');
        const newH3 = card.querySelector('h3') as HTMLElement;

        activeIndex = clickedIndex;

        const tl = gsap.timeline();

        // 1. Collapse previous
        tl.to(prevBodies, {
          height: 0, opacity: 0, duration: 0.3, ease: 'power2.in',
          onComplete: () => {
            if (prevH3) {
              prevH3.style.writingMode = 'vertical-rl';
              prevH3.style.fontSize = '0.875rem';
              prevH3.style.letterSpacing = '0.05em';
            }
          }
        }, 0);

        tl.to(prevCard, {
          flexGrow: 0, flexShrink: 0, flexBasis: collapsedWidth + 'px',
          opacity: 0.6, cursor: 'pointer',
          duration: 0.5, ease: 'power2.inOut'
        }, 0);

        // 2. Expand clicked
        tl.to(card, {
          flexGrow: 1, flexShrink: 1, flexBasis: '0%',
          opacity: 1, cursor: 'default',
          duration: 0.5, ease: 'power2.inOut',
          onStart: () => {
            if (newH3) {
              newH3.style.writingMode = 'horizontal-tb';
              newH3.style.fontSize = '';
              newH3.style.letterSpacing = '';
            }
          }
        }, 0.1);

        // 3. Reveal bodies
        tl.to(newBodies, {
          height: 'auto', opacity: 1, duration: 0.4, ease: 'power2.out'
        }, 0.3);

        // 4. Staggered content
        if (newH3) {
          tl.fromTo(newH3,
            { opacity: 0, x: -20 },
            { opacity: 1, x: 0, duration: 0.35, ease: 'power3.out' },
            0.35
          );
        }

        const desc = card.querySelector('.haccordion-body p');
        if (desc) {
          tl.fromTo(desc,
            { opacity: 0, y: 12 },
            { opacity: 1, y: 0, duration: 0.3, ease: 'power2.out' },
            0.42
          );
        }

        const listItems = card.querySelectorAll('.haccordion-body li');
        if (listItems.length) {
          tl.fromTo(listItems,
            { opacity: 0, x: -10, y: 6 },
            { opacity: 1, x: 0, y: 0, duration: 0.3, stagger: 0.08, ease: 'power2.out' },
            0.48
          );
        }

        const bottomEls = card.querySelectorAll('.haccordion-body > div');
        if (bottomEls.length) {
          tl.fromTo(bottomEls,
            { opacity: 0, y: 10 },
            { opacity: 1, y: 0, duration: 0.3, stagger: 0.06, ease: 'power2.out' },
            '-=0.15'
          );
        }
      });
    });
  }

  document.addEventListener('astro:page-load', initHAccordion);
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initHAccordion);
  } else {
    initHAccordion();
  }
</script>
