---
import PillBadge from '~/components/ui/PillBadge.astro';

export interface Props {
  kicker?: string;
  kickerVariant?: 'dot' | 'pill';
  number?: string;
  subtitle?: string;
  align?: 'center' | 'left';
  class?: string;
}
const { kicker, kickerVariant = 'dot', number, subtitle, align = 'center', class: className = '' } = Astro.props;
---

<div class:list={[align === 'center' && 'text-center', className]}>
  {number && (
    <span class="block text-5xl md:text-6xl font-light text-sage-dark leading-none tracking-tight mb-4" aria-hidden="true">
      {number}
    </span>
  )}
  {kicker && kickerVariant === 'pill' && (
    <p class="mb-6"><PillBadge text={kicker} /></p>
  )}
  {kicker && kickerVariant === 'dot' && (
    <p
      class:list={[
        'text-xs font-semibold uppercase tracking-[0.2em] text-muted mb-3 flex items-center gap-2',
        align === 'center' && 'justify-center',
      ]}
    >
      <span class="w-1.5 h-1.5 rounded-full bg-sage" aria-hidden="true"></span>
      {kicker}
    </p>
  )}
  <h2 class:list={['text-3xl sm:text-5xl tracking-tight text-charcoal leading-tight', subtitle && 'mb-4']}>
    <slot />
  </h2>
  {subtitle && (
    <p class:list={['text-base text-muted max-w-2xl leading-relaxed', align === 'center' && 'mx-auto']}>
      {subtitle}
    </p>
  )}
</div>
