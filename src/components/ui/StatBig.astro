---
export interface Props {
  value: string;
  label: string;
  size?: 'md' | 'lg';
  class?: string;
}
const { value, label, size = 'lg', class: className = '' } = Astro.props;
---

<div class:list={['border-t border-black/10 pt-6', className]} data-fade-up>
  <p
    class:list={[
      'font-heading text-charcoal leading-none tracking-tight',
      size === 'lg' ? 'text-5xl md:text-7xl' : 'text-4xl md:text-5xl',
    ]}
  >
    {value}
  </p>
  <p class="mt-2 text-sm text-muted uppercase tracking-wide">{label}</p>
</div>
