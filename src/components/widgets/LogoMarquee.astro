---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Logo {
  src: ImageMetadata;
  alt: string;
  href?: string;
  scale?: number; // 1 = normal, 1.3 = plus gros, 0.8 = plus petit
}

interface Props {
  title?: string;
  logos: Logo[];
  speed?: number;
}

const { title, logos, speed = 30 } = Astro.props;
---

<section class="py-6 bg-gray-50 bg-slate-800/50 overflow-hidden">
  {title && (
    <p class="text-center text-sm text-gray-500 text-gray-400 mb-4 uppercase tracking-wider font-medium">
      {title}
    </p>
  )}

  <div class="relative">
    <div class="absolute left-0 top-0 bottom-0 w-20 bg-gradient-to-r from-gray-50 from-slate-800/50 to-transparent z-10"></div>
    <div class="absolute right-0 top-0 bottom-0 w-20 bg-gradient-to-l from-gray-50 from-slate-800/50 to-transparent z-10"></div>

    <div class="flex overflow-hidden">
      <div class="marquee-track flex items-center gap-12 md:gap-16" style={`--marquee-duration: ${speed}s`}>
        {logos.map((logo) => {
          const scaleStyle = logo.scale ? `transform: scale(${logo.scale})` : '';
          return logo.href ? (
            <a href={logo.href} target="_blank" rel="noopener noreferrer" class="flex-shrink-0 opacity-70 hover:opacity-100 transition-opacity grayscale hover:grayscale-0">
              <Image
                src={logo.src}
                alt={logo.alt}
                class="h-8 md:h-10 w-auto object-contain"
                style={scaleStyle}
                height={40}
              />
            </a>
          ) : (
            <div class="flex-shrink-0 opacity-70 grayscale">
              <Image
                src={logo.src}
                alt={logo.alt}
                class="h-8 md:h-10 w-auto object-contain"
                style={scaleStyle}
                height={40}
              />
            </div>
          )
        })}
        {logos.map((logo) => {
          const scaleStyle = logo.scale ? `transform: scale(${logo.scale})` : '';
          return logo.href ? (
            <a href={logo.href} target="_blank" rel="noopener noreferrer" class="flex-shrink-0 opacity-70 hover:opacity-100 transition-opacity grayscale hover:grayscale-0">
              <Image
                src={logo.src}
                alt={logo.alt}
                class="h-8 md:h-10 w-auto object-contain"
                style={scaleStyle}
                height={40}
              />
            </a>
          ) : (
            <div class="flex-shrink-0 opacity-70 grayscale">
              <Image
                src={logo.src}
                alt={logo.alt}
                class="h-8 md:h-10 w-auto object-contain"
                style={scaleStyle}
                height={40}
              />
            </div>
          )
        })}
      </div>
    </div>
  </div>
</section>

<style>
  .marquee-track {
    animation: marquee var(--marquee-duration, 30s) linear infinite;
  }

  @keyframes marquee {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }

  .marquee-track:hover {
    animation-play-state: paused;
  }
</style>
