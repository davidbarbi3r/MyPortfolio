---
interface Props {
  title?: string;
  description?: string;
  downloadUrl?: string;
  class?: string;
}

const {
  title = "Checklist gratuite : les 10 erreurs SEO des cabinets comptables",
  description = "Recevez la checklist pour auditer votre site en 10 minutes et identifier vos actions prioritaires.",
  downloadUrl = "/lead-magnets/checklist-seo-expert-comptable.pdf",
  class: className = "",
} = Astro.props;
---

<div class={`lead-magnet-form ${className}`} data-lead-form>
  <div class="max-w-2xl mx-auto bg-green-800/10 bg-gray-800 rounded-2xl p-8 md:p-10">
    <!-- Before submit -->
    <div data-lead-before>
      <h3 class="text-xl md:text-2xl font-heading font-semibold text-gray-900 text-gray-100 mb-3">
        {title}
      </h3>
      <p class="text-gray-600 text-gray-300 mb-6">
        {description}
      </p>
      <form data-lead-form-el class="flex flex-col sm:flex-row gap-3">
        <input
          type="email"
          name="email"
          required
          placeholder="votre@email.fr"
          class="flex-1 px-4 py-3 rounded-lg border border-gray-300 border-gray-600 bg-gray-700 text-white text-sm focus:outline-none focus:ring-2 focus:ring-green-700"
        />
        <button
          type="submit"
          class="px-6 py-3 bg-green-700 hover:bg-green-600 text-white font-semibold text-sm rounded-lg transition whitespace-nowrap"
          data-lead-btn
        >
          Télécharger la checklist
        </button>
      </form>
      <p class="text-xs text-gray-500 text-gray-400 mt-3">
        Pas de spam. Vous pouvez vous désinscrire à tout moment.
      </p>
      <p data-lead-error class="text-xs text-red-600 mt-2 hidden"></p>
    </div>

    <!-- After submit -->
    <div data-lead-after class="hidden text-center">
      <div class="text-3xl mb-3">&#10003;</div>
      <h3 class="text-xl font-heading font-semibold text-gray-900 text-gray-100 mb-2">
        C'est parti !
      </h3>
      <p class="text-gray-600 text-gray-300 mb-6">
        Votre checklist est prête. Cliquez ci-dessous pour la télécharger.
      </p>
      <a
        href={downloadUrl}
        target="_blank"
        rel="noopener"
        class="inline-block px-8 py-3 bg-green-700 hover:bg-green-600 text-white font-semibold rounded-lg transition"
      >
        Ouvrir la checklist →
      </a>
    </div>
  </div>
</div>

<script>
  document.addEventListener('astro:page-load', () => {
    document.querySelectorAll<HTMLElement>('[data-lead-form]').forEach((container) => {
      const form = container.querySelector<HTMLFormElement>('[data-lead-form-el]');
      const btn = container.querySelector<HTMLButtonElement>('[data-lead-btn]');
      const before = container.querySelector<HTMLElement>('[data-lead-before]');
      const after = container.querySelector<HTMLElement>('[data-lead-after]');
      const errorEl = container.querySelector<HTMLElement>('[data-lead-error]');

      if (!form || !btn || !before || !after || !errorEl) return;

      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        const email = new FormData(form).get('email') as string;
        if (!email) return;

        btn.disabled = true;
        btn.textContent = 'Envoi...';
        errorEl.classList.add('hidden');

        try {
          const res = await fetch('/api/subscribe', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ email }),
          });

          if (!res.ok) throw new Error();

          before.classList.add('hidden');
          after.classList.remove('hidden');
        } catch {
          errorEl.textContent = 'Une erreur est survenue. Réessayez ou contactez-moi directement.';
          errorEl.classList.remove('hidden');
          btn.disabled = false;
          btn.textContent = 'Télécharger la checklist';
        }
      });
    });
  });
</script>
