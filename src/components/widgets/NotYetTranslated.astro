---
// src/components/NotTranslatedYet.astro
interface Props {
  frenchUrl: string;
}

const { frenchUrl } = Astro.props;
---

<div class="flex flex-col items-center justify-center min-h-screen p-8 text-center">
  <h1 class="text-4xl font-bold mb-6">This page is not yet available in English</h1>
  <p class="text-xl mb-8">We're working on the translation. In the meantime, you can visit the French version.</p>

  <a
    href={frenchUrl}
    class="px-6 py-3 bg-green-800 text-white rounded-lg hover:bg-blue-700 transition-colors"
  >
    Visit French version
  </a>
</div>
