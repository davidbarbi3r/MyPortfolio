---
import { Icon } from 'astro-icon/components';
import Image from '~/components/common/Image.astro';
import { CallToAction } from '~/types';

export interface Props {
  title?: string;
  subtitle?: string;
  tagline?: string;
  content?: string;
  callToAction?: string | CallToAction;
  callToAction2?: string | CallToAction;
  image?: string | any;
}

const {
  title = await Astro.slots.render('title'),
  subtitle = await Astro.slots.render('subtitle'),
  tagline,
  content = await Astro.slots.render('content'),
  callToAction = await Astro.slots.render('callToAction'),
  callToAction2 = await Astro.slots.render('callToAction2'),
  image = await Astro.slots.render('image'),
} = Astro.props;
---

<section class="relative md:-mt-[76px] not-prose" data-hero>
  <div class="absolute inset-0 pointer-events-none" aria-hidden="true"></div>
  <div class="relative max-w-7xl mx-auto px-4 sm:px-6">
    <div class="pt-0 md:pt-[76px] pointer-events-none"></div>

    {/* === HEADLINE BLOCK — full width, giant typography, overlaps photo === */}
    <div class="pt-8 md:pt-12 lg:pt-16 relative z-10">
      {tagline && (
        <h1
          class="text-sm text-slate-500 dark:text-slate-400 font-medium tracking-[0.2em] uppercase mb-6"
          data-hero-tagline
        >
          <span class="inline-block w-4 h-[2px] bg-emerald-600 mr-3 align-middle"></span>
          {tagline}
        </h1>
      )}
      {title && (
        <p
          class="text-4xl md:text-5xl lg:text-6xl font-bold leading-[0.95] tracking-tight mb-0 font-heading"
          data-hero-title
          set:html={title}
        />
      )}
    </div>

    {/* === 3-COLUMN GRID — text+CTA | photo (center, wider) | stats === */}
    <div class="grid grid-cols-1 lg:grid-cols-4 gap-8 lg:gap-10 lg:-mt-16 pb-12 md:pb-20">

      {/* Column 1: Description + CTA (1/4) */}
      <div class="lg:col-span-1 flex flex-col justify-center order-2 lg:order-1">
        {subtitle && (
          <p class="text-sm md:text-base text-slate-600 dark:text-slate-300 leading-relaxed mb-8" data-hero-subtitle set:html={subtitle} />
        )}
        {callToAction && (
          <div class="flex">
            {typeof callToAction === 'string' ? (
              <Fragment set:html={callToAction} />
            ) : (
              <a
                class="inline-flex items-center gap-2 bg-gradient-to-r from-emerald-800 to-emerald-600 hover:from-emerald-700 hover:to-emerald-500 text-white font-semibold tracking-wide uppercase text-xs px-5 py-3 rounded-lg transition-all duration-300 whitespace-nowrap"
                href={callToAction?.href}
                data-hero-cta
                data-magnetic
              >
                {callToAction?.icon && (
                  <Icon name={callToAction.icon} class="w-4 h-4" />
                )}
                {callToAction?.text}
              </a>
            )}
          </div>
        )}
        {callToAction2 && (
          <div class="flex mt-3">
            {typeof callToAction2 === 'string' ? (
              <Fragment set:html={callToAction2} />
            ) : (
              <a class="btn" href={callToAction2?.href}>
                {callToAction2?.icon && (
                  <Icon name={callToAction2.icon} class="w-5 h-5 mr-1" />
                )}
                {callToAction2.text}
              </a>
            )}
          </div>
        )}
      </div>

      {/* Column 2: Portrait photo — center, imposing (2/4) */}
      <div class="lg:col-span-2 relative z-0 order-1 lg:order-2">
        {image && (
          <div class="relative overflow-hidden rounded-lg" data-hero-photo>
              {typeof image === 'string' ? (
                <Fragment set:html={image} />
              ) : (
                <Image
                  class="w-full h-auto object-contain rounded-lg"
                  widths={[400, 768, 1024]}
                  sizes="(max-width: 1023px) 100vw, 50vw"
                  loading="eager"
                  width={800}
                  height={1000}
                  {...image}
                />
              )}
          </div>
        )}
      </div>

      {/* Column 3: Stats / Metrics (1/4) */}
      <div class="lg:col-span-1 flex flex-col justify-center order-3">
        {content && <Fragment set:html={content} />}
      </div>

    </div>
  </div>
</section>

