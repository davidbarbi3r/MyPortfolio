{
  "cleanUrls": true,
  "trailingSlash": true,
  "redirects": [
    { "source": "/call", "destination": "/reserve-ton-appel/", "permanent": true },
    { "source": "/call/", "destination": "/reserve-ton-appel/", "permanent": true },
        { "source": "/book-a-call", "destination": "/reserve-ton-appel/", "permanent": true },
    { "source": "/book-a-call/", "destination": "/reserve-ton-appel/", "permanent": true }
  ],
  "headers": [
    {
      "source": "/_astro/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
